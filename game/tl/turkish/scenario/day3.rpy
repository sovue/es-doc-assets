translate turkish day3_playground_us_f88907e2:


    us "Ama bana karşı bir gol atamayacaksın!"


translate turkish day3_playground_us_f4d2ad6b:


    me "Göreceğiz..."


translate turkish day3_playground_us_05c10dae:


    "İsabetli bir vuruşla topu kalenin sağ alt köşesine gönderdim."


translate turkish day3_playground_us_9f646b2e:


    "Ulyana hareket bile edemedi."


translate turkish day3_playground_us_94dc722a:


    "Yine de bir anlamı yok – penaltı vuruşları tahmin edilemez."


translate turkish day3_playground_us_34ad2df9:


    me "Görünüşe göre ben kazandım."


translate turkish day3_playground_us_a01972f6:


    "Cevap vermedi ve bana kızgınlıkla baktı."


translate turkish day3_playground_us_24a977a7:


    "Durumu yumuşatmam lazım."


translate turkish day3_playground_us_f5bed6f9:


    me "Sinirlenme!{w} Ben sadece..."


translate turkish day3_playground_us_e3b0eb4b:


    "Tam o anda müzik çaldı ve öncüleri öğle yemeğine çağırdı."


translate turkish day3_playground_us_f6bba3b9:


    us "Pekala, Seninle sonra ödeşirim!"


translate turkish day3_playground_us_a66acadc:


    "Güldü, elini salladı ve kantine doğru koşmaya başladı."


translate turkish day3_playground_us_19a2ba8b:


    "Topla birazcık oynayıp onu takip ettim."


translate turkish day3_stage_dv_57fadfbd:


    "Sahne alanına geldiğimde sahnede Alisa'yı gördüm."


translate turkish day3_stage_dv_14e3da9e:


    "Kız her şeyini ortaya koyuyordu - gözleri kapalıydı, bacaklarından birini hoparlörün üzerine koymuş ve müziğin ritmiyle vücudunu sallıyordu."


translate turkish day3_stage_dv_ebaf2447:


    "Melodiyi tanıyamadım, ama önceden bir yerde duyduğuma eminim."


translate turkish day3_stage_dv_bbd1630b:


    th "Muhtemelen Sovyet-Rock türü."


translate turkish day3_stage_dv_b91c885c:


    "Hemen bu türde bir düzine grup sayabilirdim ama uzman sayılmazdım."


translate turkish day3_stage_dv_abb4c6d0:


    "Şarkı gerçekten basit görünüyordu, kelimenin tam anlamıyla sadece üç akorlu bir ilerleme."


translate turkish day3_stage_dv_61c07cfb:


    "Birazcık pratikle muhtemelen ben bile çalabilirim."


translate turkish day3_stage_dv_3ae0fcac:


    th "Acaba Alisa bu yeteneklerini nasıl kazandı?"


translate turkish day3_stage_dv_3e58d153:


    "SSCB'de bu tür müzikler hiçbir zaman ulusal düzeyde kabul görmemişti."


translate turkish day3_stage_dv_923112f9:


    "Geleceğin rock yıldızı beni farketmedi."


translate turkish day3_stage_dv_3aea360d:


    "Sanki müzik ile bir olmaya çalışıyordu, Her notada, her barda, her üçlükte yankılanmak için."


translate turkish day3_stage_dv_d8f81d0f:


    "Aklıma hemen seksenli yılların rock kahramanları geldi - birçoğu müziğe benzer şekilde bağlıydı."


translate turkish day3_stage_dv_a08c8857:


    th "Eğer öncü üniforması yerine o dönemin modasına uygun bir şeyler giyseydi kimse herhangi bir farklılık görmezdi."


translate turkish day3_stage_dv_8ec8402b:


    "{i}Performansı{/i} bitmek üzereydi."


translate turkish day3_stage_dv_2a480da6:


    "Son birkaç akoru çalarken Alisa sonunda beni fark etti."


translate turkish day3_stage_dv_13716aa5:


    dv "Beğendin mi?"


translate turkish day3_stage_dv_4f67d38e:


    "Beklediğim kadar şaşırmış görünmüyordu."


translate turkish day3_stage_dv_4041176b:


    me "Evet, güzeldi."


translate turkish day3_stage_dv_944e8574:


    dv "Sanki daha iyisini yapabilirsin de!"


translate turkish day3_stage_dv_495c9ac7:


    "Alisa şakacı bir şekilde güldü."


translate turkish day3_stage_dv_149c1b07:


    me "Daha iyisini yapabileceğimi söylemiyorum.{w} Müzikte profesyonel değilim."


translate turkish day3_stage_dv_65c958c7:


    dv "Şüphesiz."


translate turkish day3_stage_dv_bd025218:


    me "Evet."


translate turkish day3_stage_dv_d16a7088:


    "Başka ne diyeceğimi bilmediğim için yoluma koyuluyordum."


translate turkish day3_stage_dv_f72c72fe:


    dv "Bekle bir dakika."


translate turkish day3_stage_dv_ad02f53a:


    me "Ne?"


translate turkish day3_stage_dv_4657233d:


    dv "Akşamki dans partisini duydun mu?"


translate turkish day3_stage_dv_f14dc8aa:


    me "Balo olduğunu sanmıştım..."


translate turkish day3_stage_dv_f48c6409:


    dv "Balo, dans partisi – ne farkı var?"


translate turkish day3_stage_dv_823e3ce8:


    "Kaşlarını çattı."


translate turkish day3_stage_dv_c6a323d5:


    me "Evet, duydum, niye sordun ki?"


translate turkish day3_stage_dv_a67a2d53:


    dv "Gidecek misin?"


translate turkish day3_stage_dv_2625e9c4:


    "Bu sözleri söyledikten sonra arkasını döndü.."


translate turkish day3_stage_dv_0e943fd7:


    me "Emin değilim... Ya sen?"


translate turkish day3_stage_dv_2e685a48:


    dv "Ne yapacağım ki orada? Moron sürüsünü mü izleyeceğim?"


translate turkish day3_stage_dv_30498730:


    "Alisa'nın kelimelerinde doğruluk payı vardı, ama bu açık saygısızlık beni şaşırttı."


translate turkish day3_stage_dv_a94386e7:


    "Açıkça görülüyor ki nefret ettiği şey balo fikri değil."


translate turkish day3_stage_dv_977aad9c:


    me "Ama neden?"


translate turkish day3_stage_dv_a35f4984:


    dv "'Neden' derken neyi kastediyorsun?"


translate turkish day3_stage_dv_99ad6855:


    me "Şey, neden gelmek istemiyorsun?{w} Dans partileri eğlenceli olur..."


translate turkish day3_stage_dv_c217ed8b:


    dv "Öyle mi düşünüyorsun?"


translate turkish day3_stage_dv_868730ed:


    "Sinir olduğu sesinden belli oluyordu."


translate turkish day3_stage_dv_9d80b9cf:


    me "Bilmiyorum.{w} Ama düşündüm ki..."


translate turkish day3_stage_dv_86c3ec28:


    dv "Hiçbir zaman sevmedim."


translate turkish day3_stage_dv_0d425fdb:


    "Sözümü kesti."


translate turkish day3_stage_dv_c0fab6ae:


    dv "Partilerde yapılacak hiçbir şey yok!"


translate turkish day3_stage_dv_97523377:


    me "Anlıyorum...{w} Planın ne o zaman?"


translate turkish day3_stage_dv_a2c6cc1c:


    "Sohbeti devam ettirmek için sordum."


translate turkish day3_stage_dv_81a1f427:


    dv "Pratik yapıcağım."


translate turkish day3_stage_dv_2c8d8df5:


    me "Ne pratiği?"


translate turkish day3_stage_dv_096cd639:


    dv "Müzik tabii aptal! Duydun bile!"


translate turkish day3_stage_dv_d4729704:


    "Alisa tamamen deliye döndü. Bir kaç tane daha aptalca soru sorarsam hayatım için koşmak zorunda kalacağım."


translate turkish day3_stage_dv_5f54b3cd:


    me "Bu şarkıyı kim yazdı?"


translate turkish day3_stage_dv_b4427906:


    dv "Ben yazdım!"


translate turkish day3_stage_dv_2d4780ec:


    me "Yani, tek başına mı yazdın?"


translate turkish day3_stage_dv_5977fdff:


    dv "Tek başıma!"


translate turkish day3_stage_dv_67492ba0:


    me "Vay be..."


translate turkish day3_stage_dv_4933fe62:


    "Tuhaf bir sessizlik havada asılı kaldı."


translate turkish day3_stage_dv_621c7bd3:


    me "Tamam o zaman..."


translate turkish day3_stage_dv_caeeba52:


    dv "Dinlemek istemiyor musun?"


translate turkish day3_stage_dv_98aef877:


    me "Zaten duymadım mı?"


translate turkish day3_stage_dv_0433bfa6:


    dv "Kastettiğim bu değildi!"


translate turkish day3_stage_dv_e16a3b7b:


    "Somurttu."


translate turkish day3_stage_dv_83ff5116:


    dv "Bütün şarkı! Şimdilik sadece bir kısmını duydun."


translate turkish day3_stage_dv_4c77f7ce:


    me "Ah... Hadi, çal o zaman..."


translate turkish day3_stage_dv_2af74aa2:


    dv "Şimdi değil."


translate turkish day3_stage_dv_9e500e36:


    me "Pekala, çalma o zaman..."


translate turkish day3_stage_dv_46a31379:


    "Benden ne istediğinden emin değildim."


translate turkish day3_stage_dv_3564e101:


    dv "Çalmamı istemiyor musun?"


translate turkish day3_stage_dv_1594019e:


    th "Görünüşe göre onu hayal kırıklığına uğrattım."


translate turkish day3_stage_dv_9a66cc72:


    "Alnıma gitarı ile vurmasına ya da daha kötü bir şey için hazırlandım."


translate turkish day3_stage_dv_d7b3342b:


    "Ama Alisa sadece yüzünde sinirli bir bakış ile yetindi."


translate turkish day3_stage_dv_02a64e1d:


    me "Sana – söylemiştim."


translate turkish day3_stage_dv_57a1e5c0:


    dv "Bu akşam buraya gel o zaman – Senin için çalacağım."


translate turkish day3_stage_dv_421da051:


    th "'Benim için mi'?{w} Ne kadar tatlı."


translate turkish day3_stage_dv_964231c7:


    me "Bu akşam dans partisi var."


translate turkish day3_stage_dv_c9fb6705:


    dv "Gitmek istemediğini söylemiştin!"


translate turkish day3_stage_dv_42ff6b7c:


    th "Öyle bir şey demedim..."


translate turkish day3_stage_dv_2c3eb69e:


    "Dürüst olmak gerekirse istemiyordum, ama DvaCheh ile etrafta dolaşmak daha kötü bir fikir."


translate turkish day3_stage_dv_117c8fe1:


    me "Olga Dmitrievna bundan hoşlanmaz..."


translate turkish day3_stage_dv_73cb60c5:


    dv "Siktir et onu!"


translate turkish day3_stage_dv_c8090db3:


    "Dedi Alisa, sinirlenerek."


translate turkish day3_stage_dv_7f329f3b:


    "Dans partisindeki utanç ve Dvachevskaya'nın çılgın gitar yetenekleri arasında ikincisini seçmeyi tercih ederim."


translate turkish day3_stage_dv_0d0c3fa8:


    dv "İyi çocuk."


translate turkish day3_stage_dv_1f246e2c:


    "Garip bir şekilde gülümsedi."


translate turkish day3_stage_dv_19538e61:


    "Tüm bunlar planladığım şey değildi."


translate turkish day3_stage_dv_2567c047:


    dv "Siktir git, ben de pek ilgilenmiyordum zaten!"


translate turkish day3_stage_dv_412caa87:


    "Onaylamadığını belli ederek arkasını döndü."


translate turkish day3_stage_dv_a97da226:


    "Tam verdiğim kararın doğru olup olmadığını merak ediyordum ki, aniden öncüleri öğle yemeğine çağıran bir zil sesiyle kesintiye uğradım."


translate turkish day3_stage_dv_9256eb27:


    "Kantine doğru baktım."


translate turkish day3_stage_dv_20b3b612:


    th "Sanırım gitme vakti geldi - açlık insanı keskin bir bela gibi sarıyor."


translate turkish day3_stage_dv_402e53da:


    "Alisa'yı da yanıma çağırmak niyetiyle arkamı döndüm."


translate turkish day3_stage_dv_c0edcd63:


    "Ama neşesiz ve üzgün duruyordu."


translate turkish day3_stage_dv_be5bcccb:


    me "Her müzisyen ne zaman ayrılmasını bilir."


translate turkish day3_stage_dv_3e1d421a:


    "Nefesimin altından homurdandım."


translate turkish day3_main4_a20cefa7:


    "..."


translate turkish day3_main4_e3a9b50b:


    "'Sıra içerisinde ilerleyenlerde kim? Bunlar öncüler!'"


translate turkish day3_main4_9086ffe8:


    "Öncüler {i}sıra içerisinde{/i} genellikle Sovyonok kampındaki kantine yürürlerdi."


translate turkish day3_main4_ffd49d36:


    "Daha önce olduğu gibi kimsenin beni rahatsız etmeyeceği bir yer arıyordum."


translate turkish day3_main4_45805593:


    th "Huzur içinde yiyebileyim diye!"


translate turkish day3_main4_5b7d20b3:


    "Bunun için de en azından son gelen ben olmamalıyım."


translate turkish day3_main4_3d31ce74:


    th "Ama şundan oldukça emindim: Burada ne olursa olsun, ben istesem de istemesem de oluyor."


translate turkish day3_main4_4cb70312:


    "Kantin, aynı bir yumurta gibi tıka basa doluydu."


translate turkish day3_main4_7168ef23:


    "Olga Dmitrievna girişte, baykuş gibi etrafı gözleyerek duruyordu."


translate turkish day3_main4_764d9df7:


    mt "Pekala Semyon, bugün iyi çalıştın mı?"


translate turkish day3_main4_aac8720f:


    me "Yeteri kadar."


translate turkish day3_main4_4e3031c8:


    mt "Aferin, gerçekten aferin! Ve en zoru henüz gelmedi!"


translate turkish day3_main4_f1d5cd91:


    th "Eminim öyledir..."


translate turkish day3_main4_63b5e296:


    mt "Güzel, git kızların yanına otur."


translate turkish day3_main4_4cd2fcde:


    "Sütunun yanındaki masayı işaret etti.{w} Slavya, Ulyana ve Lena orada oturuyordu."


translate turkish day3_main4_07355afa:


    th "O kadar da kötü değil.{w} En azından en kötüsü değil..."


translate turkish day3_main4_74860e53:


    "Yemeğimi aldım ve yanlarına gittim."


translate turkish day3_main4_4bf10d5d:


    me "Buraya oturmamın sakıncası var mı?"


translate turkish day3_main4_a4520622:


    "Kendimi biraz aptalca konuşurken fark ettim. Zaten başka boş yer de yoktu."


translate turkish day3_main4_ae35202b:


    sl "Hayır, tabii ki yok!"


translate turkish day3_main4_ae6727cd:


    us "Lütfen otur."


translate turkish day3_main4_2622f621:


    "Lena sessiz kaldı."


translate turkish day3_main4_fe3ea323:


    "Bugünkü yemek bir tabak pancar çorbası (içinde biraz et olduğundan şüpheleniyordum ama kanıtım yoktu), biraz kümes hayvanı (muhtemelen 'chickenus domesticus'), kızarmış patates ve geleneksel bir bardak kompottan oluşuyordu."


translate turkish day3_main4_6e7c603f:


    "Yerel yemekleri gün geçtikçe daha da beğeniyordum."


translate turkish day3_main4_b6d69ff6:


    "Sanırım başka bir seçeneğim olmadığı kanısına varmıştım. Bu da demek oluyor ki şikayet etmenin bir faydası yok."


translate turkish day3_main4_123f8387:


    th "Tanrıya şükürler olsun yiyecek {i}bir şeyler{/i} var."


translate turkish day3_main4_b15bd6e7:


    sl "Bu gece baloya geliyor musun?"


translate turkish day3_main4_595d7b8c:


    me "Bilmiyorum."


translate turkish day3_main4_6e25c9b3:


    th "Alisa ile önceden planım olmasına rağmen..."


translate turkish day3_main4_4c1600f4:


    us "Gelecek! Gidecek hiçbir yeri yok!"


translate turkish day3_main4_99ce3e5f:


    "Mutlu bir şekilde söyledi."


translate turkish day3_main4_56e1d2cc:


    me "Sen tabii ki geleceksin..."


translate turkish day3_main4_aa1aa469:


    us "Elbette! Kendini aptal durumuna düşürmeni izleme fırsatını kaçıramam."


translate turkish day3_main4_15dfe923:


    "Haklıydı, bu yüzden yanıt vermedim."


translate turkish day3_main4_b78c6e26:


    me "Peki ya sen?"


translate turkish day3_main4_3329e7d9:


    "Lena'ya sordum."


translate turkish day3_main4_31b01f67:


    un "Evet..."


translate turkish day3_main4_521b6831:


    "Kısa bir şekilde cevapladı."


translate turkish day3_main4_56d548d4:


    sl "Gördün mü? Sen de gelmelisin."


translate turkish day3_main4_f6a30a37:


    "Bana herhangi bir seçenek bırakmadan dedi."


translate turkish day3_main4_e75e0db2:


    us "Kuyruklu ceketini giymeyi unutma."


translate turkish day3_main4_0033c883:


    "Görünüşe göre Ulyana yaptığı şakadan o kadar memnun olmuş ki yüksek sesle güldü."


translate turkish day3_main4_bb5ceb0f:


    "Ama gerçekten giyecek hiçbir şeyim yok."


translate turkish day3_main4_006252b0:


    "Gardırobumda sadece öncü kıyafeti ve kışlık kıyafetler var, ki bu akşam bile uygunsuz olurdu."


translate turkish day3_main4_99eeab2f:


    me "Peki sen ne giyeceksin, şovmen?"


translate turkish day3_main4_0063fafa:


    us "Giz-li!"


translate turkish day3_main4_85dd239b:


    me "Tıpkı bir anaokulunun gösterisindeki gibi küçük bir elbise mi olacak?"


translate turkish day3_main4_8d42266c:


    "Ulyana kıpkırmızı oldu - görünüşe göre onu kızdırmayı başardım."


translate turkish day3_main4_90fa481a:


    us "Hayır, biyolojik tehlike kıyafeti giyeceğim! Senden enfeksiyon kapmayayım diye!"


translate turkish day3_main4_405ea5ee:


    me "Acaba benden ne tür bir enfeksiyon kapmaktan korkuyorsun?"


translate turkish day3_main4_a840c516:


    sl "Yeter, çocuklar! Kavga etmeyin!"


translate turkish day3_main4_1c4b960b:


    us "Salaklık tabii ki!"


translate turkish day3_main4_59986520:


    "Görünüşe göre Ulyana yine zekice bir cevap verdiğini düşündüğü için çok memnun oldu."


translate turkish day3_main4_7312ace7:


    me "Bilirsin, zaten grip olduysan soğuk algınlığına yakalanamazsınız."


translate turkish day3_main4_dbe6fc9f:


    "Bu oyunda iki kişi oynayabilir."


translate turkish day3_main4_4d08faa9:


    us "Ne ima etmeye çalışıyorsun?"


translate turkish day3_main4_8d6a94af:


    me "Oh hiçbir şey, hiçbir şey..."


translate turkish day3_main4_2ed6c63f:


    "Sinsice başka tarafa baktım."


translate turkish day3_main4_b155806b:


    us "Şey demek mi istiyorsun...?"


translate turkish day3_main4_a852076f:


    "Yine kıpkırmızı oldu."


translate turkish day3_main4_36af1581:


    me "Bir şey ima etmiyorum."


translate turkish day3_main4_e7059468:


    un "Çocuklar..."


translate turkish day3_main4_94c9b804:


    "Müdahale edenin Lena olduğu düşünüldüğünde, muhtemelen gerçekten durma zamanı gelmişti."


translate turkish day3_main4_e4c12ca4:


    us "Bunu istiyorsan! Sana vereceğim!"


translate turkish day3_main4_b9d24980:


    me "Ne? Sonunda bilgilendin mi?"


translate turkish day3_main4_5fea1e70:


    "Ulyana cevap vermek yerine pancar çorbasıyla dolu tabağını kaptı ve başımın üzerine devirdi."


translate turkish day3_main4_9f238d85:


    "Bu oyun beklenmedik bir finalle karşılaştı..."


translate turkish day3_main4_670b85c3:


    me "Oh, seni küçük...!"


translate turkish day3_main4_874c2400:


    "Zıpladı ve kaçmaya çalıştı."


translate turkish day3_main4_3d220a8d:


    "Ama şimdi kaçamayacak – Elini yakaladım."


translate turkish day3_main4_e4c890fc:


    th "Eee, şimdi ne? Kafasını masaya vuramam!"


translate turkish day3_main4_8f1d5041:


    "Bu pandomim birkaç saniye sürdü."


translate turkish day3_main4_8811fef6:


    "Birden Ulyana kompot dolu bir bardağı ustalıkla kaptı ve yüzüme sıçrattı."


translate turkish day3_main4_3958434a:


    "Böylece tutuşumdan kaçabildi."


translate turkish day3_main4_7e7c5066:


    "Tezgâha doğru koşmaya başladı, ben de onu kovaladım."


translate turkish day3_main4_7321633c:


    "Bunun sonucunda birkaç masa devrildi, bir yığın sofra takımı parçalandı, beş öncü çeşitli yaralanmalarla sakatlandı ve her iki taraf da tamamen yoruldu."


translate turkish day3_main4_b1e8f257:


    th "Berabere sayılır."


translate turkish day3_main4_17b22f81:


    th "Kavgacı bir beraberlik.{w} Çok fazla kavgacı."


translate turkish day3_main4_e6d45acc:


    "Birbirimizin önünde durduk ve derin derin nefes aldık."


translate turkish day3_main4_0224f2b4:


    me "Bana bir daha böyle davranmayacağını söyle!"


translate turkish day3_main4_54810cc5:


    us "Ya sen?!"


translate turkish day3_main4_23a87547:


    "Olga Dmitrievna gizlice arkamızda belirdi."


translate turkish day3_main4_2948bc41:


    "Düşündüğünüzde, böyle bir isyanın fark edilmemesi mümkün değil."


translate turkish day3_main4_501e435e:


    mt "Pekala, şimdi yaptıklarınızdan memnun musunuz?"


translate turkish day3_main4_a3227502:


    "Sesi sakin olmaya çalışıyordu, ama eminim ki sinirden patlamak üzere."


translate turkish day3_main4_9799cd00:


    mt "Ve tüm bu dağınıklığı kim toparlayacak?!"


translate turkish day3_main4_643530f6:


    "Aynen böyle oldu."


translate turkish day3_main4_a71a3e52:


    mt "Kim, sana soruyorum, kim?!"


translate turkish day3_main4_cc05f4a5:


    us "O!"


translate turkish day3_main4_6e0e9ab6:


    "Ulyana tam bir güvenle cevap verdi."


translate turkish day3_main4_8cc8ea72:


    me "O!"


translate turkish day3_main4_078c536a:


    "Daha az emin bir şekilde itiraz ettim."


translate turkish day3_main4_221ac838:


    mt "İkiniz de!"


translate turkish day3_main4_cd7733bf:


    "Kamp lideri süregelen bu tartışmaya kesin bir son verdi."


translate turkish day3_main4_abca6dac:


    "Genel olarak, benim payıma düşen suçun onunkinden daha fazla olduğundan emin değildim."


translate turkish day3_main4_d4b025ce:


    "Yine de Ulyana'nın yüzünde bir damla bile suçluluk duygusu yoktu."


translate turkish day3_main4_3297e1dc:


    us "Bas git! Temizlik yapmıyorum! Kimsenin buna vakti yok!"


translate turkish day3_main4_79a78d45:


    us "Bu onun hatası! İlk o başlattı!"


translate turkish day3_main4_fa057752:


    me "Hayır öyle olmadı!"


translate turkish day3_main4_0f7ff14d:


    us "Oh evet öyle oldu!"


translate turkish day3_main4_179e42ee:


    mt "Bütün bu saçmalıklarla uğraşmayacağım!"


translate turkish day3_main4_97932981:


    mt "Semyon, git paspas, kova ve bez al, bilirsin dolapta bulunan eşyalar, ve sana gelecek olursak!!!"


translate turkish day3_main4_ccad0a84:


    "Ulyana'ya sinirli bir bakış attı, bu kız için biraz üzüldüm."


translate turkish day3_main4_f438658b:


    mt "Sen!!!{w} hemen kırılmış sofra takımlarını toplamaya başla!"


translate turkish day3_main4_097f4a0a:


    "Olga Dmitrievna derin bir nefes aldı ve devam etti:"


translate turkish day3_main4_12c1e19a:


    mt "Sorun dışında hiçbir şey değilsin!{w} Kaç kere sana söyledim...?"


translate turkish day3_main4_051185fa:


    "Dersi atlamaya karar verdim ve çıkışa yakın görünen dolaba gittim."


translate turkish day3_main4_2ffc3634:


    "Birden aklıma mükemmel bir fikir geldi - neden kaçıp gitmiyorum?"


translate turkish day3_main4_27e1f3fe:


    "Elbette, Olga Dmitrievna bizi çoktan yakaladı, ama suçlanacak kişi ben değilim."


translate turkish day3_main4_9c178a5f:


    "Tabii ki hep konuştuğu şu {i}gerçek öncü{/i} değilim, Ulyana ile karşılaştırıcak olursak..."


translate turkish day3_main4_4ec22d66:


    "Her neyse, asıl suçlu o.."


translate turkish day3_main4_87ca6467:


    th "Buradaki pisliği temizlemekten başka yapacak daha iyi bir işim yok. Cevap aramak zorundayım!"


translate turkish day3_main4_bfb5e7fb:


    "'Gerçek orada bir yerde' sözü bir şekilde aklımdan geçti."


translate turkish day3_library_sl_ccebe3fc:


    "Çözüm bir anda ortaya çıktı."


translate turkish day3_library_sl_9cad1570:


    "Olga Dimitrievna Ulyana'yı azarlarken ben de gizlice çıkışa yöneldim, neyse ki dolabın yanındaydı."


translate turkish day3_library_sl_2a352a63:


    "Dışarı çıkarken birkaç dakika tereddüt ettim ve Electronik'e rastladım."


translate turkish day3_library_sl_f9674fb7:


    "Görünüşe göre kulüpte geç saatlere kadar çalışıyormuş.."


translate turkish day3_library_sl_023f2a34:


    el "Ateş nerede??"


translate turkish day3_library_sl_6e69e20d:


    me "Ateş...?{w} Servisim on dakika içinde kalkıyor."


translate turkish day3_library_sl_e64f933d:


    el "Ne?{w} Hey, bekle!"


translate turkish day3_library_sl_d7d54b7f:


    "Electronik'in sözleri havada asılı kaldı."


translate turkish day3_library_sl_1afa7cdc:


    "Meydana gittim."


translate turkish day3_library_sl_f44b49d9:


    me "Saklanmak için kesinlikle iyi bir yer değil."


translate turkish day3_library_sl_863b1e12:


    "Gerçekten stres ya da yorgunluk halindeyken sık sık kendi kendime konuşmaya başlıyorum."


translate turkish day3_library_sl_f5dc1ea7:


    "Şey, tam olarak konuşmak sayılmaz ama mırıldanıyorum."


translate turkish day3_library_sl_6c76fea4:


    "Konsantre olmama ve en iyi çözümü bulmama yardımcı oluyor."


translate turkish day3_library_sl_2e3c65cd:


    me "Tamam, sırada ne var?{w} Nereye gitmeliyim?.."


translate turkish day3_library_sl_ea2b71fd:


    "En iyi yer, en az sayıda insanın bulunduğu yer olacaktır."


translate turkish day3_library_sl_bfa9bfb0:


    th "Sonuç olarak yolum ormana düşüyor."


translate turkish day3_library_sl_a088dacb:


    "Yarım dakika sonra, orman yolunun yakınındaki bir kütüğün üzerine oturmuş dinleniyordum bile."


translate turkish day3_library_sl_caca443f:


    th "Harika bir kaçıştı!"


translate turkish day3_library_sl_15e7cffc:


    th "Umarım bu Ulyana'ya uslu durmayı öğretir! Gerçekten, o artık bir çocuk değil!"


translate turkish day3_library_sl_cbda97c3:


    th "Üzücü ama gerçek...{w} Artık çocuk değil."


translate turkish day3_library_sl_be69861b:


    "Şimdi, aklımdan bir düşünce geçti: Tüm bu durumu yanlış ele almış olabilirim."


translate turkish day3_library_sl_fb96d515:


    th "Kırılan sofra takımlarının büyük bir kısmı benim yüzümden."


translate turkish day3_library_sl_e732f41b:


    th "Dahası, bu kargaşaya daha en başta karışmayabilirdim."


translate turkish day3_library_sl_89141735:


    "Bu beni düşündürdü."


translate turkish day3_library_sl_72cbabba:


    sl "Havan nasıl?"


translate turkish day3_library_sl_5d2bdfb2:


    "Slavya yanımda duruyorun."


translate turkish day3_library_sl_a99618e8:


    th "Nasıl farkedilmeden yanıma gelebilmeyi başardı?{w} Tanrıya şükür, Olga Dmitrievna değil."


translate turkish day3_library_sl_84662d7a:


    me "İyiyim..."


translate turkish day3_library_sl_78884236:


    "Bunlar ağzımdan çıkarmayı başardığım tek kelimelerdi.."


translate turkish day3_library_sl_c9b49156:


    sl "Seni burada bulabileceğimi düşündüm."


translate turkish day3_library_sl_5ac38cf1:


    me "Neden?"


translate turkish day3_library_sl_f1262d21:


    sl "Emin değilim, sadece içimden geldi..."


translate turkish day3_library_sl_72426581:


    "Gökyüzüne doğru baktı."


translate turkish day3_library_sl_42471a85:


    sl "Buralarda çok az insan var."


translate turkish day3_library_sl_becb13d6:


    th "Slavya bir tür sosyal fobim olduğunu mu düşündü?!{w} Aslında, öyle düşünmek için bir çok nedeni var"


translate turkish day3_library_sl_bf693f95:


    me "Peki ya sen... burada ne yapıyorsun?"


translate turkish day3_library_sl_94fc3843:


    sl "Seni arıyordum."


translate turkish day3_library_sl_9fa90903:


    "Bir daha gülümsedi, ama bu gülümseme farklıydı. Sanırım biraz dost canlısı bir gülümseme."


translate turkish day3_library_sl_8052945a:


    me "Ben mi? Neden?"


translate turkish day3_library_sl_b57bc8ed:


    sl "Tahmin edemez misin?"


translate turkish day3_library_sl_a5d87f4f:


    "Sert bir derse hazırlandım."


translate turkish day3_library_sl_e2e2018f:


    sl "Anladığım kadarıyla Ulyana'dan daha az suçlusun."


translate turkish day3_library_sl_66b23847:


    th "Şimdi kamp liderinin asistanı beni mi savunuyor!{w} Kendimi daha fazla acınası hissettim."


translate turkish day3_library_sl_4fa4d55e:


    th "Hadi ama, ciddileş, burada {i}iyi polis kötü polis{/i} oynamıyoruz!"


translate turkish day3_library_sl_50c80811:


    sl "Ama ona yardım etmeyeceğini kabul edersem, bana yardım etmek zorundasın."


translate turkish day3_library_sl_d322f1a0:


    "Slavya bunu söyledikten sonra bir kez daha gökyüzüne baktı."


translate turkish day3_library_sl_7b2c24d7:


    th "Acaba gökyüzünde neyi arıyor?"


translate turkish day3_library_sl_a9c6d0dd:


    me "Ne yapmam gerek?"


translate turkish day3_library_sl_b90384cf:


    sl "Kütüphanedeki kitapları tekrardan düzenlemeliyiz."


translate turkish day3_library_sl_28c44327:


    "Ulyana ile birlikte disiplin köleliğinden çok daha iyi. Her neyse, bu reddedemeyeceğim bir teklifti."


translate turkish day3_library_sl_c7aaed10:


    me "Hizmetinizdeyim matmazel. Ya da madam?"


translate turkish day3_library_sl_ec2c2a7c:


    "Güldü."


translate turkish day3_library_sl_e6b3e7b4:


    sl "O zaman beni takip edin mösyö!"


translate turkish day3_library_sl_f4346447:


    "Bir kaç dakika içinde kütüphaneye ulaştık."


translate turkish day3_library_sl_4faed1c0:


    "Tüm yol boyunca Olga Dmitrievna ile karşılaşmaktan endişeleniyordum."


translate turkish day3_library_sl_e82faf41:


    "Görünüşe göre Slavya endişemi fark etmemiş.."


translate turkish day3_library_sl_9a6e5488:


    th "Ve hala, beni azarlamamış olması oldukça garip."


translate turkish day3_library_sl_1c2eed77:


    "Benzetmemize devam edecek olursak, Slavya kesinlikle iyi polis."


translate turkish day3_library_sl_f58d39b1:


    "İçeri girdiğimizde, kütüphanenin pencerelerinden pırıl pırıl güneş ışığı süzülüyor, sayısız toz zerreciği kirişlerde dans ediyordu."


translate turkish day3_library_sl_35c68aa3:


    "Bu, asla başka bir şeyle karıştıramayacağınız o kendine özgü kokuya sahip özel kütüphane tozundan."


translate turkish day3_library_sl_1d93103b:


    "Marksizm-Leninizm klasiklerinin can çekişen eserlerinin mikroskobik parçaları."


translate turkish day3_library_sl_325f1bcd:


    th "Bu ilginç, kurgu rafının yanındaki toz, fizik ve kimya kitaplarının yanındaki toza benziyor mu?"


translate turkish day3_library_sl_826e40a7:


    sl "Bu raflardan başlayacaksın."


translate turkish day3_library_sl_17c95df4:


    "Slavya, Lenin'in heykel başının yanındaki kitap rafını işaret etti."


translate turkish day3_library_sl_46f0983a:


    me "Pekala ama tam olarak ne yapmam lazım?"


translate turkish day3_library_sl_968cfe00:


    sl "Raflardaki kitapları al ve yere koy.{w} Tozlarını alacağız ve sonra geri koyacağız."


translate turkish day3_library_sl_6febb73f:


    "Tüm bu toz dumana bakılırsa, öncülerin en sevdiği faaliyetin okumak olduğu söylenemez."


translate turkish day3_library_sl_3a98efa2:


    me "Zhenya'nın nerede olduğuna dair bir fikrin var mı?"

translate turkish day3_library_sl_a1e6dd7a:


    sl "Bilmiyorum, muhtemelen bir yerlere gitmiştir."


translate turkish day3_library_sl_ea719463:


    th "Garip."


translate turkish day3_library_sl_a2356fab:


    "Görünüşe göre dünyada Zhenya'yı görebileceğimiz sadece iki yer var - kütüphane ve kantin."


translate turkish day3_library_sl_ac2cba61:


    "İşe başladım."


translate turkish day3_library_sl_0eb6b971:


    "Sanırım hayatım boyunca hiç bu kadar çok kitabı aynı anda elime almamıştım."


translate turkish day3_library_sl_ce83d765:


    "Her neyse, bilgisayar ekranından ya da tabletten okumaya çok daha alışkınım."


translate turkish day3_library_sl_de4998dd:


    "İlk olarak, elektronik kitaplara para vermeye gerek yok, ve ikinci olarak, her şeyin basılmış halini bulamazsın."


translate turkish day3_library_sl_77254c81:


    sl "Nasıl gidiyor?"


translate turkish day3_library_sl_515b792e:


    "Kitap raflarının arkasında duran Slavya sordu."


translate turkish day3_library_sl_31dbcb74:


    me "İyi gidiyor, küçük adımlarla ilerliyorum."


translate turkish day3_library_sl_3799372a:


    me "Bunun hakkında hiçbir şey okudun mu?"


translate turkish day3_library_sl_8f3fa4b1:


    sl "Ne hakkında?"


translate turkish day3_library_sl_5625a91d:


    me "Komünizm..."


translate turkish day3_library_sl_d51d54a0:


    sl "Hayır, ben daha çok tarihi kitaplarla ilgileniyorum.{w} Ve macera kitapları."


translate turkish day3_library_sl_7f0819cb:


    me "Ben de..."


translate turkish day3_library_sl_a3f8af02:


    "Tarihsel edebiyat tam olarak favorim değildi ama sosyalizm altındaki sınıf mücadelesi kesinlikle onunla boy ölçüşemezdi!"


translate turkish day3_library_sl_eae58056:


    sl "Hey, Ulyana'ya karşı kin tutma."


translate turkish day3_library_sl_ec1593ec:


    me "Tutmuyorum..."


translate turkish day3_library_sl_e1c77be8:


    "Gerçekten de kantindeki olayın ardından egomun büyük ölçüde iyileştiğini hissettim.{w} Ayrıca, öğle yemeğinden arta kalanları bir orman gölünde temizlemeyi başardım."


translate turkish day3_library_sl_ca83718e:


    sl "Bütün bunları inat olsun diye yapmıyor."


translate turkish day3_library_sl_04a51e77:


    me "İnat olsun olmasın, herkes hareketlerinden önce düşünmeli!{w} Ah, her neyse..."


translate turkish day3_library_sl_0f8bf2e5:


    "Hiç tanımadığım insanlar tarafından yazılmış düzinelerce kitap arasında dolaşıp durdum."


translate turkish day3_library_sl_92df4c4a:


    th "Kim olduklarını bir dakika içinde unutacağım, ve ne hakkında yazdıklarını asla öğrenemeyeceğim."


translate turkish day3_library_sl_4012f849:


    th "Bu, pek çok yazarın kaderidir - var olmayan bir öncü kampın gerçekliğinin kütüphanesindeki kitap rafında sert kapaklı bir dizi terk edilmiş mektup olmak."


translate turkish day3_library_sl_73956111:


    sl "Bitirdin mi?"


translate turkish day3_library_sl_f8226aa9:


    me "Evet, Sanırım."


translate turkish day3_library_sl_7bfe1a7a:


    sl "Ben de.{w} Tamam, hadi şöyle yapalım, Ben onları sileceğim sen ise teker teker raflara yerleştireceksin."


translate turkish day3_library_sl_f38a2469:


    me "Ama hangi sırayla dizildiklerini hatırlamıyorum."


translate turkish day3_library_sl_57b94aaa:


    sl "Bir şey olmaz. Zaten kimse okumuyor."


translate turkish day3_library_sl_68a9ffa6:


    th "Her duruma uygun bir gülümsemesi var gibi görünüyor."


translate turkish day3_library_sl_19451d64:


    "Birkaç kez o gülümsemede küçük farklılıklar, duygu tonları fark ettim - neşe, mutluluk, üzüntü..."


translate turkish day3_library_sl_853f82b2:


    "Ancak bu duygu durumları o kadar uçuktu ki, hayal görmediğimden gerçekten emin olamıyordum."


translate turkish day3_library_sl_5ff6b0ce:


    "Bu sefer gülümsemesi flört eder gibiydi."


translate turkish day3_library_sl_1e475060:


    me "Evet, muhtemelen.{w} En azından ben bunları okumuyor olurdum."


translate turkish day3_library_sl_08cfb744:


    "Slavya nemli bir bez ile kapakları siliyordu, ve ben de kitapları raflara diziyordum."


translate turkish day3_library_sl_3a2c6311:


    "İyi bir takımız – işimiz neredeyse bitti."


translate turkish day3_library_sl_9fdf4842:


    sl "Neden üst raflardan kitapları almadın?"


translate turkish day3_library_sl_4c1d6d10:


    me "Üst raflar mı?"


translate turkish day3_library_sl_f8c41e21:


    "Yukarı baktım."


translate turkish day3_library_sl_cbcf5cb7:


    me "Üzgünüm, onları farkedememişim."


translate turkish day3_library_sl_705bea28:


    sl "Sorun değil."


translate turkish day3_library_sl_f9e5b237:


    me "Bekle bir saniye!{w} Sandalyeyi getireyim."


translate turkish day3_library_sl_164801d0:


    "Hatırı sayılır boyumla bile oradaki kitaplara ulaşamazdım."


translate turkish day3_library_sl_5c3aa9a0:


    "Sandalyenin üzerine çıktım ve kitapları raflardan alıp Slavya'ya vermeye başladım."


translate turkish day3_library_sl_6f01b19b:


    "Bir süre sonra, neredeyse bir düzine kitap rafların en uzak köşesinde kalmıştı."


translate turkish day3_library_sl_a29261f6:


    "Bana o kadar uzağa ulaşmak zor olmayacakmış gibi geldi."


translate turkish day3_library_sl_45a87cde:


    "Her zaman iki kez ısırmaktansa daha büyük bir ısırık almayı tercih etmişimdir.{w} Ve altımdaki sandalyeyi hareket ettirmeden o ısırığı almak."


translate turkish day3_library_sl_57e655b2:


    "Ölümcül bir hata oldu..."


translate turkish day3_library_sl_3b6da452:


    "Gözlerimi açtığımda kendimi Slavya'nın kucağında buldum."


translate turkish day3_library_sl_64eccf44:


    me "Sen... Ben... Yaşıyor musun?!"


translate turkish day3_library_sl_df45d6bc:


    "Hayatımın korkusunu yaşadım."


translate turkish day3_library_sl_9f4025f7:


    th "Şu anda sadece 17 yaşında olsam bile, bir sandalyeden bir kızın üzerine düşmek başka bir şey!"


translate turkish day3_library_sl_0451d1e4:


    sl "Ben iyiyim."


translate turkish day3_library_sl_55c4c14d:


    "Yüzü benimkinden sadece bir santim uzaktaydı."


translate turkish day3_library_sl_f3139a0d:


    me "Kırık bir şey var mı?"


translate turkish day3_library_sl_3f137cac:


    sl "Sanmıyorum."


translate turkish day3_library_sl_673a4231:


    sl "Senden çok kötü bir dublör olurdu."


translate turkish day3_library_sl_ce3666e5:


    "Güldü."


translate turkish day3_library_sl_e2d2475f:


    me "Emin olabilirsin."


translate turkish day3_library_sl_e10fbc50:


    "Gözlerinin içine baktım.{w} Sadece baktım."


translate turkish day3_library_sl_382be24f:


    "Ne söylemem gerektiği hakkında emin değildim...{w} Slavya da ya tereddüt etti ya da liderliği bana bıraktı."


translate turkish day3_library_sl_f0551a4a:


    th "Böyle giderse bir şeyler olabilir."


translate turkish day3_library_sl_5ff7b840:


    th "Dudakları dudaklarıma çok yakın!"


translate turkish day3_library_sl_44711d46:


    "Bedenimde doğal bir arzu uyanmaya başladı, ama bu {i}doğru{/i} muydu?"


translate turkish day3_library_sl_f481ef93:


    "Ayağa kalkma isteği duydum ama başaramadım."


translate turkish day3_library_sl_ef3ea7a1:


    "Slavya sessizce yatıyor ve gözlerimin içine bakıyordu."


translate turkish day3_library_sl_5ab0d3a1:


    "Birdenbire, kulağımın ucunda çalan zili fark ettim."


translate turkish day3_library_sl_8e8e0763:


    sl "Yemek vakti geldi.."


translate turkish day3_library_sl_751ac511:


    me "Evet..."


translate turkish day3_library_sl_d8eca9e9:


    sl "Gidelim mi? Yoksa burada biraz daha mı yatalım?"


translate turkish day3_library_sl_e4a6b1bd:


    "Tekrar gülümsedi ve bu sefer gülümsemesi bana sanki bir şey ima ediyormuş gibi kurnazca geldi."


translate turkish day3_library_sl_050169d2:


    me "Gidelim..."


translate turkish day3_library_sl_19989263:


    "Bir santim bile hareket etmedim."


translate turkish day3_library_sl_0f8c2844:


    sl "Eğer gideceksek, önce senin kalkman gerek."


translate turkish day3_library_sl_85a7ebd8:


    me "Tabii..."


translate turkish day3_library_sl_e6991c34:


    "Görünmez bir gücün beni olduğum yerde tuttuğunu hissettim."


translate turkish day3_library_sl_8f6ef867:


    "Slavya Bunu fark etmiş gibiydi ve dikkatlice altımdan sıvıştı."


translate turkish day3_library_sl_c0e00208:


    sl "Burada kalmaya devam mı edeceksin?"


translate turkish day3_library_sl_ec2c2a7c_1:


    "Güldü."


translate turkish day3_library_sl_491711dd:


    "O noktada nihayet aklım başıma geldi ve ayağa kalktım.."


translate turkish day3_library_sl_8a8c94c1:


    me "Üzgünüm..."


translate turkish day3_library_sl_a707867b:


    sl "Sorun değil."


translate turkish day3_library_sl_cd4fe72c:


    sl "Ama daha bitirmedik.{w} kalanları sonra temizlememiz gerek."


translate turkish day3_library_sl_85279b68:


    me "Evet, elbette."


translate turkish day3_library_sl_92690f30:


    "Kantin yolu boyunca sessizliğimi korudum."


translate turkish day3_library_sl_f1edeb24:


    "Slavya kamptaki hayatını anlatıp duruyordu ama monolog olduğu için pek dikkatimi vermiyordum."


translate turkish day3_library_sl_d67f2f47:


    "Kantine geldik, Olga Dmitrievna'yı verandada gördüm."


translate turkish day3_library_sl_2c96d9df:


    mt "Açıklaman gereken bir şey yok mu, genç adam?"


translate turkish day3_library_sl_c3fe9d67:


    "Unuttuğum şeyin ne olduğunu şimdi hatırlıyorum..."


translate turkish day3_library_sl_5cb822ee:


    me "Hayır..."


translate turkish day3_library_sl_18279173:


    mt "Temizlik görevin nasıldı?"


translate turkish day3_library_sl_65bf82fc:


    me "Eh, yeterince iyi..."


translate turkish day3_library_sl_09a04ec4:


    mt "Ulyana bana öyle demedi ama."


translate turkish day3_library_sl_3074c0ad:


    me "Hepsi onun hatasıydı!"


translate turkish day3_library_sl_6fc0750c:


    mt "Ben sana ne dedim?"


translate turkish day3_library_sl_6ced5f4c:


    mt "Beraber temizlemenizi söyledim!{w} Ve sen ne yapıyorsun?!"


translate turkish day3_library_sl_d2aa1636:


    "Ne demek gerektiğini bilmiyordum, çünkü içten içe onun haklı olduğunu biliyordum.."


translate turkish day3_library_sl_418c13dd:


    sl "Onu suçlama!{w} Semyon kütüphanede bana yardım ediyordu."


translate turkish day3_library_sl_38689622:


    mt "Oh, gerçekten mi?"


translate turkish day3_library_sl_7314bee2:


    sl "Evet!"


translate turkish day3_library_sl_bc20eb0b:


    mt "Bu çok iyi bir şey ama...{w} Kısa kesmek gerekirse, bu akşam yemek yiyemeyeceksin!"


translate turkish day3_library_sl_a2911372:


    me "Nasıl?! Neden?!"


translate turkish day3_library_sl_902a9a2f:


    "Protesto ettim."


translate turkish day3_library_sl_5ec7a533:


    "Ancak, benim protestom daha çok hapishane yemekhanesinde yeniden yemek talebine benziyordu - cesur ve cüretkâr ama yine de aptalca ve ters etki yaratan bir protesto."


translate turkish day3_library_sl_b77f1870:


    mt "Umarım bu sana bir ders verir!"


translate turkish day3_library_sl_fcc1c309:


    "O anda Olga Dmitrievna, küçük bir öncü kamp liderinden çok eski bir Roma lejyoner komutanına benziyordu."


translate turkish day3_library_sl_5bdcf334:


    "Ona nasıl karşı çıkmam gerektiği hakkında hiçbir fikrim yoktu."


translate turkish day3_library_sl_ae8c4442:


    sl "Affet onu!{w} Ve beni sorumlu tut!"


translate turkish day3_library_sl_d4764288:


    "Kamp lideri bunu düşünmek için zaman ayırdı."


translate turkish day3_library_sl_777093a7:


    mt "Pekala, eğer öyle diyorsan!"


translate turkish day3_library_sl_309686e8:


    sl "Teşekkürler!"


translate turkish day3_library_sl_73aab3cd:


    me "Teşekkürler..."


translate turkish day3_library_sl_34c73a83:


    "Aceleyle içeri girdik."


translate turkish day3_library_sl_4df43400:


    sl "Ben kızlara katılacağım. Önceden anlaşmıştık.{w} Kendine iyi bak.!"


translate turkish day3_library_sl_3ec70e0f:


    "Gülümsedi ve el sallayarak vedalaştı."


translate turkish day3_library_sl_99d3acba:


    "Cidden, o olmasaydı ben nerede olurdum!?"


translate turkish day3_library_sl_0eba76f0:


    "Slavya'nın yakınında boş yer yoktu ve ayrıca arkadaşlarıyla da tanıştırılmamıştım."


translate turkish day3_cleaning_us_99ef151c:


    "Hayır, kaçmak pek iyi bir fikir değil."


translate turkish day3_cleaning_us_93c60cc4:


    "Öncelikle, Olga Dmitrievna beni çoktan yakaladı ve kaçmak sadece cezamı ağırlaştırır."


translate turkish day3_cleaning_us_394c9d9e:


    "Bunun yanı sıra, gerçekten de kısmen suçluydum..."


translate turkish day3_cleaning_us_2f94b8f1:


    th "Elbette hepsi onun suçuydu!"


translate turkish day3_cleaning_us_25f82315:


    "Ama öyle tepki vermemiş olsaydım, muhtemelen bu dayaktan kaçınabilirdik."


translate turkish day3_cleaning_us_996e7fec:


    th "Muhtemelen..."


translate turkish day3_cleaning_us_3e5b8732:


    "Dolabı açtım ve bir süpürge, bir paspas ve bir faraş çıkardım."


translate turkish day3_cleaning_us_f469532f:


    "Ben döndüğümde Olga Dmitrievna, Ulyana'nın yakınında bile değildi."


translate turkish day3_cleaning_us_24ab10f2:


    me "Gitti mi?"


translate turkish day3_cleaning_us_7e694dd0:


    us "Göremiyor musun?"


translate turkish day3_cleaning_us_eb7418c4:


    "Ulyana sinirli görünüyordu, tüm genç ruhu iz bırakmadan kaybolmuştu."


translate turkish day3_cleaning_us_3b4a6242:


    me "Tamam, bir saniye bekle, önce gidip biraz yıkanacağım."


translate turkish day3_cleaning_us_a464805b:


    "Ona kızgın bir bakış attım ve çıkışa doğru yöneldim."


translate turkish day3_cleaning_us_80aa159b:


    "Üzerimdeki yemek artıklarını yıkadım ve kantine döndüm."


translate turkish day3_cleaning_us_8bf25c46:


    me "Bundan kaçış yok, temizlemek zorundayız."


translate turkish day3_cleaning_us_0713a7b2:


    us "Hepsi senin yüzünden!"


translate turkish day3_cleaning_us_97c9d07e:


    "Tek bir bakışı bile tüylerimi ürpertti."


translate turkish day3_cleaning_us_771aa502:


    me "Elbette öyle!"


translate turkish day3_cleaning_us_12685598:


    me "Her şeyin suçlusu benim!{w} Yerel bir doğal tehlike olan benim."


translate turkish day3_cleaning_us_005b5a5d:


    us "Oh, kes sesini..."


translate turkish day3_cleaning_us_abd7f53b:


    "Yine de bu temizlik görevinden kaçmaya çalışmaması biraz garip."


translate turkish day3_cleaning_us_87e97c80:


    "Ulyana'nın kaçıp beni yalnız bırakma şansı vardı ama her nasılsa tam tersini yaptı, kırık tabak parçalarını özenle topladı, yerleri sildi, sandalyeleri ve masaları topladı."


translate turkish day3_cleaning_us_ad056558:


    "Aslında o kadar hızlıydı ki ona yetişmekte zorlandım."


translate turkish day3_cleaning_us_a3e4be71:


    me "Birdenbire çok iyi davranmaya başlamadın mı?"


translate turkish day3_cleaning_us_a9babbd5:


    us "Bütün günü burada geçirmek istemiyorum, seni aptal!"


translate turkish day3_cleaning_us_9fc103c6:


    "Sesi hala sinirli geliyordu."


translate turkish day3_cleaning_us_ac945f7b:


    me "Dinle, böyle davranmaman gerektiğini anlaman lazım...{w} En azından bu kadar değil..."


translate turkish day3_cleaning_us_fbfed032:


    "Nedense ona ahlaki bir ders vermeye karar verdim."


translate turkish day3_cleaning_us_e142a9de:


    us "Ben hiçbir şey yapmadım!{w} Bana hakaret eden sendin."


translate turkish day3_cleaning_us_4f354c21:


    "Ulyana paspas ve kovayı aldı ve kantini en uzak köşesine gitti."


translate turkish day3_cleaning_us_d71063b0:


    th "Görünüşe göre hala kızgın."


translate turkish day3_cleaning_us_b32f5157:


    "Kırılmış sofra takımları dağına dönüp baktığımda, nihayet felaketin boyutunu anlamaya başladım."


translate turkish day3_cleaning_us_7300ad57:


    th "Şanslıyız ki çatal ve kaşıklar metalden yapılmıştı – yemek için hala yiyecek malzemelerimiz var.{w} Ama neredeyse hiç tabak kalmadı...."


translate turkish day3_cleaning_us_e66e1571:


    us "Hey..."


translate turkish day3_cleaning_us_81282f69:


    "Ulyana beni bağırarak çağırdı."


translate turkish day3_cleaning_us_cbdad383:


    "Onun yanına gittim."


translate turkish day3_cleaning_us_557a9104:


    us "Anlayamıyorum, neden benden bu kadar nefret ediyorsun?"


translate turkish day3_cleaning_us_8e1a6421:


    "Yüzü o kadar ciddileşti ki, bunun onun başka bir numarası olmadığına inanmaya hazırdım."


translate turkish day3_cleaning_us_dffd29c3:


    me "Niye sanıyorsun?"


translate turkish day3_cleaning_us_f0847682:


    us "Hiçbir fikrim yok, bu yüzden sana soruyorum."


translate turkish day3_cleaning_us_e5f99c8b:


    me "Senden nefret etmiyorum.{w} Sadece bazen şu davranışların...{w} biliyorsun."


translate turkish day3_cleaning_us_8c306ba5:


    "Bu kadar basit, ama hala doğru."


translate turkish day3_cleaning_us_a00845ac:


    us "Ne gibi?{w} Hiçbir fikrim yok."


translate turkish day3_cleaning_us_cc439301:


    "Merakla kaynayan bakışlarını bana doğru kaldırdı."


translate turkish day3_cleaning_us_4470295b:


    me "Öncelikle, kompotu üzerime dökmenin ne anlamı var?"


translate turkish day3_cleaning_us_c656e178:


    us "Bunu sen istedin."


translate turkish day3_cleaning_us_65b7d3f3:


    "Temizlemeye başladığımızdan beri ilk defa gülümsedi."


translate turkish day3_cleaning_us_2bb47ab4:


    me "Evet, elbette..."


translate turkish day3_cleaning_us_47d09bdb:


    "Ağır bir şekilde iç çektim."


translate turkish day3_cleaning_us_0621ba40:


    me "Peki, o zaman başkalarından ne bekliyorsun?"


translate turkish day3_cleaning_us_ff47fe7e:


    us "Hiçbir şey."


translate turkish day3_cleaning_us_2f6a59ef:


    "Sert bir şekilde cevap verdi."


translate turkish day3_cleaning_us_8e2b133b:


    "Bu tartışma bitmişti, ben de sessizce temizlik yapmaya devam ettim."


translate turkish day3_cleaning_us_a20cefa7:


    "..."


translate turkish day3_cleaning_us_86688e12:


    "Kantini düzeltmemiz bir kaç saatimizi aldı."


translate turkish day3_cleaning_us_0a8d709c:


    "Sonunda bütün kırık sofra takımları gitmişti. Sandalyeler ve masalar yerli yerindeydi, yerler temiz görünüyordu."


translate turkish day3_cleaning_us_d6447ba7:


    "Ulyana ile birlikte yemek tezgahının yanında oturuyorduk, nefes nefese kalmıştık, haklı olarak dinleniyorduk."


translate turkish day3_cleaning_us_a4eb05ec:


    me "Şimdi aptalca bir numara yüzünden ne kadar çaba sarf edilmesi gerektiğini görüyorsun."


translate turkish day3_cleaning_us_d9f878c6:


    us "Ama ben daha yorulmadım!"


translate turkish day3_cleaning_us_fc386561:


    "Ama yüzünden dökülen ter tam tersini söylüyordu."


translate turkish day3_cleaning_us_8e0db1a9:


    me "Oh, iyi o zaman..."


translate turkish day3_cleaning_us_926c6d27:


    us "Peki, bundan sonra ne yapacağız?"


translate turkish day3_cleaning_us_2a831701:


    me "Seni bilmem, ama ben gitmeyi tercih ederim..."


translate turkish day3_cleaning_us_2fe78b26:


    us "Hayır! Hayır! Hepsi bu kadar değil!"


translate turkish day3_cleaning_us_86e9c04d:


    us "Yapman gereken..."


translate turkish day3_cleaning_us_6e6e30b3:


    "Tereddüt etti."


translate turkish day3_cleaning_us_cbab93c7:


    us "Bana küçük bir şey için daha yardım etmek!"


translate turkish day3_cleaning_us_341c6bf4:


    me "Başka bir şaka daha mı düşünüyorsun?"


translate turkish day3_cleaning_us_7862b445:


    us "Tabii!"


translate turkish day3_cleaning_us_6d77584d:


    "Genişçe gülümsedi."


translate turkish day3_cleaning_us_b72aa87d:


    me "Ben senin adamın değilim.{w} Bugün sadece tek bir cezadan fazlasıyla tatmin oldum."


translate turkish day3_cleaning_us_005a932e:


    us "Tamam, hadi bir anlaşma yapalım!{w} Eğer şimdi bana yardım edersen sana bir daha şaka yapmayacağım!"


translate turkish day3_cleaning_us_d5e744c0:


    "Elbette bu güzel bir anlaşmaydı, ama nedense Ulyana'ya güvenmek istemedim."


translate turkish day3_cleaning_us_24184228:


    th "Sormaktan zarar gelmez."


translate turkish day3_cleaning_us_72d07964:


    me "Pekala, planın nedir?"


translate turkish day3_cleaning_us_8e695095:


    us "Şeker çalacağız!"


translate turkish day3_cleaning_us_3d342d5a:


    me "Ne?!"


translate turkish day3_cleaning_us_cce1c4dc:


    "Böyle bir şey beklemem gerekirdi."


translate turkish day3_cleaning_us_82811001:


    th "Şeker çocuklar içindir..."


translate turkish day3_cleaning_us_f544383f:


    us "Şef çöp atmaya gideceğinden bizi kimse göremez!"


translate turkish day3_cleaning_us_df96cac2:


    me "Ben yokum!"


translate turkish day3_cleaning_us_44f47ba7:


    us "Ah, her neyse!"


translate turkish day3_cleaning_us_99aa653e:


    "Homurdandı ve arkasını döndü."


translate turkish day3_cleaning_us_1838e844:


    us "O zaman kendim yaparım!"


translate turkish day3_cleaning_us_821e8719:


    me "Ve ben de sana izin verm..."


translate turkish day3_cleaning_us_e1f72ec9:


    "Daha cümlemi bitirmeden, Ulyana çoktan tezgâhın üzerinden atlayıp dolaba koştu, kapağını açtı ve karıştırmaya başladı."


translate turkish day3_cleaning_us_e182607e:


    me "Hey, kes şunu!{w} Sanki Olga Dmitreivna ile hiç problemin yok da!"


translate turkish day3_cleaning_us_6586cba7:


    "Cevap vermedi."


translate turkish day3_cleaning_us_fdb724d1:


    me "Böyle bir suçtan sadece temizlik yaparak kurtulamazsın."


translate turkish day3_cleaning_us_2992696a:


    "Ulyana kapağı kapadı.{w} Elinde kocaman bir torba şeker tutuyordu."


translate turkish day3_cleaning_us_244f004d:


    me "Ah seni küçük...! Geri koy onu!"


translate turkish day3_cleaning_us_5cc17f12:


    "Bana dilini çıkardı ve arka kapıdan kaçtı."


translate turkish day3_cleaning_us_8d50913c:


    "Böylece bırakamazdım!{w} Takip etmek için dışarı fırladım."


translate turkish day3_cleaning_us_499e4041:


    "Elbette oldukça önde başlamıştı, ama yine de tüm enerjimi kovalamacaya harcadım."


translate turkish day3_cleaning_us_0ab77e34:


    th "Onu tekrardan gözden kaybetmeyeceğim!"


translate turkish day3_cleaning_us_a0344103:


    "Meydana kadar koşuşturduk..."


translate turkish day3_cleaning_us_971a61ea:


    "Müzik kulübünden geçtik..."


translate turkish day3_cleaning_us_c8e8d113:


    "Ve orman yoluna çıktık."


translate turkish day3_cleaning_us_596c2686:


    "Az kalsın Ulyana'yı yakalıyordum ki absürt bir şekilde bir anda durdu..."


translate turkish day3_cleaning_us_13e17fb4:


    "Fakat ben duramadım ve çarpışıp düştük."


translate turkish day3_cleaning_us_31ba2a96:


    "Çimlerin üzerinde yuvarlandık...."


translate turkish day3_cleaning_us_9cd22020:


    me "Yakaladım!"


translate turkish day3_cleaning_us_7aeb2243:


    "Zafer çığlığı attım."


translate turkish day3_cleaning_us_c67ac3de:


    us "Hayır yakalamadın..."


translate turkish day3_cleaning_us_ed702531:


    "Utanmış bir şekilde cevap verdi."


translate turkish day3_cleaning_us_0ec6d3ef:


    "Ulyana altımda yatıyordu."


translate turkish day3_cleaning_us_92dbd985:


    "Yüzü benim yüzüme epey yakındı."


translate turkish day3_cleaning_us_cb6f36c0:


    "Vücut ısısını ve düzensiz nefes alıp verişlerini duyabiliyordum."


translate turkish day3_cleaning_us_57515ee8:


    th "Elbette, şu anda sadece bir çocuk ama yakında bir kadın olacak."


translate turkish day3_cleaning_us_b08ceff8:


    "Çok rahatsız ediciydi."


translate turkish day3_cleaning_us_c19988a4:


    us "Bana tecavüz mü edeceksin?"


translate turkish day3_cleaning_us_436a485d:


    "Kendine geldi."


translate turkish day3_cleaning_us_0c857a98:


    me "Etmemi mi istiyorsun?"


translate turkish day3_cleaning_us_b4df4200:


    "Her neyse, bu onun için daha çok bir oyun gibiydi."


translate turkish day3_cleaning_us_0fca62ac:


    us "Tabii ki et!"


translate turkish day3_cleaning_us_0f58246c:


    "Bana kurnazca bir gülüş verdi ve sessizce homurdandı.{w} Ya da ben mi öyle gördüm?"


translate turkish day3_cleaning_us_568b5895:


    me "Modumda değilim..."


translate turkish day3_cleaning_us_44f47ba7_1:


    us "Ah, her neyse!"


translate turkish day3_cleaning_us_bd670e0e:


    "Ulyana yakınlaştı ver burnumu ısırdı."


translate turkish day3_cleaning_us_b47815ea:


    "Bunu beklemiyordum."


translate turkish day3_cleaning_us_4e8535ee:


    "Sadece bir anlık tereddüt, onun kendini kurtarması ve bir düzine metre uzağa koşması için yeterliydi."


translate turkish day3_cleaning_us_28d12718:


    us "İzle!{w} Buna sonra pişman olacaksın!"


translate turkish day3_cleaning_us_5cabe167:


    "Sesli bir şekilde güldü ve ağaçların arasında kayboldu."


translate turkish day3_cleaning_us_780778e4:


    "Şeker torbası yanımda duruyordu."


translate turkish day3_cleaning_us_6e19bf3f:


    th "Acaba bilerek mi bıraktı?"


translate turkish day3_cleaning_us_11007c59:


    "Yemek zamanı yaklaşıyor, acele edip şekerleri yerine koymalıyım."


translate turkish day3_cleaning_us_ff6853b7:


    "...ve tercihen (çok tercihen) gözlerden uzak kalmalıyım."


translate turkish day3_cleaning_us_f7b4ae2b:


    "Elbette şekerleri çalanın Ulyana olduğunu söyleyeceğim..."


translate turkish day3_cleaning_us_e4f68848:


    th "Ama bana inanan olur mu ki?"


translate turkish day3_cleaning_us_492cba74:


    "Olga Dmitrievna kantinin girişinde bekliyordu bile…"


translate turkish day3_cleaning_us_2299f5be:


    mt "İyi iş, Semyon!"


translate turkish day3_cleaning_us_fb544be4:


    me "Hangi iş?"


translate turkish day3_cleaning_us_1ed8ab85:


    "Şeker torbasını arkama sakladım."


translate turkish day3_cleaning_us_9d2438b5:


    "Torba şeffaf ve cebime koyamayacağım kadar büyüktü."


translate turkish day3_cleaning_us_7746de39:


    mt "Temizliği kastediyorum. Her şey temiz ve düzenli"


translate turkish day3_cleaning_us_59d93851:


    me "Ah, evet..."


translate turkish day3_cleaning_us_a8ce4ea0:


    mt "Ulyana nerede?"


translate turkish day3_cleaning_us_f7c4eac6:


    th "Keşke bende bilseydim!"


translate turkish day3_cleaning_us_c7337a6d:


    me "O... birazdan gelir..."


translate turkish day3_cleaning_us_881d262a:


    mt "Tamam o zaman. Haydi yemeğe."


translate turkish day3_cleaning_us_ad1ee043:


    "Kantine girdim."


translate turkish day3_cleaning_us_5a56cd46:


    "Hiç şaşırmadığım bir şekilde doluydu."


translate turkish day3_cleaning_us_0a6a1ce5:


    "Şimdi torbayı farkedilmeden nasıl geri koyacağım hiçbir fikrim yok."


translate turkish day3_cleaning_us_4bcefbd3:


    th "Tabii, akşam da yapabilirim ama şimdi ne yapacağım?!"


translate turkish day3_cleaning_us_2a454c26:


    sl "Semyon!"


translate turkish day3_cleaning_us_71e7861c:


    "Arkamı döndüm. Slavya önümde duruyordu"


translate turkish day3_cleaning_us_da29ffa7:


    sl "Vay, bu da ne?"


translate turkish day3_cleaning_us_6651226b:


    "Zamanında saklayamadığım torbaya baktı"


translate turkish day3_cleaning_us_5a9cf61b:


    th "Suçüstü yakalandım, ya da daha doğrusu şeker üstü! Şimdi azar yemeye hazırlanma vakti."


translate turkish day3_cleaning_us_1a98bf30:


    me "Bunlar...{w} şekerler..."


translate turkish day3_cleaning_us_81dfe51a:


    sl "Nereden?"


translate turkish day3_cleaning_us_d9ec0a9f:


    th "Onları çaldım, lanet olsun..."


translate turkish day3_cleaning_us_934cbef8:


    me "Ulyana'dan aldım."


translate turkish day3_cleaning_us_320366d1:


    sl "Oh, anlıyorum. Aynı eski şarkı ve dans ha?"


translate turkish day3_cleaning_us_5d6eebdb:


    me "Ne demek istiyorsun?"


translate turkish day3_cleaning_us_63f30cbb:


    sl "İlk kez şeker çalmadı."


translate turkish day3_cleaning_us_11ef631b:


    th "Bunu nasıl düşünemedim ki?"


translate turkish day3_cleaning_us_ee1d96ff:


    sl "Bırak ben yerine koyayım."


translate turkish day3_cleaning_us_73aab3cd:


    me "Teşekkürler..."


translate turkish day3_cleaning_us_03e8e491:


    "Slavya tekrardan günü kurtarıyor."


translate turkish day3_cleaning_us_1751857b:


    "Torbayı aldı ve büfeye doğru yola koyuldu."


translate turkish day3_cleaning_us_574fb3bf:


    "Tatlıları geri verirken ne söyleyeceğini dinlemeye hiç niyetim yoktu. Bu yüzden kantinde oturacak bir yer aramaya başladım."


translate turkish day3_main5_144331d6:


    "Görünüşe göre Electronik ve Shurik ile oturmam gerek."


translate turkish day3_main5_967e239c:


    "Oturacak başka bir yer yoktu."


translate turkish day3_main5_67af4832:


    me "Nasılsınız beyler!?"


translate turkish day3_main5_cc50a49a:


    "Ne zaman onlarla muhatap olmak zorunda kalsam, onları kızdırmak ya da en azından küstahça veya ukalaca şakalaşmak için içimde bir istek uyanıyordu."


translate turkish day3_main5_887a8a04:


    "Böyle davranmak riskli, ama {i}elektronik kardeşler{/i} olumlu duygularımın birincil kaynağıydı."


translate turkish day3_main5_1d386f5f:


    me "Nasıl gidiyor?"


translate turkish day3_main5_489d4411:


    el "İyi. ya sen?"


translate turkish day3_main5_7cf58fb3:


    me "Eh işte."


translate turkish day3_main5_2e8cf482:


    sh "Bir şey mi oldu?"


translate turkish day3_main5_ad9962cd:


    me "Çok şey oldu."


translate turkish day3_main5_a4a08fa3:


    el "Anlatmak ister misin?"


translate turkish day3_main5_b216e161:


    me "Yok, belki başka bir zaman."


translate turkish day3_main5_44ead865:


    sh "Sen bilirsin."


translate turkish day3_main5_2aa751d7:


    "Çaresiz bir jest yaptı"


translate turkish day3_main5_3ca98c02:


    el "Yemekten sonra baloya gidiyoruz!"


translate turkish day3_main5_b528275f:


    "Electronik kıkırdadı."


translate turkish day3_main5_e1a72042:


    me "Biliyorum."


translate turkish day3_main5_d1f8823e:


    el "Kiminle dans edeceksin?"


translate turkish day3_main5_7b2a4bde:


    me "Daha düşünmedim.{w} Sen kiminle edeceksin?"


translate turkish day3_main5_7d7e9876:


    el "Ben... Şey, ben..."


translate turkish day3_main5_94a58e2f:


    "Görünüşe göre bu soru onu hazırlıksız yakalamıştı."


translate turkish day3_main5_7607ce16:


    me "Ulyana ile edebilirsin. Onu mutlu eder."


translate turkish day3_main5_8da8904a:


    el "Hayır, teşekkürler!"


translate turkish day3_main5_5753b37f:


    "Electronik öfkeyle ellerini salladı."


translate turkish day3_main5_5fe023fb:


    me "Ve sen, Shurik, sen de bence Alisa ile etmelisin."


translate turkish day3_main5_e778b8e0:


    sh "Teşekkürler, Ben almayayım."


translate turkish day3_main5_1d41d511:


    "Electronik'ten daha sakin durdu"


translate turkish day3_main5_246c6e50:


    me "Ah, hadi ama çocuklar, eğlenceli olurdu!"


translate turkish day3_main5_29c157fd:


    el "Hem...{w} Yapacak işlerimiz var!{w} Robotu bitirmemiz gerek!"


translate turkish day3_main5_41e8d12f:


    me "Oh, bu harikulade bir fikir!{w} Robotla dans et! Dans edebilir mi?"


translate turkish day3_main5_9eb621e9:


    sh "Daha yürüyemiyor bile."


translate turkish day3_main5_067ae991:


    "Shurik muhtemelen olayı tamamen kaçırdı."


translate turkish day3_main5_04d8b901:


    el "Neden, tüm kampın önünde başarılarımızı sergilemek için harika olur!"


translate turkish day3_main5_345dabaf:


    sh "Peki onlara ne göstereceğiz?"


translate turkish day3_main5_69ce28cd:


    el "Evet, haklısın..."


translate turkish day3_main5_b54d08ef:


    "İkisi de hayal kırıklığına uğramış bir şekilde tabaklarına baktılar. "


translate turkish day3_main5_a20cefa7:


    "..."


translate turkish day3_main5_a20cefa7_1:


    "..."


translate turkish day3_main5_a20cefa7_2:


    "..."


translate turkish day3_main5_3f89d2ed:


    "Yemek vakti bitmişti ve öncüler yavaş yavaş dağılmaya başlamışlardı."


translate turkish day3_main5_ad0e1b9c:


    me "Balo için ne giyeceksiniz?"


translate turkish day3_main5_83b23459:


    "Shurik ve Electronik'e sordum."


translate turkish day3_main5_3b3ff830:


    el "Giyecek bir şeyimiz yok. Aynen böyle gideceğiz."


translate turkish day3_main5_4bca7d01:


    "Öncü kıyafetini gösterdi."


translate turkish day3_main5_51acbdbc:


    th "Görünüşlerini hiç önemsemiyor gibi görünüyorlar."


translate turkish day3_main5_46388e2b:


    th "O zaman niye umrumda olsun ki?!"


translate turkish day3_main5_a2a4c2bc:


    th "Kışlık kıyafetlerimi giymek iyi bir seçenek değil, o yüzden böyle gideceğim."


translate turkish day3_main5_0058648c:


    me "Ne zaman başlıyor?"


translate turkish day3_main5_129ca123:


    el "9'dan sonra."


translate turkish day3_main5_855db9ee:


    me "Tamamdır."


translate turkish day3_main5_a8b4968b:


    "Kantinden çıktım ve akşamın taze havasını içime çektim."


translate turkish day3_main5_52c76225:


    "Okulda gittiğim o nadir dansları hatırladım."


translate turkish day3_main5_b1cb0198:


    "Tereddüt, güvensizlik, hatta korku..."


translate turkish day3_main5_68f4a1be:


    "Dans etmeyi, biri beni davet ederse nasıl tepki vereceğimi bilmezdim, birini davet etmeye dahi cesaret edemezdim."


translate turkish day3_main5_c972d742:


    "Üstüne üstlük, Bu konuda kendimi oldukça rahatsız hissettim."


translate turkish day3_main5_742d0473:


    "Ve diğerlerinin eğlenmesini görmek de çok tatsızdı."


translate turkish day3_main5_fa8fda07:


    "Bu kıskançlık değildi.{w} Daha çok benim için garip görünen bir şey üzerinden insanların eğlenmesindeki rahatsız edici histi."


translate turkish day3_main5_1ecbd57e:


    "Baloya kadar daha çok zaman olduğunu düşündüm, böylece akşam dinç olmak için biraz uyuyabilirdim."


translate turkish day3_main5_629eed15:


    "Kamp liderinin kabinine girdiğimde hemen yatağa uzandım ve gözlerimi kapattım."


translate turkish day3_main5_a20cefa7_3:


    "..."


translate turkish day3_main5_f7195c18:


    "Gariptir ki, alarm gerekmeden tam zamanında uyanmıştım."


translate turkish day3_main5_da045b54:


    "Saat 9'u gösteriyordu."


translate turkish day3_main5_2da36184:


    "Böyle bir şey çok nadir olur."


translate turkish day3_main5_97bec1c5:


    "Yine de kendimi halsiz hissettim."


translate turkish day3_main5_dab6de06:


    th "Muhtemelen gün ortasında uyumak pek de iyi bir fikir değildi."


translate turkish day3_main5_48355910:


    "Dans etmek yerine Alisa'yı görmeye gideceğim."


translate turkish day3_main5_d91422b8:


    "Zamanı geldi o zaman."


translate turkish day3_main5_abd3bafa:


    "Ama Lena'ya yardım edeceğimi söylemiştim..."


translate turkish day3_main5_f2246ca0:


    th "Ne yapmalıyım?"


translate turkish day3_main5_5dd208f8:


    "Gitmem gerek."


translate turkish day3_main5_a74ee93a:


    "Birkaç dakika içinde meydandaydım."


translate turkish day3_main5_c5292350:


    "Hoparlörler ve bazı DJ ekipmanları anıtın yanında kurulmuştu ve ağaçlar ışıklı iplerle süslenmişti."


translate turkish day3_main5_bfae52bf:


    th "Ah, tipik bir kır balosu."


translate turkish day3_main5_b71fb061:


    "Etrafta çok fazla öncü vardı, ama tanıdık herhangi bir yüz göremedim, o yüzden banka oturdum ve beklemeye başladım."


translate turkish day3_main5_bf88823d:


    th "Dans etmek zorunda değilim, sonuçta."


translate turkish day3_main5_ba5eaafc:


    "Belki oturup birileriyle muhabbet edebilirim."


translate turkish day3_main5_f62bc905:


    us "Hey, üzgün surat."


translate turkish day3_main5_c9bf617b:


    "Ulyana."


translate turkish day3_main5_b9767350:


    me "Bir şey teklif etmek için mi buradasın?"


translate turkish day3_main5_ab2952f4:


    us "Hadi, dans edelim!"


translate turkish day3_main5_9528c3cd:


    me "Daha çok erken...{w} Daha müzik bile açılmadı."


translate turkish day3_main5_0225548f:


    us "Blah, çok sıkıcısın!"


translate turkish day3_main5_386b2a74:


    th "Evet, böyle bir etkinlik için o kadar da iyi biri değilim."


translate turkish day3_main5_7ad70676:


    "Uzaklaştı."


translate turkish day3_main5_a11f2300:


    th "Yani Ulyana gece elbisesi gibi bir şey mi giydi?{w} Çok komik."


translate turkish day3_main5_9104ac12:


    sl "Selam!"


translate turkish day3_main5_3c7474d6:


    "Slavya."


translate turkish day3_main5_a87c71d7:


    me "Hey."


translate turkish day3_main5_81c4dbcb:


    "Yanıma oturdu."


translate turkish day3_main5_c2bffcd7:


    sl "Akşam nasıl?"


translate turkish day3_main5_e7ce88cd:


    me "İyi."


translate turkish day3_main5_0d67c838:


    sl "Neden bu kadar üzgünsün?"


translate turkish day3_main5_b97e3fd5:


    me "Değilim..."


translate turkish day3_main5_795edb64:


    sl "Tamam. Dans etmek seni mutlu eder o zaman!"


translate turkish day3_main5_907b6d20:


    me "Belki..."


translate turkish day3_main5_0981716b:


    sl "Bir dansı da bana ayırmayı unutma!"


translate turkish day3_main5_5fc53cc4:


    "Güldü ve müzik ekipmanlarının olduğu bölgeye doğru yürüdü."


translate turkish day3_main5_aedce5d2:


    "Durum ciddileşiyor. Dans partisi boyunca burada öylece oturamam."


translate turkish day3_main5_bd946546:


    un "Merhaba."


translate turkish day3_main5_d106dd84:


    "Lena yakınlaştı."


translate turkish day3_main5_8bd25464:


    me "Oh, merhaba, sen de buradasın demek..."


translate turkish day3_main5_6837bff6:


    th "Bu kadar şaşırılacak bir şey miydi?"


translate turkish day3_main5_f1be5fed:


    un "Evet."


translate turkish day3_main5_4457b2a1:


    me "Pekala...{w} Bu partiyi aydınlatacak mıyız?"


translate turkish day3_main5_a4468653:


    "Şaka o kadar da komik değildi."


translate turkish day3_main5_47092547:


    un "…"


translate turkish day3_main5_c5ac7756:


    "Lena kızardı ve aşağı baktı."


translate turkish day3_main5_8c3325f1:


    me "Şey, belki bir şeyleri ateşe vermek o kadar da iyi bir fikir değil..."


translate turkish day3_main5_80702140:


    un "Tamam, sanırım ben..."


translate turkish day3_main5_279eeea1:


    me "Evet..."


translate turkish day3_main5_bc5b46e9:


    "Gitti."


translate turkish day3_main5_a20cefa7_4:


    "..."


translate turkish day3_main5_94d94b39:


    "Görünüşe göre tüm kamp meydandaydı."


translate turkish day3_main5_3d7269a4:


    "Öncüler büyük gruplar oluşturdular, konuştular, şakalaştılar ve güldüler."


translate turkish day3_main5_e3412cd3:


    "DJ panelinde Ulyana, Olga Dmitreivna ile çalınacak şarkı üzerine sesli bir şekilde tartıştılar."


translate turkish day3_main5_461da4d2:


    "Ve işte.{w} Müzik çalmaya başladı."


translate turkish day3_main5_e9f89819:


    "Müzik grubunu ya da şarkıyı bilmiyorum. Ama bana soracak olursanız 'Soviet pop klasikleri' olduğunu söyleyebilirim."


translate turkish day3_main5_337cd741:


    "Öncüler sanki müziği duymamış gibi bir süre öylece durdular."


translate turkish day3_main5_5f0a6bf8:


    "İlk adımı atmak her zaman çok zordur.{w} Özellikle de bu teklifi yapacak tek kişinin siz olacağından eminseniz..."


translate turkish day3_main5_f14850ff:


    "Ulyana bu basit gerçeği kavrayamamış gibiydi."


translate turkish day3_main5_1b76cd8a:


    "Birkaç adımda meydanın ortasına ulaştı ve yüksek sesle haykırdı:"


translate turkish day3_main5_617994a2:


    us "Ne için duruyorsunuz?!"


translate turkish day3_main5_62d41fb8:


    "Ve saçma bir şekilde kıpırdamaya başladı."


translate turkish day3_main5_b59f99e6:


    "'Kıpırdamak' gerçekten doğru bir kelime.{w} Bundan daha iyisini bulamazsınız."


translate turkish day3_main5_530ffc25:


    "Çok aptalca ve komik duruyordu, hatta gülmeden duramadım bile."


translate turkish day3_main5_da8b7f2f:


    "Farketti."


translate turkish day3_main5_015e0ef0:


    us "Hey! Semyon!"


translate turkish day3_main5_11709dee:


    "Onu duyamamış gibi yaptım."


translate turkish day3_main5_81e15cab:


    us "Duymamış gibi yapmayı bırak! Buraya gel."


translate turkish day3_main5_0acd34c9:


    "Görmezden gelmeye devam ettim."


translate turkish day3_main5_57b6835b:


    "Öncüler yavaş yavaş bu parti için fazla seksi olmadıklarını fark ettiler ve dans etmeye başladılar."


translate turkish day3_main5_0cfd660b:


    "Benim bakış açımdan gerçekten çok aptalca duruyordu."


translate turkish day3_main5_6ca388ff:


    th "Uzun zamandır unutulmuş şarkıların ritmiyle kollarını ve bacaklarını sallamak mı?{w} Hadi ama, gerçekçi ol!"


translate turkish day3_main5_785dd32e:


    "Elbette dans etmeyi tam bilmiyordum, ama bu şey dans sayılırsa tabii."


translate turkish day3_main5_7023662f:


    sl "Hey, Semyon, ne duruyorsun öyle?{w} Dans etmek istemiyor musun?"


translate turkish day3_main5_19346aa1:


    "O kadar derin düşüncelerdeydim ki Slavya'yı farketmemiştim."


translate turkish day3_main5_6a4b94d5:


    me "Pek sayılmaz..."


translate turkish day3_main5_d7a9e07a:


    sl "Emin misin?"


translate turkish day3_main5_d1046a49:


    "Gülümsedi."


translate turkish day3_main5_65003d93:


    me "Belki sonra."


translate turkish day3_main5_7ccf3096:


    th "Lanet olsun! Ben burada ne yapıyorum ki?!"


translate turkish day3_evening_sl_906aa1af:


    th "Bir köşede sıkıca oturmayı tercih ediyorsan neden bir dans partisine geliyorsun?"


translate turkish day3_evening_sl_007e73c0:


    me "Tamam, ama azıcık..."


translate turkish day3_evening_sl_d0c11d8b:


    sl "İşte böyle!"


translate turkish day3_evening_sl_55ab51a9:


    "Bana elini uzattı."


translate turkish day3_evening_sl_e6ed4325:


    "Dans eden kalabalığın ortasında duruyorduk."


translate turkish day3_evening_sl_0dd1c4e2:


    "Aslında duran bendim, Slavya 'alışıyor', ritme göre sallanıyordu."


translate turkish day3_evening_sl_588cc129:


    "Bu rahatsız edici teklifi kabul ettiğim için şimdiden kendimi suçluyordum."


translate turkish day3_evening_sl_8bd9ab89:


    th "Tamam, işte yine yeniden başlıyoruz, peki şimdi ne olacak?"


translate turkish day3_evening_sl_3987eb50:


    "Etrafımdaki dans eden öncüleri inceledim."


translate turkish day3_evening_sl_7cf46727:


    th "Hayır! Buna daha hazır değilim."


translate turkish day3_evening_sl_6a467bdf:


    "Müzik absürt bir şekilde durdu."


translate turkish day3_evening_sl_dd530cb7:


    "Bazı insanlar hâlâ momentum etkisinde dans ediyordu ama çoğunluk durmuştu."


translate turkish day3_evening_sl_a231e522:


    mt "Paniklemeyin!"


translate turkish day3_evening_sl_cdf4ba52:


    "Lider DJ paneline gitti ve bir şeyleri düzenledi."


translate turkish day3_evening_sl_80ab8af2:


    mt "Sıradaki şarkı. Bayanlar bayları davet etsin."


translate turkish day3_evening_sl_69f37ce2:


    "Slavya'ya baktım."


translate turkish day3_evening_sl_e0a7c20b:


    "Bana elini gülümseyerek uzattı."


translate turkish day3_evening_sl_660ca959:


    "Bir kızı asla reddetmemelisiniz."


translate turkish day3_evening_sl_480cbce8:


    "Bir kaç dakika boyunca dans ettik."


translate turkish day3_evening_sl_3ff4b37b:


    "Göğsü daha hızlı inip kalktı ve yüzü daha da kızardı."


translate turkish day3_evening_sl_98bcf9db:


    "Slavya gözlerime baktı."


translate turkish day3_evening_sl_77871c15:


    "Dans eden öncülere, ayağıma, ya da başka herhangi bir yere bakmaya çalıştım."


translate turkish day3_evening_sl_a4bce591:


    "Garip bir histi: Tüm vücudum zaman zaman ürperdi, ama hoş bir ürpermeydi, hiçbir tedirginlik ya da utanç belirtisi olmadan."


translate turkish day3_evening_sl_d4eb018d:


    "Zihnim mucizevi bir şekilde sakinleşti."


translate turkish day3_evening_sl_f5c6ebae:


    "Bu kızın gitmesine izin vermek istemediğimi fark ettim ve onunla sonsuza kadar dans etmeye hazırım!"


translate turkish day3_evening_sl_5cf561ad:


    "Yanımıza atlayan Ulyana bir an durdu ve sırıttı."


translate turkish day3_evening_sl_67912668:


    "Belki de bir şeyler görüyordum ama o küstah kızın bir şeyler ima etmeye çalıştığı düşüncesinden kurtulamıyordum."


translate turkish day3_evening_sl_1eafcf89:


    "Korku dolu bir yüz ifadesi takındım ama o çoktan gitmişti."


translate turkish day3_evening_sl_a428f2b1:


    sl "Bir sorun mu var?"


translate turkish day3_evening_sl_e6509443:


    "Sessizce sordu."


translate turkish day3_evening_sl_fb700e8f:


    me "Her şey yolunda...{w} Demek istediğim, her şey harika."


translate turkish day3_evening_sl_46fbad31:


    "Daha kekelemeye başlamamıştım, ama yakında başlayacağım kesin."


translate turkish day3_evening_sl_df85f677:


    sl "Çok gerginsin."


translate turkish day3_evening_sl_89875d8e:


    me "Birazcık."


translate turkish day3_evening_sl_9fb02d3f:


    "Dürüstçe söyledim."


translate turkish day3_evening_sl_478c945d:


    sl "Erkekler dans etmeyi pek sevmez."


translate turkish day3_evening_sl_48176bfb:


    me "Sanırım..."


translate turkish day3_evening_sl_43c3e662:


    "Bir şey söylemedi, sadece gülümsedi."


translate turkish day3_evening_sl_a20cefa7:


    "..."


translate turkish day3_evening_sl_b2671e23:


    "Şarkı sonunda bitti."


translate turkish day3_evening_sl_97f9a3fb:


    "Slavya'yı hâlâ tutuyordum ama elimden kolayca sıyrıldı."


translate turkish day3_evening_sl_42e06c7b:


    sl "Dans için teşekkürler!"


translate turkish day3_evening_sl_39a579dc:


    me "Asıl ben sana etmeliyim."


translate turkish day3_evening_sl_ff3d4c64:


    "Bir süre öylece durup ona baktım."


translate turkish day3_evening_sl_ed185ba1:


    "Sıradaki parça çalmaya başladı."


translate turkish day3_evening_sl_69421a79:


    sl "Bir kez daha?"


translate turkish day3_evening_sl_0a5e88b4:


    me "Hayır, sanırım biraz dinleneceğim."


translate turkish day3_evening_sl_144a26aa:


    "Meydandan mümkün olduğunca hızlı bir şekilde uzaklaşmaya çalıştım."


translate turkish day3_evening_sl_46643faf:


    "Nasıl plaja geldiğimi hatırlamıyorum bile."


translate turkish day3_evening_sl_b8ec268f:


    th "Neden kaçtım ki?"


translate turkish day3_evening_sl_52f987f3:


    "Tam olarak kaçmak gibi görünüyordu."


translate turkish day3_evening_sl_a727c48b:


    th "Dans güzeldi ve Slavya'da memnundu."


translate turkish day3_evening_sl_c5789e6f:


    "Ama bir şeyler yolunda değildi, baloyu düşünmek bile beni huzursuz ediyordu.."


translate turkish day3_evening_sl_915c2c39:


    "Belki de durumu kavrayamadım ve duygusallaştım?"


translate turkish day3_evening_sl_073908ff:


    "Bu nadiren yaşanır."


translate turkish day3_evening_sl_e79ce22b:


    "Her zaman sakin davranmaya ve durumu sakin bir şekilde değerlendirmeye çalışırdım.{w} Ama şimdi böyle yapabildim mi?"


translate turkish day3_evening_sl_cd66cbff:


    "Kuma oturdum ve nehri izlemeye başladım."


translate turkish day3_evening_sl_8a61b36d:


    "Dolunay suyun çok üzerinde asılı duruyordu.."


translate turkish day3_evening_sl_71e227a7:


    "Anılar beni bunalttı."


translate turkish day3_evening_sl_98e1accf:



    nvl clear
    "Ben 6 yaşındaydım. Babam ve ben balık tutuyorduk. Oltamı beceriksizce fırlattım ve beklemeye başladım. Bir dakika, iki, 10. Hiçbir balık ısırığı yok. Bu sırada babam bir bir yakalıyordu."


translate turkish day3_evening_sl_01fe6588:


    me "Bunu nasıl yapabiliyorsun?"


translate turkish day3_evening_sl_454a26a0:


    "Açıklıyor. Ama şimdi tüm detayları hatırlamıyorum."


translate turkish day3_evening_sl_cd97be40:


    "9 yaşındayım. Hayaletlerle dolu kır evimizin yakınında karanlık, tamamlanmamış bir bina, vampirler, ya da belki sadece berduşlar. İkinci kata çıkan, uçurumun üzerinde asılı duran dengesiz ahşap bir merdiven - bodruma inen delik."


translate turkish day3_evening_sl_0a0165e9:


    "Korkmuştum, ama hala merdivenlerden inmeye devam ediyordum. Ayağıma bir tuğla düştü ve bir tırnağımı kırdım."


translate turkish day3_evening_sl_742d2cdc:


    "12 yaşındayım. Bir video oyunu turnuvasındaki ilk zaferim. Bir konsol dövüş oyunu oynuyoruz. Hayali bir seyirci benim şaşırtıcı zaferimi alkışlıyor."


translate turkish day3_evening_sl_6fffdf4d:



    nvl clear
    "15 yaşındayım. Topuğumla birkaç harika gol attım. Ve 30 metreden üst köşeye harika bir şut."


translate turkish day3_evening_sl_20e21081:


    "17 yaşındayım. İlk aşkım. Geçici görüntüler, şehrin puslu havasında kayıp giden ve kaybolan bir gölge. Binaların ve köşelerin arasında onu yakalayamıyorum."


translate turkish day3_evening_sl_b039b984:


    "Sonraki anılar daha net ama çok daha az canlı hale geldi."


translate turkish day3_evening_sl_294cee60:


    "Çocukluğuma ve gençliğime dair gördüğüm görüntüler net değildi. Ayrıntılardan yoksundular ve insanların yüzlerini tam olarak göremiyordum. Bazen dökülmüş boyalarla kaplı bir tuvale benziyorlardı."


translate turkish day3_evening_sl_f7b289c8:


    "Ama o puslu görüntülerin hissettirdikleri, yakın zamandaki anılarımın hissettirdiklerinden çok daha sıcaktı."


translate turkish day3_evening_sl_76b2fe88:


    nvl clear


translate turkish day3_evening_sl_a20cefa7_1:


    "..."


translate turkish day3_evening_sl_6792bf1f:


    sl "İşte buradasın!"


translate turkish day3_evening_sl_f493af42:


    "Slavya bana doğru eğildi.{w} Korkmadım."


translate turkish day3_evening_sl_93544105:


    sl "Neden bu kadar erken ayrıldın?"


translate turkish day3_evening_sl_3b07d9cd:


    me "Sadece biraz yalnız kalmak istedim."


translate turkish day3_evening_sl_e79530ba:


    "Sanki bir kabuğa saklanmış gibiydim, benim için dış dünya yoktu ve tüm uyaranlara aynı şekilde tepki veriyordum.{w} Üç maymun gibiydim.{w} Kötülük duymayın, kötülük görmeyin, kötülük konuşmayın."


translate turkish day3_evening_sl_3a8dd74d:


    sl "Burası gerçekten güzel değil mi?"


translate turkish day3_evening_sl_21eebc87:


    "Slavya nehire baktı."


translate turkish day3_evening_sl_63d245c0:


    me "Evet, öyle..."


translate turkish day3_evening_sl_d3e0ec8b:


    sl "Bir dans daha?"


translate turkish day3_evening_sl_70849ba4:


    me "Hayır, teşekkürler. Böyle iyiyim."


translate turkish day3_evening_sl_c8cd5039:


    "İçten içe Slavya'ya karşı bu kadar sert olmamam gerektiğini biliyordum, ama ipin ucundaki bir kukla gibiydim, başka koşullar altında asla söylemeyeceğim şeyleri söylemek zorunda kaldım."


translate turkish day3_evening_sl_29dcd13b:


    sl "Ne hakkında düşünüyorsun?"


translate turkish day3_evening_sl_f0e61106:


    me "Hiçbir şey..."


translate turkish day3_evening_sl_3da81d34:


    sl "Hiçbir şeyi düşünemezsin!"


translate turkish day3_evening_sl_b29aedbf:


    "Dudaklarını büktü ama hemen ardından gülümseyerek alınmadığını belli etti."


translate turkish day3_evening_sl_4ab2d20d:


    sl "Fark etmesen bile her zaman bir şeyler düşünüyorsun."


translate turkish day3_evening_sl_6ab05865:


    me "Belki."


translate turkish day3_evening_sl_fbb41494:


    sl "Eee, ne düşünüyordun?"


translate turkish day3_evening_sl_a3db8fcb:


    me "Baykuşlar hakkında."


translate turkish day3_evening_sl_870d8d2c:


    "Aklıma gelen ilk şeyi söyledim."


translate turkish day3_evening_sl_37437f1e:


    sl "Neden baykuşlar?"


translate turkish day3_evening_sl_ce3666e5:


    "Güldü."


translate turkish day3_evening_sl_595d7b8c:


    me "Bilmiyorum."


translate turkish day3_evening_sl_cd57019d:


    sl "Hiç baykuş gördün mü?"


translate turkish day3_evening_sl_d490fd5c:


    me "Elbette gördüm."


translate turkish day3_evening_sl_05e130d4:


    th "Ne saçma bir soru..."


translate turkish day3_evening_sl_1537169b:


    sl "Sever misin peki?"


translate turkish day3_evening_sl_66bebe85:


    me "Diğerleri gibi kuşlar sadece."


translate turkish day3_evening_sl_1dcb4b49:


    sl "Gece-kuşu."


translate turkish day3_evening_sl_26b4f833:


    "Diye belirtti."


translate turkish day3_evening_sl_c6d4e117:


    me "Evet, bir gece-kuşu."


translate turkish day3_evening_sl_67f5dc8a:


    th "Bir gece-kuşu."


translate turkish day3_evening_sl_f08d71cf:


    "Bir baykuş hayal ettim - kocaman yanıp sönen gözleri olan küçük tüylü bir kutu."


translate turkish day3_evening_sl_35f51a31:


    sl "Sen bir gece baykuşu musun?"


translate turkish day3_evening_sl_e54b39e9:


    me "Ne?"


translate turkish day3_evening_sl_0db8f540:


    sl "Bilirsin, sabahçı baykuşlar vardır, gececi baykuşlar vardır. Birisi erkenden uyanmayı birisi de daha çok uyumayı tercih eder."


translate turkish day3_evening_sl_e90153b6:


    "Söyledikleri beni gerçekliğe geri getirdi."


translate turkish day3_evening_sl_a6f160d4:


    "Tozlu odamı hayal ettim, ıvır zıvırla dolu, masanın üzerinde yıkanmamış bir yığın tabak, köşede çürümeye bırakılmış gitar, lambadan sarkan kravat ve tüm bunların zirvesi, yatağın altındaki kirli çorap yığını."


translate turkish day3_evening_sl_4ac82707:


    "Ben gerçekten bir gece baykuşuydum.{w} Gece benim zamanımdı."


translate turkish day3_evening_sl_2e21ef54:


    "Ama nasılsa bu kampta erkenden uyanmayı başarabildim."


translate turkish day3_evening_sl_dc4d60ee:


    me "Biliyorum."


translate turkish day3_evening_sl_b712550e:


    sl "O zaman sen hangisisin?"


translate turkish day3_evening_sl_1d219eb9:


    me "Gece baykuşu sanırım...{w} Uyumayı seviyorum."


translate turkish day3_evening_sl_6b0f0e89:


    sl "Ben de sabahçıyım.{w} Ne kadar erken kalkarsan, gün içinde o kadar çok şey yapabilirsin."


translate turkish day3_evening_sl_8392621f:


    "Gerçekten yapmam gereken acil bir şey yok, bu yüzden gece ve gündüz arasında herhangi bir fark görmüyorum.{w} Sadece geceleri her şey daha sakin ve sessiz oluyor."


translate turkish day3_evening_sl_09bf6d3d:


    me "Slavya, hayatında hiç sorun yaşamıyor musun?"


translate turkish day3_evening_sl_5240e44d:


    sl "Ne demek istiyorsun?"


translate turkish day3_evening_sl_a4614188:


    "Merakla sordu."


translate turkish day3_evening_sl_77f4a782:


    me "Her zaman mutlu, yardıma hazır ve bir şeyler yapmaya başlamak için çok heveslisin."


translate turkish day3_evening_sl_7f5e995c:


    me "Sanki hiçbir şey seni sinirlendiremez gibi."


translate turkish day3_evening_sl_af407039:


    sl "Neden!?"


translate turkish day3_evening_sl_ec2c2a7c:


    "Güldü."


translate turkish day3_evening_sl_cbff0809:


    sl "Ben sadece sıradan bir insanım."


translate turkish day3_evening_sl_7c783ece:


    th "Haklı.{w} Sıradan bir yerde sıradan bir insan."


translate turkish day3_evening_sl_cce49fa3:


    me "Bazen burada garip olanın ben olduğumu düşünüyorum."


translate turkish day3_evening_sl_52f705e3:


    sl "Kampı sevmiyor musun?"


translate turkish day3_evening_sl_8f568239:


    me "Sadece kampı kastetmiyorum.{w} Önceden..."


translate turkish day3_evening_sl_2a7a8a3b:


    "Tökezledim."


translate turkish day3_evening_sl_4b44803d:


    th "Onunla bile bu kadar açık konuşmamalıyım."


translate turkish day3_evening_sl_5d943aa7:


    me "Evde de.{w} Diğerleri gibi olmadığımı düşünüyorum. Ait olduğum yer burası değil gibi..."


translate turkish day3_evening_sl_4b441221:


    sl "Oh durdur şunu! Böyle düşünmek aptalca."


translate turkish day3_evening_sl_81571d87:


    th "Biraz önce kendimi dünyanın geri kalanına kapatmıştım ve şimdi kalbimi bu kıza açıyorum."


translate turkish day3_evening_sl_15fa3132:


    th "Bana neler oluyor?"


translate turkish day3_evening_sl_97fb9be9:


    me "Hayır, gerçekten. Başka şartlar altında bana hiç dikkat etmezsin.{w} Senden çok farklıyım. Tembelim, çekingenim ve olağanüstü yeteneklerim yok."


translate turkish day3_evening_sl_45a7a568:


    me "Kalabalık geniş bir şehirde fark edeceğin en son kişi ben olurdum.{w} Gerçi benim için dışarı çıkmak bile nadirdir."


translate turkish day3_evening_sl_618ab2ac:


    sl "Semyon, beni korkutuyorsun."


translate turkish day3_evening_sl_453d16cb:


    "Ciddi bir şekilde baktı."


translate turkish day3_evening_sl_d4064844:


    "Utanmıştım ama gözlerimi kaçırmadım."


translate turkish day3_evening_sl_aad6bab5:

    me "Haksız mıyım?"


translate turkish day3_evening_sl_738f16d6:


    sl "Elbette!{w} Sen sensin. Senin gibi başka kimse yok. Sadece biraz özgüvenli ve sabırlı olmalısın, böylece her şeyi başarabilirsin!{w} Buna hiç şüphe yok."


translate turkish day3_evening_sl_c4f4bcb6:


    "Gökyüzüne baktım."


translate turkish day3_evening_sl_3b021425:


    me "Eğer her şey senin dediğin gibi kolay olsaydı..."


translate turkish day3_evening_sl_b574b5d1:


    sl "Hiç de zor değil! Hatta gel şimdi başlayalım!"


translate turkish day3_evening_sl_1ad35916:


    me "Neye başlayalım?"


translate turkish day3_evening_sl_7109d569:


    sl "Değişime!"


translate turkish day3_evening_sl_ee1a91b3:


    th "Bu şekilde mi?"


translate turkish day3_evening_sl_ea49f8ff:


    me "Bunu nasıl yapabileceğimizi düşünüyorsun?"


translate turkish day3_evening_sl_541b7562:


    sl "İşe yarar bir şeyler yapmalıyız!"


translate turkish day3_evening_sl_e473fa2f:


    me "Örneğin?"


translate turkish day3_evening_sl_7db509b3:


    sl "Şey..."


translate turkish day3_evening_sl_60f3d758:


    "Bir anlığına düşündü."


translate turkish day3_evening_sl_44f18559:


    sl "Hadi meydanı temizleyelim.{w} Balo çoktan bitti!"


translate turkish day3_evening_sl_6e3178d0:


    me "Sadece ikimiz mi?"


translate turkish day3_evening_sl_bd88c88c:


    th "Tüm işi yapabilecek miyiz?"


translate turkish day3_evening_sl_be7f9c31:


    sl "Yapacak çok şey yok.{w} İlk adım her zaman en önemlisidir!"


translate turkish day3_evening_sl_c3348a75:


    th "Bu konuda onunla tartışamam ama karanlıkta ağaçlardan ışıkları indirmek, ağır ses ekipmanlarını taşımak ve süpürmek..."


translate turkish day3_evening_sl_03eb9a2e:


    "Bunların hiçbiri yapılacaklar listemde yoktu."


translate turkish day3_evening_sl_0e6e2d6e:


    "Ama onu nasıl kibarca reddedeceğimi bilemedim."


translate turkish day3_evening_sl_615361ab:


    me "Belki yarın yapabiliriz?{w} Herkesle?"


translate turkish day3_evening_sl_c0da7d07:


    sl "Neden yarına bırakalım?{w} Diziliş sırasında temiz bir meydanda durmak harika olmaz mıydı?"


translate turkish day3_evening_sl_8cede868:


    th "İlk olarak, genel olarak dizilimleri sevmem."


translate turkish day3_evening_sl_5b4109bc:


    me "Hey, seni anlayabiliyorum...{w} Ama yapacak çok iş var!"


translate turkish day3_evening_sl_bbc1f2e4:


    "Slavya bir anlığına düşündü."


translate turkish day3_evening_sl_245f16e1:


    sl "Evet, görünüşe göre haklısın."


translate turkish day3_evening_sl_3e8d56f1:


    th "Demek ki bazen ben haklı.{w} O da yanlış olabilirmiş."


translate turkish day3_evening_sl_d746a7a3:


    sl "O zaman..."


translate turkish day3_evening_sl_83de587e:


    "Gerindi ve esnedi."


translate turkish day3_evening_sl_3b5d4e01:


    sl "Uyuyalım o zaman!"


translate turkish day3_evening_sl_3cd13b17:


    "İyi fikir, ama daha çok konuşmak istiyordum."


translate turkish day3_evening_sl_186a1c59:


    me "Erken değil mi...?"


translate turkish day3_evening_sl_bf68bee5:


    sl "Hayır!"


translate turkish day3_evening_sl_8b29d788:


    "Slavya eleştirel bir şekilde karşı çıktı."


translate turkish day3_evening_sl_440467e0:


    sl "O zaman yarın tüm gün uyursun."


translate turkish day3_evening_sl_3dd3f806:


    me "Bana bir masal anlat o zaman!"


translate turkish day3_evening_sl_75c35567:


    "Aklımdan geçen ilk şeyi söyledim."


translate turkish day3_evening_sl_e8eb4335:


    sl "Ben sadece kitaplarda okuduklarımı biliyorum...{w} Bilmen gerek."


translate turkish day3_evening_sl_807b7383:


    th "Belki biliyorumdur..."


translate turkish day3_evening_sl_744ed324:


    "Ne başarısızlık ama."


translate turkish day3_evening_sl_ad3d2e0c:


    sl "Gitmeli miyiz?"


translate turkish day3_evening_sl_55ab51a9_1:


    "Elini bana uzattı."


translate turkish day3_evening_sl_6199f44f:


    me "Burada biraz daha duracağım, biraz temiz havaya ihtiyacım var."


translate turkish day3_evening_sl_76d0ac27:


    me "Sen gidebilirsin! İyi geceler!"


translate turkish day3_evening_sl_5f3273c1:


    sl "İyi geceler!"


translate turkish day3_evening_sl_ec475aa3:


    "Slavya uzaklaştı."


translate turkish day3_evening_sl_22e44be2:


    "Önce yenilgimin tadını çıkarmak istedim."


translate turkish day3_evening_sl_4ff0543c:

    "Bu parlak fikirden sonra onunla bir dakika bile birlikte olmaya dayanamadım. Masal mı? Bu da ne yahu?"


translate turkish day3_evening_sl_335c00f5:


    th "Bu işler böyledir. Bir kızla sıradan bir sohbet etmeye çalışırsın ve bu tam bir fiyaskoya dönüşür."


translate turkish day3_evening_sl_368a09ed:


    "Gökyüzüne baktım."


translate turkish day3_evening_sl_7de6936f:


    "Yıldızlar, güneşten uzaktaki şu küçük ışıklar, sanki bana gülüyormuş gibi şımarıkça göz kırptı."


translate turkish day3_evening_sl_b61a3a4c:


    "Döndüm ve yüzümü kuma gömdüm."


translate turkish day3_evening_sl_10854c7a:


    "Bir süre sonra bunun da benim parlak fikirlerimden biri olduğunu fark ettim, yatmadan önce masal istemekle aynı düzeydeydi."


translate turkish day3_evening_sl_a8978170:


    "Ayağa kalktım, tükürükler saçarak liderin kabinine gittim."


translate turkish day3_evening_sl_a20cefa7_2:


    "..."


translate turkish day3_evening_sl_5195ec0b:


    "Yol boyunca sırtım kaşındı."


translate turkish day3_evening_sl_81f35693:


    "Sadece sırtım değil, tüm vücudum."


translate turkish day3_evening_sl_533207f2:


    "Şaşılacak bir şey yok, birkaç gündür banyo yapmadım, burası gündüzleri çok sıcak olduğu için domuz gibi terliyorsunuz."


translate turkish day3_evening_sl_17474fa5:


    th "Sabun ve havlu bulmalıyım."


translate turkish day3_evening_sl_aadfea7e:


    "Olga Dmitreivna'nın kabininde her şeyi bulabilirsiniz."


translate turkish day3_evening_sl_f8c52b26:


    "Birkaç dakika sonra elimde banyo malzemeleriyle tekrar meydandaydım."


translate turkish day3_evening_sl_b0cbc573:


    th "Şimdi duşu bulmam lazım."


translate turkish day3_evening_sl_3b2b772c:


    "Kolay oldu. Bina ormanın hemen yanındaydı."


translate turkish day3_evening_sl_662916c1:


    th "Duşlar için gerçekten iyi bir yer."


translate turkish day3_evening_sl_d2fefd9e:


    "Sanırım içeride Blair Cadısı yoktu ama ışıklar hâlâ açıktı."


translate turkish day3_evening_sl_2ee9293b:


    me "Peki gece yarısı banyo yapmak kimin parlak fikri?"


translate turkish day3_evening_sl_2eb0d079:


    "Mırıldandım."


translate turkish day3_evening_sl_68584892:


    "Sadece tek bir problem var – içerideki kız mı erkek mi?"


translate turkish day3_evening_sl_c7224776:


    "İlk durumda hiçbir endişe duymadan birlikte banyo yapabilirdik."


translate turkish day3_evening_sl_289b8414:


    th "Halka açık duşları pek sevmem ama bu kez üstesinden gelebilirim."


translate turkish day3_evening_sl_0c723b2c:


    "İkinci durumda beklemem ya da bütün gece boyunca kendimi kaşımam gerekecekti."


translate turkish day3_evening_sl_99683490:


    th "Kim bilir daha ne kadar beklemem gerekecek..."


translate turkish day3_evening_sl_9c652616:


    "Camdan içeriyi dikizledim.{w} Ama buhar yüzünden kimseyi göremedim."


translate turkish day3_evening_sl_de4b06b3:


    "Aniden, Slavya kalın buhar tabakasının ardından belirdi."


translate turkish day3_evening_sl_3300e119:


    "Doğal olarak çıplaktı, banyoda olması gereken herkes gibi."


translate turkish day3_evening_sl_f8f1d6e9:


    "Şaşkınlıktan ona öylece bakıp durdum."


translate turkish day3_evening_sl_45d87efb:


    "Hiçbir zaman çıplak bir kızı bu kadar yakından görmemiştim, camdan bile."


translate turkish day3_evening_sl_4029c0f3:


    "Aletim olması gerektiği gibi tepki verdi."


translate turkish day3_evening_sl_0ad798c3:


    "Sinir dalgaları gözlerimden vücuduma doğru yayıldı."


translate turkish day3_evening_sl_c0894e89:


    "Ne olursa olsun, savaş çıksa bile gözlem noktamı terk edemezmişim gibi görünüyordu."


translate turkish day3_evening_sl_addbff34:


    "Ama Slavya beni farketmedi."


translate turkish day3_evening_sl_defd30a4:


    "Yavaşça yıkanıyordu. Kafasını duruluyor, Vücudunu bir süngerle ovalıyor ve kovadan kendi üzerine su döküyordu."


translate turkish day3_evening_sl_4cdeecd0:


    "Ardıdan saçını yıkamaya başladı."


translate turkish day3_evening_sl_f24eb2b8:


    "Tamamen yıkanması için ne kadar zamana ihtiyacı olduğunu hayal bile edemiyorum, ama dakikalar saniyeler gibi akıp geçti, işte o kadar dalmıştım manzaraya."


translate turkish day3_evening_sl_a20cefa7_3:


    "..."


translate turkish day3_evening_sl_9d93e651:


    "Sonunda yıkanmayı bitirdi, memnuniyetle iç çekti ve kapıya doğru yürüdü."


translate turkish day3_evening_sl_a20cefa7_4:


    "..."


translate turkish day3_evening_sl_4ad1145a:


    "Ancak o soyunma odasına girdiğinde kendime gelebildim, gözetleme yerimi terk ettim ve yakındaki çalılıklara saklandım."


translate turkish day3_evening_sl_9d9ca7f3:


    "Yapılacak en iyi şey kaderi kışkırtmamak ve ayrılmaktı ama bunu çok geç fark ettim."


translate turkish day3_evening_sl_bf131a4a:


    "Slavya bir an sonra verandada belirdi, bir süre orada durdu, gece esintisinin tadını çıkardı ve saklandığım yöne doğru yürüdü."


translate turkish day3_evening_sl_c31ff7a6:


    "Aklımda bir düzine bahane vardı ama saklandığım çalılara bile bakmadan geçip gitti."


translate turkish day3_evening_sl_efff4fc1:


    th "Görünüşe göre şanslıyım..."


translate turkish day3_evening_sl_62c6e320:


    "Dikkatli bir şekilde dışarı çıktım ve banyo yapma niyetimi tamamen unutarak Olga Dmitrievna'nın kabinine gittim."


translate turkish day3_evening_sl_a085be61:


    "Tamamen bitkin düşmüştüm ve yatağa girip uyumak istiyordum."


translate turkish day3_evening_sl_d8f66d7a:


    "Gözlerim sabırsızlanıyor ve zaman zaman kapanıyordu."


translate turkish day3_evening_sl_a936b78e:


    "Göz kırpmak bile tehlikeliydi."


translate turkish day3_evening_sl_3d48081a:


    "Kampı hâlâ gözlerim kapalı yürüyecek kadar iyi tanımıyordum."


translate turkish day3_evening_sl_a20cefa7_5:


    "..."


translate turkish day3_evening_sl_44fae48f:


    "Aniden Slavya yanımda belirdi."


translate turkish day3_evening_sl_3820771a:


    me "..."


translate turkish day3_evening_sl_6de32e31:


    sl "Uyumaya mı gidiyorsun?"


translate turkish day3_evening_sl_da49764c:


    me "Şey... evet..."


translate turkish day3_evening_sl_97fc1ed6:


    "Tam o anda banyodaki manzarayı hatırladım ve utanarak gözlerimi kaçırdım."


translate turkish day3_evening_sl_b78c6e26:


    me "Ya sen?"


translate turkish day3_evening_sl_7405f4b0:


    sl "Temizlik yapıyorum!"


translate turkish day3_evening_sl_2214025f:


    "Süpürgeyi arkasından çıkardı."


translate turkish day3_evening_sl_dfc6b36d:


    "Slavya gece vakti boş meydanda elinde süpürgesiyle çocuk masallarındaki cadılara benziyordu."


translate turkish day3_evening_sl_e07c37b3:


    sl "Ne?"


translate turkish day3_evening_sl_62fd010a:


    me "Hiç.{w} Banyodan sonra meydanı temizlemek iyi bir fikir mi?"


translate turkish day3_evening_sl_f52a7f9e:


    sl "Banyo ettiğimi nereden biliyorsun?"


translate turkish day3_evening_sl_28bebef0:


    "Korkunun bedenimi ele geçirdiğini fiziksel olarak hissettim, sırtımdan soğuk terler akmaya başladı, düşüncelerim dondu ve hiçbir bahane düşünemedim."


translate turkish day3_evening_sl_3820771a_1:


    me "..."


translate turkish day3_evening_sl_a684124e:


    "Slavya bana şaşkınlıkla bakmaya devam etti."


translate turkish day3_evening_sl_888019d6:


    "Görünüşe göre hayatım vereceğim cevaba bağlıydı"


translate turkish day3_evening_sl_12308c9c:


    me "Şey. Saçın ıslak..."


translate turkish day3_evening_sl_1f26ca7d:


    sl "Oh, haklısın."


translate turkish day3_evening_sl_5d0b4e88:


    "Keşke yer yarılsa da yerin içine girsem. Böylece bu dünyadan da {i}kendi{/i} dünyamda yok olduğum gibi aniden ve geri dönülmez bir şekilde yok olabilirdim."


translate turkish day3_evening_sl_c493719d:


    sl "Sen de mi banyo etmeye gidiyorsun?"


translate turkish day3_evening_sl_2e67d98e:


    me "Ben... ehh..."


translate turkish day3_evening_sl_3a1790bb:


    "Slavya elimdeki çantaya baktı."


translate turkish day3_evening_sl_92d5dd33:


    me "Evet gideceğim! İyi geceler!"


translate turkish day3_evening_sl_6b587b4c:


    "Arkamı döndüm ve duşa doğru yola koyuldum."


translate turkish day3_evening_sl_63c688cb:


    th "Ne felaket, ne utanç verici..."


translate turkish day3_evening_sl_09404bd9:


    "Tüm bu olanlar için kendime lanet etmeye çalışarak yavaşça yürüdüm."


translate turkish day3_evening_sl_ee7118ff:


    th "İlk etapta dikizlememeliydim."


translate turkish day3_evening_sl_e5405609:


    th "Ama yine de dikizliyorsam, o zaman daha dikkatli olmalı ve önceden bir bahane düşünmeliyim."


translate turkish day3_evening_sl_45531a98:


    th "Oh..."


translate turkish day3_evening_sl_a20cefa7_6:


    "..."


translate turkish day3_evening_sl_0cfbc599:


    "Yıkanmam fazla zaman almadı."


translate turkish day3_evening_sl_9dc5cc01:


    "Gece kendi balosunu ya da muhtemelen bir konserini yapmış gibiydi. Yıldızlar ışıktı. Kuşlar ve böcekler bir orkestraydı, bir yerlerde öten bir baykuş da onun yönetmeniydi. Ağaçlardaki rüzgârın sesi seyircilerin alkışlarıydı."


translate turkish day3_evening_sl_36d666ac:


    "Ormanda temiz ve taze durduğunuzda gece çok daha güzel görünüyordu."


translate turkish day3_evening_sl_501fc9a9:


    "Birden yakındaki çalılıklardan bir ses duydum."


translate turkish day3_evening_sl_7492209c:


    "Ürperdim ama çok korkmadım."


translate turkish day3_evening_sl_c160bc4e:


    th "Sincap ya da başka bir şey olmalı."


translate turkish day3_evening_sl_a710287b:


    th "Yine de gidip kontrol etmeliyim."


translate turkish day3_evening_sl_add052f9:


    "Çalılıklara yaklaştım."


translate turkish day3_evening_sl_f110d6af:


    "Ama şüpheli biri ya da herhangi bir şey bulamadım."


translate turkish day3_evening_sl_869f707c:


    th "Sadece..."


translate turkish day3_evening_sl_bd3b5e0d:


    "Temiz bir vücut ve sakin bir ruh haliyle Liderin kabinine yola koyuldum."


translate turkish day3_evening_sl_1424964a:


    "Olga Dmitrievna uyumuş bile."


translate turkish day3_evening_sl_01ffcfe1:


    "Yatağa üstümü çıkarmadan yatıp battaniyeyi üstüme örttüm."


translate turkish day3_evening_sl_b675339f:


    "Cevapları bulma düşüncelerinin gölgede bırakamadığı çıplak Slavya'yı hatırlayarak uzun süre uyuyamadım."


translate turkish day3_evening_un_dee15e4b:


    "Bir dans daveti daha onurumu tamamen yok edebilir."


translate turkish day3_evening_un_f61e6089:


    "Gitmek için uygun bir bahane düşünmeye başladım ve bunu yapmak için uygun zamanı kolluyordum, ama sonra Lena'yı gördüm. Yavaşça bana doğru geliyordu."


translate turkish day3_evening_un_b9dd006a:


    un "Gitmeli miyiz?"


translate turkish day3_evening_un_25f7abbc:


    me "Nereye?"


translate turkish day3_evening_un_f12b72b3:


    "Düşüncelerime o kadar dalmıştım ki ne demek istediğini anlamadım."


translate turkish day3_evening_un_bf618d8b:


    un "Revire.{w} Ama eğer burada dans etmek istersen..."


translate turkish day3_evening_un_a35ed640:


    "Dans edeceğinden şüpheliydim. Lena bütün gece bir kenarda durmuştu."


translate turkish day3_evening_un_5b6584a0:


    me "Hayır etmem!{w} Hadi gidelim."


translate turkish day3_evening_un_ea985af0:


    th "En azından burada utangaç bir inek gibi durmak zorunda kalmam!"


translate turkish day3_evening_un_329854dd:


    "Cidden kendimi köşede gizlemeye çalışmak hiç de hoş değil."


translate turkish day3_evening_un_c5a5dd23:


    th "Çin dükkanındaki bir boğa bile dans pistinde benden daha çeviktir."


translate turkish day3_evening_un_3db6c6b7:


    "Zaten dans etmek gibi en ufak bir niyetim yoktu."


translate turkish day3_evening_un_68b672da:


    un "Peki, revire gitmeli miyiz?"


translate turkish day3_evening_un_ef4b7608:


    "Lena beni düşüncelerimden alıverdi."


translate turkish day3_evening_un_3b8ef189:


    "Bir süredir kantinin yanında duruyordum."


translate turkish day3_evening_un_95bffd3a:


    me "Evet, elbette... Teşekkürler!"


translate turkish day3_evening_un_2e3d9fb1:


    un "Ne için?"


translate turkish day3_evening_un_f8a6296f:


    "Bana şaşkın bir şekilde baktı."


translate turkish day3_evening_un_177d6e89:


    me "Şey... Beni oradan çıkardığın için..."


translate turkish day3_evening_un_cea5943f:


    "Ona dans etmenin bana göre olmadığını söylememeliydim."


translate turkish day3_evening_un_966aaa9d:


    me "Şey...{w} Bilirsin... Orası çok sıkıcı!"


translate turkish day3_evening_un_fb773468:


    un "Bana dans etmeyi pek sevmiyomuşsun gibi geldi."


translate turkish day3_evening_un_d153fd8d:


    "Dürüstlüğünde en ufak bir alaycılık izi yoktu, çocukçu bir yüz bile."


translate turkish day3_evening_un_5e7d152e:


    "Görünüşe göre anlayamamış gibiydi."


translate turkish day3_evening_un_bae3aca3:


    me "Evet. O kadar sevmiyorum. İlgimi çekmiyor."


translate turkish day3_evening_un_5b72d7bd:


    un "Benimde.{w} Kimse beni dansa davet etmez."


translate turkish day3_evening_un_2f7bb5d6:


    "Lena utandı ve yaptığı gibi yere baktı."


translate turkish day3_evening_un_4cb51946:


    me "Garip."


translate turkish day3_evening_un_940302b3:


    un "Ne garip?"


translate turkish day3_evening_un_f9720baf:


    me "Şey... Kimsenin seni davet etmemesi."


translate turkish day3_evening_un_4429143b:


    un "Sence ederler mi?"


translate turkish day3_evening_un_ca11e47a:


    "Tekrardan şaşkın bir beklenti ile, anlayıştan yoksun bir bakış attı."


translate turkish day3_evening_un_92393659:


    "Kafam karıştı ve karşılığında ne söyleyeceğimi bilemedim."


translate turkish day3_evening_un_34c195e3:


    me "Evet! Kesinlikle!{w} Eğer dans etmeyi sevseydim, seni kesinlikle davet ederdim."


translate turkish day3_evening_un_082d3571:


    un "Teşekkürler..."


translate turkish day3_evening_un_e99c1593:


    "Geri kalan yol boyunca tek bir kelime etmedik."


translate turkish day3_evening_un_542f1cb7:


    "Lena aptalca iltifatımdan dolayı kafası karışmış olduğu belliydi ve bir konuşma başlatmak için hangi konuyu seçeceğimi bilmiyordum."


translate turkish day3_evening_un_c0de7e94:


    "O sırada hava tamamen kararmıştı ve revirin gece sisiyle kaplı kasvetli binası perili bir evi andırıyordu."


translate turkish day3_evening_un_2079dd47:


    "Arkamı dönüp hiçbir ses çıkartmadan uzaklaşmak istedim."


translate turkish day3_evening_un_13fbafd7:


    "Lena'ya hızlıca bir göz attım ve her zamanki gibi göründüğünü fark ettim – utangaç, mütevazi, belirsiz, ama hiçbir şekilde korkmadım."


translate turkish day3_evening_un_6cdc223c:


    "Sadece beni biraz daha rahatsız etti."


translate turkish day3_evening_un_095403d0:


    th "Ben korkarken o korkmuyor olamaz."


translate turkish day3_evening_un_cc26ac1a:


    "Aniden bir baykuş öttü ve korkudan titredim."


translate turkish day3_evening_un_cc73b68c:


    "Lena ya duymamış, ya dikkat etmemiş ya da hiç korkmamış gibi görünüyordu."


translate turkish day3_evening_un_9b14946c:


    "Üçüncü seçeneğe inanmakta güçlük çekiyordum ama ona bunu sorarak kendi korkumu ele vermek istemedim."


translate turkish day3_evening_un_24cab478:


    "Revire girdim ve karanlıkta bir düğme buldum."


translate turkish day3_evening_un_49249630:


    me "Hemşire gelecek mi?"


translate turkish day3_evening_un_404b569f:


    un "Gelmeyecek..."


translate turkish day3_evening_un_e0ce2859:


    th "Tamam gelmeyecek, anladım...{w} Bekle bir saniye...{w} Ne demek gelmeyecek?"


translate turkish day3_evening_un_e1a4709a:


    me "Ah, anlıyorum..."


translate turkish day3_evening_un_5fa11b3d:


    "Lena ile tek başıma kalmaktan korktuğumdan değil.{w} İçeride.{w} Gece.{w} Etrafta kimse yokken..."


translate turkish day3_evening_un_36602009:


    th "Sadece filmlerde böyle durumlarda bir şeyler olur."


translate turkish day3_evening_un_0216a72c:


    "Sadece Lena ile birlikteyim, Ulyana ya da Slavya ile değil."


translate turkish day3_evening_un_83f4508f:


    "Ve bu benim olaylara karşı tutumumu ciddi şekilde değiştirdi."


translate turkish day3_evening_un_9e2d7d99:


    un "Kutular burada."


translate turkish day3_evening_un_923e6e0a:


    "Dağını kutu yığınlarını gösterdi."


translate turkish day3_evening_un_9066f7f1:


    "Onlardan neredeyse bir düzine kadar vardı."


translate turkish day3_evening_un_75fde160:


    "10 dakikalık bir işten daha uzun sürecek."


translate turkish day3_evening_un_3a066bb2:


    "Önümdeki kutulardan birini masanın üzerine koydum ve içindekileri yerleştirmeye başladım."


translate turkish day3_evening_un_30cdf24e:


    "Bandajlar vardı. Fazlasıyla hem de."


translate turkish day3_evening_un_b4c9e1a9:


    un "İşte, al bunu."


translate turkish day3_evening_un_ec9bb664:


    "Lena bana bir kağıt verdi."


translate turkish day3_evening_un_b5daf913:


    "Bazı bölümler vardı ve hemen sol tarafa ismi, eğer varsa ortaya açıklamayı ve sağ tarafa da miktarı yazmam gerektiğini fark ettim."


translate turkish day3_evening_un_50cb3d48:


    th "Veritabanı değil ama iş görür."


translate turkish day3_evening_un_48b8c403:


    "İş tüm hızıyla başladı."


translate turkish day3_evening_un_2b543552:


    un "Semyon..."


translate turkish day3_evening_un_ad02f53a:


    me "Ne?"


translate turkish day3_evening_un_0c8d272a:


    "Lena'ya baktım."


translate turkish day3_evening_un_3500c639:


    "Bir anlığına bana bir şeyler demek için hazırlanıyor gibi durdu, ama sonra bakışını tekrardan düşürdü."


translate turkish day3_evening_un_8da69387:


    un "Yok, yok bir şey."


translate turkish day3_evening_un_9f980148:


    "Benim için hiçbir kelime etmeden durmak çok zor.{w} Ancak ilk konuşmayı yapmaya cesaret edemedim, sadece konuşmak için iyi bir konu bulamadığım için değil, aynı zamanda utangaç hissettiğim için. Bu kız herhangi bir şeyden kolayca utanabilirdi."


translate turkish day3_evening_un_2b543552_1:


    un "Semyon..."


translate turkish day3_evening_un_e79d0fd5:


    me "Evet?"


translate turkish day3_evening_un_dbc3003f:


    un "Onları tekrardan sayıyorsun."


translate turkish day3_evening_un_e1d4a194:


    "Gerçekten de daha önce saydığım bandajları çıkarıp 'veri tabanına' koymaya başlamıştım."


translate turkish day3_evening_un_87731a54:


    me "Oh, üzgünüm."


translate turkish day3_evening_un_d00d3d0f:


    "Cevap vermedi."


translate turkish day3_evening_un_6b863b6b:


    me "Hey. Nerelisin? Demek istediğim, nereden geldin? Yani, nerede doğdun? Demek istediğim, nerede yaşıyorsun?"


translate turkish day3_evening_un_4dbf341d:


    un "Şey, ben...{w} Buradan çok da uzak olmayan bir kasaba var..."


translate turkish day3_evening_un_652ee7d0:


    me "Buradan uzak değil demek. Neresi öyleyse?"


translate turkish day3_evening_un_e807e738:


    un "Bir yerlerde..."


translate turkish day3_evening_un_adc0b8f3:


    "Bunun hakkında konuşmak istemiyor gibi duruyordu."


translate turkish day3_evening_un_270ee4bf:


    th "Lena da mı bir şeyler saklıyor yoksa?"


translate turkish day3_evening_un_1663f57c:


    "Olga Dmitreivna'nın durumunda bu açıklanabilirdi, ama iş Lena'ya gelince..."


translate turkish day3_evening_un_7edc04e0:


    th "Kesinlikle Liderin durumuyla aynı değil."


translate turkish day3_evening_un_4b79f78a:


    me "Bu bir sır mı?"


translate turkish day3_evening_un_f4abdb32:


    un "Hayır...{w} Sadece..."


translate turkish day3_evening_un_8a3717f6:


    me "O zaman.. Güneyde bir yerlerde mi?"


translate turkish day3_evening_un_9857e8f9:


    "Daha orijinal bir şey düşünmeliydim."


translate turkish day3_evening_un_6791c4d1:


    "Her fikrim yanlış yöne sapıyor, ve bu casusluk girişimi daha da kötü sonuçlandı."


translate turkish day3_evening_un_fa0dd942:


    "Ve güneyi düşündüm çünkü Sovyetler Birliği'nin hatırladığım tek öncü kampı 'Artek' idi."


translate turkish day3_evening_un_c81cda2f:


    un "...Evet..."


translate turkish day3_evening_un_e39caf93:


    "Lena yanıt vermekte tereddüt etti."


translate turkish day3_evening_un_45925f2f:


    "Yalan söyleyip söylemediğini söyleyemezdim."


translate turkish day3_evening_un_3dfaf878:


    un "Burayı sevmiyor musun?"


translate turkish day3_evening_un_38d9fd3d:


    th "Acaba dediğim hangi söz ona bunu düşündürmeye itti?"


translate turkish day3_evening_un_8610e699:


    me "Kesinlikle hayır! Burayı seviyorum!"


translate turkish day3_evening_un_f13d454c:


    "Sahte dostluğum kulağa çok samimiyetsiz ve rahatsız edici geliyordu."


translate turkish day3_evening_un_1a377d44:


    me "Peki ya sen?"


translate turkish day3_evening_un_cc213e9d:


    un "Seviyorum.{w} Burası çok sakin, kütüphanede çok fazla kitap var.{w} Ve buranın insanları cömert..."


translate turkish day3_evening_un_a3126422:


    me "İyi... Ama tabii ki hepsi değil..."


translate turkish day3_evening_un_b672514d:


    un "Neden?"


translate turkish day3_evening_un_6cde6e35:


    "Son kısmı gerçekten yüksek sesle mi söyledim?"


translate turkish day3_evening_un_4c03a0c5:


    "Görünüşe göre öyle söylemişim."


translate turkish day3_evening_un_339a1158:


    me "Şey, bilirsin...{w} Ulyana, örneğin. Tamamen dengesiz bir güç uygulama noktasına sahip bir Energizer pili gibidir."


translate turkish day3_evening_un_d39ab564:


    un "Pil mi...{w} Ne?"


translate turkish day3_evening_un_4d8feba6:


    "Belki de gerçekten zamanda geriye yollanmışımdır."


translate turkish day3_evening_un_6421514b:


    me "Boşver."


translate turkish day3_evening_un_a656cdf8:


    me "Ya da Alisa! 'Öncü, çocukların rol modelidir!' sözü kesinlikle onu tanımlamıyor! Eğer herkes onu örnek almaya başlasaydı, yirmi yıl içinde ülke için tam bir felaket olurdu..."


translate turkish day3_evening_un_61114f6a:


    th "Ancak şimdi düşündüğünüzde, 80'lerde herkesin Alisa Dvachevskaya örneğini takip ettiği sonucuna varabilirsiniz, muhtemelen şu anda benim bulunduğum yerde."


translate turkish day3_evening_un_f187db47:


    un "Aslında normalde öyle değil."


translate turkish day3_evening_un_76bd4f62:


    me "'Öyle değil'mi? - Ne gibi değil?"


translate turkish day3_evening_un_0a526940:


    un "Onun hakkında söylediklerin gibi değil."


translate turkish day3_evening_un_61c3831d:


    me "Öncelikle, ben hiçbir şey söylemedim.{w} Ben sadece onun örnek alınacak en iyi kişi olmadığını belirttim."


translate turkish day3_evening_un_21b0641e:


    un "Şey... Sanırım öyle dedin."


translate turkish day3_evening_un_25b8be5c:


    me "Sanırım onu çok iyi tanıyorsun."


translate turkish day3_evening_un_cd1ed0e4:


    un "Muhtemelen."


translate turkish day3_evening_un_2bf6a5e9:


    "Bu soruyu konuşmayı devam ettirmek için söylemiştim ve böyle bir cevap beklemiyordum."


translate turkish day3_evening_un_b3051fc6:


    "Alisa ve Lena çok farklı insanlar. Yakın olabilecekleri fikri bana pek inandırıcı gelmiyor."


translate turkish day3_evening_un_68730dd3:


    un "Aynı kasabadan geldik."


translate turkish day3_evening_un_508a08eb:


    "Sanki zihnimi okumuş gibi."


translate turkish day3_evening_un_2a8c5047:


    un "Alisa bir yaş büyük olmasına rağmen ortak arkadaşlarımız var."


translate turkish day3_evening_un_eaa5b39b:


    me "Tamam. Bu birazcık garip.{w} Öyle değil. Sadece şaşırdım."


translate turkish day3_evening_un_25ed7170:


    un "Herkes şaşırıyor."


translate turkish day3_evening_un_d7a43efd:


    "Lena birazcık gülümsedi."


translate turkish day3_evening_un_0bf46b97:


    "İkinci kutuyu aldım."


translate turkish day3_evening_un_f520e822:


    "Analginum, aktif kömür, Analginum, aktif kömür, tuzlu su çözeltisi, potasyum permanganat, furatsilin, Analginum..."


translate turkish day3_evening_un_88d5fb70:


    "Lena her zaman basit cümleler ile konuşuyor."


translate turkish day3_evening_un_2594eb2e:


    "Her konuşma bir monologa ya da garip bir sessizliğe dönüşürse onunla nasıl iletişim kurabilirim?"


translate turkish day3_evening_un_d0a225ef:


    "Bu durumdan pek memnun değilim."


translate turkish day3_evening_un_69f23bef:


    "Bazen utangaçlık maskesinin ardında bir şeyler saklıyor gibi duruyor.{w} Ama ne?"


translate turkish day3_evening_un_52bebeb3:


    me "Biliyor musun, kısa bir süre önce bir kitap okudum....{w} Bilim kurguyu sever misin?"


translate turkish day3_evening_un_267018a5:


    un "Çok değil."


translate turkish day3_evening_un_eda10b2f:


    th "Lanet olsun. Başka bir başarısızlık."


translate turkish day3_evening_un_41202424:


    me "Eğer hoşuna gitmiyorsa...{w} O zaman hangi kitapları seviyorsun?"


translate turkish day3_evening_un_25828f24:


    un "Farklı türler..."


translate turkish day3_evening_un_c28a338c:


    "Konuşma düzgün gitmiyordu ve daha iyisi için başka konular aramak zorunda kaldım."


translate turkish day3_evening_un_c7228702:


    "Kim bilir neden, ama yine dansı düşündüm."


translate turkish day3_evening_un_7e05f767:


    "Huzursuzluk hissi, rahatsızlık ve hatta utanç beni bir kez daha bunalttı."


translate turkish day3_evening_un_9a396b7b:


    "Görünüşe göre Lena'dan bazı konularda o kadar da farklı değilim. Utangacım ve anlamadığım ya da anlayamadığım şeylerden korkuyorum."


translate turkish day3_evening_un_54d0f688:


    th "Her şeyden önce kendi korkularımın üstesinden gelmeliyim."


translate turkish day3_evening_un_cd4e8ca1:


    th "Ve böylece onu daha iyi anlayabilirim."


translate turkish day3_evening_un_7c4840c7:


    "Aklımı başıma topladım."


translate turkish day3_evening_un_f8fb534c:


    me "Sadece bir kaç tane kutu kaldı..."


translate turkish day3_evening_un_f1be5fed:


    un "Evet."


translate turkish day3_evening_un_e1fb3662:


    me "Hey. Bir fikrim var.{w} Daha sonra kantine gitmeye ne dersin?{w} Sanırım kayıt cihazı oraya alındı."


translate turkish day3_evening_un_9a25521c:


    th "Kantine gitmenin nesi var?"


translate turkish day3_evening_un_3db7cd22:


    "Tereddüt etti."


translate turkish day3_evening_un_41cfffd5:


    un "Ne için?"


translate turkish day3_evening_un_4125d583:


    "Samimi bakışları, ne teklif edeceğim konusunda en ufak bir fikri olmadığını açıkça ortaya koydu."


translate turkish day3_evening_un_1279bc8e:


    me "Şey... Dürüst olacağım, Dans etmeyi bilmiyorum, bu yüzden dans etmeyi sevmiyorum.{w} Bu yüzden orada kafam çok karışıktı."


translate turkish day3_evening_un_054e8b5f:


    me "Belki seninle dans ederek sana teşekkür edebilirim."


translate turkish day3_evening_un_8ebabae6:


    un "Ama ben..."


translate turkish day3_evening_un_7c35a05f:


    "Bir an için ilaçları ayırmayı bıraktı, kızardı ve gözlerimin içine baktı."


translate turkish day3_evening_un_7f15ab29:


    "Biraz inatçı oldum."


translate turkish day3_evening_un_72e48efd:


    th "Gerçekten salakça bir fikir."


translate turkish day3_evening_un_99ad9909:


    me "Eğer istemezsen sorun değil...{w} Israr etmem!"


translate turkish day3_evening_un_d8e58db9:


    un "Ya biri bizi görürse?"


translate turkish day3_evening_un_5226ed1b:


    "Bunu düşünmemiştim."


translate turkish day3_evening_un_9cb1a370:


    "Çok büyük bir sorun değil.{w} Ama..."


translate turkish day3_evening_un_606af4d5:


    me "Herkes uyumuştur bile.{w} Ve kimse geceleri kantine gitmez!"


translate turkish day3_evening_un_3855e2ee:


    un "Oraya nasıl gideceğiz?"


translate turkish day3_evening_un_6e8ce990:


    "Bunu önceden düşünmeliydim."


translate turkish day3_evening_un_962242d8:


    me "Şey..."


translate turkish day3_evening_un_e9f68551:


    "Slavya'nın anahtarları bendeydi. Ama biri yemek çaldığımızı sanmasın diye bunu dile getiremezdim."


translate turkish day3_evening_un_964defe1:


    "O an liderin kabininden cep telefonumu hala almadığım için pişman oldum."


translate turkish day3_evening_un_4ee977cd:


    "Olga Dmitrievna o zaman benimle konuştu ve ben onu unuttum."


translate turkish day3_evening_un_6f016ce7:


    "Her neyse, bu saçma konudan kurtulam için bir şey bulmam lazım."


translate turkish day3_evening_un_7e3db1d5:


    me "Ehh, ne tür müzik dinlersin?"


translate turkish day3_evening_un_9c66e26a:


    un "Farklı...{w} Pek ilgimi çekmiyor."


translate turkish day3_evening_un_f8be0238:


    me "O zaman şimdi çaldığını hayal edelim...{w} Demek istediğim... çaldığını varsayalım."


translate turkish day3_evening_un_52f34a61:


    un "Nasıl yani?"


translate turkish day3_evening_un_0c4b535c:


    me "Zihninin içinde çalıyor gibi!"


translate turkish day3_evening_un_43e2549c:


    "Öncüler dans ederkenki melodi hala aklımda.{w} Müzik ve sözler hafızamda çok netti."


translate turkish day3_evening_un_db88fd32:


    un "Yapabileceğimden emin değilim."


translate turkish day3_evening_un_7b5327be:


    me "Deneyebilirsin ama."


translate turkish day3_evening_un_3c68ea6c:


    un "Muhtemelen..."


translate turkish day3_evening_un_04cfc77c:


    "İznini aldım!"


translate turkish day3_evening_un_7ddfa955:


    "Lena'nın durumunda, bu 'muhtemelen' bile 'evet' olarak değerlendirilebilir."


translate turkish day3_evening_un_a20cefa7:


    "..."


translate turkish day3_evening_un_067ecc79:


    "Geri kalan zamanda ilaçları yerlerine dizdik ve miktarlarını ve isimlerini yazdık."


translate turkish day3_evening_un_f7242642:


    "Böyle bir şanstan sonra söylediğim her kelimeye daha fazla dikkat etmeliyim."


translate turkish day3_evening_un_3c9b2687:


    "Geri kalan zamanın çoğunda sessiz kaldım."


translate turkish day3_evening_un_72af65bb:


    "Sonunda son kutudaki ilaçları da dizdik."


translate turkish day3_evening_un_5b5ee5ef:


    "Lena'ya listeyi verdim ve ona bakmaya başladım, Sanki domuz yavrularıyla hokkabazlık yaparken tek tekerlekli bisiklete binen koca ayak görmüş gibi.{w} Şaşırtıcı, korkutucu ve hepsinden önemlisi büyüleyiciydi."


translate turkish day3_evening_un_2342bdd6:


    "Aniden kahkahayı patlattı."


translate turkish day3_evening_un_3d342d5a:


    me "Ne?!"


translate turkish day3_evening_un_6f2b6d18:


    un "Görünüşün..."


translate turkish day3_evening_un_094d6b91:


    me "Ne olmuş görünüşüme?"


translate turkish day3_evening_un_d460b3a8:


    un "Komik."


translate turkish day3_evening_un_f90f07e5:


    me "Gerçekten mi...?"


translate turkish day3_evening_un_791682db:


    un "Evet öyle. Şimdi nereye gidiyoruz?"


translate turkish day3_evening_un_25f7abbc_1:


    me "Nereye mi?"


translate turkish day3_evening_un_530d77f3:


    "Son sözleri beni huzursuz etmişti. Bu yüzden hakkında konuştuğumuzu unutmuştum."


translate turkish day3_evening_un_9ac6ce51:


    "Dürüst konuşacağım, bir an için bu dünyayı tamamen terk ettim."


translate turkish day3_evening_un_3d8fbc00:


    un "Şey, bilirsin...{w} Dans."


translate turkish day3_evening_un_48e08966:


    "Lena hemen kızardı ve yüzü utangaçlık, tedirginlik ve korkudan oluşan garip bir ifadeye büründü."


translate turkish day3_evening_un_558e6a65:


    me "Ah, evet! üzgünüm, sadece düşüncelerimde kayboldum.{w} Hadi iskeleye gidelim."


translate turkish day3_evening_un_38967a03:


    "Neden bilmiyorum ama iskeleyi seçtim."


translate turkish day3_evening_un_c980d140:


    "Belki de meydanda, yerleşim bölgesinde ya da kantinin yakınında bir öncüye rastlayabileceğiniz ama iskelede rastlayamayacağınız içindir.{w} En azından düşündüğüm buydu."


translate turkish day3_evening_un_cd9d64c3:


    "Ya da belki de büyük ve parlak ay ışığının gecede suyun üzerinde yansıdığı içindir."


translate turkish day3_evening_un_5626210f:


    "Ve bugün dolunay."


translate turkish day3_evening_un_7a658aae:


    "Nasıl oldu bilmiyorum ama bu çözüm kendiliğinden ortaya çıktı."


translate turkish day3_evening_un_c8879bbd:


    me "Eğer beğenmediysen, o zaman..."


translate turkish day3_evening_un_ac6b93bc:


    un "Hayır. Orası gerçekten çok güzel bir yer."


translate turkish day3_evening_un_0899349d:


    "Lena kapıyı kilitledi ve iskeleye doğru yola koyulduk."


translate turkish day3_evening_un_2baf966e:


    "Gece uyuyan kampın üzerine çöktü."


translate turkish day3_evening_un_9380078a:


    un "Patikayı takip etmeli miyiz?"


translate turkish day3_evening_un_22b1f5c5:


    me "Neden? Ormandan daha hızlı olur. Oraya giden güzel bir yol var."


translate turkish day3_evening_un_2745ec45:


    un "Pekala. Orada şey olabilir..."


translate turkish day3_evening_un_c8d94649:


    me "Kim? Bir baykuş mu?"


translate turkish day3_evening_un_60bde9d8:


    "Güldüm."


translate turkish day3_evening_un_7b76c769:


    un "Oh, sen..."


translate turkish day3_evening_un_fa1386f8:


    "Yüzünde bir hoşnutsuzluk gölgesi belirdi."


translate turkish day3_evening_un_b2a637c4:


    me "Boş ver. Özür dilerim!"


translate turkish day3_evening_un_68893216:


    un "Burası gerçekten karanlık."


translate turkish day3_evening_un_413580ee:


    me "Korkuyor musun?"


translate turkish day3_evening_un_9c33c3aa:


    un "Çok değil..."


translate turkish day3_evening_un_732bddc6:


    me "Eğer istersen..."


translate turkish day3_evening_un_a798f094:


    un "Tamam...{w} Ben sadece...?"


translate turkish day3_evening_un_44ced226:


    "Cümlesini bitirmeden kolumu tuttu."


translate turkish day3_evening_un_17ef55d6:


    un "Senin için sorun olur mu?"


translate turkish day3_evening_un_006ab8be:


    "Şimdi kızarma sırası bana gelmişti."


translate turkish day3_evening_un_771aa502:


    me "Elbette!"


translate turkish day3_evening_un_c41c7779:


    "Orman boyunca yürüdük."


translate turkish day3_evening_un_90e23667:


    "Yine de orman sayılmazdı.{w} Daha çok kampla iskele arasında küçük bir koruluk gibi."


translate turkish day3_evening_un_8ba91e28:


    "Neredeyse bir 100 metre uzunluğunda."


translate turkish day3_evening_un_e7d25333:


    "Tek başıma olsam bile korkacak bir şey olacağını asla düşünmezdim."


translate turkish day3_evening_un_b12f537c:


    "Ama Lena'nın korkusu bulaşıcıymış gibi görünüyordu."


translate turkish day3_evening_un_cd8be3f9:


    "Dallar üzerimizde sallanıyordu.{w} Ürperdim ve Lena koluma daha da sıkı sarıldı."


translate turkish day3_evening_un_4a492d8c:


    me "Korkma. Sincap olmalı."


translate turkish day3_evening_un_0905212f:


    un "Evet..."


translate turkish day3_evening_un_51f323e1:


    "İskeleye ulaştık.{w} Gece çok güzeldi."


translate turkish day3_evening_un_52acfaa6:


    "Nehire yaklaştım ve Lena'ya seslendim ."


translate turkish day3_evening_un_6bf1e9fc:


    me "Bak!"


translate turkish day3_evening_un_5732579f:


    "İskele, kayıkhane ve ay suda yansıyordu."


translate turkish day3_evening_un_4de4a131:


    "Suyun yüzeyi Harikalar Diyarı'na açılan bir kapı olarak başka bir dünyaya benziyordu.{w} Sadece atlayabilir ve kendinizi diğer tarafta bulabilirsiniz."


translate turkish day3_evening_un_983cba26:


    me "Bu dansı bana lütfeder misiniz?"


translate turkish day3_evening_un_cc87c2d0:


    "Ona elimi uzattım ve beceriksizce eğildim."


translate turkish day3_evening_un_36d02627:


    "Lena tereddüt etti.{w} Tavırlarımda aşırıya kaçmış olmalıyım."


translate turkish day3_evening_un_d77a4476:


    me "Korkacak bir şey yok, ben de iyi değilimdir."


translate turkish day3_evening_un_981f5474:


    th "Neden 'ben de'?{w} Dans edemediğini hiç söylemedi, gerçi bu çok açıktı."


translate turkish day3_evening_un_b993fafe:


    un "Tamam."


translate turkish day3_evening_un_d32a46e3:


    "Lena bana elini uzattı, onu biraz kenara çektim ve kollarımı nazikçe beline doladım."


translate turkish day3_evening_un_2c69e0e2:


    "Birkaç dakika öylece durduk."


translate turkish day3_evening_un_6cb44a45:


    un "Sırada ne var?"


translate turkish day3_evening_un_bdc4a7dc:


    me "Şey. Bilmiyorum...{w} Şarkıyı hatırlıyor musun?"


translate turkish day3_evening_un_38866932:


    un "Zar zor...{w} Ama hatırlıyorum."


translate turkish day3_evening_un_cdeaa5d1:


    me "Harika! Filmlerdeki gibi vals yapalım."


translate turkish day3_evening_un_e0124613:


    un "Nasıl yani?"


translate turkish day3_evening_un_dd7ae836:


    "Ona cevap vermek yerine Lena ile birlikte dikkatlice bir daire çizmeye başladım."


translate turkish day3_evening_un_2d6366e8:


    me "Gördün mü. O kadar da zor değil!"


translate turkish day3_evening_un_a35af87c:


    un "Evet..."


translate turkish day3_evening_un_480cbce8:


    "Birkaç dakika vals ettik."


translate turkish day3_evening_un_0e0749ce:


    "Ya da ne derseniz deyin."


translate turkish day3_evening_un_16ce780a:


    "O kadar da yakın olmamamıza rağmen sıcak hissettim."


translate turkish day3_evening_un_3ff4b37b:


    "Göğsü ağır bir şekilde sallandı ve yüzü giderek daha fazla kızarmaya başladı."


translate turkish day3_evening_un_2c5d4171:


    "Lena bana bakmadı, gözlerini bir o yana bir bu yana çevirdi."


translate turkish day3_evening_un_fdcc8c70:


    "Aniden hiçbir zaman böyle bir şey hissetmediğimi hatırladım."


translate turkish day3_evening_un_70d5f90d:


    "Gerçekliği aşan bir şefkatti, kendimi başka bir dünyada, daha iyi bir dünyada bulmuşum gibi."


translate turkish day3_evening_un_2d5d1563:


    "Bu kızın gitmesine izin vermek istemediğimi ve onunla sonsuza kadar vals yapmak için her şeyden vazgeçebileceğimi fark ettim."


translate turkish day3_evening_un_b3998185:


    "Lena'ya daha sıkı sarıldım ve ancak o zaman doğrudan bana baktı."


translate turkish day3_evening_un_ef0ec8a2:


    "Bakışlarında şaşkınlık ve kafa karışıklığı vardı ama hiç korku yoktu."


translate turkish day3_evening_un_5c5e383c:


    "Benden korkmadı ve beni uzaklaştırmadı."


translate turkish day3_evening_un_cc8b4535:


    un "Dans edemediğini söylemiştin."


translate turkish day3_evening_un_1ec032b9:


    me "Gerçekten edemiyorum..."


translate turkish day3_evening_un_615f491b:


    "Kafam karışmıştı."


translate turkish day3_evening_un_20470c50:


    "Bu tepkiyi ondan beklemiyordum."


translate turkish day3_evening_un_9dc68533:


    "Kafa karışıklığı, utangaçlığı ve korkusu nereye kayboldu?"


translate turkish day3_evening_un_48c7652f:


    me "Sen de... Çok iyi dans ediyorsun..."


translate turkish day3_evening_un_466707e6:


    un "Biliyorum!"


translate turkish day3_evening_un_f8ce941d:


    "Yüzünde şakacı bir gülümseme belirdi."


translate turkish day3_evening_un_ea63114f:


    "Ya da bana mı öyle geldi?"


translate turkish day3_evening_un_3e1fa0d9:


    "Hayır, yemin ederim ki öyleydi."


translate turkish day3_evening_un_160309c6:


    th "Bu nasıl mümkün olabilir?"


translate turkish day3_evening_un_d8f01710:


    "Lena'nın utangaç ve mütevazi tavırları bu an ile hiçbir değildi."


translate turkish day3_evening_un_d941a3d5:


    th "Ne demeliyim?{w} Bundan sonra ne yapmalıyım?"


translate turkish day3_evening_un_93db6486:


    "Her geçen dakika daha da garipleşen bu dansta onunla sadece vals yapmaya devam edebilirdim."


translate turkish day3_evening_un_c81d9d23:


    mt "Semyon! Semyon, neredesin?"


translate turkish day3_evening_un_438b28d5:


    "Ses ormandan gelmişti."


translate turkish day3_evening_un_e5902723:


    th "Lanet olsun, olabilecek en kötü zamanlama!"


translate turkish day3_evening_un_105fc865:


    mt "Semyon!"


translate turkish day3_evening_un_980eb22f:


    "Olga Dmitrievna'ydı.{w} Uzun zamandır görünürde olmadığımdan endişelenmiş olmalı."


translate turkish day3_evening_un_22027067:


    "Yorulmak nedir bilmeyen bir kamp liderinin {i}kayıp{/i} bir öncüyü aramak isteyeceğini düşünmeliydim!"


translate turkish day3_evening_un_d26f19fa:


    th "Ona önceden revir'e gideceğimi söylemeliydim."


translate turkish day3_evening_un_f5e453bf:


    th "Şimdi bunu düşünmenin bir anlamı yok."


translate turkish day3_evening_un_74229088:


    "Lena bana sorgulayıcı bir şekilde baktı."


translate turkish day3_evening_un_42de22f4:


    un "Beraber görünmemiz hiç iyi olmaz."


translate turkish day3_evening_un_f14f0728:


    me "Neden?{w} Hadi gidip ona her şeyin yolunda olduğunu söyleyelim."


translate turkish day3_evening_un_211c6e09:


    un "Hayır. Saklanıp sonradan kampa geri dönelim."


translate turkish day3_evening_un_93c1d6e9:


    th "Fikri garipti.{w} Her şey yolunda gidiyordu oysaki..."


translate turkish day3_evening_un_5e1c6dc6:


    th "En azından bir şeyler yolunda gitmeye başlamıştı.{w} Ya da bana öyle görünüyordu."


translate turkish day3_evening_un_04f3f218:


    th "Ama neydi o {i}bir şey{/i}?"


translate turkish day3_evening_un_c5b4a9e1:


    me "Tamam o zaman."


translate turkish day3_evening_un_83831235:


    "Tartışmamaya karar verdim, böyle bir durumda uygun değildi."


translate turkish day3_evening_un_e073d1d4:


    "Olga Dmitrievna bir süre boyunca seslendi ve gitti."


translate turkish day3_evening_un_2308a96f:


    un "Hadi gidelim."


translate turkish day3_evening_un_9513cd87:


    me "Evet..."


translate turkish day3_evening_un_63803f24:


    "Lena geri dönerken kolumu tutmadı."


translate turkish day3_evening_un_a604adb5:


    "Biraz hayal kırıklığına uğramıştım ama ilk adımı atacak kadar emin değildim."


translate turkish day3_evening_un_31cc1eca:


    "Yine sessiz kaldık. Konuşmaya başlamak Lena'ya özgü bir şey değildi ve ben de iskelede olanlardan sonra ne diyeceğimi bilemiyordum."


translate turkish day3_evening_un_89f67cb6:


    "Dönüş yolu boyunca yere bakmaya devam etti ve 'her zamanki' ifadesini korudu."


translate turkish day3_evening_un_985381f5:


    "Ne tuhaf bir değişiklik!"


translate turkish day3_evening_un_46255706:


    "Daha doğrusu tuhaf olan iskeledeki o gülümseme ve Lena'nın sözleriydi."


translate turkish day3_evening_un_a20cefa7_1:


    "..."


translate turkish day3_evening_un_4f71cd7e:


    "Meydanda durdu."


translate turkish day3_evening_un_ccdf7460:


    un "Gitmem gerek."


translate turkish day3_evening_un_9513cd87_1:


    me "Tamam..."


translate turkish day3_evening_un_375d8a14:


    un "Teşekkürler... bugün için..."


translate turkish day3_evening_un_9513cd87_2:


    me "Evet..."


translate turkish day3_evening_un_26a8bbab:


    "Lena arkasını dönüp kulübesine yöneldi ve ben olduğum yerde durmaya devam ettim."


translate turkish day3_evening_un_59d28a2d:


    th "Bu da neydi böyle?"


translate turkish day3_evening_un_8e35b95f:


    th "Dans, ruh halindeki ani değişim ve her şeyin bir anda normale dönmesi."


translate turkish day3_evening_un_a2d69018:


    "O kısacık anda sanki başka bir Lena'yı kucaklıyor gibiydim."


translate turkish day3_evening_un_a5692cd4:


    "Bu doğru! Kendinde değildi. Tamamen farklı biri gibi görünüyordu."


translate turkish day3_evening_un_c579109c:


    th "Belki onu yeterince iyi bilmiyorumdur?"


translate turkish day3_evening_un_92dafc98:


    "Daha önce Lena'nın utangaçlık maskesinin altında bir şeyler sakladığını hissetmiştim."


translate turkish day3_evening_un_79930909:


    "Birini anlamak iki günden çok daha uzun sürer."


translate turkish day3_evening_un_c154d46b:


    th "Lanet olsun! Ne yapmalıyım?!{w} Belki de sadece bir şeyler görüyordum!"


translate turkish day3_evening_un_a20cefa7_2:


    "..."


translate turkish day3_evening_un_f4822807:


    "Liderin kabinine doğru yola koyuldum."


translate turkish day3_evening_un_cec9d8ef:


    "Tüm kamp uykudaydı, bu yüzden beni görecek kimse yoktu."


translate turkish day3_evening_un_dd369d3a:


    th "Ne olmuş yani? Bir öncünün gece yürüyüşe çıkmasının nesi yanlış!?"


translate turkish day3_evening_un_35589041:


    "Neredeyse kapıya varmıştım ki arkamdan bir ses duydum."


translate turkish day3_evening_un_c6f6cc81:


    "Ağaçların yakınındaki çalılıkların dalları, sanki orada biri hareket etmiş gibi hışırdadı."


translate turkish day3_evening_un_3bc47b84:


    th "Buralarda vahşi hayvan olmaması lazım."


translate turkish day3_evening_un_2bdac6ec:


    th "Birisi beni izliyor olmalı!"


translate turkish day3_evening_un_8591c155:


    "O anda kendimi sesin kaynağına doğru gidip çalılıkların arkasına bakmaya zorladım."


translate turkish day3_evening_un_258661a5:


    "Çok karanlıktı. Bu yüzden hiçbir şey göremiyordum"


translate turkish day3_evening_un_d49de170:


    "Daha da ilerlemenin bir anlamı yok. Zaten biri izliyorsa şuana kadar gitmiş olmalı."


translate turkish day3_evening_un_f54ea053:


    "Kabine geri döndüm."


translate turkish day3_evening_un_76db5439:


    "Işık açıktı."


translate turkish day3_evening_un_d336a541:


    th "Görünüşe göre hala uyanık."


translate turkish day3_evening_un_37715fc9:


    mt "Semyon! Nerelerdeydin?!"


translate turkish day3_evening_un_72311896:


    me "Ne demek 'nerede'?{w} Ben ve Lena revirde ilaçları diziyorduk. Bunu akşam yapacağımı daha önce söylemiştim."


translate turkish day3_evening_un_d858aa01:


    mt "Gerçekten mi? Ne zaman oldu bu? Yeterince uzun sürdü! Yarım saat önce revirdeydim, ışıkları kapalıydı!"


translate turkish day3_evening_un_8125eef3:


    me "Şey... Ahem... Küçük bir yürüyüşe çıkmaya karar verdik."


translate turkish day3_evening_un_a91b818e:


    mt "Sen dışarıda yürüyüş yaparken ben senin için endişeleniyorum!"


translate turkish day3_evening_un_a81f88a1:


    me "Şey, üzgünüm...{w} Bir dahaki sefere seni haberdar ederim."


translate turkish day3_evening_un_140addaa:


    mt "Lütfen et!{w} Şimdi yatağa git, geç oldu!"


translate turkish day3_evening_un_254cc408:


    "Ona katılmamak elde değil."


translate turkish day3_evening_un_f2607f9a:


    th "Bugün gerçekten zor bir gündü."


translate turkish day3_evening_un_89fdb957:


    "Akşamki olayları düşünemeyecek kadar yorgundum ve doğru dürüst bir şey düşünebileceğimden bile şüpheliydim..."


translate turkish day3_evening_un_95c84c3a:


    th "Asıl mesele şu ki, tüm bunlara nasıl tepki vereceğime dair tek bir fikrim bile yok."


translate turkish day3_evening_un_d0119574:


    th "Lena'ya, kampa, tüm bu dünyaya."


translate turkish day3_evening_un_d12034ba:


    "Cevapları aramak için 1 dakika bile ayırmadım.{w} Dahası, sanki olası bir keşif beni korkutuyormuş gibi bundan kaçınıyordum."


translate turkish day3_evening_un_5db7cdc5:


    "Ve Lena...{w} Onunla geçirdiğim her an {i}gerçek{/i} dünyaya gitme denemelerimden daha önemliydi."


translate turkish day3_evening_un_9e50ec2f:


    "Neyi yanlış yaptığımı ve neyi hiç yapmadığımı anlamaya çalışarak uzun süre kendimi endişelendirebilirdim, ama yorgunluk beni yendi..."


translate turkish day3_evening_us_8e722b79:


    "Slavya gitti."


translate turkish day3_evening_us_1a407541:


    "Benim için yaptığı onca şeyden sonra onu reddetmemeliydim belki, ama ben bu tür faaliyetler için yaratılmamıştım."


translate turkish day3_evening_us_324a06ef:


    "Öncüler dans etmeye devam etti."


translate turkish day3_evening_us_d21cca78:


    th "En azından balayından keyif alıyor gibilerdi."


translate turkish day3_evening_us_ea24578a:


    "Olga Dmitrievna'da dans etti."


translate turkish day3_evening_us_ea82e2f0:


    "Bunun gerçekten uygun olmadığını düşünüyorum.{w} Lider etrafta düzeni sağlamak zorundadır."


translate turkish day3_evening_us_78fb937a:


    th "Özellikle de 17 yaşında olmadığı için."


translate turkish day3_evening_us_f2be2b10:


    "Olga Dmitrievna, sanki birilerinin onun profesyonelliğinden şüphe ettiğini hissetmiş gibi yanıma geldi."


translate turkish day3_evening_us_0f6bc7b5:


    mt "Neden dans etmiyorsun?"


translate turkish day3_evening_us_8717f26e:


    me "İstemiyorum..."


translate turkish day3_evening_us_b0e280b5:


    mt "Sen bilirsin."


translate turkish day3_evening_us_945c59bc:


    "Kurnazca gülümsedi."


translate turkish day3_evening_us_31a7a515:


    mt "O zaman senin için mükemmel bir görevim var!"


translate turkish day3_evening_us_e473fa2f:


    me "Bir görev, hangisi...?"


translate turkish day3_evening_us_a1f730b2:


    "Başka herhangi bir aktivite dans etmekten daha iyiydi."


translate turkish day3_evening_us_bc92d844:


    mt "Kantini bugün güzel temizledin ama...{w} Bence borcunu ödemedin."


translate turkish day3_evening_us_8941bd9d:


    me "Ahhh?"


translate turkish day3_evening_us_8403b986:


    mt "Ulyana!"


translate turkish day3_evening_us_123f5418:


    us "Ne?!"


translate turkish day3_evening_us_7f1e0dc0:


    mt "Gel buraya."


translate turkish day3_evening_us_86cbd5c6:


    "Ulyana isteksizce yanımıza geldi."


translate turkish day3_evening_us_1e9714fe:


    mt "Gördüğüm kadarıyla uzun bir süre boyunca yeterince dans ettin."


translate turkish day3_evening_us_6c304510:


    us "Hayır, etmedim!"


translate turkish day3_evening_us_eb9a46a9:


    "Aynı bir domuz gibi terliyordu, yani lider haklı gibiydi."


translate turkish day3_evening_us_9a131f0d:


    mt "Sen ve Semyon için bir görevim var."


translate turkish day3_evening_us_4b8e25e2:


    us "Ama Olga Dmitrievna...!"


translate turkish day3_evening_us_4aca71e6:


    "Ulyana yalvardı."


translate turkish day3_evening_us_c588b18c:


    us "Şimdi dans vakti! Ve geç oldu!"


translate turkish day3_evening_us_63ea0fa5:


    mt "Fazla zaman almaz.{w} Slavya kütüphanedeki kitapları diziyordu ama henüz bitirmemişti..."


translate turkish day3_evening_us_c4a407cc:


    mt "Bir kaç tane raf kaldı."


translate turkish day3_evening_us_e566dcaf:


    us "Ama..."


translate turkish day3_evening_us_c2f28fc6:


    mt "Aması yok!"


translate turkish day3_evening_us_888f7373:


    th "Tanrı aşkına."


translate turkish day3_evening_us_8b0f570d:


    "İş yapmayı sevmem, ama dans..."


translate turkish day3_evening_us_7f594afe:


    me "Ben hazırım!"


translate turkish day3_evening_us_d0e475bd:


    mt "İyi iş, Semyon! İşte benim oğlum! Gerçek bir öncü! Onu örnek olarak almalısın Ulyana!"


translate turkish day3_evening_us_8378599b:


    "Yine de Ulyana böyle bir örnekten hoşlanmadı."


translate turkish day3_evening_us_88adb859:


    mt "Yap o zaman! Bütün kamp sana güveniyor!"


translate turkish day3_evening_us_d172a747:


    us "Bunu unutmayacağım."


translate turkish day3_evening_us_86a7768d:


    "Tısladı."


translate turkish day3_evening_us_7cf397bf:


    "Akşamları kamp gerçekten güzel.{w} Sessizlik ve huzur beni sakinleştiriyor."


translate turkish day3_evening_us_b69e6c0f:


    "Sadece meydandan gelen uzak müzik sesi burada yalnız olmadığımı hatırlattı."


translate turkish day3_evening_us_38d5d35e:


    "Ve Ulyana da yeni geldi."


translate turkish day3_evening_us_79dbaa1d:


    me "Temizliği elbisenle yapabilirsin."


translate turkish day3_evening_us_a026df63:


    "Sırıttı."


translate turkish day3_evening_us_fb48ad0c:


    us "Hepsi senin suçun!"


translate turkish day3_evening_us_74af0838:


    "Ağır bir şekilde nefes aldı ve yüzü domates gibi kızardı. O kadar kızardı ki kulaklarından buhar çıksa şaşırmazdım."


translate turkish day3_evening_us_0ab904a2:


    us "Sen! Hepsi senin!{w} Senin! Suçun!"


translate turkish day3_evening_us_6a9fa49b:


    me "Neden ben?"


translate turkish day3_evening_us_0f170283:


    us "Sessiz kalsaydın bunlar olmazdı!"


translate turkish day3_evening_us_21221d76:


    me "Ne değişirdi?{w} Her türlü bize işi kitleyecekti."


translate turkish day3_evening_us_5a606f08:


    us "Sen..."


translate turkish day3_evening_us_a2d9c3e3:


    "Normal bir şekilde konuşamıyordu ve sadece tıslıyordu."


translate turkish day3_evening_us_5bbc2e7c:


    me "Peki ya sessiz kalsaydım ne olurdu?{w} Eğlenmene izin vereceğini düşünüyor musun?"


translate turkish day3_evening_us_c1625886:


    "Ulyana bana baktı."


translate turkish day3_evening_us_49ae3aab:


    "Bir tık rahatlamış gibi duruyordu."


translate turkish day3_evening_us_8fa6a151:


    us "Gerçekten mi? Hiç umurunda değil!{w} Dans bile etmeyi blimiyorsun!"


translate turkish day3_evening_us_9574dd57:


    me "Yapamıyorsam ne olmuş?"


translate turkish day3_evening_us_05b51e5d:


    us "Eğer benle dans etseydin...{w} Eğlenceli olurdu!"


translate turkish day3_evening_us_f51acc4b:


    "Yine o 'çocuksu' moduna geri döndü."


translate turkish day3_evening_us_b3acf935:


    me "Belki de...{w} Ama olayların nasıl geliştiğini görüyorsun."


translate turkish day3_evening_us_1d9ef291:


    "Kimin daha iyi bir dansçı olduğunu göremedik bile."


translate turkish day3_evening_us_90a2bbc6:


    "Kütüphaneye yakınlaştık. Dışarısı kararmıştı bile."


translate turkish day3_evening_us_f49d96cb:


    "Olga Dmitrievna'nın kitapları gece dizme isteği...{w} ya da daha çok emri...{w} beni biraz şaşırttı."


translate turkish day3_evening_us_bc244cfb:


    th "Bu çok tuhaf."


translate turkish day3_evening_us_a7e2aa20:


    "İçeride ışık yanmıyordu ve düğmeye basmama rağmen ışık yanmıyordu."


translate turkish day3_evening_us_d3f5e62a:


    "Aslında düzgün çalışıyor olabilirdi ama ışıklar yanmıyordu."


translate turkish day3_evening_us_f09b37ef:


    us "Bekle, Mum alıp geleceğim."


translate turkish day3_evening_us_681ab9c1:


    "Tam mumların ve kibritlerin yerini nereden bildiğini soracaktım ki yanımdaki masada iki küçük ışık belirdi."


translate turkish day3_evening_us_7827470a:


    us "Daha iyi!"


translate turkish day3_evening_us_574bbbd5:


    "Ulyana kendinden memnun bir şekilde konuştu."


translate turkish day3_evening_us_3f38f9a0:


    me "Sırada ne var?"


translate turkish day3_evening_us_fbf7b967:


    us "Sırada ne var derken?"


translate turkish day3_evening_us_c349ed5f:


    "Bana sorgulayıcı bir şekilde baktı."


translate turkish day3_evening_us_050fe076:


    me "Ne yapacağız?"


translate turkish day3_evening_us_8232daec:


    us "Pff, nasıl bilebilirim?"


translate turkish day3_evening_us_393056bc:


    "Kıkırdadı."


translate turkish day3_evening_us_b57abe01:


    me "Harika."


translate turkish day3_evening_us_6046a48f:


    "Raflar arasında yürüdüm."


translate turkish day3_evening_us_a5101d38:


    th "Olga Dmitrievna 'birkaç raf' hakkında bir şeyler söylemişti."


translate turkish day3_evening_us_0e2a5ebd:


    "Kitaplara dokunup üzerlerinde toz olmadığından emin oldum."


translate turkish day3_evening_us_f637ef9a:


    "Görünüşe göre birileri bizden önce iyi iş çıkarmış."


translate turkish day3_evening_us_d054667b:


    "Tüm kütüphaneyi inceledikten sonra temizlenecek bir şey bulamadım. Lider bir hata yapmış olmalı."


translate turkish day3_evening_us_eb36cc9f:


    "Aniden arkamdan ayak sesleri duydum."


translate turkish day3_evening_us_cca19138:


    "Eski, çatlak zemin gıcırdıyordu, bu yüzden Ulyana fark edilmeden bana gizlice yaklaşamadı."


translate turkish day3_evening_us_08ef6f67:


    us "Boo!"


translate turkish day3_evening_us_468f92d5:


    "Arkamı döndüm."


translate turkish day3_evening_us_9e09f5fa:


    me "Aman tanrım, çok korktum, lütfen..."


translate turkish day3_evening_us_80eb9adc:


    us "Ah, her neyse!"


translate turkish day3_evening_us_e2993c31:


    "Kızgınlıkla arkasını döndü."


translate turkish day3_evening_us_4ab03e66:


    me "Burası çok temiz görünüyor, o yüzden..."


translate turkish day3_evening_us_c1661c00:


    "Loş ışıklı kitap sıraları bana sitemle baktı."


translate turkish day3_evening_us_4c1d899a:


    "Unutulmuş yıllardan bilinmeyen yazarlar."


translate turkish day3_evening_us_51f94d8f:


    th "Onları hatırlayan var mı acaba?{w} Zhenya hatırlıyor olmalı."


translate turkish day3_evening_us_b78d5ef3:


    "Eminim ki her şeyi hatırlıyordur."


translate turkish day3_evening_us_fce45449:


    us "Tamam. Otur."


translate turkish day3_evening_us_dc9d3ef6:


    "Sandalyeyi yanıma çekti.{w} Üstüne oturuyorum."


translate turkish day3_evening_us_fecfa4ed:


    me "Peki, sırada ne var?"


translate turkish day3_evening_us_5d9c94b9:


    us "Hadi birbirimize korkunç hikayeler anlatalım.{w} İki sandalye ve mumumuz var, bu yüzden iki tane hikaye olacak, birini sen anlatacaksın birini ben."


translate turkish day3_evening_us_cd917d11:


    me "Tamam."


translate turkish day3_evening_us_0e57cf1c:


    "Düşünmeden kabul ettim."


translate turkish day3_evening_us_c76d5efb:


    "Dansa geri dönmek gibi en ufak bir niyetim yoktu ve deneyimlerime göre geceleri kampta yapacak hiçbir şey yoktu."


translate turkish day3_evening_us_1da6e1e4:


    "Özellikle de Ulyana'yı gerçekten korkutabilecek birkaç güzel hikâye bildiğim için."


translate turkish day3_evening_us_a38cf680:


    "Ve bu mükemmel."


translate turkish day3_evening_us_959cb1f4:


    me "İlk sen."


translate turkish day3_evening_us_1549669b:


    us "Tamam."


translate turkish day3_evening_us_906544fe:


    "Kendini iyice rahatlatıp kollarıyla sandalyenin arkalığına sarıldı ve mumu yüzüne olabildiğince yaklaştırdı."


translate turkish day3_evening_us_517ac6ae:



    nvl clear
    "{i}Bir zamanlar, çok uzaklarda bir köyde bir çocuk yaşarmış. Sıradan bir çocukmuş. Okula gider, diğer çocuklarla oynarmış. Onunla ilgili özel bir şey yokmuş.{/i}"


translate turkish day3_evening_us_e153dd08:


    "{i}Bir gün arkadaşıyla terk edilmiş eve gitmekten korkmayacağına dair iddiaya girmiş...{/i}"


translate turkish day3_evening_us_82b72ef3:


    "Ulyana uzun bir ara verdi."


translate turkish day3_evening_us_4d3eecb3:


    me "Peki, o evde ne vardı?"


translate turkish day3_evening_us_cd35d04d:


    us "Sözümü kesme!"


translate turkish day3_evening_us_4d2c229a:


    me "Kafandan mı yazıyorsun"


translate turkish day3_evening_us_39cf5c52:


    "Dudaklarını büzdü ve devam etti."


translate turkish day3_evening_us_f5578357:


    "{i}O evde bir cadının yaşadığını ve insanların geceleri hala onun hayaletini gördüğünü söylüyorlar. Kimse kesin olarak bilmiyordu ama herkes korkuyordu.{/i}"


translate turkish day3_evening_us_f3da10f9:


    "{i}Çocuk tüm bunların saçmalık olduğunu ve bütün bir geceyi orada geçirmeye hazır olduğunu söylemişti. Öyle de yaptı. Ama sabah geri dönmedi.{/i}"


translate turkish day3_evening_us_31aee4ac:


    "{i}Asılmış halde bulundu.{/i}"


translate turkish day3_evening_us_eb137a30:



    nvl clear
    "Ulyana tekrar konuşmayı kesti."


translate turkish day3_evening_us_fd837679:


    me "Heyecan verici...{w} Kendini ayakkabı bağcıklarıyla mı astı?"


translate turkish day3_evening_us_abfdf469:


    "Şüpheci bir şekilde söyledim."


translate turkish day3_evening_us_306e9012:


    "Tekrardan kaşlarını çattı."


translate turkish day3_evening_us_6a86fe31:


    me "Bu son mu?"


translate turkish day3_evening_us_c25bebac:


    us "Elbette değil!"


translate turkish day3_evening_us_81736160:


    "{i}Çocuğu gömdüler. Olması gerektiği gibi. Tabut ve diğer şeyler.{/i}"


translate turkish day3_evening_us_387cb49c:


    "{i}Akrabaları ve arkadaşları yas tuttular ama onu geri getiremediler.{/i}"


translate turkish day3_evening_us_4498a264:


    "{i}Birkaç gün sonra köyde insanlar kaybolmaya başladı. Kimse nasıl ve neden olduğunu bilmiyordu. Öylece ortadan kayboldular.{/i}"


translate turkish day3_evening_us_2b80bb65:


    "{i}Köylüler polisi aramak istedi ama cadının evinde kendini asan çocuğun bir arkadaşı onlara çocuğu gördüğünü söyledi. Başta kimse ona inanmadı ama insanlar kaybolmaya devam etti.{/i}"


translate turkish day3_evening_us_0b0a71f5:



    nvl clear
    "{i}Sonra köylüler tabutu kazmaya karar verdiler. Kapağın iç kısmında uzun çivi çizikleri vardı. Ama ceset yoktu.{/i}"


translate turkish day3_evening_us_c6ee723c:


    "{i}Nereye gitti bu?{/i}"


translate turkish day3_evening_us_afd82e5f:


    "Ulyana mumu kendinden uzaklaştırdı ve korkunç bir yüz ifadesi takındı (ya da en azından korkunç olduğunu düşündü)."


translate turkish day3_evening_us_725f29b0:


    "{i}Sonunda tüm köylüler ortadan kaybolur ve cadının evinin yakınından geçenler iki hayalet gördüklerini söylerler.{/i}"


translate turkish day3_evening_us_76b2fe88:


    nvl clear


translate turkish day3_evening_us_c65a5a14:


    "Ulyana mumunu söndürdü ve konuşmayı kesti."


translate turkish day3_evening_us_56417cdb:


    "Hikaye bitmiş gibi görünüyordu."


translate turkish day3_evening_us_d1bfd0cf:


    me "Harika!"


translate turkish day3_evening_us_bfb0f205:


    "Alkışladım."


translate turkish day3_evening_us_5bdb65dc:


    me "Pulitzer Ödülü'ne layık değil ama..."


translate turkish day3_evening_us_d6c3ca28:


    us "Korktun mu?{w} Tırstın mı?"


translate turkish day3_evening_us_6c2b1b7e:


    me "Her tarafım titriyor."


translate turkish day3_evening_us_f4067405:


    us "Her neyse...{w} Hikayeni anlat o zaman.{w} Eminim irkilmeyeceğim bile!"


translate turkish day3_evening_us_59133844:



    nvl clear
    "Düşüncelerimi toparladım ve birkaç ay önce bir tanıdığımın blogunda okuduğum bir hikayeyi anlatmaya karar verdim."


translate turkish day3_evening_us_0864a00e:


    "Oldukça iyi bir hikaye anlatıcısıydı. En azından ben onun tarzını seviyordum. Yani başarı garantiydi."


translate turkish day3_evening_us_cf924028:


    "Hikayeyi kelimesi kelimesine hatırlamadığım bazı yerleri kendim uydurmam lazım."


translate turkish day3_evening_us_56bad404:


    "{i}İnsanlığın son kalesi olan uzak bir uzay istasyonu, düşman bir uygarlığın sınırında yer alıyor. Ateşkesin üçüncü ayı.{/i}"


translate turkish day3_evening_us_0fe7b509:


    "{i}Buna tam olarak ateşkes denemez, daha çok 'savaş değil' denebilir. Hayatta kalan küçük bir grup uzun bir kuşatmadan yorgun düşmüştür.{/i}"


translate turkish day3_evening_us_6dc81529:


    "{i}Bir yandan karakolu terk ederek geri çekilemezler. Diğer yandan, düşman saldırırsa bir dakika bile dayanamayacaklarını biliyorlar.{/i}"


translate turkish day3_evening_us_04d2b110:



    nvl clear
    "{i}Çaresizlik, içinde bulundukları durumu tanımlamak için kullanılabilecek en iyi kelime.{/i}"


translate turkish day3_evening_us_68e6fa98:


    "{i}Erzak azalıyor ve sadece birkaç atışa yetecek kadar cephane kaldı, bu da çatışmalar patlak verirse daha çok bir selam niteliğinde olacak.{/i}"


translate turkish day3_evening_us_0f0fc437:


    "{i}Rejenerasyon sistemleri sayesinde sadece bol miktarda hava ve su bulunmakta.{/i}"


translate turkish day3_evening_us_420be6e0:


    "{i}İnsanlar haftalarca birbirleriyle konuşmadılar. Ölüm kapıdayken iletişim için zaman harcamanın anlamını görememiş olabilirler.{/i}"


translate turkish day3_evening_us_b4d08157:


    "{i}Ya da tam olarak metrelerce kalınlığındaki istasyon zırhının arkasında.{/i}"


translate turkish day3_evening_us_f910168c:


    "{i}Kurtarılmayı ya da düşmanın saldırısını beklemek gerçekten daha iyi. Her iki sonuç da bu işkencenin sona ermesine yol açacaktır.{/i}"


translate turkish day3_evening_us_9e98cab6:



    nvl clear
    "{i}Bu durum görünmez bir rakibe karşı oynanan bir satranç oyununa benziyor. Bu en zor kısım - oyun sonu. Herhangi bir yanlış hamle size ya da düşmanınıza yenilgiye yol açacaktır.{/i}"


translate turkish day3_evening_us_6880febd:


    "{i}Peki düşmanın bundan haberi var mı? Onlar da yanlış bir hamle yapmaktan korkuyor olabilirler. Bu arada insanlar şahlarını hareket ettirebilirler. Ama sadece bir kare ileri ve sonra tekrar bir kare geri.{/i}"


translate turkish day3_evening_us_38c79fcf:


    "{i}Başka herhangi bir hareket otomatik olarak yenilgiye yol açacaktır. İleriye doğru atılan bir adım, saldırmak için açık bir tehdittir. Geriye doğru bir adım ise savunmanın kasıtlı bir gerekliliğidir. Rakip karşınızda oturuyor olsaydı oyun çok daha kolay olurdu. Deneyimli bir satranç oyuncusu bile gergin göz hareketlerini, ara sıra ter damlalarını ya da titreyen ellerini gizleyemez.{/i}"


translate turkish day3_evening_us_22f0a385:


    "{i}Bir yandan her şey nafile, herkes durumun umutsuz olduğunun farkında, çünkü kimse yaklaşan yenilgiden kaçmak için bir hamle yapmaya karar vermeyecek.{/i}"


translate turkish day3_evening_us_35856953:



    nvl clear
    "{i}Öte yandan, rakibinizi karşınızda gördüğünüzde, onun da tamamen sizin gibi olduğunu ve hata yapabileceğini anladığınızda, her şeyi daha kolay tehlikeye atabilirsiniz. Rakip de aynı zorlukları hissedebilir.{/i}"


translate turkish day3_evening_us_4973842c:


    "{i}Bunlar, evrenin kıyısındaki az sayıdaki erkek ve kadının içinde bulunduğu koşullar. Birkaç gün boyunca merkezden emir gelmemişti.{/i}"


translate turkish day3_evening_us_7c9be39f:


    "{i}Gerçi son emirler işe yarar bir şey içermiyordu, sadece savunmaya devam etmeleri isteniyordu.{/i}"


translate turkish day3_evening_us_f87c860d:


    "{i}Bir kare ileri, bir kare geri. Sonsuz bir sarkacın salınımı.{/i}"


translate turkish day3_evening_us_f34c1a35:


    "{i}Dördüncü ayın başında komutan geri çekilmeye karar verir.{/i}"


translate turkish day3_evening_us_f2ccbac0:


    "{i}Askerlerinin hayatlarının İnsanlığın efsanevi ideallerinden daha önemli olduğunu düşünüyor. Kimse onu bunun için yargılayamaz.{/i}"


translate turkish day3_evening_us_f5762547:



    nvl clear
    "{i}Dahası, hiçbir şeyi değiştiremezler.{/i}"


translate turkish day3_evening_us_0117105e:


    "{i}Hazırlıklar fazla zaman almaz. Batan bir gemiden kurtarabileceğiniz en büyük varlık hayatınızdır.{/i}"


translate turkish day3_evening_us_ce3c3dd4:


    "{i}Tüm istasyon mürettebatı kurtarma gemisine biner. Fırlatma işlemi başlıyor. Üç, iki, bir... ve hiçbir şey yok. Bölme kapıları açılmıyor.{/i}"


translate turkish day3_evening_us_ec3c9d93:


    "{i}Arıza olup olmadığını kontrol etmek için teknisyenler gönderiyorlar. Ama hiçbir şey bulamadılar. Kapılar açılmalı. Ama ikinci kez asla açılmazlar. Ya da üçüncü kez...{/i}"


translate turkish day3_evening_us_e838b9cb:


    "{i}Komutan mürettebatına kurtarma kapsülleriyle istasyonu terk etmelerini emreder. Ama onlar da fırlatamazlar. Bunu teknik arıza olarak açıklarlar. Mürettebat karargahla boşuna iletişim kurmaya çalışıyor.{/i}"


translate turkish day3_evening_us_a22d8215:



    nvl clear
    "{i}Birkaç gün sonra yönetici subay radarlarda hiçbir şey olmadığını fark eder. Hiçbir şey - ne gezegen, ne asteroit, ne de düşman gemisi. Sadece sonsuz bir karanlık.{/i}"


translate turkish day3_evening_us_44deaf56:


    "{i}Bir ay içinde yiyecekleri tükeniyor. Herkes bunun son olduğunu düşünüyor. Ama kimse ölmüyor, ne bir gün, ne bir hafta, ne de bir ay sonra.{/i}"


translate turkish day3_evening_us_6d909058:


    "{i}Sanki insan yaşamını sürdürmek için gıdaya ihtiyaç yokmuş gibi.{/i}"


translate turkish day3_evening_us_fe89102b:


    "{i}O anda mürettebatın çoğunluğu delirir. Bazıları sadece odalarında kalıp dua eder, bazıları istasyonda dolaşır, bazıları da intihar etmeye çalışır.{/i}"


translate turkish day3_evening_us_7ed3bc1a:


    "{i}Ancak ne plazma silahıyla nokta atışı yapmak, ne hidro tankla dalmak, ne de sadece damarları kesmek bile bir sonuç getirmiyor.{/i}"


translate turkish day3_evening_us_405821aa:



    nvl clear
    "{i}Günler geçer, aylar hatta belki yıllar - kimse zamanın kaydını tutmaz. Deliler akıllarını yeniden kazanır ve normal insanlar delirir. Bu birçok kez tekrarlanır.{/i}"


translate turkish day3_evening_us_a8f61a7d:


    "{i}Sonunda mürettebat durumunu kabullenir.{/i}"


translate turkish day3_evening_us_f0789661:


    "{i}Meslekler uydurmaya başlarlar: tiyatro sahnelemeleri, spor turnuvaları, kendi yazdıkları kitapların okumaları.{/i}"


translate turkish day3_evening_us_520553c5:


    "{i}Birçok aile çifti ortaya çıkar ve birçoğu da ayrılır.{/i}"


translate turkish day3_evening_us_df10e82a:


    "{i}Sonsuz bir zaman akışı, bir insan hayatının kapalı bir döngüsü. Ve sadece radardaki karanlık onlara dışarıdaki boşluğu hatırlatıyor. Ama istasyonun içinde de bir boşluk vardır.{/i}"


translate turkish day3_evening_us_dd21be31:


    "{i}Sonunda insanlar yaşamayı bırakır. Sadece odalarında yatar ve uyurlar. İlk başta 7/24 değil, ama zaman geçtikçe transa geçmeyi öğreniyorlar.{/i}"


translate turkish day3_evening_us_134f2ab0:



    nvl clear
    "{i}Her insanın kendi hayalleri vardır - biri çocukluğuna döner, biri kaybettiği aşkını geri alır, biri elinde bir silahla İnsanlık ideallerini savunur. Bazıları ise sadece uzayda dolaşır...{/i}"


translate turkish day3_evening_us_d9aa3d87:


    "{i}Düşmanla çatışmalardan perişan bir halde, bir kurtarma gemisi istasyona yanaşır. Biniş ekibi içeri girer.{/i}"


translate turkish day3_evening_us_0bf36ead:


    "{i}Tüm istasyon binlerce yıldır uzayda yüzen bir hurda-metal parçasına benziyordu. Reaktör uzun zaman önce kapanmış. Duvarlarda lazer atışlarının izleri vardı. Ekipmanların hepsi parçalanmıştı.{/i}"


translate turkish day3_evening_us_6b174e6c:


    "{i}Neredeyse her odada insanlığın sınırlarını savunurken korkunç bir şekilde ölen insanların çürümüş iskeletlerini buldular.{/i}"


translate turkish day3_evening_us_ab489ab3:


    "{i}Ve merkeze gönderilen sadece bir şifreli mesaj bir şeylerin ters gittiğini ima ediyordu.{/i}"


translate turkish day3_evening_us_43b9f5d0:



    nvl clear
    "{i}'Bizi kurtarın!{/i}"


translate turkish day3_evening_us_93ed5913:


    "{i}Sadece ölmek istiyoruz...'{/i}"


translate turkish day3_evening_us_6b713cd4:


    "Hikayeyi bitirdim ve Ulyana'ya baktım."


translate turkish day3_evening_us_2c2388cc:


    "Karanlık yüzünü gizlemişti."


translate turkish day3_evening_us_768354f5:


    me "Hikaye bu kadar..."


translate turkish day3_evening_us_e7066533:


    "Muma üfledim."


translate turkish day3_evening_us_3d0f0f54:


    "Ulyana çığlık attı, ayağa kalktı ve kendini bana doğru attı."


translate turkish day3_evening_us_574fb6aa:


    "Yere düştük."


translate turkish day3_evening_us_a4d2b1c8:


    me "Neyin var senin?"


translate turkish day3_evening_us_3005a190:


    us "Hiçbir şey..."


translate turkish day3_evening_us_3cff4607:


    "Sesi korkmuş gibi geldi."


translate turkish day3_evening_us_871c17c7:


    "Görünüşe göre hikayem onu etkiledi."


translate turkish day3_evening_us_c163059f:


    "Kendimi zihinsel olarak tebrik ettim.."


translate turkish day3_evening_us_4c250e85:


    "Ulyana eğlenmiyordu ama."


translate turkish day3_evening_us_355d45cd:


    "Bana sarıldı, titredi ve hıçkırdı."


translate turkish day3_evening_us_638d6acb:


    me "Neyin var senin, seni budala şey?"


translate turkish day3_evening_us_0192e2f2:


    "Başını okşadım."


translate turkish day3_evening_us_6dc624b2:


    me "Sadece bir hikaye.{w} Gerçek değil."


translate turkish day3_evening_us_24578402:


    us "Sen ve senin aptal hikayelerin!"


translate turkish day3_evening_us_00a07cdc:


    "Ulyana bana daha da sarıldı."


translate turkish day3_evening_us_14314e51:


    me "O kadar korktun mu?"


translate turkish day3_evening_us_c463eeea:


    us "Evet..."


translate turkish day3_evening_us_d47079d5:


    "Ondan bu kadar dürüst bir cevap beklemiyordum."


translate turkish day3_evening_us_0268fff6:


    me "Her şey yolunda."


translate turkish day3_evening_us_f776f380:


    th "Zaman tüm yaraları iyileştirir. Sakinleşecektir."


translate turkish day3_evening_us_3e0531a1:


    us "Dinle, Semyon..."


translate turkish day3_evening_us_67c5f2d1:


    me "Ne?"


translate turkish day3_evening_us_62db7763:


    us "Boşver, önemli değil.."


translate turkish day3_evening_us_dc1b0573:


    "Yüzünü göğsüme gömdü."


translate turkish day3_evening_us_f8253995:


    "Dakikalar geçti."


translate turkish day3_evening_us_a92c5503:


    me "Tamam, anladım.... Gitmeli miyiz?"


translate turkish day3_evening_us_0cd20c05:


    "Dinledim.{w} Ulyana sessizce horluyordu."


translate turkish day3_evening_us_61d4bcc5:


    me "Hey! Uyan!"


translate turkish day3_evening_us_094ae4ba:


    th "Korkudan uyulur mu hiç?"


translate turkish day3_evening_us_ba0cb0ae:


    me "Uyan dedim!"


translate turkish day3_evening_us_71063c36:


    "Tepki yok."


translate turkish day3_evening_us_c589ce7a:


    "Ayağa kalkmaya çalıştım."


translate turkish day3_evening_us_20833c6d:


    "Ulyana kesinlikle 40 kilodan fazla değildi, ama kendinizi böyle bir ağırlığın altında yatarken hayal edin."


translate turkish day3_evening_us_81eadbc5:


    "Kalkması gerçekten kolay değildi!"


translate turkish day3_evening_us_2f516faf:


    "Nefes almasa öldüğünü bile düşünebilirdim."


translate turkish day3_evening_us_19979d09:


    "Kesinlikle daha fazla çaba gösterebilirim..."


translate turkish day3_evening_us_ceb2ee9d:


    th "Ama sonra onu uyandıracağım ve her şey yine aynı olacak."


translate turkish day3_evening_us_c52a9778:


    th "Ne kadar da imrenilecek bir durum."


translate turkish day3_evening_us_feb9b84c:


    th "Yine de kendi kendine uyanana kadar bekleme seçeneği vardı."


translate turkish day3_evening_us_96e8f382:


    th "Böyle bir hikayeden sonra sabaha kadar uyumayacağı kesin."


translate turkish day3_evening_us_dd9bfa6a:


    "Pencereden yıldızlı gökyüzüne baktım."


translate turkish day3_evening_us_44c11d50:


    th "Acaba gerçekten hayalet mürettebatı olan uzak bir karakol var mı?"


translate turkish day3_evening_us_8ac1f25d:


    "Gözlerim yavaşça kapandı ve bir anda uykuya daldım..."


translate turkish day3_evening_dv_701cf26a:


    "Birkaç dakika sonra sahneye yaklaştım."


translate turkish day3_evening_dv_50cb2f7e:


    th "Belki de onun teklifini kabul etmek kötü bir fikirdi?"


translate turkish day3_evening_dv_13334dce:


    th "Dvachevskaya ile konuşmak bile tehlike demek..."


translate turkish day3_evening_dv_bdfb9d61:


    th "Öte yandan dans etmeyi pek sevmiyorum."


translate turkish day3_evening_dv_b864db36:


    th "Orada ne yapacağım ki?{w} Sadece kendimi rezil ederim..."


translate turkish day3_evening_dv_5815ef70:


    th "Hayır, Alisa'nın gitar çalışını dinlesem daha iyi."


translate turkish day3_evening_dv_1340350c:


    "Yaklaştığımda sahnenin kenarında bacaklarını sarkıtarak oturan bir kişi gördüm."


translate turkish day3_evening_dv_5ee37cbd:


    dv "Demek gelmeyi tercih ettin!"


translate turkish day3_evening_dv_171149e1:


    "Alisa gitarı yana koydu ve aşağı indi."


translate turkish day3_evening_dv_7c8a24e7:


    "Hatta bir an için yüzünde bir sevinç izi bile vardı.{w} Biri için çalmak kesinlikle yalnız olmaktan daha ilgi çekicidir."


translate turkish day3_evening_dv_2abbfc44:


    me "Görebileceğin gibi..."


translate turkish day3_evening_dv_64374587:


    dv "Ne yapacağız?"


translate turkish day3_evening_dv_6c4f856c:


    me "Ne demek 'ne'?"


translate turkish day3_evening_dv_554549ca:


    dv "Sana soruyorum."


translate turkish day3_evening_dv_c222ae63:


    me "Şey... istemiştin ki..."


translate turkish day3_evening_dv_e1d0c3f8:


    "Aniden bu durumun onun her zamanki şakalarından biri olduğunu düşündüm ve gitar şarkıları duymayı asla beklememeliydim."


translate turkish day3_evening_dv_c87e1fd0:


    me "Uyumaya gidiyorum. Görüşürüz!"


translate turkish day3_evening_dv_4f545b83:


    "Arkamı döndüm ve kasten yavaşça bir el salladım."


translate turkish day3_evening_dv_93b5fc50:


    dv "Hey!"


translate turkish day3_evening_dv_744f6c22:


    "Alisa kolumu tuttu."


translate turkish day3_evening_dv_ad02f53a:


    me "Ne?"


translate turkish day3_evening_dv_18f4b1ad:


    dv "Dinlemek istemiyor musun?"


translate turkish day3_evening_dv_ba6356e6:


    me "Neyi dinleyeyim? Daha kendin ne yapacağını bilmiyorsun."


translate turkish day3_evening_dv_3ce16a8b:


    dv "Elbette biliyorum!"


translate turkish day3_evening_dv_55df167e:


    "Gitarı aldı ve pena ile tellere birkaç kez vurdu."


translate turkish day3_evening_dv_a2494e1f:


    dv "Yanıma otur."


translate turkish day3_evening_dv_eaadd141:


    "İtiraz etmedim ve bir anda onun yanına oturdum."


translate turkish day3_evening_dv_55b9978e:


    th "Böylesi daha iyi."


translate turkish day3_evening_dv_69e988e0:


    th "Dansı zaten kaçırdıp şimdi gidersem eklimde ne kalacak?"


translate turkish day3_evening_dv_994a7e72:


    "Yabancı rolü pasif bir gözlemci için daha uygundu, olmayı çok istediğim hevesli bir cevap arayıcısı için değil."


translate turkish day3_evening_dv_6a5d85fb:


    dv "Şimdi sana bu şarkıyı nasıl çalacağını göstereceğim."


translate turkish day3_evening_dv_9fb4d40d:


    me "Hemen mi?"


translate turkish day3_evening_dv_7f046cee:


    dv "Ne demek 'hemen'?"


translate turkish day3_evening_dv_3eb0fb19:


    me "Uzun zamandır gitar tutmadım..."


translate turkish day3_evening_dv_22bda204:


    th "Muhtemelen bir tanesini tutmayalı ne kadar zaman olduğunu tahmin edebilirdi. Yeteneklerim bir kediyi bile güldürmeye yeterdi."


translate turkish day3_evening_dv_87662605:


    dv "Zor değil!"


translate turkish day3_evening_dv_db47df41:


    "Alisa'ya sert bir bakış attım."


translate turkish day3_evening_dv_2f5dd571:


    "Şu anda bana öyle geliyor ki duygularını ifade edemiyor."


translate turkish day3_evening_dv_f464d10c:


    "Bir an için garip otokontrolünü kaybedebilirdi ve ben de rahat, hatta komik ve arkadaş canlısı bir kız görebilirdim."


translate turkish day3_evening_dv_05afbea0:


    "Ve sonra kendine güveni ve küstahlığı geri döndüğünde, her zamanki gibi kaltaklaşır."


translate turkish day3_evening_dv_0d77d9e0:


    th "Peki ya hangisi gerçek Alisa?"


translate turkish day3_evening_dv_93b5fc50_1:


    dv "Hey!"


translate turkish day3_evening_dv_ad02f53a_1:


    me "Ne?"


translate turkish day3_evening_dv_265b67ba:


    dv "Hayal kurmayı bırak!"


translate turkish day3_evening_dv_94598a92:


    me "Oh, evet, üzgünüm..."


translate turkish day3_evening_dv_a38c32a6:


    dv "Peki, izliyor musun?"


translate turkish day3_evening_dv_dc57eba2:


    me "İzliyorum. Hangi şarkı bu?"


translate turkish day3_evening_dv_4d022e04:


    dv "Bu sabah çaldığım tabii ki!"


translate turkish day3_evening_dv_af865fbf:


    me "Oh... Tamam. Dikkatle dinliyorum."


translate turkish day3_evening_dv_13b39fa1:


    "Alisa kararını verdi ve çalmaya başladı."


translate turkish day3_evening_dv_ce617998:


    "..."


translate turkish day3_evening_dv_56072db3:


    dv "Bu kadar.{w} Anladın mı?"


translate turkish day3_evening_dv_2a7d102c:


    th "Anlamış olabilirim ama muhtemelen bunu taklit edemeyeceğim."


translate turkish day3_evening_dv_51584317:


    me "Nasıl söylesem..."


translate turkish day3_evening_dv_52e5d545:


    dv "Sorun yok. Pratikle düzelir."


translate turkish day3_evening_dv_7d8a585d:


    "Bu noktada şüphesiz haklı, ancak hayatım boyunca pratikle ilgili sorunlar yaşadım."


translate turkish day3_evening_dv_91dd4d67:


    me "Pekala..."


translate turkish day3_evening_dv_77bdacb3:


    "Gitarı Alisa'dan aldım ve ilk notayı çalmayı denedim."


translate turkish day3_evening_dv_59bff6c6:


    "Çok zordu, sanki parmaklarım düğümlenmişti ve doğru yerde olmak istemiyorlardı."


translate turkish day3_evening_dv_008caeac:


    "Önceden daha iyiydim, ama şimdi 'Daha dün annemiz'i bile çalamam."


translate turkish day3_evening_dv_dbeba143:


    dv "Ee?"


translate turkish day3_evening_dv_2074dc26:


    me "Bir saniye..."


translate turkish day3_evening_dv_4145963f:


    dv "Görünüşe göre bir rock kahramanı olamayacaksın!"


translate turkish day3_evening_dv_91623ab5:


    "Nazikçe güldü."


translate turkish day3_evening_dv_4608b651:


    me "Böylesi daha iyi..."


translate turkish day3_evening_dv_f6a527e5:


    "Boş yere basmam gereken tellerin sırasını hatırlamaya çalışarak homurdandım."


translate turkish day3_evening_dv_4366e696:


    me "Şey..."


translate turkish day3_evening_dv_54c3617f:


    "Gitar, yaralı bir dinozorun iniltilerini andıran şeytani sesler çıkarmaya başladı."


translate turkish day3_evening_dv_a4415adc:


    "Sol el parmaklarım sürekli sağ perdeleri kaçırıyor ve sağ elim ritim tutmuyordu."


translate turkish day3_evening_dv_7c983f00:


    me "Buna progresif rock diyelim."


translate turkish day3_evening_dv_334edc91:


    dv "Progresif mi? Vay, vay! Geri ver onu!"


translate turkish day3_evening_dv_13705a4a:


    "Gitarı elimden aldı ve gitar onun elinde bambaşka bir ses çıkardı."


translate turkish day3_evening_dv_11e95cca:


    "Bir an için beceriksizliğimden utandım."


translate turkish day3_evening_dv_0cf5d3af:


    "Alisa'nın yeteneği profesyonel bir gitarist seviyesinde olmayabilir, ancak yine de bunun gibi basit şeyleri güvenle çaldı."


translate turkish day3_evening_dv_195bfa48:


    "Fazlasıyla pratik yapmış olmalı."


translate turkish day3_evening_dv_561d4770:


    dv "Şimdi anladın mı?"


translate turkish day3_evening_dv_d9ffec9a:


    "Çalmayı bitirdi ve gitarı bana uzattı."


translate turkish day3_evening_dv_c97fadc0:


    me "Pekala..."


translate turkish day3_evening_dv_e9ad5daa:


    "İkinci denemede daha iyiydim, ama Alisa'nın seviyesine ulaşmak için daha çok uzun bir yolum var."


translate turkish day3_evening_dv_9422d1b3:


    "Ya da yeterli seviyeye."


translate turkish day3_evening_dv_7c284714:


    "Onunla karşılaştırıldığımda ne kadar işe yaramaz olduğumun farkındaydım."


translate turkish day3_evening_dv_c3b32ce7:


    th "Çok basit görünüyor - sadece üç akorlu bir şarkı çal!"


translate turkish day3_evening_dv_34a8a8e1:


    dv "Yine de melodi çok basit."


translate turkish day3_evening_dv_ee31e548:


    "Gitarı yan tarafıma koydum."


translate turkish day3_evening_dv_ed1bcf7d:


    "Alisa bir anlığına düşüncelerinde kaybolmuştu."


translate turkish day3_evening_dv_f28fc90f:


    dv "İlkokul çocuğu bile daha iyi çalar!"


translate turkish day3_evening_dv_e7c47ec2:


    me "Teşekkürler,{w} En azından denedim!"


translate turkish day3_evening_dv_e131c7ad:


    dv "Farkındayım!"


translate turkish day3_evening_dv_bd64fe14:


    "Gitar çalmadaki bariz üstünlüğünü göstermeye çalışıyor gibi görünüyor."


translate turkish day3_evening_dv_a9370cae:


    me "Herkes müzisyen olacak diye bir şey yok."


translate turkish day3_evening_dv_26e899f1:


    dv "Pek sayılmaz..."


translate turkish day3_evening_dv_343fa444:


    "Alisa gökyüzüne baktı."


translate turkish day3_evening_dv_799ffa98:


    dv "Senin olamayacağın belli en azından!"


translate turkish day3_evening_dv_38d5b464:


    me "Nedemiş o?"


translate turkish day3_evening_dv_c3abde57:


    dv "Nasıl çaldığını duymalıydın!"


translate turkish day3_evening_dv_43afff04:


    "Buraya geldiğim için pişmanlık duymaya başladım."


translate turkish day3_evening_dv_67787d9f:


    th "Beni boşver de Alisa neden böyle davranmak zorunda?{w} Çok kötü bir gitarist olduğum çok belli."


translate turkish day3_evening_dv_8c75e8f3:


    me "Kesinlikle.{w} Ama belki birazcık pratik yaparsama..."


translate turkish day3_evening_dv_26bc6b0e:


    dv "Yapacak mısın?"


translate turkish day3_evening_dv_968fea51:


    me "Bilmiyorum... Belki yaparım."


translate turkish day3_evening_dv_bca2071d:


    "Gitar şuanlık en büyük problemim değil aslında. Şuan içinden çıkamadığım farklı bir dünyadayım...{w} Bu Alisa ile yapacağım salakça bir tartışmadan daha önemli."


translate turkish day3_evening_dv_67458183:


    "Birden rahatsız edici bir kendine acıma, ilgisizlik ve buradan ayrılma, bu akşamı unutma dürtüsü hissettim."


translate turkish day3_evening_dv_ca179b6a:


    "Bu duygular kötü bir izlenim ve aptalca bir şey yapmak (veya söylemek) için yakıcı bir arzu bıraktı."


translate turkish day3_evening_dv_3fcbf50b:


    me "Sanki bir şey değişecek de!"


translate turkish day3_evening_dv_1145d96e:


    dv "Ne?"


translate turkish day3_evening_dv_c372f019:


    me "Gitar çalma konusunda!"


translate turkish day3_evening_dv_9d34d000:


    dv "Kesinlikle yapamazdın! Gitarı birkaç gün tıngırdatır ve sonra bırakırdın."


translate turkish day3_evening_dv_e7eaa70e:


    "Alisa'nın sözleri kalbimi deldi."


translate turkish day3_evening_dv_5187f093:


    me "Ne biliyor musun?!"


translate turkish day3_evening_dv_35264e84:


    "Peki, {i}bilmeli{/i} mi? Bu onu ilgilendirir mi?"


translate turkish day3_evening_dv_05bd68b6:


    "Sadece doğru olduğu ve bu doğruyu söyleyen Alisa olduğu için mi bu şekilde tepki veriyorum?"


translate turkish day3_evening_dv_64d153d7:


    me "Her şeyin nasıl olacağını bilemezsin!"


translate turkish day3_evening_dv_b4c62b8a:


    dv "Muhtemelen bilemem...{w} Ama en azından bir şeyler yapman lazım."


translate turkish day3_evening_dv_6528a29b:


    me "Yani, hiçbir şey yapamayacağımı mı söylüyorsun?"


translate turkish day3_evening_dv_a44772be:


    dv "Nasıl bilebilirim?"


translate turkish day3_evening_dv_92d27981:


    me "Biliyorsun, ben..."


translate turkish day3_evening_dv_21c57864:


    th "Ben ne?"


translate turkish day3_evening_dv_380c1152:


    th "Ona bilgisayar yeteneklerimden mi bahsedeceğim?{w} Ya da okuduğum kitap veya izlediğim filmlerden mi?"


translate turkish day3_evening_dv_6660ca80:


    me "Pekala, bu anlamsız bir konuşma."


translate turkish day3_evening_dv_4a20a990:


    dv "Bunu söylemeye bile gerek yok."


translate turkish day3_evening_dv_d48bc21c:


    me "Senin tek derdin eğlenmek!"


translate turkish day3_evening_dv_cb92aa34:


    dv "Ve sen de sızlanmak dışında bir şey bilmiyorsun!"


translate turkish day3_evening_dv_297beca3:


    me "Unut bunu!"


translate turkish day3_evening_dv_a08e0ef8:


    "Sahneden indim ve konser alanından uzaklaşmaya başladım."


translate turkish day3_evening_dv_8bd551d4:


    dv "Git o zaman!"


translate turkish day3_evening_dv_11b833b9:


    "Alisa'nın bana bağırdığını duydum."


translate turkish day3_evening_dv_9d84e4e8:


    me "Gidiyorum zaten!"


translate turkish day3_evening_dv_2eb0d079:


    "Mırıldandım."


translate turkish day3_evening_dv_35bec68e:


    "Patika beni meydana geri getirdi."


translate turkish day3_evening_dv_51f9be11:


    "Slavya meydanın ortasında etrafı süpürüyordu."


translate turkish day3_evening_dv_d2abd3ca:


    sl "Oh, Semyon, merhaba! Herkesin uyumaya gittiğini sanıyordum."


translate turkish day3_evening_dv_4477db54:


    me "Hayır... Sen ne yapıyorsun?"


translate turkish day3_evening_dv_753b1df5:


    sl "Balayından kalanları temizliyorum. Sen neden gelmedin?"


translate turkish day3_evening_dv_79a8a3cb:


    me "Sadece..."


translate turkish day3_evening_dv_4bd32d93:


    sl "Ve neredeydin?"


translate turkish day3_evening_dv_bbc9f7af:


    me "Ben..."


translate turkish day3_evening_dv_66b39d2d:


    "Slavya'ya, tüm kamp meydanda eğlenirken Alisa'nın önünde gitarla sahnede kendimi nasıl utandırdığımı anlatmaya en ufak bir niyetim yoktu."


translate turkish day3_evening_dv_b498ffb4:


    me "Yürüyüşe çıktım."


translate turkish day3_evening_dv_527c6bb3:


    sl "Tamam... Ama gelmeliydin. Eğlenceliydi."


translate turkish day3_evening_dv_77b6031e:


    me "İyi vakit geçirdiğinize sevindim."


translate turkish day3_evening_dv_a7c92b66:


    "Bugünkü endişelerimden ya da gecenin sıcaklığından dolayı domuz gibi terlemiştim."


translate turkish day3_evening_dv_c79602cb:


    me "Hey, nerede banyo edebilirim?"


translate turkish day3_evening_dv_46023748:


    sl "Kesinlikle. Düz git, sonra patikadan biraz sola, sonra sağa ve bir duş olacak."


translate turkish day3_evening_dv_3820771a:


    me "..."


translate turkish day3_evening_dv_56fc315a:


    sl "Sana eşlik etmemi ister misin?"


translate turkish day3_evening_dv_90d3bf06:


    me "Hayır, gerek yok. Kendim bulurum!"


translate turkish day3_evening_dv_8a838751:


    "Ona daha fazla yük olmak istemiyordum."


translate turkish day3_evening_dv_844a11d0:


    "Orman boyunca Slavya'nın gösterdiği yöne doğru yürüdüm."


translate turkish day3_evening_dv_7fd553fe:


    "Bütün vücudum kaşınıyordu."


translate turkish day3_evening_dv_1ac85161:


    th "Nasıl oldu da önceden farketmedim?"


translate turkish day3_evening_dv_b2840d09:


    "Ve daha da önemlisi, Farketmeseydim ne olurdu?"


translate turkish day3_evening_dv_19111076:


    th "İşler böyle gitmeye devam ederse sonsuza kadar bu dünyada kalmak zorunda kalacağım."


translate turkish day3_evening_dv_cd1088c8:


    "Bu düşüncenin etkisiyle ürperdim."


translate turkish day3_evening_dv_ea4df3bd:


    "Muhtemelen herhangi bir dehşet ya da sadece korku hissetmediğim fikrine."


translate turkish day3_evening_dv_d95e35f6:


    "Tıpkı her şeyin doğal akışı gibi."


translate turkish day3_evening_dv_0ba45212:


    "Ağaçların arkasında duşu görebiliyordum."


translate turkish day3_evening_dv_4c8601db:


    th "Peki öncülerin burada neden duşları var?"


translate turkish day3_evening_dv_c7b24c86:


    th "Olga Dmitrievna duşların onarımı hakkında bir şeyler söylemişti."


translate turkish day3_evening_dv_7cf75d85:


    me "Artık endişelenmeye gerek yok..."


translate turkish day3_evening_dv_2fbfcd94:


    "Sabun ve temiz havlular vardı, bu yüzden çabucak yıkandım, dışarı çıktım ve temiz gece havasını içime çektim."


translate turkish day3_evening_dv_9f7fc9a5:


    th "Ah, fiziksel temizliğin ruhsal temizliği getirmesi ne kadar harika!"


translate turkish day3_evening_dv_00142a80:


    "Tüm sorunlarım ortadan kalkmadıysa bile en azından daha az önemli hale geldi. Sanki su sadece bedenimdeki kiri değil, zihnimdeki endişeyi de temizledi."


translate turkish day3_evening_dv_9b68d7c1:


    "Birden esnemeye başladım ve gözlerimi ovuşturarak liderin kabinine yöneldim."


translate turkish day3_evening_dv_8c18ef81:


    "Alisa çalıların arasından fırlamadan önce birkaç adım bile atmamıştım."


translate turkish day3_evening_dv_e58bfb0c:


    dv "Sen... Burada ne yapıyorsun?"


translate turkish day3_evening_dv_aa2954ff:


    me "Yıkanıyordum."


translate turkish day3_evening_dv_e2ccd354:


    "Kendine geldi ve tekrar konuştu."


translate turkish day3_evening_dv_d87c29ac:


    dv "Ve?"


translate turkish day3_evening_dv_ad02f53a_2:


    me "Ve ne?"


translate turkish day3_evening_dv_410dff3b:


    dv "Nasıl bilebilirim?!"


translate turkish day3_evening_dv_b7d92302:


    me "O zaman bilmiyorsan neden konuşuyorsun?"


translate turkish day3_evening_dv_0adca3fb:


    "İçimdeki tüm huzur bir anda yok oldu, geriye sadece kızgınlık ve yorgunluk kaldı."


translate turkish day3_evening_dv_e44bfa1d:


    me "Tamam, eğer sakıncası yoksa."


translate turkish day3_evening_dv_a5e7a3c6:


    dv "Bekle..."


translate turkish day3_evening_dv_f3274282:


    me "Ne oldu?"


translate turkish day3_evening_dv_761956ea:


    dv "Eğer sahnede böyle düşündüysen... şey... Seni kırmak istememiştim."


translate turkish day3_evening_dv_1f988280:


    me "Sorun değil, alınmadım. Sadece gitar çalamıyorum. Özel bir şey değil, birçok insan çalamaz."


translate turkish day3_evening_dv_403f582b:


    "Sesimde bariz bir kızgınlık belirtisi olduğunu hissediyordum ama bu konuda hiçbir şey yapamıyordum. Her şeyi tam burada, şu anda yüzüne söylemek istiyordum."


translate turkish day3_evening_dv_5b7b1ded:


    dv "Kesinlikle, çalamıyorsun!"


translate turkish day3_evening_dv_aee5d595:


    "Alisa gülmemek için kendini zor tuttu."


translate turkish day3_evening_dv_d5503c43:


    me "Senden bıktım artık!"


translate turkish day3_evening_dv_a3a48b46:


    "O anda beni tamamen çıldırttı."


translate turkish day3_evening_dv_423dbcda:


    "Bir saniye daha geçseydi ona bağırmaya başlardım...{w} Ya da daha kötüsü."


translate turkish day3_evening_dv_f72c72fe:


    dv "Bekle."


translate turkish day3_evening_dv_d177607c:


    me "Beni yalnız bırakamaz mısın!"


translate turkish day3_evening_dv_cc1a995c:


    "Alisa bei takip etti ama durdurmaya çalışmadı."


translate turkish day3_evening_dv_0cc8c845:


    dv "Gerçekten seni kırmak istemedim..."


translate turkish day3_evening_dv_2cebe654:


    "Görünmez bir güç arkamı dönmemi sağladı."


translate turkish day3_evening_dv_d09cc761:


    me "Tamam. Artık gidebilir miyim?"


translate turkish day3_evening_dv_4907e592:


    dv "Evet... Elbette..."


translate turkish day3_evening_dv_664f2019:


    "Ay ışığında Alisa çok güzel görünüyordu ve yüzünde küçük bir suçluluk ifadesi vardı."


translate turkish day3_evening_dv_aa3cefba:


    th "Ağzını kapalı tutabilseydi eğer..."


translate turkish day3_evening_dv_74c9cbb9:


    dv "Neye sırıtıyorsun?"


translate turkish day3_evening_dv_d857ef67:


    th "Her ne kadar..."


translate turkish day3_evening_dv_356af705:


    me "Hiçbir şey. Sadece biraz daha kibar olsaydın..."


translate turkish day3_evening_dv_0fd482e1:


    dv "Ne olacaktı?"


translate turkish day3_evening_dv_389e70d3:


    "Böyle şeyler söylememeliyim, insanlar entelektüel yeteneklerine bağlı olarak fikir sahibi olabilirler."


translate turkish day3_evening_dv_a0eb57ae:


    me "Sonra hiçbir şey."


translate turkish day3_evening_dv_6f263bd2:


    dv "Başladığın şeyi bitirmelisin!"


translate turkish day3_evening_dv_c27026d4:


    me "Bitirilecek bir şey yok. Çok yoruldum ve uyumam lazım."


