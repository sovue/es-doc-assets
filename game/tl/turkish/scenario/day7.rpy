
translate turkish day7_main_aa6af803:


    "Parlak güneş ışığı göz kapaklarımın arasından bile gözlerime vuruyordu."


translate turkish day7_main_5c43311e:


    "Tembelce uzandım ve hızla yataktan kalktım."


translate turkish day7_main_f254f75a:


    "Saat öğleden sonra ikiydi."


translate turkish day7_main_b36d3471:


    th "Görünüşe göre dün beni gerçekten bitirmişti ve vücudumun toparlanmak için normalden çok daha fazla zamana ihtiyacı vardı."


translate turkish day7_main_c1bcf764:


    "Bugün ne yapmam gerektiğini düşünerek odada bir tur attım."


translate turkish day7_main_d7fae9fa:


    "O tuhaf öncüden duyduklarımdan sonra kamptaki hayatımın bir daha asla eskisi gibi olmayacağı açıktı."


translate turkish day7_main_f80b4755:


    th "Ve eğer her şey onun söylediği gibiyse, önümde bolca zaman var."


translate turkish day7_main_6bd2f897:


    "Hijyen setimi aldım ve dışarı çıktım."


translate turkish day7_main_e37820fc:


    "Sadece birkaç adım atabilmiştim ki biri sırtıma çarptı."


translate turkish day7_main_fe998b08:


    "Arkamı döndüm ve Alisa'yı gördüm."


translate turkish day7_main_b3e42438:


    dv "Hey, dikkatli ol!"


translate turkish day7_main_0ffdf7aa:


    "Dedi kayıtsızca ve yoluna devam etti."


translate turkish day7_main_17ea660a:


    "Elinde bir çeşit çanta tutuyordu."


translate turkish day7_main_dc306e1e:


    th "Ah, her neyse, bu çılgın yerde sıradan bir gün daha."


translate turkish day7_main_2e63ec7e:


    "Dişlerimi fırçalamayı bitirdim ve sonra kendime gelmek ve kafamı biraz olsun tazelemek için yüzümü buz gibi suyla yıkayarak sonsuza kadar vakit geçirdim."


translate turkish day7_main_e3cedd9c:


    "Ondan sonra kendimi biraz daha iyi hissettim."


translate turkish day7_main_c32db707:


    "Birdenbire içimi bir umut kapladı{w} buradan sağ salim çıkabileceğime dair bir umut değildi bu..."


translate turkish day7_main_79994a07:


    "Aksine, her şeyin o adamın bana anlattığı kadar kötü olduğuna inanmak istemiyordum."


translate turkish day7_main_7efc0341:


    pi "Günaydın..."


translate turkish day7_main_215b97bf:


    "Ormandan gelen belli belirsiz bir ses duydum."


translate turkish day7_main_091593a0:


    "Birisi bir ağacın arkasında duruyordu."


translate turkish day7_main_70958877:


    me "Günaydın."


translate turkish day7_main_6bedc27f:


    pi "Hazır mısın?"


translate turkish day7_main_eaccb1bc:


    me "Neye hazır mıyım?"


translate turkish day7_main_a93dcec8:


    "Tekrar baktım ve dünkü otobüs durağındaki öncü gibi görünüyordu."


translate turkish day7_main_3d1d50e7:


    "Aslında bugün böyle bir tuhaflığa hazırlıklıydım, bu yüzden gerçekten şaşırmadım ve bu konuşmaya oldukça açık kafayla başladım."


translate turkish day7_main_c6c61387:


    pi "Ona inanmadın, değil mi?"


translate turkish day7_main_cb23542f:


    me "Sen neden bahsediyorsun?"


translate turkish day7_main_74acfe46:


    pi "Söylediği her şey..."


translate turkish day7_main_fe4e16b8:


    me "Pekâlâ, ama neler olduğuna dair fikriniz nedir?"


translate turkish day7_main_71a0a00c:


    "Kendimi zaten dış dünyadan uzaklaştırmıştım ve başıma gelen her şeyi gerçek değil, kurgusal bir film gibi ele almaya karar verdim."


translate turkish day7_main_e427bce7:


    th "Umarım bu bana durumsal mantık analizi açısından daha fazla hareket alanı sağlardı."


translate turkish day7_main_4ad2a811:


    pi "Bir çıkış var. Olmak zorunda!"


translate turkish day7_main_ad9f7f99:


    "Heyecanla söyledi."


translate turkish day7_main_9da02d58:


    me "Bilmiyorum... Ama ben de buna inanmak istiyorum."


translate turkish day7_main_6c7b7a89:


    pi "Eğer sadece..."


translate turkish day7_main_2a454c26:


    sl "Semyon!"


translate turkish day7_main_47eaf14e:


    "Arkamı döndüm."


translate turkish day7_main_5d2bdfb2:


    "Slavya tam yanımda duruyordu."


translate turkish day7_main_177f4329:


    sl "Kiminle konuşuyordun?"


translate turkish day7_main_32d6e567:


    me "Ahem... Hiç kimse...{w} Sadece kendi kendime konuşuyorum."


translate turkish day7_main_85f46292:


    "Ona paralel dünyalardan gelen uzaylıları anlatmaya değeceğini pek sanmıyorum."


translate turkish day7_main_eb65a9c2:


    th "Muhtemelen onları göremez bile."


translate turkish day7_main_f35f8815:


    sl "Şimdiden hazırlandın mı?"


translate turkish day7_main_6f63a38c:


    me "Hazırlandınız mı? Başka bir yürüyüş için mi?"


translate turkish day7_main_f7b781d4:


    sl "Hayır!{w} Bugün seansın son günü."


translate turkish day7_main_0657e28f:


    me "Ne...?"


translate turkish day7_main_955f98b3:


    "Yüzüme aptalca bir gülümseme yerleşti."


translate turkish day7_main_8ecccc0f:


    sl "Bu akşam bir otobüs olacak. Gidiyoruz."


translate turkish day7_main_82b7666b:


    me "Vay canına."


translate turkish day7_main_128e12c4:


    th "En inanılmaz sürprizlere bile hazırdım ama..."


translate turkish day7_main_f4182ba6:


    "O gizemli öncünün bahsettiği şey bu muydu?"


translate turkish day7_main_2e7eb2bb:


    th "Muhtemelen öyleydi."


translate turkish day7_main_7bea6fbb:


    th "Görünüşe göre, ikinci bir tur atmam ve bu kampta bir hafta daha yaşamam gerekecek."


translate turkish day7_main_1358eee6:


    th "Ama bu sefer her şeyi biliyorum!"


translate turkish day7_main_08625009:


    me "Daha valizimi hazırlamadım...{w} Zaten hazırlayacak çok şeyim yok."


translate turkish day7_main_6f9aa3f1:


    sl "Tamam..."


translate turkish day7_main_a04a9677:


    "Slavya bakışlarını kaydırdı."


translate turkish day7_main_fe79dc7e:


    "Bir şey söylemek ister gibiydi ama tereddüt etti."


translate turkish day7_main_9a860373:


    sl "Peki, görüşürüz o zaman!"


translate turkish day7_main_279eeea1:


    me "Evet..."


translate turkish day7_main_0f8792e5:


    th "En azından ne zaman ayrılacağımızı sormam gerekiyordu."


translate turkish day7_main_adbb8b50:


    "Meydana bunu keşfetme niyetiyle gittim."


translate turkish day7_main_dd4f3123:


    th "Orada tanıdığım biri olmalı!"


translate turkish day7_main_a261ff3b:


    "Ama ister inanın ister inanmayın, meydanda beni bekleyen sadece Genda vardı."


translate turkish day7_main_588af67a:


    th "Muhtemelen tüm öncüler toparlanmakla meşguldü."


translate turkish day7_main_6ae3edb7:


    "Bir banka oturdum ve gökyüzüne baktım."


translate turkish day7_main_76f33ef6:


    th "Anlaşılan bugün sadece kalkışı beklemem, otobüste sızmam ve tıpkı ilk günkü gibi yine bu kampta uyanmam gerekiyordu..."


translate turkish day7_main_2163cc41:


    "Her şey sessizlik içinde boğuluyordu."


translate turkish day7_main_a7963ac8:


    "Güneşin gökyüzünde sıkışıp kaldığı, kuşların ve cırcır böceklerinin öğle sonrası uykusuna yattığı ve rüzgârın akşam saatlerinde insanlara uzun zamandır beklenen serinliği vermek için enerjisini sakladığı bir yaz gününün tam da o saatiydi."


translate turkish day7_main_7bc45999:


    "Birden aklıma sadece öğle yemeğini kaçırmadığım, aynı zamanda kahvaltı da etmediğim geldi."


translate turkish day7_main_6274d258:


    "Kantinde bir şey aramak saçmaydı{w} öncüler yola çıkmadan hemen önce her şeyi temizlemişlerdi."


translate turkish day7_main_fbfba1db:


    "Kafamı kaşıdım ve Olga Dmitriyevna'nın kamarasına doğru ilerledim."


translate turkish day7_main_e56fa1ff:


    th "Masanın çekmecesinde yenilebilir bir şeyler olmalıydı!"


translate turkish day7_main_ea19c1fa:


    "Tam kapıya yaklaşırken biri beni çağırdı."


translate turkish day7_main_2faacefc:


    "Shurik ve Electronik hızla kulübeye yaklaştı."


translate turkish day7_main_63a9aae8:


    el "Toplandınız mı?"


translate turkish day7_main_129cce15:


    me "Toplandım bile."


translate turkish day7_main_cc5ffa9b:


    "Onu taklit ederek cevap verdim."


translate turkish day7_main_18e33553:


    el "Son birkaç gündür pek kendinde değilsin."


translate turkish day7_main_6e4c96dc:


    me "Bunu sana söyleten nedir?"


translate turkish day7_main_40962235:


    el "Nereden bileyim? Sen daha iyi bilirsin."


translate turkish day7_main_55493947:


    me "Yani, neden bu kadar endişelisin?"


translate turkish day7_main_481d2b70:


    el "Sebebi yok..."


translate turkish day7_main_10cfbea3:


    sh "Gerçek bir öncü her zaman yoldaşının sorunlarını kendi sorunları gibi ele alır!"


translate turkish day7_main_ff16defd:


    "Ona şüpheci bir bakış attım."


translate turkish day7_main_13d9478e:


    me "İlginiz için teşekkürler. Ben iyiyim."


translate turkish day7_main_88d04331:


    "Aslında çekmecede yarım somun bayat ekmek ve bir parça tütsülenmiş sosis vardı."


translate turkish day7_main_26352937:


    "Her şeyi kasıtlı bir zevkle yedim, Olga Dmitrievna'nın muhtemelen bitkileri sulamak için kullandığı kokulu suyla yıkadım."


translate turkish day7_main_c67840a3:


    "Tam bitirmiştim ki, biri kapıyı çalmaya başladı."


translate turkish day7_main_48555f41:


    me "İçeri gel."


translate turkish day7_main_ed42b147:


    "Ulyana aceleyle odaya girdi."


translate turkish day7_main_bb2205bc:


    us "Oh, sadece sen varsın!"


translate turkish day7_main_3db311fc:


    "Hayal kırıklığına uğradığını söyledi."


translate turkish day7_main_b9fcdeff:


    me "Peki kimi görmeyi bekliyordun? Ayılarla dolu bir sirk mi?"


translate turkish day7_main_94876b55:


    "Ulyana kıkırdadı."


translate turkish day7_main_da46daf5:


    us "Olga Dmitrievna nerede?"


translate turkish day7_main_595d7b8c:


    me "Bilmiyorum."


translate turkish day7_main_8e0229dd:


    "Omuz silktim."


translate turkish day7_main_301d3861:


    us "Neden olmasın?"


translate turkish day7_main_2f877f3b:


    me "Bilmiyorum çünkü bilmiyorum...{w} Ondan ne istiyorsun ki zaten?"


translate turkish day7_main_756d3f6a:


    us "Ayrılmadan önce bir şey sormam lazım."


translate turkish day7_main_c1537911:


    me "Tamam, onu görürsem aradığınızı söylerim."


translate turkish day7_main_95cb8133:


    us "Bu arada, neden toplanmıyorsun?"


translate turkish day7_main_3178b41b:


    me "Sanki toplanacak çok şeyim var da..."


translate turkish day7_main_fa77eb7d:


    us "Peki, görüşürüz!"


translate turkish day7_main_84ce9118:


    "Sinsi bir gülümseme takındı ve kapıyı arkasından çarparak kamaradan dışarı fırladı."


translate turkish day7_main_b0f8ec72:


    "Ve hala, kimsenin bu ani ayrılışa şaşırmamış gibi görünmesi gerçekten garip."


translate turkish day7_main_80d609d4:


    th "Ve neden bunu beklemeyen tek kişi benim?"


translate turkish day7_main_e2fab788:


    th "Eşyalarımı toplayıp toplamadığım herkesin umurunda mı sanki?"


translate turkish day7_main_fa546b6a:


    th "Bunun yanı sıra, bunun birbirimizi son görüşümüz olması da kimsenin umurunda değil...?"


translate turkish day7_main_dcef1d84:


    "Dün ormandaki o adamın kampın tüm kiracılarının gerçek dışı olduğuna dair sözleri birden aklıma geldi."


translate turkish day7_main_de05ab05:


    th "Şu anda buna inanmaya her zamankinden daha hazırım."


translate turkish day7_main_d7317467:


    "Kahvaltımı bulduğum masanın çekmecesinde bir sürü ıvır zıvır vardı."


translate turkish day7_main_d43240e6:


    "Bir kalem ve bir kağıt parçası aldım, bir süre inceledim ve sonra cebime attım."


translate turkish day7_main_8dcd7fa6:


    th "Ne olur ne olmaz!"


translate turkish day7_main_39f8f65c:


    "Etrafta koşuşturan ve eşyalarını toplayan öncüleri izlemeye hiç niyetim yoktu, bu yüzden yatağıma uzandım ve nasıl sersemlediğimi fark etmedim bile...."


translate turkish day7_main_a20cefa7:


    "..."


translate turkish day7_main_59194f62:


    "Beni uyandıran birinin sesiydi."


translate turkish day7_main_9e6959c5:


    "Tanıdık bir öncü tam karşımda, sırtı bana dönük bir şekilde oturuyordu."


translate turkish day7_main_937c66f2:


    "Dünden beri ona biraz alışmıştım ve hatta ondan korkmayı bırakmış gibiydim."


translate turkish day7_main_d1240714:


    me "Hey, neden hep yüzünü saklıyorsun?"


translate turkish day7_main_cc040a11:


    pi "Çünkü görmemelisin."


translate turkish day7_main_0fa7e23d:


    me "Madem öyle diyorsunuz."


translate turkish day7_main_9ca20712:


    "Tartışacak durumda değildim."


translate turkish day7_main_c1b4c0f1:


    me "Peki, bu sefer ne açıklayacaksın?"


translate turkish day7_main_600f0c98:


    pi "Seansın son günü olduğunu zaten biliyorsun, değil mi?"


translate turkish day7_main_fc30fd2b:


    me "Evet."


translate turkish day7_main_6800c2ff:


    pi "Ve onunla zaten konuştun mu?"


translate turkish day7_main_fc30fd2b_1:


    me "Evet."


translate turkish day7_main_cf3c4c1e:


    pi "Peki, sana ne söyledi?"


translate turkish day7_main_4a46ef3d:


    me "Özel bir şey söylemedi. Buradan bir çıkış olduğunu söyledi."


translate turkish day7_main_6beb007e:


    "Öncü kahkahalara boğuldu."


translate turkish day7_main_caf2ecdd:


    pi "Evet, yıllar önce ben de buna inanıyordum."


translate turkish day7_main_f6352aef:


    me "Peki ya şimdi?"


translate turkish day7_main_52ab222f:


    pi "Peki 'şimdi' nedir? Geçmişim var, o zamanki hayatım..."


translate turkish day7_main_867d892e:


    "Bir süre konuşmayı kesti."


translate turkish day7_main_015d5bda:


    pi "Her neyse, hepsi uzun zaman önceydi, bu yüzden gerçekten hatırlamıyorum."


translate turkish day7_main_499952ad:


    pi "Gelecek hep aynı - döngüler, döngüler, döngüler, aynı hikayenin tekrarları{w} Şimdi bu nerede?"


translate turkish day7_main_50a2b7a7:


    me "Bunu söylemekten nefret ediyorum ama ben henüz sizin kadar zamanın içinde kaybolmuş değilim."


translate turkish day7_main_09c7c654:


    pi "Oh, bu bir şey değil! Zamanla geçer!"


translate turkish day7_main_54556d0f:


    "Şeytani bir kahkaha attı."


translate turkish day7_main_2ede7e21:


    me "Anlamadığım tek bir şey var - bana gelme sebebiniz nedir? Ne elde etmeyi umuyorsun?"


translate turkish day7_main_ed700d2d:


    pi "Ben mi? Gerçekten hiçbir şey."


translate turkish day7_main_ed4c078d:


    me "O zaman neden geldin?"


translate turkish day7_main_239cb75b:


    pi "Çünkü sen, o ve bizim gibiler buradaki tek gerçek insanlarsınız."


translate turkish day7_main_cce08df0:


    "Bana söylediği her şeyi göz önünde bulundurduğumda, tüm yerel kiracıların bir tür cehennem oyunundaki kuklalar olduğuna inanmaya hazır değildim."


translate turkish day7_main_4529ad5a:


    me "Haklı olduğuna emin misin?"


translate turkish day7_main_6fa19435:


    pi "Hangi konuda?"


translate turkish day7_main_311f2261:


    me "Şey... Her konuda haklı olduğunu mu?"


translate turkish day7_main_1e5d88ee:


    pi "Doğru ya da yanlış olamam. Bu dünyayı ben seçmedim, kendimi içine ben atmadım. Ben sadece buradayım. Ve sen de buradasın."


translate turkish day7_main_8b97aebf:


    me "Dinle, felsefe yapmandan dolayı başım ağrımaya başladı bile."


translate turkish day7_main_d4c1382a:


    "Bu gizemli öncüyle konuşurken neden bu kadar sakin olduğuma ben de şaşırmıştım."


translate turkish day7_main_0e575d19:


    th "İşte burada, tam önümde - bu kampta yaşanan tüm fantezi ve şeytanlıklar."


translate turkish day7_main_265d8152:


    th "İşte burada - buraya nasıl geldiğime dair bir açıklama (en azından kısmi bir açıklama)."


translate turkish day7_main_377ed3b6:


    th "İşte burada - uzun zamandır aradığım cevaplar!"


translate turkish day7_main_0a0561bd:


    "Öte yandan, benim davranışım oldukça mantıklıydı."


translate turkish day7_main_d9e03d7d:


    "Ne olduğunu tam olarak açıklayamasam da, bu guguklu adam sadece konuştu ve konuştu, ama sözleri hiçbir şeyi değiştirmedi."


translate turkish day7_main_8a6c765f:


    "O zaman onu dinlemenin ne anlamı var?"


translate turkish day7_main_6a19df1b:


    pi "Oh, hayır! Yakında her şeyi kendin anlayacaksın."


translate turkish day7_main_5022bc8a:


    "Biri kapıyı çalıyordu{w} açmak için kalktım."


translate turkish day7_main_482a0501:


    "Kapının eşiğindeki Slavya'ydı."


translate turkish day7_main_fad161d6:


    me "Olga Dmitrievna'yı görmeye mi geldin?"


translate turkish day7_main_37eba565:


    sl "Hayır."


translate turkish day7_main_7e6970f3:


    me "İçeri gel o zaman."


translate turkish day7_main_c073a9b1:


    "Öncünün çoktan ortadan kaybolduğundan yüzde yüz emindim."


translate turkish day7_main_8cf78390:


    "Meğer haklıymışım."


translate turkish day7_main_6a9ff616:


    "Slavya yatağa oturdu, ben de odanın uzak köşesindeki gardıroba sokuldum."


translate turkish day7_main_c8621acb:


    "Belirgin bir şekilde gergindi."


translate turkish day7_main_ea63ce77:


    me "Bir şey mi oldu?"


translate turkish day7_main_c18a9682:


    sl "Pek sayılmaz. Sadece bugün son gün."


translate turkish day7_main_165306ee:


    me "Ben zaten farkındayım. Geç olması hiç olmamasından iyidir."


translate turkish day7_main_6a46b661:


    sl "Ben de öyle düşünmüştüm...{w} Yani...{w} Muhtemelen birbirimizi bir daha görmeyeceğiz."


translate turkish day7_main_2aa28af8:


    me "Dedikleri gibi, dünya küçük."


translate turkish day7_main_aaf30b84:


    sl "Ama belki bana mektup yazmam için adresinizi verirsiniz?"


translate turkish day7_main_f178bf3d:


    th "Verirdim, eğer kendim bilseydim."


translate turkish day7_main_0b3bd099:


    me "Biliyorsun... Tam tersini yapalım. Sen bana adresini ver. Vardığımda sana kesinlikle yazacağım."


translate turkish day7_main_305689ee:


    sl "Ama neden seninkini vermek istemiyorsun?"


translate turkish day7_main_a91117ee:


    me "Şey... Taşınmak üzereydik, yani asla bilemezsin...{w} Sana yazsam daha iyi olur."


translate turkish day7_main_f734a826:


    "Hikayemi daha inandırıcı kılmak için en sevimli gülümsememi takınmaya çalıştım."


translate turkish day7_main_596c8eed:


    sl "Ah, tamam... Sorun yok o zaman..."


translate turkish day7_main_a4cfd165:


    "Slavya kalktı ve gidiyor gibiydi."


translate turkish day7_main_98609165:


    me "Hey, bekle, adres ne olacak?"


translate turkish day7_main_a53cdaac:


    sl "Bunu daha sonra yapalım."


translate turkish day7_main_318e3c4f:


    "Yüzünde üzüntü ve hayal kırıklığı ifadesi vardı."


translate turkish day7_main_1e9c65d7:


    "Kapıyı kapattım ve tam o sırada arkamdan öncünün kin dolu sesini duydum."


translate turkish day7_main_7fcab065:


    pi "Şimdi mutlu musun? Bir kızı incittin."


translate turkish day7_main_7700b04d:


    me "Onu neyle incittim? Ona ne söylemeliydim? Canım, köydeki sevgili büyükanneme yaz."


translate turkish day7_main_a75b7aef:


    me "Yoksa ona muhtemelen henüz inşa edilmemiş bir evin adresini mi bırakmalıydım?"


translate turkish day7_main_87494573:


    pi "Ne olmuş yani? Ben kardeşimin bekçisi değilim! Bu senin dünyan, benim değil. Kendi dünyamda bir şekilde idare ederim."


translate turkish day7_main_febd1fcf:


    "Bu son cümle beni gerçekten kıvrandırdı."


translate turkish day7_main_997bc03d:


    me "Biliyor musunuz..."


translate turkish day7_main_5e237961:


    "Cümleyi tamamlayamadım - biri yine kapıyı çalıyordu."


translate turkish day7_main_6b33d385:


    me "İçeri gel!"


translate turkish day7_main_50581468:


    "Ulyana kabine uçtu."


translate turkish day7_main_a406d12c:


    me "Bu acele niye leydim?"


translate turkish day7_main_3ea49673:


    "Aşırı gösterişli bir selam verdim."


translate turkish day7_main_4081a71f:


    us "Ben mi? Ben... sadece..."


translate turkish day7_main_440da628:


    "Gözleri temkinli bir şekilde etrafta dolaştı ve yanakları kızardı."


translate turkish day7_main_02437b85:


    us "Sadece veda etmek istemiştim!"


translate turkish day7_main_47d964b9:


    me "Nasıl olsa bunun için zamanımız olacak. Ne de olsa hepimiz aynı otobüse bineceğiz."


translate turkish day7_main_6a55610a:


    us "Evet, haklısın, ama herkesin önünde biraz utanç verici."


translate turkish day7_main_7420944b:


    me "Yani utanabileceğin bir şey mi var?"


translate turkish day7_main_60bde9d8:


    "Güldüm."


translate turkish day7_main_3dc79f49:


    us "Err!"


translate turkish day7_main_366345bd:


    "Suratını astı."


translate turkish day7_main_a18522d8:


    us "Sadece senin bir pislik olmadığını söylemek istedim. Aslında, neredeyse havalı bir adamsın!"


translate turkish day7_main_7dc51ce4:


    "Sözleri beni şaşırttı."


translate turkish day7_main_f2486061:


    me "Teşekkürler...{w} Seninle takılmak da güzel."


translate turkish day7_main_4a74cafa:


    us "İşte bu kadar!"


translate turkish day7_main_519137f4:


    "Kapıyı gürültüyle çarparak dışarı fırladı."


translate turkish day7_main_d76f8bb2:


    pi "Hey, ondan bunu beklemiyordun değil mi?"


translate turkish day7_main_b78c6e26:


    me "Beklemiyor muydun?"


translate turkish day7_main_c233607a:


    pi "Benim bununla bir ilgim yok, sana söyledim."


translate turkish day7_main_e15ce1bd:


    me "Gerçekten ne söyleyeceğini biliyor gibisin."


translate turkish day7_main_5de5d3d5:


    pi "Belki de biliyordum. Belki de yapmadım."


translate turkish day7_main_b6653187:


    me "Buraya benimle alay etmeye mi geldin?"


translate turkish day7_main_6ea78a01:


    "Kendimi kaybetmeye başladım."


translate turkish day7_main_e7918564:


    pi "Bu fikir benim de aklımdan geçmişti."


translate turkish day7_main_4d6f2bc2:


    me "O zaman ne halt etmeye burada takılıyorsun?"


translate turkish day7_main_54b22d30:


    me "Yaptıklarım hakkında yorum yapacak bir erkeğe ihtiyacım olursa, profesyonel bir psikolog tutarım!"


translate turkish day7_main_3b8fbfa4:


    pi "Bunca zamandan sonra psikolog sayılmayacağımı mı düşünüyorsun?"


translate turkish day7_main_e499cb70:


    me "Tahminimce burada geçirdiğiniz onca zamandan sonra kesinlikle kafayı yemişsiniz."


translate turkish day7_main_a9edc4dd:


    pi "Bütün psikologlar ucubedir."


translate turkish day7_main_eb56bdcb:


    me "Evet, ama bütün ucubeler psikolog değildir."


translate turkish day7_main_4fdeb53f:


    "Yüksek sesle güldü."


translate turkish day7_main_28f25b65:


    pi "Mizah anlayışı, ne kadar cesaret verici! Açıkçası, esprileriniz oldukça kötü. Kime gülüyorsunuz? Kendine!"


translate turkish day7_main_7e656166:


    me "Dinle, eğer kendi dünyanda yapacak bir şeyin yoksa, git ve ikincisini dinle."


translate turkish day7_main_8cd37642:


    pi "Peki senin kendi dünyanda yapacak bir şeyin var mı?"


translate turkish day7_main_18cd1dcb:


    "Öncü sertçe karşı çıktı."


translate turkish day7_main_06f26021:


    me "Biliyorsun, ne yapacağımı bulacağım... Eşyalarımı toplayıp, bu kampı terk edeceğim."


translate turkish day7_main_925fc2f3:


    pi "Sonra ne olacak?"


translate turkish day7_main_9791c0b4:


    me "Sonra ne...{w} Bildiğim gibi!"


translate turkish day7_main_f05adfcc:


    me "İster inanın ister inanmayın, daha önce hiç böyle bir durumla karşılaşmadım."


translate turkish day7_main_7109a0ab:


    pi "Sadece kamptan ayrılamayacağınızı unuttunuz."


translate turkish day7_main_a4f8c07f:


    th "Evet, bu konuda haklıydı.{w} Muhtemelen..."


translate turkish day7_main_c8fda9f8:


    me "Sen başaramadın diye ben de başaramayacağım anlamına gelmez!"


translate turkish day7_main_f038ee18:


    pi "Patron sensin."


translate turkish day7_main_cc46f69e:


    "Kapı çalındı. O kadar sessizdi ki zar zor duydum."


translate turkish day7_main_67e1f584:


    me "Lanet olsun, başka kim olabilir?!"


translate turkish day7_main_c78e5705:


    "Nefesimin altında tısladım ve bağırdım:"


translate turkish day7_main_6b33d385_1:


    me "İçeri gel!"


translate turkish day7_main_abbe1f0a:


    "Ama kapı açılmadı."


translate turkish day7_main_c5b18002:


    "Ben de kolu kendim çektim."


translate turkish day7_main_26171c75:


    "Lena kapının eşiğindeydi."


translate turkish day7_main_40993023:


    "Görünüşe göre onu gerçekten korkutmuşum."


translate turkish day7_main_200803e8:


    me "Özür dilerim, istemeden... Olga Dmitrievna'yı görmeye mi geldiniz?"


translate turkish day7_main_049b021f:


    un "Hayır, gelmedim."


translate turkish day7_main_ed81b2e1:


    "Yere bakarak söyledi."


translate turkish day7_main_84eb3967:


    me "Peki, ne o zaman?"


translate turkish day7_main_5f2d59cb:


    th "Lena benden ne istedi?"


translate turkish day7_main_2526c703:


    me "İçeri gel."


translate turkish day7_main_b516a337:


    "İçeri girdi ve odanın ortasında duraksadı."


translate turkish day7_main_e22a9c2a:


    me "Oturmak ister misin?"


translate turkish day7_main_d6169916:


    "Yataklardan birini işaret ettim."


translate turkish day7_main_2d050cb5:


    "Lena biraz daha tereddüt etti ama yine de oturdu."


translate turkish day7_main_ea63ce77_1:


    me "Bir şey mi oldu?"


translate turkish day7_main_72b9a973:


    un "Hiç de değil, sadece..."


translate turkish day7_main_918776a6:


    "Bana hızlı bir bakış fırlattı ama hemen kızardı ve gözlerini kaçırdı."


translate turkish day7_main_bacbd43d:


    un "İşte!"


translate turkish day7_main_989da459:


    "Lena cebinden bir şey çıkardı ve bana uzattı."


translate turkish day7_main_23db2f78:


    "Şaşırmıştım - bu benim telefonumdu."


translate turkish day7_main_27205bdb:


    me "Ama... Onu nereden aldın?"


translate turkish day7_main_8836199f:


    un "Ormanda buldum."


translate turkish day7_main_e109c728:


    me "Tamam, ama neden benim olduğunu düşünüyorsun?"


translate turkish day7_main_2bc078c7:


    un "Bir çocuk bana öyle söyledi."


translate turkish day7_main_75088da6:


    me "Onu daha önce hiç gördünüz mü?"


translate turkish day7_main_da35aa0b:


    un "Bilmiyorum, yüzünü göremiyordum ama öncü üniforması giymişti."


translate turkish day7_main_c773393c:


    "Her şey bir anda netleşti."


translate turkish day7_main_82b1e370:


    me "Ne olduğunu merak etmiyor musun?"


translate turkish day7_main_30490fdf:


    "Ekrana baktım - hala biraz pil vardı, bu nedenle cep telefonu Lena'ya sadece bir plastik parçası gibi görünmemeliydi."


translate turkish day7_main_4f35044c:


    un "Bilmiyorum, bir çeşit oyun."


translate turkish day7_main_a3eea1e0:


    me "Evet, haklısın."


translate turkish day7_main_577b13f1:


    "Menüden hızlıca Snake'i açtım ve telefonu ona uzattım."


translate turkish day7_main_19416c28:


    me "Al bakalım! Bir hatıra!"


translate turkish day7_main_afefddf2:


    un "Oh, ne yapıyorsun, ben..."


translate turkish day7_main_2ed4ff25:


    "Lena ellerini bana doğru salladı."


translate turkish day7_main_f4b1f89a:


    me "Al şunu, evde bunlardan bir sürü var."


translate turkish day7_main_cdda1bfc:


    "Biraz daha direndi ama sonunda cihazı aldı."


translate turkish day7_main_c67a4136:


    un "Peki onunla ne yapacağım?"


translate turkish day7_main_9216d06a:


    me "Sağa ve sola hareket etmek için tuşlara basın, bu peletleri yemeli ve kendi kuyruğunuza çarpmamalısınız."


translate turkish day7_main_1239b2a3:


    un "Vay canına, çok ilginç!"


translate turkish day7_main_d1046a49:


    "Gülümsedi."


translate turkish day7_main_1aa9d6c3:


    un "Teşekkür ederim! Yine de sana verecek bir şeyim yok, bu çok utanç verici."


translate turkish day7_main_58e414f2:


    me "Hiçbir şeye ihtiyacım yok, teşekkürler."


translate turkish day7_main_d4366f58:


    un "Hayır, bu hiç iyi değil!"


translate turkish day7_main_2b2d9484:


    "Her zamankinden daha kendinden emin bir sesle söyledi."


translate turkish day7_main_39665fa5:


    un "Ne de olsa bugün son gün."


translate turkish day7_main_9513cd87:


    me "Evet..."


translate turkish day7_main_f93613f2:


    un "Umarım tekrar karşılaşırız."


translate turkish day7_main_e16f1ab0:


    me "Bence görüşeceğiz."


translate turkish day7_main_77f2eecc:


    un "O zaman sana bir hediyem var."


translate turkish day7_main_5109b055:


    me "Neymiş o?"


translate turkish day7_main_03f55ca9:


    un "Gözlerini kapat."


translate turkish day7_main_7fdc006d:


    "Öyle yaptım."


translate turkish day7_main_deebb2e3:


    un "Ve ben söyleyene kadar onları açmayacağına söz ver!"


translate turkish day7_main_71d3b8c8:


    me "Tamam, tamam."


translate turkish day7_main_b472b19d:


    un "Hayır, söz vermelisin!"


translate turkish day7_main_1f17061d:


    me "Tamam, söz veriyorum!"


translate turkish day7_main_3e527e8e:


    "Bir anda yanağımda hafif bir öpücük hissettim."


translate turkish day7_main_7aaa79b3:


    "Gözlerimi açmak için çok hevesliydim ama söz verdim..."


translate turkish day7_main_d8b768ba:


    un "Aç!"


translate turkish day7_main_d6d054a1:


    "Oda boştu."


translate turkish day7_main_188f31b1:


    me "Ne kız ama..."


translate turkish day7_main_026f195c:


    "Söyleyebildiğim tek şey buydu."


translate turkish day7_main_9d8b1602:


    pi "Ee, nasıl hissediyorsun, aygır?"


translate turkish day7_main_56c91cad:


    "Lena'nın az önce oturduğu yerden kötü niyetli kahkahalar duydum."


translate turkish day7_main_0802a5ba:


    me "Demek bana şaka yapmanın yeni yolu bu, ha? Diğerlerini kullanmak?"


translate turkish day7_main_82d1e669:


    pi "Beni mi? Şaka mı yapıyorsun? Allah korusun!{w} Gerçekten, sayemde tatlı bir kızdan öpücük aldın! Yanağından ama neyse..."


translate turkish day7_main_20d94de6:


    "O anda onu gerçekten dövmek istedim, ama onun burada fiziksel bir varlık olduğundan bile emin değildim."


translate turkish day7_main_9183379b:


    me "Sanırım bu son şakan değildi?"


translate turkish day7_main_fcc63fd6:


    "Dedim, daha sakin."


translate turkish day7_main_e02cb0bc:


    pi "Kim bilir, kim bilir...{w} Eğlenceli değil mi?"


translate turkish day7_main_d2749b3c:


    "Öncü sertçe güldü. Belki de Profesör Moriarty şeytani planının başarıya ulaşacağını tahmin ederek böyle gülmüştü."


translate turkish day7_main_7a033c20:


    me "Sen kesinlikle eğleniyorsun, ama ben eğlenmiyorum."


translate turkish day7_main_33573f9b:


    pi "Sakin ol, dostum! Neredeyse hiçbir şey kalmadı - ve işte, ikinci turun!"


translate turkish day7_main_e2a097db:


    pi "Bir düzine yaptıktan sonra bir pit-stop kazanacaksın{w} Gerçi o zaman muhtemelen bana ihtiyacın olmayacak - her şeyi kendin çözeceksin."


translate turkish day7_main_15b2c48a:


    me "Şu anda da sana ihtiyacım yok."


translate turkish day7_main_d7caa3c1:


    pi "Oh, ne nankörlük..."


translate turkish day7_main_417a57f0:


    me "Kes şunu!"


translate turkish day7_main_6c7b7a89_1:


    pi "Eğer sen hiç..."


translate turkish day7_main_5f318380:


    me "Kapa çeneni artık!"


translate turkish day7_main_0d2ff854:


    pi "Anlamak yok."


translate turkish day7_main_6d00754d:


    me "KAPAT O LANET ÇENENİ!!!"


translate turkish day7_main_2d7f3c73:


    "O kadar yüksek sesle bağırdım ki duvarlar titredi."


translate turkish day7_main_348c1e05:


    "Ön kapı aniden açıldı ve Alisa içeri girdi."


translate turkish day7_main_69acda8f:


    dv "Bana mı öyle geliyor yoksa biri kafayı mı yedi?"


translate turkish day7_main_93c290bf:


    "Korkuyla sordu."


translate turkish day7_main_dd69c3a1:


    me "Öyle de denebilir."


translate turkish day7_main_a172912c:


    "Öfkeyle cevap verdim."


translate turkish day7_main_b7182058:


    dv "Neden bağırıyorsun?"


translate turkish day7_main_5c9c623e:


    me "Çünkü istiyorum."


translate turkish day7_main_7efa97c5:


    "Alisa'nın 'tesadüfen' gelişinin ya bu öncü tarafından planlandığını ya da duymaktansa kulaklarıma bir çift çivi çakmayı tercih edeceğim bir şekilde yorumlanacağını çoktan fark ettim."


translate turkish day7_main_f20d0c38:


    dv "Psikopat falan mı oldun sen?"


translate turkish day7_main_a4579566:


    "Alisa rahat bir tavırla yatağa uzandı."


translate turkish day7_main_bec896af:


    me "Bu onuru neye borçluyum?"


translate turkish day7_main_d28f8e57:


    dv "Sırf bunun için geldim. Ve sen sadece burada çığlık atıyorsun."


translate turkish day7_main_0a9c213a:


    me "Hiçbir şeyi 'sırf yapmış olmak için' yapmıyorsun."


translate turkish day7_main_f58c07db:


    dv "Yapacak bir şeyim yok. Eşyalarımı topladım. Çok sıkıcı."


translate turkish day7_main_af374609:


    me "Vay, vay..."


translate turkish day7_main_e9100bc5:


    dv "Eğer sana geldiğimi düşünüyorsan..."


translate turkish day7_main_7386d3f8:


    "Bana kızgın bir bakış fırlattı ve arkasını döndü."


translate turkish day7_main_2e5dec60:


    dv "Ondan sonra gerçekten gelmemeliydim!"


translate turkish day7_main_8e7c35a6:


    me "Neyden sonra? Tek kelime etmedim."


translate turkish day7_main_84a9b240:


    dv "Elbette söyledin! Onun yerine sen düşündün!"


translate turkish day7_main_7179f364:


    me "Şimdi de zihin mi okuyabiliyorsun?"


translate turkish day7_main_9b855aa7:


    dv "Zihninizi okumaya gerek yok - yüzünüzün her yerinde yazıyor."


translate turkish day7_main_e18b878d:


    "Yüzümde yorgunluk ve öfke dışında bir şey okumak pek mümkün değildi."


translate turkish day7_main_7b79a718:


    me "Peki sen ne okudun?"


translate turkish day7_main_359525c1:


    dv "Bu seni ilgilendirmez!"


translate turkish day7_main_4dfbba46:


    me "Seni burada tutacak değilim ya."


translate turkish day7_main_ee0160d3:


    dv "Unut gitsin! Nereye istersem oraya giderim. Bana patronluk taslama."


translate turkish day7_main_7a6ef78d:


    me "Tamam, burada kal o zaman, Tanrı aşkına!"


translate turkish day7_main_5a25a62a:


    "Her neyse, Alisa'nın arkadaşlığı öncününkinden çok daha hoşuma gitti."


translate turkish day7_main_35fda676:


    "Arkama yaslandım ve gözlerimi kapattım."


translate turkish day7_main_09b65c63:


    "Alisa'nın sessizliği bozması birkaç dakika sürdü."


translate turkish day7_main_35834dca:


    dv "Gerçekten bana bir şey söylemek istemiyor musun?"


translate turkish day7_main_e473fa2f:


    me "Mesela?"


translate turkish day7_main_81291356:


    dv "Ne de olsa bugün son gün."


translate turkish day7_main_029a43e7:


    me "Mutlu musun yani?"


translate turkish day7_main_87a35bd8:


    dv "Şey..."


translate turkish day7_main_17f57844:


    "Kararsızca geveledi."


translate turkish day7_main_3930aa38:


    dv "Herkes gidiyor."


translate turkish day7_main_eef28ca7:


    me "İyi kurtulduk."


translate turkish day7_main_6589795d:


    dv "Hepsi bu kadar mı?"


translate turkish day7_main_aa5aa16f:


    me "Başka bir şeye ihtiyacın var mı?"


translate turkish day7_main_493ea103:


    dv "Burayı sevmedin mi?"


translate turkish day7_main_d0b8151b:


    "Sesi alışılmadık geliyordu."


translate turkish day7_main_26cff5fe:


    me "Daha iyi yerler gördüm."


translate turkish day7_main_f853a1e5:


    dv "Kahretsin, o kadar aptalsın ki seninle konuşmak tamamen zaman kaybı."


translate turkish day7_main_739017d2:


    "Ayağa kalktı ve çıkışa yöneldi."


translate turkish day7_main_cfa74516:


    me "Evet, sana da iyi şanslar!"


translate turkish day7_main_d6ac8c0a:


    "Alisa bana döndü{w} yüzü öfkeyle kıvranıyordu."


translate turkish day7_main_546c756b:


    dv "En azından beni özleyeceğini söyleyemez miydin?!"


translate turkish day7_main_0b12d1b2:


    me "Tabii ki özleyeceğim."


translate turkish day7_main_db268193:


    dv "Pısırık!"


translate turkish day7_main_06efabf4:


    "Kapıyı yüksek sesle çarptı."


translate turkish day7_main_ac6d49df:


    me "Aptal!"


translate turkish day7_main_19e291ef:


    "Alisa son cümlemi duymadı tabii ki."


translate turkish day7_main_3f9dd422:


    pi "Ne asi bir piliç, değil mi?"


translate turkish day7_main_71dbf37a:


    me "Senin kadar iyi."


translate turkish day7_main_fe52d02d:


    pi "Ve sen, bu durumda."


translate turkish day7_main_dec36634:


    me "Tabii ki, beni kendinle kıyaslamaya devam et."


translate turkish day7_main_cc9559a7:


    "Muzip bir şekilde söyledim."


translate turkish day7_main_f5e0300a:


    pi "Ama ne fark eder ki? Aynı durumdayız, sadece ben biraz daha uzun süredir buradayım. Aslında çok daha uzun süredir."


translate turkish day7_main_224b03df:


    me "Ve sen zaten tamamen delirmişsin."


translate turkish day7_main_c299cbd0:


    pi "Şaşırmadım."


translate turkish day7_main_6a69d0f4:


    "Boğuk kahkahası beni gerçekten kızdırıyordu."


translate turkish day7_main_69abf7b9:


    me "Dinle, sana daha önce aktör olman gerektiğini söylemiş miydim? Harika bir Hannibal Lecter olurdun!"


translate turkish day7_main_f93c3816:


    me "Özellikle de kendini bir psikiyatrist olarak gördüğün için."


translate turkish day7_main_5521fd0f:


    pi "Bunu düşüneceğim. Şimdi gitmeliyim! Belki seni tekrar görürüm."


translate turkish day7_main_658edb67:


    me "Kaybol!"


translate turkish day7_main_7b4acbfa:


    "Ona bakmak için döndüm ama öncü çoktan ortadan kaybolmuştu."


translate turkish day7_main_f23afdfa:


    me "Oh, sonunda!"


translate turkish day7_main_bc9abf02:


    th "Ama yine de neden gelmişti?"


translate turkish day7_main_0da09332:


    "Belki de buradaki tek gerçek insanlar ben, o ve bizim gibilerdi ama ben buna inanmak istemiyordum."


translate turkish day7_main_01d888f8:


    "Tüm konuşmaları karmaşık bir oyun gibi görünüyordu."


translate turkish day7_main_0c605775:


    "Sanki bana birbiri ardına ipuçları vermeye çalışıyor, beni bir şeye yönlendirmeye çalışıyor, bir tür sinsi komployu keşfetmemi sağlıyor."


translate turkish day7_main_801bab94:


    th "Bunda pek başarılı olamaması çok kötü, çünkü fikirlerim tükendi......"


translate turkish day7_main_a20cefa7_1:


    "..."


translate turkish day7_main_bee56547:


    "Zaman aldatıcı bir şekilde ağır aksak ilerliyor, ama saat çoktan 17:00 olmuş."


translate turkish day7_main_891514f3:


    "Yaz aylarında sık rastlanan bir durumdur bu - saniyeleri ve dakikaları sayınca bir saat bile hiç bitmeyecekmiş gibi gelir, ama insan başka bir şey düşünürse bütün gün hızla akıp gider."


translate turkish day7_main_941b1a51:


    "Toplanmaya başlamaya karar verdim."


translate turkish day7_main_fb69cac0:


    th "Bensiz de gidebilirlerdi..."


translate turkish day7_main_511be532:


    "Bütün kışlık eşyalarımı hızla alıp bir çantaya tıkıştırdım. Neredeyse tekrar yatağa atlayacaktım ki kapı açıldı ve Olga Dmitrievna içeri girdi."


translate turkish day7_main_d8e5d2bb:


    mt "Bakıyorum da toparlanmışsın bile. Bu harika! Hadi gidelim!"


translate turkish day7_main_ce6ffaad:


    "İsteksizce kalktım, basit valizimi aldım ve onu takip ettim."


translate turkish day7_main_54c4948c:


    th "Bundan sonra ne olacağı gerçekten umurumda değil."


translate turkish day7_main_5af78794:


    th "Uzun zamandır bu dünyada hiçbir şeyin bana bağlı olmadığından şüpheleniyordum ve son olaylar bu konudaki inancımı pekiştirdi."


translate turkish day7_main_06390870:


    th "Yarın 410 numaralı otobüste uyanabilirim ya da hiç uyanmayabilirim."


translate turkish day7_main_5826caff:


    th "Hepsi bu kadar millet, hepsi bu kadar basit."


translate turkish day7_main_1a9d1f7c:


    th "Burada kalmanın bir anlamı yok, kaçacak bir yer yok."


translate turkish day7_main_8dc6c9ca:


    th "Aslında tek çıkış yolum herkesle birlikte otobüse binip gitmek{w} bilinmeyene doğru gitmek."


translate turkish day7_main_e4adaddf:


    th "Son bir haftadır yaptığım tek şey buydu - zifiri karanlıkta, nerede başlayıp nerede bittiğini bilmediğim dar bir patikada tökezleyerek ilerlemek."


translate turkish day7_main_0d0d1634:


    "Neredeyse kapılara yaklaşıyorduk ki birinin adımı söylediğini duydum."


translate turkish day7_main_592b8e1f:


    bush "Semyon... Semyon..."


translate turkish day7_main_f779d1e3:


    me "Olga Dmitrievna, affedersiniz, bir dakika."


translate turkish day7_main_65032a00:


    mt "Tamam, ama çabuk ol yoksa sensiz gideriz!"


translate turkish day7_main_18687800:


    "Sesin geldiği çalılıklara doğru yöneldim."


translate turkish day7_main_592b8e1f_1:


    bush "Semyon... Semyon..."


translate turkish day7_main_36c554a3:


    "Sık yeşilliklerin arasından geçtim ve bir orman yoluna çıktım."


translate turkish day7_main_52117956:


    "Ses sanki hiçbir yerden gelmiyordu: bir an bir ağacın arkasından geliyordu, şimdi ise arkamdan geliyor gibiydi."


translate turkish day7_main_8d4918eb:


    "Muhtemelen paralel dünyalardan gelen uzaylılardan biri, ama daha önce böyle biriyle karşılaşmadığımdan şüpheleniyorum."


translate turkish day7_main_f24bb417:


    bush "Fazla zamanımız yok."


translate turkish day7_main_fd341de6:


    me "Dinliyorum."


translate turkish day7_main_6b2e53ca:


    bush "Onunla çoktan iletişime geçtiğinizi biliyorum."


translate turkish day7_main_fc30fd2b_2:


    me "Evet."


translate turkish day7_main_6c48903a:


    bush "Ve sana ne söylediklerini biliyorum. Bana nasıl olduğunu sorma."


translate turkish day7_main_53a56040:


    me "Tamam."


translate turkish day7_main_0e7f1fb9:


    bush "Ama bir şeyi bilmelisin. Bildiğim bir şey var...{w} Burada bir düzineden fazla kişiyiz. Aslında, binden fazla..."


translate turkish day7_main_85f19512:


    bush "Ama pek çok insan dışarı çıktı."


translate turkish day7_main_3cf4cc40:


    "Söylediklerini sindirmeye ve doğru soruları ifade etmeye çalıştım."


translate turkish day7_main_5c937cbe:


    me "O zaman neden buradasın?"


translate turkish day7_main_df98d116:


    bush "Kaldım."


translate turkish day7_main_7332342b:


    me "Neden?"


translate turkish day7_main_0f22f523:


    bush "Başkalarının bir çıkış bulmasına yardım etmek için!"


translate turkish day7_main_d52f7ebb:


    th "Vay canına, ne kadar cömertsin."


translate turkish day7_main_fc7d44e9:


    me "Sana neden güveneyim ki? Sen zaten üçüncü kişisin...{w} Aslında hepinizin benim halüsinasyonum olmadığınızdan bile emin değilim."


translate turkish day7_main_6972bbdc:


    bush "Bu güvenle ilgili değil."


translate turkish day7_main_ca1e4751:


    me "O zaman neyle ilgili?"


translate turkish day7_main_be914630:


    bush "Doğru seçimle ilgili!"


translate turkish day7_main_ac9043c1:


    bush "Bu kampı dev bir labirent olarak düşünün - bir çıkış bulmak için birkaç doğru dönüş yapmalısınız."


translate turkish day7_main_bc5b6d3b:


    me "Peki, hangilerinin doğru olduğunu nasıl bileceğim?"


translate turkish day7_main_58019608:


    bush "Bileceksin. Benimle gel."


translate turkish day7_main_1878bc08:


    me "Nereye?"


translate turkish day7_main_4a75165b:


    bush "İkinci tura."


translate turkish day7_main_34fc2c23:


    me "Bir saniye...{w} O öncü ikinci turumun yarın başlayacağını söyledi."


translate turkish day7_main_ac491a56:


    bush "Yalan söyledi!"


translate turkish day7_main_1386fd85:


    "Konuşmacı sesini yükseltti."


translate turkish day7_main_73da8c64:


    bush "Tamamen çıldırmış ve diğerlerini yok etmeye çalışıyor!"


translate turkish day7_main_20f48057:


    me "Yani, eğer seninle gelmezsem ve otobüsle gidersem. mahvolurum, değil mi?"


translate turkish day7_main_8422eef3:


    bush "Bilmiyorum..."


translate turkish day7_main_c5e0555a:


    me "O zaman neden böyle söylüyorsun?"


translate turkish day7_main_f2ac56d7:


    bush "Kimse onunla konuştuktan sonra geri dönmedi."


translate turkish day7_main_50e4f830:


    me "Dinle, sana neden güveneyim?"


translate turkish day7_main_aa1b7016:


    "Kesinlikle diken üstündeydim."


translate turkish day7_main_817f4941:


    th "O öncü benimle sadece dalga geçerken ve gerçek bir tehlike gibi görünmezken, bu öncü açıkça endişelenmeye değer şeylerden bahsediyordu."


translate turkish day7_main_9bad067c:


    th "Hangisine güvenmem gerektiğine karar veremiyordum."


translate turkish day7_main_e1e025fb:


    th "Bu sorun kör bir adama odadaki ışığın açık mı kapalı mı olduğunu söyletmeye çalışmak gibi."


translate turkish day7_main_355517e6:


    th "Sadece tahmin edebilir. Tıpkı benim gibi."


translate turkish day7_main_068aa355:


    bush "Acele et, zaman tükeniyor!"


translate turkish day7_main_aff91d3f:


    me "Hey, bekle bir saniye."


translate turkish day7_main_77d3e654:


    bush "Bir seçim yap. Geliyor musun, gelmiyor musun?"


translate turkish day7_main_f6c00c2d:


    me "Tamam, gidelim."


translate turkish day7_main_3976ac4c:


    th "Her neyse, kulağa çılgın öncüden daha inandırıcı geliyordu."


translate turkish day7_main_f59377cf:


    th "Elbette bu çözüm ölümcül olabilir ama alternatifi de daha iyi değil."


translate turkish day7_main_220c95fc:


    "Karanlıkta bir atış yaptım."


translate turkish day7_main_2715a6e1:


    me "Tamam, nereye gidiyoruz?"


translate turkish day7_main_b3a4212e:


    bush "Zaten oradayız..."


translate turkish day7_main_9c4ed245:


    "Görüşüm azalmaya başladı ve bilincimin beni terk ettiğini hissettim..."


translate turkish day7_main_300388db:


    me "Hayır, biliyor musun, sadece birkaç dakika içinde sana inanamam."


translate turkish day7_main_92441a59:


    th "En azından diğer adamı biraz daha uzun süredir tanıyorum ve onun argümanları daha ağır basıyor."


translate turkish day7_main_026e81de:


    bush "Pişman olacaksın."


translate turkish day7_main_c9f8c4d3:


    "Bu sözler sanki başka bir dünyadan geliyor gibiydi."


translate turkish day7_main_c80400a7:


    "Ses kaybolmuş gibiydi."


translate turkish day7_main_99e05e2b:


    "Tabii ki seçimimin doğru ya da yanlış olduğundan emin olamadım."


translate turkish day7_main_f36decb5:


    "Bu, zaman sınırlaması tarafından zorlanan kör bir tahmindi."


translate turkish day7_main_f9e8cad7:


    th "Yine de haklı olup olmadığımı yakında öğreneceğiz."


translate turkish day7_main_2c7b78d5:


    "Birkaç dakika içinde diğer öncülerle birlikte otobüs durağındaydım."


translate turkish day7_main_709d3e7d:


    mt "Herkes burada mı?"


translate turkish day7_main_14167bf5:


    "Olga Dmitrievna başladı."


translate turkish day7_main_044ab0d8:


    mt "Bugün kampımızdan ayrılıyorsunuz ve size veda ederken bir şey söylemek istiyorum."


translate turkish day7_main_00123e37:


    "Gözle görülür bir şekilde gergindi ve söyleyecek söz bulamıyordu."


translate turkish day7_main_019ed77a:


    mt "Umarım burada geçirdiğin zamanı bir ömür boyu hatırlarsın ve Sovyonok'la ilgili sadece güzel anılar biriktirirsin."


translate turkish day7_main_b48fe53b:


    mt "Ayrıca en azından biraz daha iyi olmanızı, bir şeyler öğrenmeyi başarmanızı ve yeni arkadaşlar edinmenizi umuyorum...{w} Sadece... gelecek yıl tekrar gelin."


translate turkish day7_main_42256d78:


    "Kamp lideri gözlerini kaçırdı{w} Sanki gözyaşlarını içinde tutmaya çalışıyordu."


translate turkish day7_main_80682609:


    "Bu kadar duygusallaşmasını beklemiyordum."


translate turkish day7_main_f4683d53:


    "Yine de konuşması bana tamamen saçmalık gibi geldi. Her zamanki gibi."


translate turkish day7_main_09939b29:


    "Öncüler neşeyle gevezelik ederek otobüse doluşmaya başladılar."


translate turkish day7_main_4bd26034:


    "Biraz dayanmaya ve bu kampa uygun bir şekilde veda etmeye karar verdim."


translate turkish day7_main_38f849e4:


    "Birdenbire bozuk para atmak için derin bir dürtü hissettim."


translate turkish day7_main_b4d64ac3:


    "Tabii ki burada çeşme yok ve açıkçası geri dönmek de istemiyordum ama yine de bu sadece bir batıl inanç ve ben bunlara inanmıyorum{w} en azından daha önce hiç inanmamıştım."


translate turkish day7_main_f881a31d:


    "Ceplerimi karıştırırken sadece birkaç şeker ambalajı, bir kalem ve bir kâğıt parçası buldum."


translate turkish day7_main_68eaeb3b:


    "Onları bir süre elimde tuttum, sonra çömelip kağıdı yere koydum ve birkaç kelime karaladım."


translate turkish day7_main_470a435f:


    "'Bir sebepten dolayı buradasınız'."


translate turkish day7_main_4bd38202:


    "Aptallığıma sırıtarak hurdayı otobüsün tekerleklerinin altına attım ve kabine girdim."


translate turkish day7_main_d20ef26b:


    "Ortada bir yer buldum."


translate turkish day7_main_92e96785:


    "Ama en tuhafı herkesin çiftler halinde oturması ve sadece benim yalnız olmamdı."


translate turkish day7_main_c59d06a0:


    th "Ancak, şimdi ne fark eder ki?"


translate turkish day7_main_a0b475c4:


    th "Ya ortadan kaybolacağım ya da birkaç saat içinde her şeyi yeniden başlatacağım...."


translate turkish day7_main_a20cefa7_2:


    "..."


translate turkish day7_main_b9800de2:


    "Otobüs yavaşça ilçe merkezine doğru ilerliyor, ara sıra yoldaki tümseklerin üzerinden sekiyordu."


translate turkish day7_main_60b0a3f1:


    "Gecenin zifiri karanlığında eski camların ötesinde bir şey görmek imkânsızdı."


translate turkish day7_main_6cd4a42b:


    "Her neyse, çevredeki kırsal alan umurumda bile değildi - sadece oturdum ve kaçınılmaz olanı bekledim."


translate turkish day7_main_637f8d4a:


    "Uzun zamandır ilk kez kafam tamamen boştu."


translate turkish day7_main_1b370f01:


    "Etrafımdaki öncüler yolculuğun tadını çıkarıyordu."


translate turkish day7_main_eac2b791:


    "Ulyana ve Alisa kâğıt oynuyorlardı."


translate turkish day7_main_18b1408e:


    "Lena kitap okuyordu ve Slavya uyuyordu."


translate turkish day7_main_8be4c497:


    "Miku boşu boşuna Zhenya ile sohbet etmeye çalışıyor, Zhenya ise insanları öldürmeye başlamamak için gerçekten çok çaba sarf ediyordu."


translate turkish day7_main_5400ac8b:


    "Electronik ve Shurik her zamanki gibi bir şeyler hazırlıyorlardı."


translate turkish day7_main_5ae9bf47:


    "Herkes tarafından tamamen görmezden gelinen tek kişi bendim."


translate turkish day7_main_6035b571:


    th "Bu biraz zorlama bir algı olabilir - kampta evrenin merkezi olma rolüne alışmıştım, her şeyin benim etrafımda döndüğünü sanıyordum."


translate turkish day7_main_5ed13ddb:


    th "Bir yere kadar öyle olabilir ama burada ve şimdi ben sadece yabancı bir nesneyim, kristal bir ızgaranın harmonik deseninde yeri olmayan bir molekülüm...."


translate turkish day7_main_a20cefa7_3:


    "..."


translate turkish day7_main_d602b53d:


    "Yolda ne kadar kaldığımızdan emin değilim ama uyku beni ele geçirmeye başlamıştı bile."


translate turkish day7_main_7f8e5aa9:


    "Morpheus'la umutsuzca savaşıyor, olabildiğince uzun süre uyanık kalmaya çalışıyordum."


translate turkish day7_main_8f87d7c9:


    th "Ne de olsa bugünün hayatımın son günü olma ihtimali oldukça yüksekti."


translate turkish day7_main_2fc046f6:


    th "O halde bu birkaç saatlik anlamsız, yararsız varoluşa olabildiğince sıkı sarılmak mantıklı olabilir......"


translate turkish day7_main_a20cefa7_4:


    "..."


translate turkish day7_main_f6b7f9ad:


    "Birden o kağıt parçasını ve üzerindeki birkaç kelimeyi hatırladım."


translate turkish day7_main_30775a01:


    th "Kahretsin, onları daha önce görmüştüm!"


translate turkish day7_main_e730bb3c:


    th "Nasıl bu kadar cahil olabildim?"


translate turkish day7_main_7a69a252:


    th "Belki de tüm bu öncüler, tüm bu saçmalıklar bilincimi o kadar bulandırmıştı ki..."


translate turkish day7_main_cba5d1e3:


    "Kafam tam anlamıyla sorularla dolup taşıyordu."


translate turkish day7_main_ef6d6baa:


    "Ancak fiziksel yorgunluk ve daha da önemlisi duygusal yorgunluk etkisini gösterdi ve uykuya daldım..."


translate turkish day7_un_28b2bda0:


    "Bir şekilde dairemde uyandım."


translate turkish day7_un_a32e02ac:


    "Hiçbir duyguyu tetiklemedi - hayatımın bir başka günü, hepsi bu."


translate turkish day7_un_7d869d50:


    "Yataktan kalktım ve bilgisayarın başına geçtim."


translate turkish day7_un_ec63c684:


    "Görev çubuğunda bir mesaj penceresi yanıp söndü."


translate turkish day7_un_4e652ca0:


    "Oturdum ve monitöre baktım."


translate turkish day7_un_e275ca5a:


    th "Biri bana yazmıştı - bu da birinin bana hala ihtiyacı olduğu anlamına geliyordu."


translate turkish day7_un_3b3f4f87:


    "Mesaj sadece iki kelime içeriyordu - 'Uyan'."


translate turkish day7_un_002780e6:


    th "Benden ne istiyorlar{w} Bilinmeyen bir kimlik - bu spam mi?{w} Ve ne anlama geliyor - 'uyan'...?"


translate turkish day7_un_315e078b:


    th "Artık uyumuyorum."


translate turkish day7_un_bd7d69e4:


    "Pencere hala yanıp sönmeye devam ediyordu."


translate turkish day7_un_9ba4d0e0:


    "Kapatmaya çalıştım ama başaramadım. Onun yerine bir tane daha çıktı. Bir tane daha, bir tane daha. Ve hepsinde aynı 'uyan' vardı."


translate turkish day7_un_c5553e17:


    me "Benden ne istiyorsun?!"


translate turkish day7_un_a5efbe41:


    "diye bağırdım."


translate turkish day7_un_39ba5ebd:


    "Kısa süre sonra tüm ekran aynı mesajlarla parlamaya başladı."


translate turkish day7_un_395338c2:


    "Daha fazla dayanamadım, elime aldım ve tüm gücümle duvara vurdum."


translate turkish day7_un_61465614:


    "Bir telefon çaldı."


translate turkish day7_un_7411cb8f:


    th "Tuhaf, kim olabilir?"


translate turkish day7_un_191851cc:


    "Telefonu açtım ve sadece 'Uyan' sesini duydum."


translate turkish day7_un_4f1bf480:


    "Diğer uçta binlerce ses -erkekler, kadınlar, çocuklar- çığlık atıyordu..."


translate turkish day7_un_92dce532:


    dreamgirl "Uyan!"


translate turkish day7_un_e6cd0617:


    "Telefonu yere çarptım ama kırılmadı ve çalmaya devam etti."


translate turkish day7_un_b6784bd0:


    "Bir anda tüm oda yabancılarla doldu."


translate turkish day7_un_1fe77d6f:


    "Ellerimi tutuyor, gözlerimin içine bakıyor ve bağırıyorlardı, bağırıyorlardı..."


translate turkish day7_un_92dce532_1:


    dreamgirl "Uyan! Uyan!"


translate turkish day7_un_9a3170d8:


    "Soğuk terler içinde yatağımdan fırladım."


translate turkish day7_un_658777a7:


    th "Huh... Ne rüya ama..."


translate turkish day7_un_f61bd817:


    "Birkaç dakika içinde kendime geldim ve saate baktım."


translate turkish day7_un_0718c34d:


    th "Saat akşam 5{w} Ne kadar uyumuşum?!"


translate turkish day7_un_cd800d7f:


    "Dünkü tüm olaylar aklımdan geçti{w} Lena'yı aramak, yıkıcı konuşma, Alisa'nın yenilmesi..."


translate turkish day7_un_1a354f35:


    th "Onunla gerçekten konuşmalıyım, belki gece boyunca sakinleşmiştir."


translate turkish day7_un_3f9b887f:


    "Giyindim, kulübeden çıktım, düşüncelerimi toplarken biraz tereddüt ettim, sonra Lena'nın kulübesine yöneldim."


translate turkish day7_un_8e4dce15:


    th "Ne diyeceğim, konuşmaya nasıl başlayacağım{w} 'Merhaba, nasılsın? Ben de geçiyordum' diye başlayamam."


translate turkish day7_un_061fbae3:


    th "Ona hemen ders vermem mümkün değil."


translate turkish day7_un_7e701d1f:


    "Kesin bir çözüme ulaşamayınca kapıyı çaldım{w} kimse cevap vermedi."


translate turkish day7_un_6506b798:


    "Kapıyı tekrar çaldım ve sonra kapı tokmağını çektim."


translate turkish day7_un_89013315:


    th "Kilitli değildi, bu garip."


translate turkish day7_un_1ff94a41:


    "Ancak içeride kimse yoktu."


translate turkish day7_un_fc00e421:


    th "Demek ki Lena burada değil."


translate turkish day7_un_f9d3aec1:


    th "Biraz yiyecek alacağım, belki onu kantinde bulabilirim."


translate turkish day7_un_ba6405b9:


    "Kabin sıraları boyunca ilerlerken tek bir öncüye rastlamadım."


translate turkish day7_un_ee95ab11:


    th "Bu da garip, günün bu saatinde burası hep kalabalık olur."


translate turkish day7_un_1ffe59a2:


    "Meydanda da kimse yoktu."


translate turkish day7_un_1f9572c5:


    "Kantine yaklaşırken ciddi ciddi endişelenmeye başladım - akşam yemeği vakti geldi ama aç öncü kalabalıktan eser yok."


translate turkish day7_un_b2fcee60:


    "Keşke sadece bu olsaydı...{w} Kantin kapalıydı!"


translate turkish day7_un_71d41a98:


    "Gün içinde bir şeyler olmuş gibi görünüyor."


translate turkish day7_un_17d7007b:


    "Verandaya oturdum ve durumu düşünmeye başladım."


translate turkish day7_un_df3b23b2:


    "Tüm öncüler gitmişti{w} hiçbir uyarı olmadan."


translate turkish day7_un_51b3e31f:


    th "Elbette bu kampın ya da buraya geliş şeklimin normal olduğunu söylemek zor ama bu hafta boyunca henüz tamamen açıklanamaz bir şeyle karşılaşmamıştım."


translate turkish day7_un_2ea6120c:


    th "Bir sürü tuhaf şey vardı ama..."


translate turkish day7_un_3825b75c:


    me "Belki de o sığınakta saklanıyorlardı."


translate turkish day7_un_c25b3dcc:


    "Yüksek sesle kıkırdadım."


translate turkish day7_un_8bc30be9:


    "Tüm bunlar en hafif tabirle gizemli olsa da, panik atak geçirmeye yakın bile değildim."


translate turkish day7_un_484a3495:


    un "Hayır, sadece gittiler."


translate turkish day7_un_2df970b0:


    "Neredeyse yerimden fırlayacaktım{w} Lena yanımda duruyordu."


translate turkish day7_un_6e7d7566:


    me "Sen... Sen...{w} İnsanlara böyle sinsice yaklaşamazsın!{w} Neredeyse kalp krizi geçiriyordum!"


translate turkish day7_un_be58af4f:


    un "Özür dilerim..."


translate turkish day7_un_1ee77ef5:


    "Sakince söyledi."


translate turkish day7_un_43dff079:


    "Şimdi kelimeleri kafamda canlandı{w} 'Sol'..."


translate turkish day7_un_bfcc9a41:


    me "Bekle, bekle bir saniye! Ne demek 'az önce gitti'?!"


translate turkish day7_un_0f9ef342:


    un "Oturum bitti."


translate turkish day7_un_9c158afb:


    me "Peki ya kamp lideri?"


translate turkish day7_un_e24368b3:


    un "Kasabada halletmesi gereken bazı işleri vardı, o yüzden onlarla gitti."


translate turkish day7_un_a04aa514:


    me "Tamam, peki ya sen?"


translate turkish day7_un_5e51765d:


    un "Ben kaldım."


translate turkish day7_un_9895a7c7:


    "Lena tam bir sakinlikle konuşuyordu, sanki olan biten her şey tamamen normal ve rutinmiş gibi."


translate turkish day7_un_ae14ffa6:


    me "Nasıl? Neden?"


translate turkish day7_un_0128f27c:


    un "Sorun nedir?{w} Oturum bittiğinde çocuklar evlerine gitmek üzere yola çıkıyorlar, değil mi?"


translate turkish day7_un_630033b9:


    me "Peki bugünün oturumun son günü olduğuna ne zaman karar verildi?"


translate turkish day7_un_35db2fba:


    un "İnanmayacaksınız ama daha ilk gün{w} üstelik Olga Dmitrievna bunu sıralamada duyurdu."


translate turkish day7_un_06a6d311:


    "Evet, katıldığım o sıralamalarda bile aklımdan geçen son şey kamp liderinin anonslarını dinlemekti."


translate turkish day7_un_a3b16791:


    me "O zaman neden kimse bana bir şey söylemedi?"


translate turkish day7_un_fd89f04c:


    "Uzun zamandır bu lanet kamptan çıkmak için bir fırsat kolluyordum ve sonunda karşıma çıktığında, belli ki uyuyakalmışım."


translate turkish day7_un_325ed1b8:


    th "Bu tam olarak benim tarzım."


translate turkish day7_un_49d22b71:


    un "Onlardan yapmamalarını istedim."


translate turkish day7_un_b7baf6a3:


    me "Sen istemesen bile, Olga...{w} Bekle! Ne?!"


translate turkish day7_un_49d22b71_1:


    un "Ben istedim."


translate turkish day7_un_0dc9f9e8:


    "Dedi Lena aynı güvenle."


translate turkish day7_un_ee2b3274:


    me "Ne yani, beni de geride bırakmalarını mı istedin?"


translate turkish day7_un_f1be5fed:


    un "Evet."


translate turkish day7_un_65cf65b0:


    me "Ve sence de bu biraz.."


translate turkish day7_un_38a6d40e:


    me "KESINLIKLE YANLIŞ DEĞIL MI?!"


translate turkish day7_un_8807f63e:


    "Bağırmaya başladım."


translate turkish day7_un_1a28e6a0:


    un "Hayır, bu tamamen normal."


translate turkish day7_un_55f389f6:


    "Lena'ya iyice baktım."


translate turkish day7_un_13e71061:


    "Konuşmamızın başından beri yüzünden tek bir duygu bile geçmemişti."


translate turkish day7_un_5a1b2d40:


    th "Görünüşe göre şu anda karşımda duran kız, cırcır böceklerinden korkan, her fırsatta kızaran ve aşk romanları okuyan türden bir kız değil."


translate turkish day7_un_a981adad:


    me "Tamam, anladım."


translate turkish day7_un_14f2eabe:


    th "Görünüşe göre bu durum benim bu kampa mistik bir şekilde gelmemle doğrudan bağlantılı."


translate turkish day7_un_0b34c373:


    me "Sen de kimsin?"


translate turkish day7_un_0dd1a163:


    un "Ben mi? Bu sabah Lena'ydım."


translate turkish day7_un_0586ca54:


    "Sabırla cevap verdi."


translate turkish day7_un_40c0bfd0:


    me "Evet, ben de Optimus Prime'ım, dokuz milyon yıl önce İskoçya'nın dağlık bölgelerinde doğdum."


translate turkish day7_un_ebd88aea:


    "O anda ne ondan ne de etrafımdaki herhangi bir şeyden korkuyordum."


translate turkish day7_un_ddce0400:


    "Sadece içimde bir öfke patlaması vardı."


translate turkish day7_un_5d53b103:


    un "Memnun oldum, ben Lena."


translate turkish day7_un_6b20d365:


    me "Tamam, şimdi ciddileşelim. Bence söylediğiniz şey açıkçası imkansız."


translate turkish day7_un_17a451e0:


    me "Görünüşe göre bugün son gün. Her nasılsa bu konuda hiçbir şey bilmiyorum ve kamp lideri herkesle birlikte ayrılıyor, sırf sen istedin diye beni geride bırakıyor."


translate turkish day7_un_367d9ad6:


    me "Tüm bunları biraz anormal bulmuyor musun?"


translate turkish day7_un_4d7961b1:


    un "Belki de öyle."


translate turkish day7_un_e3b83b37:


    me "Bir şey mi saklıyorsun?"


translate turkish day7_un_515af32c:


    un "Belki de saklıyorumdur."


translate turkish day7_un_cdd77ebf:


    me "O zaman sahip olduğun her şeyi tükür!"


translate turkish day7_un_7540469a:


    un "Sana söylemiştim."


translate turkish day7_un_cc572823:


    "Yüzümü ellerime gömdüm ve derin bir nefes aldım."


translate turkish day7_un_db58107e:


    me "Peki, bu durumda ne yapmam gerekiyor?"


translate turkish day7_un_0da946d4:


    un "Bilmiyorum."


translate turkish day7_un_fd0ec1e9:


    me "Peki sen ne yapacaksın?"


translate turkish day7_un_fe61a603:


    un "Bilmiyorum. Akışına bırakacağım."


translate turkish day7_un_aefb602a:


    me "İşte akış."


translate turkish day7_un_185c618b:


    "Ellerimi aniden açarak tısladım."


translate turkish day7_un_b723e2c5:


    un "Peki neden bu kadar endişeleniyorsun?"


translate turkish day7_un_8f9ecda9:


    "Yüzünde ilk kez bir ilgi titreşimi belirdi."


translate turkish day7_un_e7810ecb:


    me "Peki benim nasıl hissetmemi bekliyorsun? Memnun mu?"


translate turkish day7_un_0005cbde:


    un "Pek sayılmaz, ama sen kendin istedin."


translate turkish day7_un_c9cfb0f4:


    me "Ben mi? Sen delisin!"


translate turkish day7_un_30630964:


    un "Dün beni önemsediğini ve benimle olmak istediğini kim söyledi?"


translate turkish day7_un_5cc1cbcf:


    me "Bununla ne alakası var?"


translate turkish day7_un_741edec3:


    "Anlamamış gibi davrandım ama sonunda ne demek istediğini anlamaya başlamıştım."


translate turkish day7_un_15749306:


    un "Dileğin kabul edildi!"


translate turkish day7_un_3b03af3a:


    me "Evet, tabii."


translate turkish day7_un_c11bed91:


    "Nefesimin altında mırıldandım."


translate turkish day7_un_5a52a4ba:


    me "İşte buradayım.{w} Bu olanları hiçbir şekilde açıklamıyor."


translate turkish day7_un_4d28d31b:


    un "Birinin başarılı olmasına yardımcı olabilecek birkaç numara her zaman vardır."


translate turkish day7_un_3eac24c4:


    me "Ve sen...{w} İşte böyle..."


translate turkish day7_un_f1be5fed_1:


    un "Evet."


translate turkish day7_un_e7732512:


    "Yüzünde bir gülümseme belirdi."


translate turkish day7_un_ac9ef530:


    me "Öhöm, en başından beri bu kadar kurnaz olduğunu bilseydim..."


translate turkish day7_un_4be26182:


    "Doğruyu söylemek gerekirse, tüm bu durum hoşuma gitti{w} Aslında pek hoşuma gitmedi ama merak ettim."


translate turkish day7_un_9f8b7dc3:


    th "Tabii ki diğer herkesle birlikte kaçamadığım için çok üzgünüm{w} Ancak şu anda Lena ile baş başa bir görüşme yapıyorum."


translate turkish day7_un_a2a35aab:


    th "Bu, onun gerçek yüzünü görme şansını yakalayacağım anlamına gelebilir."


translate turkish day7_un_9b37382f:


    "Ve özlemini çektiğim tüm cevaplar, herkesin gittiği gizemli bir kasabada değil, tam burada olabilir."


translate turkish day7_un_6f985085:


    me "Pekâlâ, şimdi ne yapacağız?"


translate turkish day7_un_493d793b:


    un "Biz mi?"


translate turkish day7_un_d1046a49:


    "Gülümsedi."


translate turkish day7_un_2a23e310:


    me "Evet, biz.{w} Burada sadece biz kalıyoruz.{w} Kantin kapalı ve zaten orada yiyecek kaldığından da şüpheliyim."


translate turkish day7_un_46a920a9:


    me "Elbette Olga Dmitrievna yakın gelecekte dönecektir ama..."


translate turkish day7_un_0efd4712:


    un "Ne önemi var ki?"


translate turkish day7_un_3d127dd4:


    me "Tamam, fark etmez.{w} Önerin var mı?"


translate turkish day7_un_bdb81d42:


    un "Hmm, ne istiyorsun?"


translate turkish day7_un_cd14a0d6:


    "Sinsi bir gülümsemeyle sordu."


translate turkish day7_un_291eb303:


    me "Yiyecek bir şeyler alırdım...{w} Ve sonra bilmiyorum."


translate turkish day7_un_4af71b46:


    un "Hadi gidip bir şeyler yiyelim."


translate turkish day7_un_25f7abbc:


    me "Nereye?"


translate turkish day7_un_98dfebb8:


    un "Kulübemde biraz yiyecek kalmış olmalı."


translate turkish day7_un_8d0f1bba:


    me "Tamam, anlaştık."


translate turkish day7_un_58427f30:


    "İçeri girdik ve Lena masanın çekmecesini karıştırdı."


translate turkish day7_un_2fe68f0d:


    un "Kurabiyeler var, biraz ister misin?"


translate turkish day7_un_3e7a1ceb:


    "Bana yarısı açık bir paket bisküvi uzattı."


translate turkish day7_un_d37f7637:


    me "Ne kadar şirin."


translate turkish day7_un_27c62366:


    "Alay ettim."


translate turkish day7_un_008527ca:


    un "Neden?"


translate turkish day7_un_5cbbe2b2:


    me "Bisküvi...{w} Çocukluğumdaki gibi..."


translate turkish day7_un_34ea9cb7:


    un "Sanırım."


translate turkish day7_un_0ac292f9:


    "Gülümsedi ve yanıma oturdu."


translate turkish day7_un_f71c90f1:


    me "İyi misin?"


translate turkish day7_un_3cc85031:


    "Ağzım dolu bir şekilde sordum."


translate turkish day7_un_3875ba7b:


    un "Ne?"


translate turkish day7_un_afcb638f:


    me "Ne yapacağız peki?"


translate turkish day7_un_4657d7ce:


    un "Bilmiyorum..."


translate turkish day7_un_8063e0c4:


    "Özlemle pencereden dışarı baktı."


translate turkish day7_un_c52a621b:


    un "Ama ne istiyorsun?"


translate turkish day7_un_57ffc5a8:


    me "I..."


translate turkish day7_un_bce388b7:


    th "Ama gerçekten, ben ne istiyorum?"


translate turkish day7_un_f7a69265:


    "Sadece yarım saat önce tek düşüncem bu lanet kamptan uzaklaşmaktı."


translate turkish day7_un_b783c75e:


    "Ama şimdi, tam burada, onun yanında, bir şeyler değişmiş gibiydi."


translate turkish day7_un_7f75f03b:


    me "Şey... Ben de bilmiyorum."


translate turkish day7_un_f67c85bb:


    un "Daha iyi düşün."


translate turkish day7_un_6d6679e5:


    "Kendini yaklaştırdı ve gözlerimin içine baktı."


translate turkish day7_un_b97ac4d9:


    me "Şey, ben... Bilirsin işte..."


translate turkish day7_un_5036ab46:


    "Yüzüm kızarıyor ve aklım başımdan gidiyordu."


translate turkish day7_un_619d5ebf:


    "Sadece benden bir şey istediği çok açık olan bir kıza bu kadar yakın olduğum için değil, esas olarak o kız Lena olduğu için."


translate turkish day7_un_28a06992:


    un "Ne olmuş?"


translate turkish day7_un_1b595140:


    "Beni yakından inceledi."


translate turkish day7_un_51149e68:


    me "..."


translate turkish day7_un_9e509f53:


    me "Lena, ben..."


translate turkish day7_un_3875ba7b_1:


    un "Ne?"


translate turkish day7_un_4800ea90:


    "Kendisi gibi görünmediğini söylemek hiçbir şeydi."


translate turkish day7_un_aa2b3fa8:


    "Bu metamorfozdan hiç korkmuyordum. Daha ziyade kendimden korkuyordum - böyle bir durumda ne yapabileceğimden."


translate turkish day7_un_48199bb7:


    me "I..."


translate turkish day7_un_5bf65010:


    un "Benimle olmak istemedin mi?"


translate turkish day7_un_609ebc3b:


    "Baştan çıkarıcı bir şekilde kulağıma fısıldadı."


translate turkish day7_un_2dc0d4db:


    me "Yaptım...{w} Yani... Yaptım!"


translate turkish day7_un_99cb3823:


    un "O zaman sorun ne?"


translate turkish day7_un_5e5a445c:


    me "Biliyorsun, her şey çok...{w} Ayrıca, başka koşullarım var..."


translate turkish day7_un_9307c403:


    un "Ne şartları?"


translate turkish day7_un_182b9bc9:


    "Benden uzaklaştı."


translate turkish day7_un_f0e8eea2:


    me "Şey...{w} çeşitli... koşullar..."


translate turkish day7_un_df31a10a:


    un "Tercih etmiyorsun... Tercih etmiyorsun, değil mi?"


translate turkish day7_un_d49ccc82:


    "Lena güldü."


translate turkish day7_un_5c51ac23:


    me "Tabii ki hayır, bunu nasıl düşünebilirsin!"


translate turkish day7_un_eca1df05:


    "Görünüşe göre daha da kızarmışım."


translate turkish day7_un_99cb3823_1:


    un "O zaman sorun ne?"


translate turkish day7_un_2f2888eb:


    me "Bunu istediğine emin misin?"


translate turkish day7_un_feb3b3d8:


    "Konuyu değiştirmek için çok uğraştım."


translate turkish day7_un_ba874842:


    "Ne de olsa daha bir hafta önce normal bir hayatım vardı. Her şeyin sıkı sıkıya bağlı ve iyi organize edildiği ve kızlara yer olmayan bir hayat."


translate turkish day7_un_f3bf26c2:


    "Ve şimdi Lena'nın yanımda oturduğu ve bir şeyler ima ettiği bir tür gizemli kamptayım."


translate turkish day7_un_398b3c5d:


    th "Böyle bir durumda nasıl davranmalıyım?"


translate turkish day7_un_31b01f67:


    un "Evet..."


translate turkish day7_un_a1cfdd9e:


    "Kaşlarını çattı."


translate turkish day7_un_57db0c16:


    un "Tabii ki biliyorum, sorun nedir?"


translate turkish day7_un_ae17a426:


    me "Şey, benim..."


translate turkish day7_un_3f78e394:


    "On yedi yaşında bile değilmişim gibi davranıyordum (ki şu anda öyle görünüyordum), sanki çok daha gençmişim gibi."


translate turkish day7_un_d314a10c:


    un "Benimki de..."


translate turkish day7_un_d1046a49_1:


    "Gülümsedi."


translate turkish day7_un_3179bb68:


    "Bundan sonra ne yapacağıma karar vermeliydim - şimdi, oturum kapandıktan ve tüm öncüler gittikten sonra."


translate turkish day7_un_43e408be:


    "Cevapları aramak zorundaydım."


translate turkish day7_un_21a442ca:


    "Hepsinden önemlisi, davranışlarını ve hatta karakterini istediği zaman bu kadar kolay değiştirebilen bu kıza dikkat etmeliydim..."


translate turkish day7_un_1d5c58e7:


    "Ama tam o anda aklımdan tek bir düşünce geçiyordu - \"oh ne olacak!"


translate turkish day7_un_a755f898:


    me "Sakıncası yoksa."


translate turkish day7_un_5cbb3956:


    "Gözlerimi kapattım."


translate turkish day7_un_ca7b7ca9:


    "Hiçbir şey söylemedi, sadece gülümsedi ve daha da yaklaştı."


translate turkish day7_un_0684f7af:


    "Dudaklarımız uzun bir öpücükle kilitlendi."


translate turkish day7_un_5233788b:


    "O anda her şeyi unuttum: Bu tuhaf kampı unuttum, aslında gitmiş olan yerel öncüleri unuttum, kaçık kamp liderimizi unuttum..."


translate turkish day7_un_4c273632:


    "Geçmiş hayatımı ve eğer gelecekse geleceğimi unuttum."


translate turkish day7_un_bddb8f96:


    "Şu anda önemli olan tek kişi Lena'ydı, onun yumuşak dudakları, ruhumun derinliklerine akan, beni içten içe yakan sıcaklığı."


translate turkish day7_un_d35a905d:


    "Onu yavaşça kenara çektim."


translate turkish day7_un_3c8c14d4:


    me "Bekle...{w} Sence de bu çok...{w} hızlı değil mi?"


translate turkish day7_un_b672514d:


    un "Neden?"


translate turkish day7_un_d1317e4f:


    "Gülümsedi ve bana öyle bir baktı ki, bir anda gözlerinde boğulmaya hazır hissettim kendimi."


translate turkish day7_un_ef40802e:


    un "Eminsin, değil mi?"


translate turkish day7_un_9513cd87:


    me "Eminim."


translate turkish day7_un_3cb55656:


    "Sessizce fısıldadım...."


translate turkish day7_un_a20cefa7:


    "..."


translate turkish day7_un_67d22f65:


    "İşte tam o anda Lena'yı gerçekten sevdim, ona daha sıkı sarılmak ve asla bırakmamak istedim."


translate turkish day7_un_b59d5f4a:


    "Ve tabii ki o da aynı şeyi hissetti."


translate turkish day7_un_94abf778:


    "Zaman çok hızlı akıp geçti ve biz bir olduk...."


translate turkish day7_un_a20cefa7_1:


    "..."


translate turkish day7_un_739a1875:


    "Uyandığımda dışarısı çoktan kararmıştı."


translate turkish day7_un_23b365c0:


    "Yataktan kalktım, pantolonumu giydim ve odanın içinde bir gezintiye çıktım."


translate turkish day7_un_f75f09af:


    th "Neydi bu? Hayvani bir içgüdü mü yoksa daha fazlası mı?"


translate turkish day7_un_601aa36f:


    th "Hayır, her şey yanlış, tamamen yanlış!"


translate turkish day7_un_98050cd0:


    th "Bu kampta sıkışıp kaldım, buradan kurtulma şansımı kaybettim ve en önemlisi, muhtemelen kişilik bölünmesi ve manyak-depresif bozukluğu olan bir kızla birlikteyim."


translate turkish day7_un_8f52dae4:


    "Uyuyan Lena'ya baktım."


translate turkish day7_un_728cd1d4:


    th "Her neyse, o muhteşem."


translate turkish day7_un_eebc563a:


    "Sadece birkaç saat önce aramızda geçen her şey gözlerimin önünden geçti ve tüylerimin diken diken olduğunu hissettim."


translate turkish day7_un_7858e570:


    th "Hayır, doğru mu yanlış mı bilmiyorum ama zamanda geri dönebilseydim ben de aynı şeyi yapardım."


translate turkish day7_un_ec183f94:


    "Genişçe gülümsedim ve yatağın üzerinde onun yanına oturdum."


translate turkish day7_un_bad_022c8614:


    "Saat 10'a yaklaşmıştı."


translate turkish day7_un_bad_1b57fb49:


    th "Muhtemelen kalkma vakti gelmiştir."


translate turkish day7_un_bad_bfb63a52:


    "Lena'nın omzuna hafifçe vurdum."


translate turkish day7_un_bad_c09b685c:


    "Gözlerini açtı."


translate turkish day7_un_bad_e7c35764:


    me "Günaydın. Aslında, iyi akşamlar."


translate turkish day7_un_bad_e0a6620a:


    un "Merhaba."


translate turkish day7_un_bad_c861a148:


    "Şefkatle gülümsedi."


translate turkish day7_un_bad_5c767700:


    me "Kalkma zamanı, uykucu."


translate turkish day7_un_bad_ab39f43d:


    un "Acelen mi var?"


translate turkish day7_un_bad_33e2c702:


    me "Şey, hayır...{w} Ama bu kampta tamamen yalnızız..."


translate turkish day7_un_bad_ca19d4ba:


    un "Ne olmuş yani?"


translate turkish day7_un_bad_1b595140:


    "Bana iyice baktı."


translate turkish day7_un_bad_5e428d20:


    me "Şey, hiçbir şey...{w} Olga Dmitrievna ne zaman dönecek?"


translate turkish day7_un_bad_7144803b:


    un "Sizin için bu kadar önemli mi?"


translate turkish day7_un_bad_cd66338b:


    "Yüzünde ağır bir ifade var."


translate turkish day7_un_bad_9e8dd32e:


    me "Yemek olmadan burada öleceğiz."


translate turkish day7_un_bad_e0269484:


    "Güldüm."


translate turkish day7_un_bad_2a02ff5d:


    un "O zaman gitmekte özgürsün."


translate turkish day7_un_bad_6556b37c:


    "Uzaklara, duvara doğru baktı."


translate turkish day7_un_bad_b48b240c:


    me "Ama nasıl gidebilirim?"


translate turkish day7_un_bad_4b07d0b6:


    un "Otobüsle tabii ki."


translate turkish day7_un_bad_20781912:


    me "Burada hiç otobüs yok."


translate turkish day7_un_bad_ebc83514:


    un "O zaman neden 410 numaralı otobüs hattı için burada bir durak var sanıyorsunuz?"


translate turkish day7_un_bad_6821f908:


    me "Açıkçası bilmiyorum."


translate turkish day7_un_bad_45c95a7d:


    un "Olga Dmitrievna'ya burada sizinle acilen çözmem gereken bazı meseleler olduğunu ve daha sonra geleceğimizi söyledim."


translate turkish day7_un_bad_ad02f53a:


    me "Ne dedin?"


translate turkish day7_un_bad_1ffdefb7:


    "Kendimi yıldırım çarpmış gibi hissettim."


translate turkish day7_un_bad_cca86205:


    "Neye daha çok şaşırmam gerektiğini bilmiyordum - buradan otobüslerin geçiyor olmasına mı, yoksa kamp liderinin iki öncüyü öylece boş bir kampta bırakmayı kabul etmesine mi?"


translate turkish day7_un_bad_b97307f7:


    un "Ben de öyle dedim."


translate turkish day7_un_bad_53a970d1:


    me "Gidebiliriz mi demek istiyorsun?"


translate turkish day7_un_bad_d6ccd123:


    un "Devam et, kimse seni tutmuyor."


translate turkish day7_un_bad_89256079:


    "Tüm bunları tamamen hareketsiz bir şekilde otururken söyledi - aslında o kadar hareketsizdi ki sözleri tüylerimi diken diken etti."


translate turkish day7_un_bad_526a1798:


    me "Tamam, bu şekilde tepki verdiğim için özür dilerim. Sadece... Bugün olan her şey benim için tam bir sürpriz oldu."


translate turkish day7_un_bad_654ececc:


    un "Birkaç saat önce çok şaşırmış görünmüyordun."


translate turkish day7_un_bad_039f555e:


    th "Muhtemelen yanlış bir şey söyledim...{w} Tamamen yanlış."


translate turkish day7_un_bad_b47ccf80:


    me "Neyse, alınma...{w} Kıyamete kadar burada kalmayacağız, değil mi?{w} Eğer gitmenin bir yolu varsa..."


translate turkish day7_un_bad_cf8bd28b:


    "Lena hiçbir şey söylemedi."


translate turkish day7_un_bad_4cd94bec:


    "Arkasına baktım ve ne düşündüğünü anlamaya çalıştım."


translate turkish day7_un_bad_1385de95:


    un "Tamam!"


translate turkish day7_un_bad_3fec7cdf:


    "Bir süre durakladıktan sonra neşeyle haykırdı, sonra yataktan atladı ve hızla giyinmeye başladı."


translate turkish day7_un_bad_d9dd4daf:


    un "Haydi, eşyalarını topla, on dakika içinde meydanda buluşalım!"


translate turkish day7_un_bad_a2242d63:


    "Lena eğildi ve bana tutkulu bir öpücük verdi."


translate turkish day7_un_bad_01822020:


    me "Tamamdır."


translate turkish day7_un_bad_86defb2c:


    "Onun kulübesinden çıktım ve kamp liderinin kulübesine doğru koştum."


translate turkish day7_un_bad_6ba4f013:


    "Açıkçası yanıma alacak neredeyse hiçbir şeyim yoktu."


translate turkish day7_un_bad_d7b1f94e:


    "Kışlık giysilerimi bir çantaya attım, telefonumu cebime soktum ve meydana doğru yola çıktım...."


translate turkish day7_un_bad_a20cefa7:


    "..."


translate turkish day7_un_bad_623bcbe0:


    "On beş dakika geçmişti ama Lena hala gelmemişti."


translate turkish day7_un_bad_b4641094:


    "Toplanması gereken bir sürü eşyası olduğu ve dolayısıyla hazırlanmak için daha fazla zamana ihtiyacı olduğu gerçeğini gerekçe gösterdim...."


translate turkish day7_un_bad_a20cefa7_1:


    "..."


translate turkish day7_un_bad_66dd03fe:


    "Ancak yarım saat içinde bile gelmeyince bir şeylerden şüphelenmeye başladım."


translate turkish day7_un_bad_46e4b02b:


    "Ben farkına varmadan bacaklarım beni onun kamarasına götürdü."


translate turkish day7_un_bad_e0851da8:


    "Kapıyı açtım ve Lena'nın yatakta yattığını gördüm."


translate turkish day7_un_bad_1d0de26a:


    "Etrafındaki her şey kanla ıslanmıştı - çarşaflar, battaniye. Yer kanla ıslanmıştı ve Lena'nın ön kolunda kocaman bir yarık görebiliyordum."


translate turkish day7_un_bad_e25e3383:


    "Ona doğru koştum ve omuzlarından tutup sarsmaya başladım."


translate turkish day7_un_bad_815e4974:


    me "Lena! Lena! Lena! Neden?!"


translate turkish day7_un_bad_630ef49b:


    "Hâlâ bilinci yerindeydi."


translate turkish day7_un_bad_e89187e1:


    un "Merhaba Semyon."


translate turkish day7_un_bad_777137e4:


    "Dudaklarında zayıf bir gülümseme dondu."


translate turkish day7_un_bad_9a95d0f0:


    me "Dayan! Hey, sakın bayılma! Hemen bir şeyler düşüneceğim! Dinle, her şey yoluna girecek! Ölmeyeceksin!"


translate turkish day7_un_bad_200625b6:


    "Tabii ki ben de inanmadım - Lena dirseğinden bileğine kadar damarlarını kesmişti."


translate turkish day7_un_bad_e56517e3:


    "Derin bir kesikti ve meydanda onu beklerken geçirdiğim onca zamana bakılırsa çok kan kaybetmişti."


translate turkish day7_un_bad_df119e7d:


    "Muhtemelen bir ambulans bile şimdiye kadar bir şey yapamazdı ve burada, dünyadan uzakta, boş kampta Lena'nın hayatta kalma şansı sıfırdı..."


translate turkish day7_un_bad_ac6d49df:


    me "Ne kadar aptal olabilirsin!?"


translate turkish day7_un_bad_57856a8b:


    "Onu sıkıca kucakladım ve sarıldım."


translate turkish day7_un_bad_6d0fc2fd:


    "Gözyaşlarım yanaklarımdan aşağı akıyor, saçlarında kayboluyordu."


translate turkish day7_un_bad_1b1fd4fe:


    "Hayatım boyunca hiç bu kadar çok ağlamamıştım."


translate turkish day7_un_bad_ce1f1f67:


    me "Aptal! Neden yolu kesmek zorundaydın ki? Herkes karşıdan karşıya geçiyor, sen yolu kesiyorsun!"


translate turkish day7_un_bad_0ab6f7e7:


    un "Özür dilerim...{w} Olduğu gibi oldu..."


translate turkish day7_un_bad_5820dcba:


    "Belli belirsiz mırıldandı."


translate turkish day7_un_bad_3492de92:


    me "Ama neden?! Neden?!"


translate turkish day7_un_bad_3a8a8420:


    un "Yoruldum. Çok yorgunum."


translate turkish day7_un_bad_c2ddb952:


    "Lena sessizleşti."


translate turkish day7_un_bad_abd71de2:


    "Doğrudan gözlerinin içine baktım - hala bilinci yerindeydi ama içindeki son yaşam kırıntısı da hızla sönüyordu."


translate turkish day7_un_bad_19198e2a:


    un "Her şeyden çok yoruldum...{w} Maske takmaktan...{w} Acı çekmekten...{w} Sadece seninle olmak istedim...{w} Ama sen de beni terk ettin..."


translate turkish day7_un_bad_b1c8ef56:


    me "Ben hiçbir yere gitmedim! İşte buradayım! Neden?! Ne yaptın sen?!"


translate turkish day7_un_bad_0b0df940:


    un "Özür dilerim..."


translate turkish day7_un_bad_68679f3d:


    "Gözyaşlarına boğulmuştum, hiçbir şey söyleyemiyordum."


translate turkish day7_un_bad_d2f8b2b7:


    un "Üzgünüm...{w} Seni göreceğim...{w} Sonra..."


translate turkish day7_un_bad_359cbafc:


    "Ona daha da sıkı sarıldım."


translate turkish day7_un_bad_3824bfbf:


    "Lena'nın nefesi giderek zayıflıyordu ve çok geçmeden sonsuza dek kesildi."


translate turkish day7_un_bad_4664516e:


    "Dehşete kapılmış bir halde yataktan fırladım."


translate turkish day7_un_bad_912ad41d:


    "Gözlerim karardı, kalbim çılgınca atmaya başladı ve yerde yatan kanlı bıçağı gördüm."


translate turkish day7_un_bad_d7fd24dc:


    "Bir an sonra bıçağı ellerimde tutuyordum."


translate turkish day7_un_bad_8f9c66f6:


    "Bıçak bileğimden bir kıl kadar uzakta durdu."


translate turkish day7_un_bad_8a75b802:


    th "Ama neden? Bunun ne faydası olacaktı?"


translate turkish day7_un_bad_9c8a7ab2:


    "Tamamen korkmuş bir şekilde oturdum ve Lena'ya baktım."


translate turkish day7_un_bad_ff9eb876:


    me "Hayır, sen ölmedin."


translate turkish day7_un_bad_47037f84:


    "Histerik bir kahkaha patlattım."


translate turkish day7_un_bad_675c0b56:


    me "Hadi, uykucu, uyanma vakti!"


translate turkish day7_un_bad_31c290d0:


    "Yumuşak bir sesle söyledim ve onu omuzlarından sarstım."


translate turkish day7_un_bad_123bb3db:


    "Ama Lena uyanmadı."


translate turkish day7_un_bad_c1836b70:


    me "Ben neyim... Ben...{w} Ben ne yaptım?!"


translate turkish day7_un_bad_7f565988:


    "Dehşet içinde kulübeden dışarı fırladım ve deli gibi koştum."


translate turkish day7_un_bad_90732d43:


    "Ne kadar zaman geçti bilmiyorum ama sonunda kendimi yıprattım ve yere yığıldım."


translate turkish day7_un_bad_8c7dae16:


    "Etrafımda düşmanca bir sessizlik vardı ve sadece yıldızlar sessiz bir azarlamayla bana bakıyordu."


translate turkish day7_un_bad_9e1de710:


    "Bunlar dün Lena'nın hayranlıkla seyrettiği yıldızlardı..."


translate turkish day7_un_bad_a5b7f2b5:


    "Yine bir ağlama büyüsü beni parçaladı."


translate turkish day7_un_bad_c2891e48:


    th "Neden, neden yaptı bunu?! Onu terk ettiğim için mi?! Nereye gitmiştim?! Onu hiç bırakmadım ve bırakmayacaktım da!"


translate turkish day7_un_bad_871cc013:


    "Ancak o anda onun benim için gerçekten önemli olduğunu fark ettim."


translate turkish day7_un_bad_08f145b6:


    "Tüm tuhaflıklarına, bugün olan her şeye, kısa süreli tanışıklığımız boyunca olan her şeye rağmen, birdenbire hayatımdaki en değerli şey haline geldiğini fark ettim."


translate turkish day7_un_bad_daac228f:


    "Ve ben... O lanet otobüsü duyar duymaz onu, onun duygularını anında unuttum."


translate turkish day7_un_bad_824a58dd:


    "Gerçi bu onun davranışını haklı çıkarmazdı ama onu düşünmeyi nasıl bırakabilirdim ki..."


translate turkish day7_un_bad_ee990b86:


    "Uzun bir süre orada uzanıp yıldızları izledim...."


translate turkish day7_un_bad_a20cefa7_2:


    "..."


translate turkish day7_un_bad_51f4d2a1:


    "Başımın üzerindeki ağaçlar hafif gece esintisiyle huzur içinde sallanıyordu. Bana ne olduğu ağaçların umurunda bile değildi."


translate turkish day7_un_bad_a33a26f0:


    "Manzara tanıdık geliyordu."


translate turkish day7_un_bad_3256dae3:


    "Gözyaşlarımı bastırarak kampa doğru geri döndüm."


translate turkish day7_un_bad_e2267550:


    "Burada her şey dünkü, birkaç gün önceki gibi görünüyordu...{w} Meydan, Genda'nın anıtı... öncülerin kulübeleri... Lena'nın kulübesi."


translate turkish day7_un_bad_5dd67afb:


    "İçim paramparça olmuştu."


translate turkish day7_un_bad_d4c3458a:


    "Acı her an bedenimi milyonlarca küçük parçaya ayıracakmış gibi hissediyordum."


translate turkish day7_un_bad_56824cd3:


    "Dizlerimin üzerine çöktüm ve yumruklarım tamamen kanla lekelenene kadar yeri yumruklamaya başladım."


translate turkish day7_un_bad_54b67798:


    th "Keşke biraz daha erken fark etseydim...{w} Sadece bir an önce, daha fazlasını istemiyorum..."


translate turkish day7_un_bad_3a000f1c:


    th "O kadar... o kadar...{w} En ufak bir ipucu bile onun için yeterliydi."


translate turkish day7_un_bad_425b26e9:


    "Ancak o anda Lena'nın öldüğünü fark ettim{w} Ve benim bir parçam da onunla birlikte ölmüştü."


translate turkish day7_un_bad_dd13b05c:


    "Muhtemelen en iyi diyebileceğim parçam..."


translate turkish day7_un_bad_4212818d:


    "Bir süre sonra aklım başıma geldi, onun kulübesinde duruyordum."


translate turkish day7_un_bad_a42b463d:


    "Kan çoktan kurumuştu, ay ışığı artık ona yansımıyordu."


translate turkish day7_un_bad_51c253d9:


    "Yatağına gittim ve Lena'nın cesedinin yanına oturdum."


translate turkish day7_un_bad_3eddd6fc:


    "Burada olmaktan çok korkuyordum ama ona bir şey söylemem gerektiğini hissettim."


translate turkish day7_un_bad_07109f1d:


    me "Özür dilerim."


translate turkish day7_un_bad_7cd29b00:


    "Ben başladım."


translate turkish day7_un_bad_eefec37d:


    me "Elbette artık çok geç, ama eğer beni bir yerlerden duyabiliyorsan, unutma lütfen, seni sonsuza kadar, hayatımın sonuna kadar seveceğim!"


translate turkish day7_un_bad_73cd14af:


    "Ve bu yalın gerçekti."


translate turkish day7_un_bad_ab86e84f:


    me "Duygularını görmezden geldiğim için özür dilerim. Her zaman sadece kendimi düşündüğüm için özür dilerim. Her şey için özür dilerim...{w} Ölmesi gereken bendim, sen değil."


translate turkish day7_un_bad_41e2281b:


    "Cesedini bir battaniyeyle örttüm ve yavaşça kulübeden çıktım."


translate turkish day7_un_bad_e845b484:


    "Otobüs durağında kendime geldim."


translate turkish day7_un_bad_38f3ab16:


    me "Demek kaçıyorsun, pislik herif?"


translate turkish day7_un_bad_02a0d7a5:


    "Kendi kendime karanlık bir şekilde mırıldandım."


translate turkish day7_un_bad_5684a1f5:


    th "Bu kampta bir dakika daha kalmaya dayanamazdım."


translate turkish day7_un_bad_cfc84616:


    th "Lena asla geri dönmeyecek, yaptıklarımı haklı çıkaramam{w} beni buradan götürecek otobüsü bekleyeceğim."


translate turkish day7_un_bad_fb75b41c:


    "Yarın ya da bir saat sonra başıma gelecekler umurumda bile değil."


translate turkish day7_un_bad_8a6bbc18:


    "Cevaplar umurumda değil, buraya nasıl geldiğim umurumda değil..."


translate turkish day7_un_bad_1167379e:


    "Çok geçmeden uzakta loş bir ışık parıltısı gördüm{w} nedense hiç şaşırmadım."


translate turkish day7_un_bad_b2ca87a4:


    "Bir dakika içinde 410 numaralı boş bir otobüste oturuyor ve hava koşullarına yenik düşmüş bir pencereden gecenin karanlığına bakıyordum."


translate turkish day7_un_bad_238ed2ad:


    "Zihnim bomboştu."


translate turkish day7_un_bad_ee87ed80:


    "Bizi insan yapan her şeyi - hisler, duygular, özlemler, acılar - hepsini o öncü kampında bıraktım."


translate turkish day7_un_bad_27cdd9e3:


    "Şimdi sahip olduğum tek şey bu gece ve boş otobüs."


translate turkish day7_un_bad_26c4841e:


    "Artık ne gelecek ne de şimdiki zaman var."


translate turkish day7_un_bad_eb03b956:


    "Eğer yarın ölürsem bu sadece başka bir insan bedeninin varlığının sona erdiği anlamına gelir - gerçek ben birkaç saat önce orada öldü...."


translate turkish day7_un_bad_a20cefa7_3:


    "..."


translate turkish day7_un_bad_6bb89a09:


    "Ne kadar zaman geçti bilmiyorum ama yorgunluk beni ele geçirdi."


translate turkish day7_un_bad_75b8b39e:


    "Uyuyor ya da uyanık olmam kesinlikle fark etmediği için bununla savaşmayacaktım."


translate turkish day7_un_bad_61f61677:


    "Gözlerimi zar zor açık tutabildim ve çok geçmeden bayıldım..."


translate turkish day7_un_good_1e14927c:


    "Lena'yı uyandırmaya hiç niyetim yoktu."


translate turkish day7_un_good_0f009ba2:


    "Onun nasıl uyuduğunu izlemek tarifsiz bir zevkti."


translate turkish day7_un_good_cb08a804:


    "İnsanlar uykunun bir insanın gerçek yüzünü ortaya çıkardığını söylerler."


translate turkish day7_un_good_655fad3e:


    "Eski bir medeniyette şöyle bir gelenek olduğunu duymuştum: Bir kadın evlenmeden önce nişanlısını üç gece boyunca uyurken izlermiş."


translate turkish day7_un_good_d9e8de3e:


    "Ve sonra onunla evlenip evlenmeyeceğine karar verirmiş."


translate turkish day7_un_good_0d6d6fe6:


    "Bunu aklımda tutarak, Lena'nın yüzünde iyilik, nezaket ve çocuksu bir naiflikten başka bir şey olmadığını rahatlıkla söyleyebilirdim."


translate turkish day7_un_good_d1a6079c:


    th "Dün Alisa'yı bayıltan kız gerçekten bu olabilir miydi?"


translate turkish day7_un_good_416ed528:


    "Her ne olursa olsun, her şey çoktan oldu."


translate turkish day7_un_good_82dadd76:


    "Ve ben Lena'yı zaten böyle gördüm...{w} İlk birkaç günkü alçakgönüllülüğü, adadaki histerisi, dün meydandaki öfkesi, bugünkü tutkusu..."


translate turkish day7_un_good_aa392382:


    th "Tek bir insan bu kadar çok zıt kişilik özelliğiyle nasıl başa çıkabilir?"


translate turkish day7_un_good_1a2112d1:


    th "Gerçekten ikili, üçlü, hatta dörtlü bölünmüş bir kişiliğe sahip olabilir mi?..."


translate turkish day7_un_good_a20cefa7:


    "..."


translate turkish day7_un_good_b36c6fa6:


