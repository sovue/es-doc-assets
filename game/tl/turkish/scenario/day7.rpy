    "Çok geçmeden kapının arkasında çalışmalar başladı - çekiç darbelerini, makinelerin tıkırtılarını ve elektronik cihazların vızıltılarını duyabiliyordum."


translate turkish day7_us_2ca031ea:


    "Electronik ve Shurik kendi meselelerini tartışıyorlardı, bu yüzden fazla dikkat etmiyordum."


translate turkish day7_us_81c60560:


    "Daha çok binadan ne zaman ayrılacaklarını merak ediyordum."


translate turkish day7_us_28532eec:


    th "Ama Shurik'in tutkusunu göz önüne alırsak..."


translate turkish day7_us_e1c95826:


    us "Bırakın beni!"


translate turkish day7_us_417eb8f9:


    "Ulyana sonunda güreşerek dışarı çıktı ama yine de sesini yükseltmedi."


translate turkish day7_us_00c87776:


    us "Neden sadece gidemiyoruz?"


translate turkish day7_us_6c39322b:


    "Nefesinin altında sordu."


translate turkish day7_us_60ae17bd:


    me "Ne düşünüyorsun? Her şey yolunda mı?"


translate turkish day7_us_38311340:


    us "Peki sorun ne?"


translate turkish day7_us_9ca91be8:


    me "Bütün geceyi burada birlikte geçirdik."


translate turkish day7_us_2bcd45b7:


    th "Ve kapıyı kapatarak önlem aldığımı düşünürsek, ne düşünecekleri çok açık."


translate turkish day7_us_cbf4636b:


    us "Ne olmuş yani?"


translate turkish day7_us_ba0e85e5:


    me "Ne demek 'yani'?"


translate turkish day7_us_1fd5a2a5:


    "Yorgunca iç çektim."


translate turkish day7_us_2c1c12f9:


    me "Sadece bana güven! Senin için önemli olmadığını biliyorum ama benim için önemli!"


translate turkish day7_us_8b8ddb79:


    us "Tamam, iyi, burada saklanmaya devam edeceğiz."


translate turkish day7_us_dcea2b7f:


    "Ulyana kızgınlıkla kabul etti."


translate turkish day7_us_c441e2a5:


    "Gerekirse uzun süre beklemeye hazırdım ama ancak birkaç dakika sonra ön kapı açıldı ve içeri biri girdi."


translate turkish day7_us_ea040539:


    sl "Günaydın, çocuklar!"


translate turkish day7_us_073bef57:


    el "Günaydın! Günaydın!"


translate turkish day7_us_c6c5df39:


    sh "Günaydın!"


translate turkish day7_us_c50dbd79:


    "Ben Slavya."


translate turkish day7_us_36054e3a:


    sl "Yapışkan bandınız var mı diye soracaktım?"


translate turkish day7_us_a716e0cd:


    sh "Var. Bir yerlerde..."


translate turkish day7_us_1758adf3:


    "Shurik düşünceli bir şekilde cevap verdi."


translate turkish day7_us_837638ee:


    el "Ah, arka odaya bir göz atın!"


translate turkish day7_us_d9880b2f:


    "Bu sözler tüylerimi diken diken etti ve kapının kolunu sıkıca kavradım."


translate turkish day7_us_a3e6a343:


    "Slavya karşı taraftan kapıya yaklaştı ve çekerek açmaya çalıştı ama ben tüm gücümle kapıyı zorluyordum."


translate turkish day7_us_9daed956:


    sl "Kapı kilitli."


translate turkish day7_us_338f90c7:


    el "Olamaz, biz o odayı asla kilitlemeyiz!"


translate turkish day7_us_96e3c2da:


    sh "Bir de ben deneyeyim."


translate turkish day7_us_9a13cece:


    "Shurik kapının kolunu çekti ama hiçbir şey olmadı, yine de sabit tutmak için çok çaba sarf ettim."


translate turkish day7_us_28d6326b:


    sh "Sıkışmış. Bana yardım et!"


translate turkish day7_us_8e62bdbd:


    "Birkaç dakika içinde Electronik ile birlikte kapıyı açmaya çalışıyorlardı."


translate turkish day7_us_3c57cbd3:


    "Sanki tüm hayatım buna bağlıymış gibi kolu kavradım, ama ne olursa olsun bu kısa bir mücadele oldu - ellerim çabucak pes etti ve bıraktım."


translate turkish day7_us_4a18af52:


    "Kapı çarparak açıldı ve parlak güneş ışığı beni kör etti, bu yüzden Shurik, Electronik ve Slavya'nın şaşkın yüzlerini ilk birkaç saniye göremedim."


translate turkish day7_us_0cb3a629:


    el "Ahem... Günaydın!"


translate turkish day7_us_9b07033b:


    us "Günaydın..."


translate turkish day7_us_db8c0cef:


    "Ulyana onu göremeyeceğim şekilde arkamda duruyordu ama sesindeki utancı hissedebiliyordum."


translate turkish day7_us_f3289a98:


    sh "Peki senin burada ne işin var?"


translate turkish day7_us_e4baa3e6:


    "Shurik sanki hiç şaşırmamış gibi sordu."


translate turkish day7_us_b0e31fb0:


    me "Şey...{w} Doğruyu söylemek gerekirse, bir film izliyorduk. Ulyana bir kaset getirdi ve senin de burada bir videon var..."


translate turkish day7_us_f20523f5:


    "Shurik güvensizce arka odanın derinliklerine baktı."


translate turkish day7_us_2affcd83:


    "Mesajı alıp kaseti gösterene kadar Ulyana'yı dürttüm."


translate turkish day7_us_a303a91b:


    el "Peki bu film ne?"


translate turkish day7_us_05d05fbf:


    "Electronik'in yüzünde zorlukla görülebilen bir sırıtma belirdi."


translate turkish day7_us_8f6c89a0:


    me "Sıradan bir film... Bir gerilim filmi! En son gerilim filmi!"


translate turkish day7_us_816f2706:


    "Sonra onun ve diğerlerinin şu anda ne düşündüğünü hayal ettim ve öfkeyle dolup taştım."


translate turkish day7_us_8ccefc46:


    me "Eğer düşünürsen... biz... Böyle bir şey yok!"


translate turkish day7_us_48e6007e:


    "Parmağımla Ulyana'yı işaret ettim."


translate turkish day7_us_d2a8f0f0:


    "O da bana sertçe baktı."


translate turkish day7_us_82fab5b1:


    sl "Kimse seni bir şeyle suçlamıyor..."


translate turkish day7_us_f3e5d2d3:


    "Dedi Slavya bana bakmadan..."


translate turkish day7_us_3129c89c:


    me "En azından burada aklı başında bir kişi var!"


translate turkish day7_us_cc54c296:


    sl "Yine de..."


translate turkish day7_us_7dd3d65d:


    "Nefesinin altında ekledi."


translate turkish day7_us_ad02f53a:


    me "Ne dedin?"


translate turkish day7_us_47020024:


    us "Her şey tam olarak sana anlattığı gibiydi."


translate turkish day7_us_29d44d62:


    "Ulyana sohbete katıldı."


translate turkish day7_us_0313b033:


    us "Bir film izliyorduk ve sonra uykumuz geldi. Çok geç olmuştu."


translate turkish day7_us_daef1297:


    el "Hiçbir şey düşünmedik...{w} Sadece aptalca bir durum, hadi ama, yeter..."


translate turkish day7_us_e3a1d5a1:


    "Electronik bunu bir şakayla geçiştirmeye çalıştı."


translate turkish day7_us_a17efb6c:


    sl "Sanırım burada Olga Dmitriyevna karar verecek."


translate turkish day7_us_2ff596a2:


    "Slavya soğuk bir sesle söyledi."


translate turkish day7_us_04e9a59a:


    me "Hey, bekle! Neden bunu kamp liderine götürüyorsun?"


translate turkish day7_us_9f99e4ab:


    sl "Başka kime?"


translate turkish day7_us_2b3752c2:


    me "Ama görüyorsunuz, biz doğruyu söylüyoruz!"


translate turkish day7_us_180a5d04:


    sl "Yargılayacak kişi ben değilim..."


translate turkish day7_us_2d71c574:


    me "Lanet olsun! O zaman kim?! Her şeyi kendi gözlerinizle gördünüz!"


translate turkish day7_us_97f0d6ac:


    sl "Buna kamp lideri karar verir."


translate turkish day7_us_11681176:


    "Slavya sessizce konuştu ve gitmek için döndü."


translate turkish day7_us_b93ba56b:


    me "Bekle!"


translate turkish day7_us_279248eb:


    "Tek bir hamlede kapının önünde belirdim ve yolunu kestim."


translate turkish day7_us_04377996:


    me "Dinleyin!"


translate turkish day7_us_4c8b51f3:


    sl "Bu beni ilgilendirmez..."


translate turkish day7_us_a74cf5b3:


    "Slavya bakışlarımdan kaçmaya çalışıyordu."


translate turkish day7_us_a9ab19d6:


    th "Görünüşe göre o da bu durumdan rahatsız."


translate turkish day7_us_5b85d78d:


    sl "Ben sadece..."


translate turkish day7_us_c7f85ff8:


    me "Kime karşı yükümlülüğünüz var? Bunu neden yapmanız gerekiyor?"


translate turkish day7_us_a6fdad47:


    sl "Çünkü..."


translate turkish day7_us_60e65045:


    "Sözlerini bitirecek kelimeleri bulamadı."


translate turkish day7_us_aca23380:


    me "Yani! Yani gitmek zorunda değilsin... hiçbir yere... kimseye bir şey söylemek zorunda değilsin."


translate turkish day7_us_37eba565:


    sl "Hayır..."


translate turkish day7_us_c72cecb4:


    "Sinirli bir şekilde konuştu ama sonra başını kaldırdı ve bana yoğun bir bakış attı."


translate turkish day7_us_19d8e410:


    sl "Özür dilerim, Semyon."


translate turkish day7_us_fcafb3be:


    us "Bırak onu, gitsin."


translate turkish day7_us_9a93eedf:


    "Başımı Ulyana'ya çevirdim. Slavya'nın kulüp binasından sıvışması için bu bir saniyelik süre yeterliydi."


translate turkish day7_us_b93ba56b_1:


    me "Bekle! Sadece bekle!"


translate turkish day7_us_c3edfb53:


    "Koşarken ona bağırdım ama hiçbir etkisi olmadı."


translate turkish day7_us_10f920b2:


    th "Kamp liderine gitmesini engellemek için Slavya'yı nafile bir çabayla takip etmenin hiçbir anlamı yoktu. Eğer gitmeye niyetliyse, onu bağlayamam."


translate turkish day7_us_f94a034f:


    us "Zaten hiçbir şey kanıtlayamaz."


translate turkish day7_us_9367d115:


    "Ulyana kıkırdadı."


translate turkish day7_us_271eed32:


    me "Bir şey kanıtlayıp kanıtlayamayacağı kimin umurunda?{w} Bütün bunlardaki konumunu anlamıyor musun?"


translate turkish day7_us_de872d99:


    me "İçinde bulunduğun her durumda suçluluğun kaçınılmazdır{w} Üstelik böyle bir durumda..."


translate turkish day7_us_4becc777:


    us "O zaman birlikte sorumluyuz."


translate turkish day7_us_5345aad1:


    "Kurnazca sırıttı."


translate turkish day7_us_0c53b718:


    me "Aynen öyle..."


translate turkish day7_us_767711c4:


    "Binadan çıktım ve merdivenlere oturdum."


translate turkish day7_us_ca5d2b01:


    el "Şey... Her ihtimale karşı senin yanında olacağız. Değil mi, Shurik?"


translate turkish day7_us_f7843a33:


    sh "Sanırım öyle. Burada ne olduğunu tam olarak anlayamadım ama muhtemelen endişe verici bir şey olmamıştır."


translate turkish day7_us_06498067:


    el "Tamam, kahvaltıya gidiyoruz!"


translate turkish day7_us_4c751a5e:


    "Çok geçmeden onları gözden kaybettik."


translate turkish day7_us_b451f12c:


    us "Hadi gidip yemek yiyelim!"


translate turkish day7_us_2dcff881:


    "dedi Ulyana neşeyle."


translate turkish day7_us_1cbe0f5f:


    me "Tek düşündüğün yemek!"


translate turkish day7_us_439a68cf:


    us "Neden ağlıyorsun ki? Neyi değiştirecek ki?"


translate turkish day7_us_42da4d87:


    "En azından bu konuda haklıydı."


translate turkish day7_us_87f2529e:


    th "Kamp liderinin kararını beklemek zorundayız."


translate turkish day7_us_52e891ef:


    me "Hadi gidelim."


translate turkish day7_us_e5f23980:


    "Kantine yöneldik."


translate turkish day7_us_e64b885e:


    "Olga Dmitrievna ve Slavya dışında tüm kamp kahvaltı için toplanmıştı."


translate turkish day7_us_29b1cc7a:


    th "En iyisi bu olabilir, sanırım."


translate turkish day7_us_eabb99b9:


    us "Sen ne düşünüyorsun?"


translate turkish day7_us_30a8c2b2:


    "Yemeğimizi alıp oturduğumuzda Ulyana neşeyle bana sordu."


translate turkish day7_us_df42402e:


    me "Aynı şeyi."


translate turkish day7_us_682ca4a2:


    us "Hadi, hiçbir şey için endişelenmeyi bırak!"


translate turkish day7_us_25e396e3:


    me "Belki senin için hiçbir şeydir."


translate turkish day7_us_7ac5a652:


    th "Gerçekten, bunun nesi kötü?"


translate turkish day7_us_dd7a2cb9:


    th "Her durum farklı açılardan yorumlanabilir{w} hele de bir nedeniniz varsa..."


translate turkish day7_us_126beeed:


    us "Hadi ama, en kötü ne olabilir ki?"


translate turkish day7_us_44eab9f2:


    me "Biliyorsun, kamp liderimiz biraz... eksantriktir."


translate turkish day7_us_1a257db4:


    us "Eksantrik... Belki öyle, ama biz öyle bir şey yapmadık. Hem de hiçbir şey!"


translate turkish day7_us_6ad7fada:


    me "Umarım o da buna inanıyordur."


translate turkish day7_us_edf1846c:


    "Ulyana ile ilişkim son zamanlarda dramatik bir şekilde gelişmişti."


translate turkish day7_us_88166c1e:


    "Başlarda onu sadece yaramaz, terbiyesiz bir çocuk olarak görüyordum ama artık karakterinin iyi taraflarını da görmeye başlamıştım."


translate turkish day7_us_f3d379ac:


    "Gerçi çok fazla değildi..."


translate turkish day7_us_f6c5d224:


    "Ve şimdi, tam da her şey yoluna girmeye başlamışken, kamp lideriyle yapacağım zorlu bir konuşma yaklaşıyordu."


translate turkish day7_us_da1b7a68:


    th "Belki de olan her şeyi rüyamda görmüştüm ve Slavya'nın bu sabahki tepkisi sadece şaşkınlıktan kaynaklanıyordu..."


translate turkish day7_us_a1bda0c8:


    mt "Yemeğinizi beğendiniz mi?"


translate turkish day7_us_2515daf1:


    "Olga Dmitrievna başımda dikiliyordu. Bana tehditkar bir şekilde baktı."


translate turkish day7_us_df6dbf74:


    us "Evet."


translate turkish day7_us_ea23ce21:


    mt "Davranışınızı açıklayabilir misiniz?"


translate turkish day7_us_00c2b734:


    me "Neyi açıklayabilirim?"


translate turkish day7_us_1a0200f5:


    mt "Örneğin, nasıl oldu da Sibernetik Kulübü'nün hizmet odasında bulundunuz? Anahtarı nereden aldın? Orada ne yapıyordun ki?"


translate turkish day7_us_40981815:


    "Bu lanetli anahtarı elde ettiğim koşulları hatırladım."


translate turkish day7_us_03126c7a:


    th "Bu konuyu Electronik'le konuşmalıyım."


translate turkish day7_us_75eb26f7:


    me "Slavya sana bizim versiyonumuzu anlattıysa."


translate turkish day7_us_581b4f29:


    us "Bir film izliyorduk!"


translate turkish day7_us_483db5e3:


    "Ulyana ciddi olduğunu iddia etti."


translate turkish day7_us_7996582c:


    mt "Bütün gece mi?"


translate turkish day7_us_17187bef:


    "Kamp lideri alaycı bir tavırla sordu."


translate turkish day7_us_8882dbb1:


    us "Sonra uyuyakaldım ve Semyon da benimle kaldı."


translate turkish day7_us_e8218d47:


    mt "Yani kamaralarınıza gitme şansınız yok muydu?"


translate turkish day7_us_d3ad4e8d:


    us "Küçücük bir tane bile!"


translate turkish day7_us_5f234a66:


    mt "Peki sen ne diyeceksin?"


translate turkish day7_us_db73f201:


    me "Kulağa çok aptalca geliyor ama o haklı."


translate turkish day7_us_73f28212:


    mt "Buna inanmamı mı bekliyorsun?"


translate turkish day7_us_5232e44c:


    me "Gerçek bu."


translate turkish day7_us_28860bdc:


    mt "Sizi hiçbir şeyle suçlayamam..."


translate turkish day7_us_f9fe8dfb:


    "Kamp lideri yavaşça başladı."


translate turkish day7_us_78c9d534:


    mt "Ama öte yandan, tüm bu durum normalin ötesinde. Öncüler bu şekilde davranmamalı!{w} Ve hikayenizde çok fazla tutarsızlık var."


translate turkish day7_us_c7395410:


    me "Anladık."


translate turkish day7_us_64ed00c4:


    "Kaderci bir şekilde kabul ettim."


translate turkish day7_us_ed3d54bd:


    mt "Aşağıdakileri yapacağım: Ulyana, cezalısın, kamarana kapatılacaksın ve seninle ne yapacağıma daha sonra karar vereceğim."


translate turkish day7_us_2b2111cc:


    "Ulyana'ya dikkatle baktım{w} beklentilerimin aksine üzgün görünmüyordu."


translate turkish day7_us_b346132a:


    mt "Açıkçası, bunun senin hatan olduğunu düşünmüyorum, ama adil olmak gerekirse..."


translate turkish day7_us_9ac1f10f:


    us "Harika! Bana ihtiyacın olursa beni nerede bulacağını biliyorsun!"


translate turkish day7_us_21586975:


    "Hemen ayağa kalktı ve çıkışa yöneldi."


translate turkish day7_us_601dcc29:


    "Olga Dmitrievna onu durdurmaya çalışmadı."


translate turkish day7_us_f86f5ead:


    mt "Onunla her zaman çok fazla sorun çıkıyor! Ve seni tüm bunlara o bulaştırdı."


translate turkish day7_us_463bcf35:


    me "Beni neyin içine soktuğunu gerçekten anlamıyorum{w} ve ona karşı çok sert görünüyorsun."


translate turkish day7_us_86c24609:


    mt "Bana onun gibi başka bir öncü gösterin!"


translate turkish day7_us_9b510cae:


    "Kamp lideri güldü."


translate turkish day7_us_d8a59e1a:


    me "Yaramazlık yaptığı için ceza aldığında bu başka bir hikaye, ama burada..."


translate turkish day7_us_b0a68be7:


    mt "Aslında neler olup bittiğini gerçekten anlamıyorum ama benim görevim sizin ahlaki karakterinizle ilgilenmek! Ve bu durum şüpheli. Oldukça şüpheli."


translate turkish day7_us_e6d5b5bb:


    me "Peki onu daha ne kadar hapsedeceksiniz?"


translate turkish day7_us_2c3aefa4:


    mt "Bilmiyorum..."


translate turkish day7_us_c8efaa8d:


    "Olga Dmitrievna bir süre düşündü."


translate turkish day7_us_aa5a8210:


    mt "Bugün ayrılış günü{w} ama bu şartlar altında..."


translate turkish day7_us_015aa4b8:


    me "Ne? Ne kalkışı?"


translate turkish day7_us_e5e97d5d:


    "Kelimeye atladım."


translate turkish day7_us_2a286c8b:


    mt "Dönem bugün bitiyor. Bu son gün."


translate turkish day7_us_d3383672:


    me "Ee, ne...?"


translate turkish day7_us_ca88a665:


    "Sıkıştırabildiğim tek yanıt buydu."


translate turkish day7_us_95d81bde:


    th "Son gün, yani...{w} Sonunda bu lanet kamptan ayrılabileceğim!"


translate turkish day7_us_148a37fc:


    th "Belki de acılarımın sona erme vakti gelmiştir ve sıradan gerçekliğime geri dönebilirim?"


translate turkish day7_us_d94530d9:


    me "Ama neden bu kadar ani?"


translate turkish day7_us_484d29a2:


    mt "Kim için ani? Sıralamada bahsetmiştim!"


translate turkish day7_us_b7dab458:


    "Haklı. Sıralarda genellikle uyuyordum ya da etrafa bakıyordum ve anonsları pek dinlemiyordum."


translate turkish day7_us_230b0b30:


    me "Peki saat kaçta?"


translate turkish day7_us_f2dd2ae4:


    mt "Saat beş gibi. Hazırlanmayı unutma!"


translate turkish day7_us_b8beaef4:


    th "Toplayacak pek bir şeyim yok."


translate turkish day7_us_d6c3fd46:


    "Ayağa kalktı, bir tepsi aldı ve gidecekti."


translate turkish day7_us_10a9cce9:


    me "Peki Ulyana'ya ne olacak?"


translate turkish day7_us_24e7f6f2:


    mt "Henüz bilmiyorum, sana söyledim. Muhtemelen daha sonra gidecek."


translate turkish day7_us_a1e9eded:


    me "Nasıl yani? Herkesle değil mi?"


translate turkish day7_us_4859697b:


    mt "Şey, evet."


translate turkish day7_us_9e33a049:


    me "Bu normal mi?"


translate turkish day7_us_cb6d083f:


    "Gerçekten şaşırdım."


translate turkish day7_us_9ee92636:


    mt "Bunun nesi yanlış?"


translate turkish day7_us_e037db1b:


    th "\"Yanlış\" mı bilmiyorum ama oldukça tuhaf olduğu kesin."


translate turkish day7_us_4cedb800:


    mt "Hâlâ yapmam gereken işler var...."


translate turkish day7_us_a20cefa7:


    "..."


translate turkish day7_us_a075466c:


    "Uzun zaman önce soğumuş olan yulaf lapamı amaçsızca karıştırdım."


translate turkish day7_us_6d8e9a1c:


    th "Kalkış, buradan çıkma olasılığı!"


translate turkish day7_us_d58d3bbd:


    th "Ama öte yandan, Ulyana."


translate turkish day7_us_ddc689f2:


    "Onun önünde kendimi suçlu hissettim."


translate turkish day7_us_0b1acb99:


    th "Sonunda o cezalandırılırken ben cezalandırılmadım{w} bu adil değil."


translate turkish day7_us_2b277b74:


    "Hayır, onun acısını paylaşmak istediğimden değil, ama orada kilit altında oturmasının adil olduğunu düşünmüyorum."


translate turkish day7_us_4de1adb3:


    th "Ayrılmadan önce hala biraz zaman var. Durumu açıklığa kavuşturmak için yeterli olacaktır."


translate turkish day7_us_743c2089:


    "Önce Slavya ile konuşmaya karar verdim."


translate turkish day7_us_90ef6742:


    th "Umarım sakinleşmiştir."


translate turkish day7_us_246c591f:


    "Slavya'yı meydanda bulmaya alışmıştım, bu yüzden hiç şüphe duymadan oraya gittim."


translate turkish day7_us_21e83890:


    th "Neden tam olarak oraya?{w} Çünkü bu kampta onunla çoğunlukla orada karşılaştım."


translate turkish day7_us_b960cd1c:


    "Ama Genda'nın sığınağının yakınında tek bir kişi bile yoktu."


translate turkish day7_us_bab2fcfe:


    "Bir süre orada durup anıta baktım, sonra kütüphaneye yöneldim."


translate turkish day7_us_645d78b5:


    "Zhenya'nın komşusunun şu anda nerede olduğunu bilmesi mantıklı."


translate turkish day7_us_d20a5a40:


    "Kapıyı çaldıktan sonra (önceki deneyimlerimi hatırlıyorum, bu gereksiz bir tavır değildi) içeri girdim."


translate turkish day7_us_a715c94f:


    "Zhenya kitabından uzaklaşıp bana dikkatle baktı."


translate turkish day7_us_6705d775:


    mz "Ne istiyorsun?"


translate turkish day7_us_b3e89296:


    me "Sorun ne? Neden böyle tepki veriyorsun? İçeri bile giremiyor muyum?"


translate turkish day7_us_3f35d5c7:


    mz "Ne yani, buraya sebepsiz yere mi geldin? Bir şeyler okumak istediğinden şüpheliyim."


translate turkish day7_us_ff471f9a:


    me "Şey, hayır..."


translate turkish day7_us_dd5de5c4:


    "Marksist-Leninizm'in klasikleri benim favori edebiyatım değildi."


translate turkish day7_us_e0d0e8a3:


    me "Slavya'nın nerede olduğunu bilmek istiyorum."


translate turkish day7_us_41ebc836:


    mz "Neden bilmek istiyorsun?"


translate turkish day7_us_166c7947:


    "Bunu sanki konuşmanın bittiğinden eminmiş gibi söyledi ve böylece okumasına devam etti."


translate turkish day7_us_9c2b514a:


    me "Madem soruyorum, açıkça bilmem gerek."


translate turkish day7_us_4101fa65:


    mz "İskelede olmalı."


translate turkish day7_us_6dc67cf3:


    "Zhenya kayıtsızca cevap verdi."


translate turkish day7_us_73aab3cd:


    me "Teşekkürler..."


translate turkish day7_us_0faa275e:


    "Bilmek istediğimi öğrendikten sonra bu kötülük kalesinden aceleyle çıktım."


translate turkish day7_us_da95a21f:


    th "Evet, Zhenya'nın sert bir ruhu var{w} en azından ben onu anlamakta zorlanıyorum."


translate turkish day7_us_ba64d8f0:


    "İskelede bazı öncüler kayıkları rıhtıma çekerken, diğerleri küreklerle ya da halatlarla koşuşturuyordu."


translate turkish day7_us_e721198a:


    "Yakından baktığımda Slavya'nın oldukça uzakta, suya yakın bir yerde oturduğunu fark ettim."


translate turkish day7_us_f191de9e:


    me "Temizlik mi yapıyordu?"


translate turkish day7_us_757f4d47:


    "Aklıma gelen en nötr soruyu sordum."


translate turkish day7_us_8b01f8be:


    sl "Evet."


translate turkish day7_us_4e965a2e:


    "Dönmeden cevap verdi."


translate turkish day7_us_b3a03b6f:


    me "Dinle, ben..."


translate turkish day7_us_89748db4:


    sl "...Ulyana hakkında konuşmak ister misin?"


translate turkish day7_us_ff471f9a_1:


    me "Şey, evet..."


translate turkish day7_us_5b802725:


    "Açıkçası ne konuşacağım hakkında hiçbir fikrim yoktu{w} Slavya bizi depoda buldu, yanlış anladı ve her şeyi kamp liderine anlattı."


translate turkish day7_us_70278229:


    "Şimdi düşünürseniz, bu artık onu ilgilendirmiyor."


translate turkish day7_us_752bcc5c:


    th "Öte yandan, Olga Dmitrievna ile şimdi konuşmak zaman kaybı olurdu."


translate turkish day7_us_64efd5bd:


    "Belki de bilinçaltımda Slavya'nın gerekçesini anlamak, onu bir şekilde aklayabilmek istiyordum..."


translate turkish day7_us_0483babd:


    sl "Ne söylemek istiyordun?"


translate turkish day7_us_eb47c7e6:


    me "Ulyana cezalandırıldı. Belki de bizimle gelmeyecek."


translate turkish day7_us_ecd25c83:


    sl "Hiç şaşırmadım."


translate turkish day7_us_b4a66582:


    me "Sadece size orada özel bir şey olmadığını açıklamak istedim."


translate turkish day7_us_ff2ee0f7:


    sl "Açıkçası, bilmiyorum. Sadece her şeyi rapor etmek zorundaydım."


translate turkish day7_us_c1375773:


    me "Yani yaptınız. Kimseyi daha iyi durumda bıraktı mı?"


translate turkish day7_us_3cc8517a:


    "Kendi kendime mırıldandım."


translate turkish day7_us_dd320952:


    sl "Tabii ki bunun doğru olduğundan emin değildim..."


translate turkish day7_us_6175a110:


    "Kafası karışmış bir şekilde söyledi."


translate turkish day7_us_b41d6a32:


    me "Eh, olan olmuş...{w} Ulyana'yı ev hapsinden kurtarmak mümkün mü sence?"


translate turkish day7_us_4d657d7b:


    sl "Onun için çok endişeleniyorsun."


translate turkish day7_us_3568a2ad:


    "Slavya sonunda bana baktı ve gülümsedi."


translate turkish day7_us_c5c058f9:


    me "Onun hakkında değil... Adalet hakkında!"


translate turkish day7_us_b89f54ec:


    "Biraz kafam karışsa da doğru cevabı buldum."


translate turkish day7_us_822ca264:


    sl "Kamp liderimizi tanıyorsun."


translate turkish day7_us_df7535dd:


    me "Tanıyorum, orası kesin."


translate turkish day7_us_ce7c946a:


    sl "Sadece bekle. Eninde sonunda sakinleşecektir."


translate turkish day7_us_44dec0d8:


    "Evet, sanırım en iyi karar buydu."


translate turkish day7_us_c8c804ac:


    me "Evet, haklısın."


translate turkish day7_us_26dcea4e:


    "Bir süre sessizce onun yanında durdum."


translate turkish day7_us_f37824e2:


    "Slavya konuşmaya devam etmeye istekli görünmüyordu."


translate turkish day7_us_e2cc6a60:


    "Yine de bir eksiklik hissi vardı, ancak bu rahatsız edici durumun birkaç saat sürmesi fikriyle karşı karşıya kaldığımda, yük olmamaya karar verdim."


translate turkish day7_us_2e597f6a:


    me "Tamam, ben gidiyorum o zaman."


translate turkish day7_us_5f596122:


    sl "Görüşürüz."


translate turkish day7_us_d1046a49:


    "Gülümsedi."


translate turkish day7_us_7177cc70:


    "Meydanın ortasında durup düşündüm."


translate turkish day7_us_733af708:


    th "Kalkışa daha çok zaman var ve yapacak hiçbir şeyim yok."


translate turkish day7_us_0477db27:


    th "Daha dün, sonsuza kadar burada sıkışıp kalmışım ve çok zamanım varmış gibi göründüğünde - aslında çok az olsa da - daha hızlı düşünme ve hareket etme ihtiyacı hissettim."


translate turkish day7_us_f5c36e19:


    th "Ama şimdi bu kamptan sonsuza dek ayrılmama sadece beş saat kalmışken, onu nasıl geçireceğime dair en ufak bir fikrim yok."


translate turkish day7_us_60d55935:


    "Ulyana'yı ziyaret etmeye karar verdim."


translate turkish day7_us_cfa9bf4e:


    th "Ne de olsa, kamarasından çıkmasına izin verilmese bile, bu onu ziyaret edemeyeceğim anlamına gelmiyordu."


translate turkish day7_us_63ca30ce:


    "Kapıyı nazikçe çaldım."


translate turkish day7_us_37c07e8b:


    us "Burada istenmiyorsunuz!"


translate turkish day7_us_61815909:


    "Kapının arkasından öfkeli bir ses geldi."


translate turkish day7_us_4c56125d:


    "Kolu çektim ve içeri girdim."


translate turkish day7_us_824d3de5:


    me "Selam, mahkum!"


translate turkish day7_us_70b26771:


    us "Ah, sensin..."


translate turkish day7_us_743d2def:


    "Ulyana hayal kırıklığıyla söyledi."


translate turkish day7_us_96cb823a:


    me "Ne yani, burada hoş karşılanmayan tek kişi ben miyim?"


translate turkish day7_us_15aba1cf:


    "Gülümsemeye çalıştım."


translate turkish day7_us_467b6ff9:


    us "Neden geldin?"


translate turkish day7_us_43e44e64:


    me "Burada tek başına sıkılırsın diye düşündüm."


translate turkish day7_us_e7312d00:


    us "Ben iyiyim!"


translate turkish day7_us_c33a6926:


    me "Alisa nerede?"


translate turkish day7_us_67ce2945:


    us "Gördüğün gibi, burada değil."


translate turkish day7_us_8a6c21b7:


    me "Hadi ama, neden bu kadar kızgınsın? Sabah çok daha iyi bir ruh halindeydin."


translate turkish day7_us_76aad34e:


    us "Kızgın mı? Ben mi?"


translate turkish day7_us_d54c78b5:


    me "Ben değilim, orası kesin."


translate turkish day7_us_621db685:


    us "Yapacak başka bir şeyin olmadığı için buraya geldin, değil mi?"


translate turkish day7_us_0d9da0d6:


    me "Evet, benim hatam."


translate turkish day7_us_18e7bfa2:


    "Teatral bir şekilde iç çektim ve başımı öne eğdim."


translate turkish day7_us_2259a5d2:


    us "Otur o zaman."


translate turkish day7_us_83c16d37:


    "Karşı yatağa oturdum."


translate turkish day7_us_f9c0308a:


    us "Bana bir şey söyle."


translate turkish day7_us_36e3343b:


    me "Olga Dmitrievna'ya yanlış bir şey yapmadığımızı kanıtlamak için bir yol bulalım!"


translate turkish day7_us_26f39e54:


    us "Ben yanlış bir şey yapmadım."


translate turkish day7_us_e9d754a4:


    "Ulyana beni düzeltti."


translate turkish day7_us_b1a66e30:


    us "Senin bununla bir ilgin yok gibi görünüyor."


translate turkish day7_us_d9150933:


    me "Tamam, bırak olsun."


translate turkish day7_us_03f66e24:


    us "Ama neden?"


translate turkish day7_us_86d84474:


    th "Zor bir soru."


translate turkish day7_us_ecae36f6:


    "Rollerimizi değiştirmişiz gibi hissediyorum: Ben aptalca bir plan öneriyordum, o ise mantığın sesi oluyordu."


translate turkish day7_us_873c6ad1:


    me "Çünkü biz yanlış bir şey yapmadık!"


translate turkish day7_us_56f9ef5d:


    us "Neyin var senin? Sadece birkaç saat toprakta kalacağım, hepsi bu. Zaten yakında yola çıkmamız gerekiyor."


translate turkish day7_us_442bf024:


    "Yatağa uzandı ve gözlerini tavana dikti."


translate turkish day7_us_3838f56d:


    me "Elbette, ama..."


translate turkish day7_us_5093b270:


    "Onu neşelendirmek için çok uğraştım ama görünüşe göre şu ana kadar başarılı olamadım."


translate turkish day7_us_14e075c5:


    me "Bir şeyler yapmak ister misin?"


translate turkish day7_us_6494556f:


    us "Öğle yemeği vakti geldi bile."


translate turkish day7_us_43b742c4:


    "Saatime bir göz attım."


translate turkish day7_us_ddedc7ac:


    me "Evet, doğru."


translate turkish day7_us_07a52ab7:


    us "Al sana bir iş. Dışarı çıkamayacağıma göre, git ve bana yiyecek bir şeyler getir."


translate turkish day7_us_6ae432cd:


    me "Efendim, evet efendim!"


translate turkish day7_us_a0ee099d:


    "Onu selamladım ve aceleyle kabinden çıktım."


translate turkish day7_us_7b5685fb:


    "Son zamanlarda Ulyana'nın zihninde nihayet bir şeylerin tıklandığını düşünmeye başlamıştım."


translate turkish day7_us_56f958e0:


    "Belki cezanın onun üzerinde bir etkisi oldu, belki de başka bir şeydi."


translate turkish day7_us_c059b51b:


    "Ve ona karşı tutumum değişti."


translate turkish day7_us_2a9a781a:


    "Eskiden yaptığı yanlışlar bana kızgınlıktan başka bir şey hissettirmezdi ama şimdi anlayış ve bir tür sempati de vardı."


translate turkish day7_us_c2b62820:


    "Ne de olsa ben de bir zamanlar çocuktum."


translate turkish day7_us_2326b742:


    th "Belki de ona neyin doğru neyin yanlış olduğu açıklanırsa, birçok hatadan kaçınabilir."


translate turkish day7_us_e9f2b2e6:


    "Kantinde, bana iki porsiyon vermeyi reddeden aşçıyla tartıştım."


translate turkish day7_us_749be311:


    "Ancak kamptaki herkes Ulyana'nın cezalı olduğunu zaten biliyordu, bu yüzden sonunda ikna gücüm diyet standartlarına üstün geldi."


translate turkish day7_us_9c84b285:


    "Kısa süre sonra Ulyana'nın kulübesinde oturuyor ve patatesli köfteleri mideye indiriyordum."


translate turkish day7_us_19b4f87b:


    me "Tıpkı son yemek gibi."


translate turkish day7_us_e718f922:


    us "Sen neden bahsediyorsun?"


translate turkish day7_us_076ef871:


    me "Her idam mahkumunun son bir dilek tutma hakkı vardır. Benim de son dileğim böyle bir öğle yemeği."


translate turkish day7_us_6532261a:


    us "Hmm..."


translate turkish day7_us_1d2850e0:


    "Sürpriz bir şekilde yemekler gerçekten çok lezzetliydi."


translate turkish day7_us_1357b107:


    me "Dileğiniz ne olurdu?"


translate turkish day7_us_8a3e0f25:


    us "Şey... İdam edilmemek için tabii ki!"


translate turkish day7_us_ec2c2a7c:


    "Güldü."


translate turkish day7_us_4e8385e3:


    me "Yapamazsın."


translate turkish day7_us_d8734f33:


    us "Neden? Eğer bir şey dileyebiliyorsan."


translate turkish day7_us_d1a58061:


    me "Yapabilirsiniz ama belli sınırlar içinde."


translate turkish day7_us_1b7bd7e3:


    us "Yani hiçbir şey değil."


translate turkish day7_us_ba513381:


    me "Tamam o zaman, hiçbir şey değil."


translate turkish day7_us_2bca74af:


    us "O zaman bu ilginç değil."


translate turkish day7_us_a220139e:


    me "Bence idam mahkûmu olmak zaten pek de ilginç bir şey değil."


translate turkish day7_us_e98bfbde:


    "Dişlerimin arasından sırıttım."


translate turkish day7_us_389622ca:


    us "Bilemem, o deneyimi hiç yaşamadım."


translate turkish day7_us_0cf85698:


    "Ama düşünürseniz, bu neredeyse benim durumum."


translate turkish day7_us_8c75e136:


    th "Bu kamp benim hücrem{w} birkaç saat daha tutuklu kalacağım ve sonra tıpkı ölümden sonra olduğu gibi belirsizlikle yüzleşeceğim."


translate turkish day7_us_72658116:


    th "Tek fark, daha fazla seçeneğim olması. Eğer lineup'a katılmak istersem katılırdım, istemezsem katılmazdım."


translate turkish day7_us_9e77a60a:


    me "Bundan sonra ne yapacaksın?"


translate turkish day7_us_5f2c0f51:


    us "Ne demek istiyorsun?"


translate turkish day7_us_c9d0b0d9:


    me "Kamptan sonra."


translate turkish day7_us_efd76d15:


    "Bana şaşkınlıkla baktı."


translate turkish day7_us_85f9af1a:


    us "Okula dönmek tabii ki."


translate turkish day7_us_133710bb:


    th "Evet, sadece benim için buradan ayrılmak bir bariyeri, bir sınırı geçmek, bir şeyin sonu ve başka bir şeyin başlangıcı gibi."


translate turkish day7_us_cbeb66da:


    "Bir hafta önce her zamanki dünyamdan koparılıp kim bilir nereye getirildiğimi fark etmek benim için çok zordu{w} ama sonra buna alıştım."


translate turkish day7_us_40e7e33b:


    "Ve işte yine başlıyoruz."


translate turkish day7_us_74755571:


    th "Temelde tek fark, artık korku ve dehşet duygusuyla değil, künt, batan bir belirsizlik duygusuyla yüzleşiyorum."


translate turkish day7_us_cdd166bb:


    us "Peki ya siz?"


translate turkish day7_us_6aabcfa6:


    me "I... Yapacak bir şeyler bulurum."


translate turkish day7_us_94d9cae2:


    us "Bir şeyler mi?"


translate turkish day7_us_42be2b6f:


    "Bir kahkaha patlattı."


translate turkish day7_us_90305e74:


    me "Evet, sorun ne?"


translate turkish day7_us_a5f6da24:


    us "Palyaço olmak için sirk okuluna gitmeliydin!"


translate turkish day7_us_5ac38cf1:


    me "Neden?"


translate turkish day7_us_79d4d869:


    us "Sana bakarken insan gülmeden edemiyor."


translate turkish day7_us_ed762271:


    me "Ama neden?"


translate turkish day7_us_1c0cb259:


    us "Her zaman bir tür şehit, tüm Ruslar için yeni bir mesih gibi davranıyorsun."


translate turkish day7_us_67f0f7a7:


    "Sözlerinde biraz gerçeklik payı vardı."


translate turkish day7_us_bb751cb7:


    me "Kendimce sebeplerim var."


translate turkish day7_us_e0608260:


    "Mırıldandım ve pencereye doğru döndüm."


translate turkish day7_us_96bedb40:


    us "Ne gibi sebepler?"


translate turkish day7_us_e9cde24f:


    me "Çeşitli...{w} Neden bu kadar meraklısın?"


translate turkish day7_us_b72e8852:


    us "Benim bir çocuk olduğumu unuttun mu?"


translate turkish day7_us_3aa0974f:


    "Küstahça sırıttı."


translate turkish day7_us_31faa27f:


    me "Seninle geçirdiğim yarım saat benim için korkunç bir işkence gibi."


translate turkish day7_us_7c214dde:


    us "Konuşana bak! Sen gerçekten huysuz birisin!"


translate turkish day7_us_1aff923f:


    me "Neden böyle düşünüyorsun?"


translate turkish day7_us_ebf04f0a:


    us "Her zaman derin bir ruh arayışı içindesin, bir şeyler bulmaya çalışıyorsun, etrafındaki herkesi analiz ediyorsun."


translate turkish day7_us_1a13d024:


    "Ulyana'ya hayret dolu bir bakış attım."


translate turkish day7_us_3637341f:


    "Bu kadar küçük bir kızın böylesine olgun bir muhakeme yeteneğine sahip olmasını asla beklemezdim."


translate turkish day7_us_5730768c:


    me "...ve?"


translate turkish day7_us_38197147:


    us "Bu kadar."


translate turkish day7_us_0d76fe54:


    me "En azından nasıl davranacağımı biliyorum - ve cezalı duruma düşmüyorum."


translate turkish day7_us_b9e39a7d:


    us "Bu bir şans meselesi."


translate turkish day7_us_7f6b716b:


    "Sırıttı."


translate turkish day7_us_a7b22250:


    me "Evet, tabii!"


translate turkish day7_us_26a5c7be:


    us "Eğer dün gece..."


translate turkish day7_us_5e054826:


    "Kısa kesmişti."


translate turkish day7_us_fc2d031c:


    me "\"Dün gece\" ne?"


translate turkish day7_us_0cdc580c:


    us "Hiçbir şey."


translate turkish day7_us_7a4616c7:


    me "Hayır, başladığın şeyi bitir!"


translate turkish day7_us_b58aec3f:


    "Tam ağzını açmıştı ki kapının arkasından adım sesleri duyuldu ve bir saniye sonra Olga Dmitrievna odaya girdi."


translate turkish day7_us_aef6989a:


    mt "Ah, işte buradasın. Bu daha da iyi."


translate turkish day7_us_6553b668:


    "Kafası karışmış ve ne diyeceğini bilemez haldeydi."


translate turkish day7_us_cb8b6ba5:


    mt "Bu sabahki olayı tekrar gözden geçirdim...{w} Çok daha netleşti gibi değil, ama büyük bir mesele gibi görünmüyor.{w} Yani Ulyana, artık resmi olarak cezalı değilsin."


translate turkish day7_us_0cd3e52f:


    me "Keşke bunu en başından beri yapsaydın."


translate turkish day7_us_901a0e98:


    "Mırıldandım."


translate turkish day7_us_574528c5:


    mt "Bir şey mi söyledin?"


translate turkish day7_us_3c5e2cfc:


    me "Hayır, hiçbir şey."


translate turkish day7_us_73c573c4:


    mt "Kalkış yaklaşıyor, eşyalarınızı toplama zamanı."


translate turkish day7_us_8af1d414:


    "Bunu söyleyerek kulübeden ayrıldı."


translate turkish day7_us_4456980d:


    us "Şimdi her şeyin nasıl sonuçlandığını görüyorsunuz!"


translate turkish day7_us_c63ec5a4:


    me "Evet..."


translate turkish day7_us_9da1463d:


    "İç çektim."


translate turkish day7_us_2d5f3035:


    me "Toplanacak mısın?"


translate turkish day7_us_f2cfbfb7:


    us "Evet, sanırım...{w} Ya sen?"


translate turkish day7_us_bad_7d11a631:


    me "Evet, ben de eşyalarımı toplayacağım."


translate turkish day7_us_bad_cf3fffbb:


    "Cevap vermedi, ben de kulübeden çıktım."


translate turkish day7_us_bad_953ac80a:


    th "Görünüşe göre bu kamptaki son görevim de tamamlandı - Ulyana'nın cezası bozuldu."


translate turkish day7_us_bad_044c011d:


    th "Bana kalan tek şey buradan ayrılmak ve yeni bir şey için hazırlanmak."


translate turkish day7_us_bad_782e9fd9:


    "Kamp liderinin kulübesine girerken gözlerimi odanın içinde gezdirdim."


translate turkish day7_us_bad_9bc29860:


    th "Toplanacak bir şeyim var mı ki zaten?"


translate turkish day7_us_bad_cae3ae11:


    "Kışlık kıyafetlerimi bir çantaya doldurdum ve yatağa oturdum."


translate turkish day7_us_bad_b02e82a9:


    "Acı verici bir eksiklik hissi peşimi bırakmıyordu - ya deja vu ya da bir şeyi unuttuğum ama tam olarak ne olduğunu hatırlayamadığım hissi."


translate turkish day7_us_bad_6288575d:


    th "Her şey söylendiğinde ve yapıldığında, burada herhangi bir cevap bulmayı başaramadım ve şimdi arayışıma başka bir yerde devam etmem gerekecek."


translate turkish day7_us_bad_1aa8b92f:


    th "Kaçmak mümkün olmadıktan sonra buraya nasıl ve neden geldiğim gerçekten önemli mi? Görünüşe göre hiçbir şey bana bağlı değil."


translate turkish day7_us_bad_41fa4bd9:


    "Önceden her şey daha basit görünüyordu."


translate turkish day7_us_bad_5a9fed74:


    "Evet, büyük beklentilerim yoktu, bakış açılarım pek akıl almazdı ama en azından her şey oldukça açıktı."


translate turkish day7_us_bad_3a418180:


    "Yine de burada geçirdiğim bir hafta.... önceki tüm hayatımdan daha fazla sorun ortaya çıkardı."


translate turkish day7_us_bad_a20cefa7:


    "..."


translate turkish day7_us_bad_f98266b4:


    "Saat beşi vurdu."


translate turkish day7_us_bad_d924adad:


    "Çantayı aldım ve otobüs durağına doğru hızla yürüdüm, bensiz gideceklerinden endişeliydim!"


translate turkish day7_us_bad_abfd8483:


    "Görünüşe göre otobüs, tüm öncüler gibi çoktan orada bekliyordu."


translate turkish day7_us_bad_090f0c1d:


    mt "Herkes burada mı?"


translate turkish day7_us_bad_14167bf5:


    "Olga Dmitrievna başladı."


translate turkish day7_us_bad_044ab0d8:


    mt "Bugün kampımızdan ayrılıyorsun ve sana veda ederken bir şey söylemek istiyorum."


translate turkish day7_us_bad_00123e37:


    "Gözle görülür bir şekilde gergindi ve söyleyecek söz bulamıyordu."


translate turkish day7_us_bad_019ed77a:


    mt "Umarım burada geçirdiğin zamanı bir ömür boyu hatırlarsın ve Sovyonok'la ilgili sadece güzel anılar biriktirirsin."


translate turkish day7_us_bad_b48fe53b:


    mt "Ayrıca en azından biraz daha iyi olmanızı, bir şeyler öğrenmeyi başarmanızı ve yeni arkadaşlar edinmenizi umuyorum...{w} Sadece... gelecek yıl tekrar gelin."


translate turkish day7_us_bad_42256d78:


    "Kamp lideri arkasını döndü{w} gözyaşlarını tutmaya çalışıyor gibiydi."


translate turkish day7_us_bad_80682609:


    "Bu kadar duygusallaşmasını beklemiyordum."


translate turkish day7_us_bad_f4683d53:


    "Yine de konuşması tam bir saçmalık gibiydi. Her zamanki gibi."


translate turkish day7_us_bad_592d05f0:


    "Öncüler yavaş yavaş otobüse binmeye başladı."


translate turkish day7_us_bad_5176ce5d:


    "Gözlerim kalabalığın üzerinde Ulyana'yı arıyordu."


translate turkish day7_us_bad_422a1788:


    me "Ulyana nerede?"


translate turkish day7_us_bad_2dd2f5e0:


    mt "O gitmeyecek."


translate turkish day7_us_bad_0012312c:


    "Lider kısa cevap verdi."


translate turkish day7_us_bad_ae14ffa6:


    me "Nasıl? Neden?"


translate turkish day7_us_bad_945c2cb1:


    mt "O cezalı."


translate turkish day7_us_bad_55986632:


    me "Ama dedin ki."


translate turkish day7_us_bad_f037a948:


    mt "Yine iş başında."


translate turkish day7_us_bad_149b3064:


    me "Ne demek istiyorsun?"


translate turkish day7_us_bad_76b8fe45:


    mt "Hey, içeri gir, yoksa seni almadan gidecekler!"


translate turkish day7_us_bad_a8a52ea3:


    th "Gerçekten de, dışarıda kalan son adam bendim."


translate turkish day7_us_bad_4b08df28:


    me "Bekle bir saniye."


translate turkish day7_us_bad_8d6e2c28:


    mt "Kımılda!"


translate turkish day7_us_bad_ef663ab0:


    "Beni otobüse doğru itti{w} tartışmamaya karar verdim."


translate turkish day7_us_bad_4c34caf5:


    th "İşte sonunda, sonsuza kadar ondan sorumlu tutulamam! İşte yine başlıyoruz! Eğer bu kadar inatçı olacaksa, sonuçlarıyla yüzleşmek ona kalmış!"


translate turkish day7_us_bad_92535a77:


    "Son koltuğa ben oturdum."


translate turkish day7_us_bad_d1b5df44:


    "Benim için bir partner yoktu, ki o anda bu benim için sorun değildi."


translate turkish day7_us_bad_06550b87:


    "Ancak çok geçmeden Alisa yanıma oturmak için hareket etti."


translate turkish day7_us_bad_fddf23ae:


    dv "Ulyana nerede?"


translate turkish day7_us_bad_bd9299cf:


    me "Kaldı."


translate turkish day7_us_bad_69139e02:


    dv "Neden?"


translate turkish day7_us_bad_ba766f00:


    me "Topraklanmış..."


translate turkish day7_us_bad_ec5a83b6:


    "Tek kelimelik cevaplar verdim, konuşmaya ilgi göstermedim."


translate turkish day7_us_bad_81056a1f:


    dv "Neden?"


translate turkish day7_us_bad_7479b07e:


    me "Bilmiyorum."


translate turkish day7_us_bad_86e1bfff:


    dv "Ne yani, öğrenmeye bile çalışmadın mı?"


translate turkish day7_us_bad_d762c781:


    me "Geri dönmeye değer mi?"


translate turkish day7_us_bad_72474ea4:


    dv "Kalmalısın."


translate turkish day7_us_bad_b0739623:


    me "Ne için? İstersen kalabilirsin. Çok uzağa gitmedik."


translate turkish day7_us_bad_aa5269ba:


    dv "Evet, evet..."


translate turkish day7_us_bad_ee6019f2:


    "Sakince konuştu ve evine gitti."


translate turkish day7_us_bad_1ff20cee:


    "Slavya ve Zhenya ön koltuklarda oturmuş heyecanla bir şeyler konuşuyorlardı. Lena, Miku, Shurik, Electronik bana yakın oturuyor ve kâğıt oynuyorlardı. Alisa ve başka bir kız bir dergiye bakıyorlardı."


translate turkish day7_us_bad_e72a9bb8:


    "Muhtemelen yapacak pek bir şeyi olmayan tek kişi bendim."


translate turkish day7_us_bad_f2666b16:


    "Ulyana'ya olanlar yüzünden kendimi hâlâ biraz suçlu hissettiğimi düşünürken yakaladım kendimi."


translate turkish day7_us_bad_0e4c5769:


    th "Ama ne yapabilirdim ki{w} eğer onunla birlikte kalsaydım, muhtemelen ayrılmak için tek şansımı kaçırmış olacaktım..."


translate turkish day7_us_bad_05830ef4:


    th "Ve benim durumumda, böyle oyunlar oynamak ölümcül olabilir!"


translate turkish day7_us_bad_13511f52:


    th "Ve bunun dışında, yeter artık!"


translate turkish day7_us_bad_f86e1ee0:


    "Yine de onu düşünmeden edemiyordum{w} Hatalı olduğumu, korkakça davrandığımı, kötü bir şey yaptığımı{w} Benim yerimde kim olsa yapardı..."


translate turkish day7_us_bad_654261be:


    th "Her neyse, o benim için kim ki onun uğruna risk almam gerekiyor?"


translate turkish day7_us_bad_8ce59d82:


    "Bu soruya cevap vermek daha da zordu."


translate turkish day7_us_bad_7415ba73:


    "Burada geçirdiğim bir hafta boyunca onu ve diğerlerini oldukça iyi tanıdım."


translate turkish day7_us_bad_a7064953:


    th "Sonunda kendimi bir şekilde Ulyana'ya karşı sorumlu hissettim!"


translate turkish day7_us_bad_abd762d2:


    th "Ama şimdi bunu düşünmenin ne anlamı var?"


translate turkish day7_us_bad_69057b86:


    th "Bu öncü kamptan ayrılıyorum{w} bilinmeyene doğru gidiyorum."


translate turkish day7_us_bad_79fbcf58:


    th "Şu andan itibaren tüm kararlarımı bu dünyanın bana yabancı ve büyük olasılıkla düşmanca olduğu varsayımına dayanarak vermek zorundayım."


translate turkish day7_us_bad_dd2f1e94:


    th "Ve güvenebileceğim hiç kimse yok."


translate turkish day7_us_bad_d80fce90:


    "Gerçi düşününce bu durum benim için çok da yeni değil{w} geçmişte hep yalnızdım......"


translate turkish day7_us_bad_a20cefa7_1:


    "..."


translate turkish day7_us_bad_e1a1a085:


    "Sovyonok çok gerilerde kaldı, bu garip dünyaya gece çöktü. O kadar karanlıktı ki otobüs mavimsi siyah bir okyanusun üzerinde yüzüyor gibiydi ve sadece bazen kasvetli ormanlar ve ufka kadar uzanan tarlalar yüzeyinden dalgalar gibi yükseliyordu."


translate turkish day7_us_bad_9c63431a:


    "Her neyse, çevre şu anda en az endişelendiğim şeydi - dizlerime kadar yansımamın içindeydim."


translate turkish day7_us_bad_ef6dcef8:


    "Bana kampta yarım kalmış bir iş bırakmışım gibi geliyor."


translate turkish day7_us_bad_bdc41394:


    "Şu anda oraya geri dönemesem de."


translate turkish day7_us_bad_3dfd000d:


    th "Kötü şeyler, iyi şeyler - her şey yakında unutulacak, geriye sadece buraya geldiğim gerçeği, eski hayatımın sonu ve yenisinin başlangıcı kalacak."


translate turkish day7_us_bad_0bf16c1e:


    th "Pratik olarak konuşursak, burası süslü bir yer değil - sadece kendi zamanımdan ışınlandığım seksenli yılların öncü kampı..."


translate turkish day7_us_bad_cd6651e8:


    th "Her halükarda, gideceğimiz kasabada beni nelerin beklediğini düşünmeyi tercih ederim."


translate turkish day7_us_bad_6e3dcb07:


    th "Ne de olsa dönecek hiçbir yerim yok{w} evim, param, arkadaşlarım ya da akrabalarım yok."


translate turkish day7_us_bad_2560e7b0:


    th "Birkaç saat içinde yollarımı ayıracağım tüm bu öncüler?{w} Hiçbirini bir daha görmeyeceğim.{w} Ya onlar? Birkaç yıl içinde beni hatırlayacaklarını sanmıyorum."


translate turkish day7_us_bad_34c047f7:


    th "Onlar için önemli bir şey değil, onlar için ben zaman yolcusu değil, sıradan bir çocuğum, onların akranıyım......"


translate turkish day7_us_bad_a20cefa7_2:


    "..."


translate turkish day7_us_bad_790bebae:


    "Yol sonsuz görünüyordu{w} öncülerin çoğu çoktan uykuya dalmıştı ama ben yine de kestirme isteğimle savaşıyordum."


translate turkish day7_us_bad_55c5b97a:


    "Bilinmeyene uyanık kalarak girmek her zaman daha iyidir, ancak bilinmeyenin bu savaşta her zaman bir üstünlüğü vardır - uygun gördüğü şekilde kontrol edebildiği zamanın akışı."


translate turkish day7_us_bad_59d8bd33:


    "Bir dakika, bir saat beklersiniz ama hiçbir şey olmaz. Zaten sınırlarına kadar gerilmiş olan sinirleriniz sonunda strese teslim olur ve öylece uykuya dalarsınız..."


translate turkish day7_us_good_0f8e9855:


    me "Toplayacak fazla bir şeyim yok."


translate turkish day7_us_good_fa7387e7:


    "Aslında, gerçek buydu."


translate turkish day7_us_good_07b57da2:


    us "O zaman bana yardım etmek ister misin?"


translate turkish day7_us_good_011dac7d:


    me "Tamam, tabii, neden olmasın?"


translate turkish day7_us_good_9e6ddcf0:


    "Kıyafetlerini dolaplardan çıkarıp yatağının üzerine yığmaya başladı."


translate turkish day7_us_good_16c1c561:


    me "Dikkat et, her şeyi berbat edeceksin."


translate turkish day7_us_good_a5b3f692:


    us "Sorun yok! Onları evde yıkarım!"


translate turkish day7_us_good_8821f1ec:


    "Tişörtler, etekler, şortlar, elbiseler, ayakkabılar, spor ayakkabılar, iç çamaşırları... Kıyafet yığını gittikçe büyüyordu."


translate turkish day7_us_good_1b010f5f:


    me "Bütün bunları buraya gerçekten tek başına mı getirdin?"


translate turkish day7_us_good_2312e712:


    "Ulyana'nın yapısını düşününce, buna inanmak zordu."


translate turkish day7_us_good_fc656e44:


    us "Evet, tabii ki!"


translate turkish day7_us_good_ce3666e5:


    "Güldü."


translate turkish day7_us_good_968191a9:


    us "Hadi, bana yardım et."


translate turkish day7_us_good_907c8b48:


    "Kıyafetleri büyük bir çantaya doldurmaya başladık."


translate turkish day7_us_good_7128760a:


    "İlk başta her şeyi dikkatlice paketlemeye çalıştım, ancak bunun anlamsız olduğunu fark ettikten sonra, her şeyi sığdırmak için her şeyi doldurmaya başvurdum."


translate turkish day7_us_good_e48f1d3a:


    "Sonunda yatakta giysi kalmadı ve hatta bir şekilde çantanın fermuarını çekmeyi bile başardık."


translate turkish day7_us_good_848e1ff0:


    us "Yani, bu kadar."


translate turkish day7_us_good_9513cd87:


    me "Evet..."


translate turkish day7_us_good_153e49e8:


    "Saate baktım{w} kalkış saatine yaklaşık kırk dakika vardı."


translate turkish day7_us_good_05577344:


    us "Bilirsin, eğlenceliydi."


translate turkish day7_us_good_cb23542f:


    me "Ne demek istiyorsun?"


translate turkish day7_us_good_150ba4fa:


    us "Geçen hafta eğlenceliydi."


translate turkish day7_us_good_75e0e5f1:


    me "Ah, evet."


translate turkish day7_us_good_f2170060:


    "Dalgın dalgın söyledim."


translate turkish day7_us_good_734b6aae:


    us "Sence de öyle değil mi?"


translate turkish day7_us_good_665c7c6a:


    me "Neden?"


translate turkish day7_us_good_68413a8d:


    us "Bana biraz samimiyetsiz geldi."


translate turkish day7_us_good_b2352a58:


    me "İtiraf etmeliyim ki pek de havada yürüyen biri değilim, evet."


translate turkish day7_us_good_14cb44fc:


    us "Ama neyi beğenmedin?"


translate turkish day7_us_good_5839d87f:


    th "Her şeyi bir anda söyleyemem ki."


translate turkish day7_us_good_d2eaf470:


    me "Gördüğünüz gibi... Bazı anlar, nasıl desem, biraz beklenmedikti."


translate turkish day7_us_good_2ee7e228:


    us "Blah, çok sıkıcısın..."


translate turkish day7_us_good_0c55cf94:


    "Dedi Ulyana ve benden uzaklaştı."


translate turkish day7_us_good_34c3e0de:


    me "Benden ne bekliyordun ki?"


translate turkish day7_us_good_cac3332a:


    us "Daha sonra hatırlayacak hiçbir şeyin yokmuş gibi konuşuyorsun."


translate turkish day7_us_good_b654b924:


    me "Evet, hatırlayacak çok şey var."


translate turkish day7_us_good_5154e89b:


    "Parıldadım."


translate turkish day7_us_good_ac91a0ae:


    us "Evet, ben de bunu söylüyorum!"


translate turkish day7_us_good_e24147c1:


    "Bana yakından baktı{w} Bu beni biraz rahatsız etti."


translate turkish day7_us_good_f3274282:


    me "Şimdi ne olacak?"


translate turkish day7_us_good_f68e9feb:


    us "Peki ya ben, beni hatırlayacak mısın?"


translate turkish day7_us_good_39fd95ae:


    me "Elbette hatırlayacağım. Herkes."


translate turkish day7_us_good_7b24e7b5:


    us "Herkes."


translate turkish day7_us_good_d445de56:


    me "Ve sen, en çok da sen!"


translate turkish day7_us_good_55ab6c4e:


    "Elimi kalbimin üzerine koyarak hazır ola geçip selam verdim."


translate turkish day7_us_good_7827470a:


    us "Bu daha iyi!"


translate turkish day7_us_good_f3bc15be:


    th "Ancak, onun hakkında gerçekten hatırlamam gereken bir şey var mı?"


translate turkish day7_us_good_37b15a62:


    th "Evet, bir sürü macera yaşadık ama benim için Ulyana kim?{w} Sadece başka bir gerçeklikten gelen meraklı bir çocuk..."


translate turkish day7_us_good_b532bb7b:


    th "Bir daha düşündüm de, şu anki durumum gerçekten o kadar umurumda mı?{w} Buraya geldiğim ilk andan itibaren her şey muazzam bir şekilde değişti, bu yüzden şu anda sadece bundan sonra ne olacağını merak ediyorum."


translate turkish day7_us_good_2104e6d9:


    th "Elbette, bilinmezlik en hoş perspektif değil ama nefes kesici bir perspektif olduğunu da kabul etmeliyim."


translate turkish day7_us_good_78852785:


    th "Kendi dünyama dönüp dönmeyeceğim artık bana bağlı değil."


translate turkish day7_us_good_119d1deb:


    th "Bu, gerçekten başka seçeneğim olmadığı anlamına geliyor - yerel yaşam koşullarına uyum sağlamak zorundayım."


translate turkish day7_us_good_3c4827d3:


    "Ve bu koşullardan biri de tam karşımda oturmuş, geniş geniş gülümsüyordu."


translate turkish day7_us_good_77a7cf13:


    me "Biliyor musun, ilk düşündüğüm kadar aptal değilmişsin."


translate turkish day7_us_good_0f029e42:


    us "Neden aptal olduğumu düşündün ki?"


translate turkish day7_us_good_3db311fc:


    "Kırgın bir ses tonuyla söyledi."


translate turkish day7_us_good_2824e5e8:


    me "Şaka yapıyorum."


translate turkish day7_us_good_27972fbd:


    us "Sen ve senin şakaların."


translate turkish day7_us_good_96ba4ae7:


    me "Pekala, zamanı geldi."


translate turkish day7_us_good_89d3eb13:


    us "Hadi gidelim."


translate turkish day7_us_good_5b0783c9:


    "Ulyana mutlu bir şekilde çantayı işaret etti."


translate turkish day7_us_good_f2e007f0:


    me "Evet..."


translate turkish day7_us_good_379e3d71:


    "Eşyalarını omuzladım{w} ağırlıktan neredeyse ikiye bölünecektim."


translate turkish day7_us_good_fd618572:


