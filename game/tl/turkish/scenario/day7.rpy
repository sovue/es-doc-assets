translate turkish day7_dv_7d2a5519:


    th "Ona karşı herhangi bir şey hissediyor muyum? Sempati duyuyorum, bir tür şefkat ama daha fazlası var mı?"


translate turkish day7_dv_b0325c5c:


    "Düşüncelerim Alisa tarafından bölündü."


translate turkish day7_dv_a303f6cc:


    dv "İşte, al şunu."


translate turkish day7_dv_77743949:


    "Bana kocaman bir sırt çantası uzattı."


translate turkish day7_dv_4907682a:


    me "Bu da ne?"


translate turkish day7_dv_ff782f2a:


    "Şüpheyle sordum."


translate turkish day7_dv_e780e2ad:


    dv "Eşyalarım."


translate turkish day7_dv_aae0b9eb:


    me "Neden bu kadar az?"


translate turkish day7_dv_4eaa9948:


    dv "Sığdırabildiğim kadarını getirdim."


translate turkish day7_dv_5491b40f:


    me "Bak...{w} Ne kadar uzağa gitmemiz gerektiğini bilmiyoruz.{w} Belki sadece en gerekli şeyleri alabilirsin?"


translate turkish day7_dv_44f79413:


    dv "Ne yani, atmak zorunda mıyım? Burada mı bırakayım?"


translate turkish day7_dv_15d90504:


    "Alisa burnunu çekti."


translate turkish day7_dv_206f97a8:


    "Birincisi, neden bu kadar çok eşyası olduğunu anlayamadım ve ikincisi, orada bu kadar değerli ne var?"


translate turkish day7_dv_8d0625c6:


    me "Ama onu taşımak gibi şövalyece bir görev bana ait, değil mi?"


translate turkish day7_dv_bdbe816e:


    dv "Tabii ki benim!"


translate turkish day7_dv_3aa0974f:


    "Küstahça gülümsedi."


translate turkish day7_dv_8d91232a:


    "Ne kadar ağır olacağını hesapladım."


translate turkish day7_dv_278bae91:


    th "Yaklaşık on kilo sanırım{w} bunu birkaç kilometre taşıyabilirim ama daha fazla değil..."


translate turkish day7_dv_9887bbde:


    me "Bununla çok uzağa gidemeyeceğimizi anlıyorsunuzdur."


translate turkish day7_dv_d3b04189:


    dv "Elimizden geleni yapacağız."


translate turkish day7_dv_a7bd2a57:


    me "Yani daha sonra bir şeyler atabilir miyim?"


translate turkish day7_dv_7ec4ae09:


    dv "Göreceğiz bakalım."


translate turkish day7_dv_521b5dfc:


    "Gözleri sinsice parlayarak cevap verdi."


translate turkish day7_dv_9886068f:


    me "Tamam, sözünüze güveniyorum."


translate turkish day7_dv_91ff7f5a:


    th "Ne de olsa onu taşımak zorundayım, içinden bir şeyler atmaya hakkım var."


translate turkish day7_dv_a07a03c0:


    "Ve böylece yolculuğumuz başladı."


translate turkish day7_dv_92f1963f:


    "Yorulmaya başlamam en az bir saatimi aldı."


translate turkish day7_dv_31827d05:


    "Böyle bir dayanıklılığa sahip olduğumu asla düşünmezdim."


translate turkish day7_dv_948d6304:


    "Ya sırt çantasını taşımak kolaydı ya da dün geceki egzersizler kaslarımı çalıştırmıştı."


translate turkish day7_dv_3e917655:


    "Yol kenarında durdum ve Alisa'nın eşyalarını yere attım."


translate turkish day7_dv_e4dfaea7:


    dv "Ne yapıyorsun?"


translate turkish day7_dv_6932f262:


    "Kızgın olduğu belliydi."


translate turkish day7_dv_6557adca:


    me "Kendin taşımak ister misin?"


translate turkish day7_dv_b2bffcd8:


    dv "Tabii ki istemem!"


translate turkish day7_dv_ddbf8003:


    me "Bu durumda dinlenmem gerekiyor."


translate turkish day7_dv_5ced9ae4:


    "Doğal olarak, en mantıklı karar eşyaların çoğundan kurtulmak ve sadece en gerekli şeyleri saklamaktı, ancak kendimi bu kadar sert önlemler almaya ikna edemedim."


translate turkish day7_dv_a87b4b28:


    me "Bunca zamandır sessizliğini koruyorsun..."


translate turkish day7_dv_47e8d127:


    "Alisa boş gözlerle uzaklara dalan yola bakıyordu."


translate turkish day7_dv_2895df22:


    dv "Konuşacak ne var ki?"


translate turkish day7_dv_e807ab10:


    me "Bilmiyorum...{w} Ama hiçbir şey olmamış gibi davranıyorsun."


translate turkish day7_dv_b9934743:


    dv "Bir şey mi oldu?"


translate turkish day7_dv_46ec1ab9:


    "Dalgın dalgın sordu."


translate turkish day7_dv_256912af:


    me "Şey... Bilirsin işte."


translate turkish day7_dv_6330e388:


    dv "Yeterince dinlendin mi? Gidelim o zaman!"


translate turkish day7_dv_45b6c18e:


    "Alisa hızla benden uzaklaşmaya başladı."


translate turkish day7_dv_1d8b65b9:


    me "Hey, bekle bir dakika!"


translate turkish day7_dv_02244c64:


    "Sırt çantasını omuzladım ve peşinden koştum...."


translate turkish day7_dv_a20cefa7_3:


    "..."


translate turkish day7_dv_8af27249:


    "Bir süredir Alisa biraz önde, ben arkada sessizce yolculuk ediyorduk."


translate turkish day7_dv_d9f48ac6:


    "Konuşmaya nasıl başlayacağımı bilmiyordum."


translate turkish day7_dv_f9d9d427:


    "Geceki olayların büyük bir hata olduğuna dair açık ipuçları veriyor gibi görünüyordu."


translate turkish day7_dv_c81f3a7e:


    "En azından bana öyle geldi."


translate turkish day7_dv_e4773f56:


    "Gerçi benim bakış açıma göre olanlar olması gerekenlerdi."


translate turkish day7_dv_bd664ace:


    "Kamptaki son birkaç gün boyunca Alisa'dan kesinlikle etkilenmiştim{w} onun da benden etkilendiğine inanıyorum."


translate turkish day7_dv_9f1719bd:


    th "Bu durumda sorun ne?"


translate turkish day7_dv_5f62b20e:


    th "Belki de bunun sadece bir gecelik bir ilişki olmasını istemiyordur?"


translate turkish day7_dv_9bbf9c21:


    me "Bilirsin işte."


translate turkish day7_dv_00dae805:


    "Döndü ve bana baktı."


translate turkish day7_dv_6afc1bb3:


    me "Eğer yanlış bir şey yaptıysam..."


translate turkish day7_dv_6812f447:


    dv "Sen yanlış bir şey yapmadın."


translate turkish day7_dv_a31a4d9f:


    me "Ama..."


translate turkish day7_dv_904f584f:


    dv "Bu şekilde ortaya çıktı."


translate turkish day7_dv_953edcaa:


    me "Yani sadece bir kaza mıydı?"


translate turkish day7_dv_3ae4e7bf:


    dv "Ben öyle bir şey demedim."


translate turkish day7_dv_b233eb86:


    me "O zaman ne dedin?"


translate turkish day7_dv_20a5d791:


    "Düzgün bir cevap alamamam beni sinirlendirmeye başladı ve sesimi yükselttim."


translate turkish day7_dv_60992bdb:


    me "Bana sadece ipuçları, belirsizlikler veriyorsun! Peki ya açık sözlülük, samimiyet? Daha önce böyle değildin!"


translate turkish day7_dv_86f37595:


    dv "İnsanlar değişmeye meyillidir..."


translate turkish day7_dv_47359365:


    "Yavaşça ilerledi."


translate turkish day7_dv_ad786d68:


    me "Değişim mi? Sen buna \"değişim\" mi diyorsun? Artık tamamen farklı birisin! Tıpkı Lena gibi, gerçekten."


translate turkish day7_dv_1647718e:


    "Alisa durdu ama dönmedi."


translate turkish day7_dv_e9b62978:


    dv "Karşılaştırma...{w} Anladın mı?!{w} Beni onunla karşılaştırma!"


translate turkish day7_dv_03ee962e:


    "Sessizce konuştu ama sesinde öfke vardı."


translate turkish day7_dv_d3383672:


    me "Ne...?"


translate turkish day7_dv_b6ed7be6:


    "Biraz şaşırmıştım."


translate turkish day7_dv_98eb301b:


    dv "Her şey için beni suçluyorsun ama ya kendin? Sürekli ona bakıyorsun! Şimdi bile onu bende görmeyi başarıyorsun..."


translate turkish day7_dv_3837a7d9:


    me "Bekle, ne..."


translate turkish day7_dv_c011ba0d:


    dv "O zaman neden dün geldin? Ona gidebilirdin! Biliyordun."


translate turkish day7_dv_3b51cf39:


    me "Neyi biliyor muydum?"


translate turkish day7_dv_ffc2234f:


    dv "Seni beklediğimi biliyordum!"


translate turkish day7_dv_cdd661a7:


    "Görünüşe göre bu itirafı yapmak Alisa için zor bir karardı, ancak ilk başta onun sözlerine pek önem vermedim."


translate turkish day7_dv_760c9675:


    me "Dün gelmemi siz söylediniz, ben de..."


translate turkish day7_dv_0433bfa6:


    dv "Bu onunla ilgili değil!"


translate turkish day7_dv_d1db8c32:


    "Alisa hıçkırıklara boğuldu ve elleriyle yüzünü kapattı."


translate turkish day7_dv_613a279f:


    "Tamamen şaşkına dönmüştüm."


translate turkish day7_dv_5bf38ff0:


    "Hala neyi ima ettiğini anlamamıştım, bu yüzden normal bir şekilde konuşmak imkansızdı."


translate turkish day7_dv_aa4f4033:


    me "Özür dilerim...{w} Affet beni..."


translate turkish day7_dv_a9505b4f:


    dv "Özür dilemeyi kes!"


translate turkish day7_dv_e506eadf:


    me "Ama yanlış bir şey söylediysem ya da yaptıysam..."


translate turkish day7_dv_1a4b9468:


    dv "Özür dilemenin ne anlamı var? Zaten dilediyseniz...{w} En başından beri kendinize çeki düzen verseniz iyi olur."


translate turkish day7_dv_732b1419:


    me "Ama nasıl yapacağımı bilmiyorum!"


translate turkish day7_dv_bdcc6431:


    "Alisa bana baktı."


translate turkish day7_dv_b4bb6756:


    "Bakışlarında o kadar büyük bir keder vardı ki dayanamadım ve arkamı döndüm."


translate turkish day7_dv_8a74fc28:


    "Bir süre öylece durduk."


translate turkish day7_dv_5fcaf917:


    "Sonra kendini toplar gibi oldu."


translate turkish day7_dv_1b7149e8:


    dv "Tamam, unut gitsin. Yolumuza devam edelim."


translate turkish day7_dv_7f90898b:


    "Elbette istesem de unutamazdım ama yine de söyleyecek bir şeyim yoktu ve sessizlik içinde onu takip ettim...."


translate turkish day7_dv_a20cefa7_4:


    "..."


translate turkish day7_dv_bf9809fa:


    "Güneş yavaş yavaş ufkun altına doğru ilerliyordu."


translate turkish day7_dv_546ddc40:


    "Düşüncelere dalmıştım ve sırtımdaki ağır sırt çantasını bile unutmuştum."


translate turkish day7_dv_7d33e08e:


    "Bir şeyler söylemeli, bir şeyler yapmalıydım."


translate turkish day7_dv_29a605f9:


    th "Alisa beni bekliyor{w} En azından birkaç kelime..."


translate turkish day7_dv_ee5b037a:


    th "Ama ne ile başlamalıydım?"


translate turkish day7_dv_3522dad7:


    "Hayatımdaki her şeyin oldukça basit olmasına alışmıştım."


translate turkish day7_dv_26ce155f:


    "Herhangi bir görev sadece birkaç adım sonra zaten bitmiş gibi görünüyordu."


translate turkish day7_dv_bb97fe3b:


    "Hedefime giden uzun yolu düşünmek yerine, hemen sonuçları düşünmeye başladım ve elde edilmemiş bir zaferin tadını çıkardım."


translate turkish day7_dv_99fc5064:


    "Üstelik gerçek dünyada böyle bir durumla karşılaşacağımdan da şüpheliydim."


translate turkish day7_dv_6fb63bc0:


    "Açıkçası, uzun zamandır beni önemseyecek bir insanın hayalini kuruyordum."


translate turkish day7_dv_ff2cf0a2:


    "Ama şu anda karşımda böyle biri var ve ben hiçbir şey hissetmiyorum."


translate turkish day7_dv_79e93d21:


    "Ve Alisa'ya 'evet' ya da 'hayır' diyemiyorum çünkü bundan sonra ne olacağını bilmiyorum."


translate turkish day7_dv_cb230162:


    "Bu arada hava karardı."


translate turkish day7_dv_31cc1e11:


    me "Sanırım gece için bir kamp yapmalıyız."


translate turkish day7_dv_683a8ca7:


    dv "Gidecek çok yer kalmadı."


translate turkish day7_dv_3e4e35f3:


    me "Emin misin? Öyle olsa bile, gündüz seyahat etmek daha iyi."


translate turkish day7_dv_19dee4e1:


    dv "En iyisini sen bilirsin..."


translate turkish day7_dv_8cef92aa:


    "Soğuk bir şekilde cevap verdi."


translate turkish day7_dv_2da2cbd9:


    "Bir ormanın kenarında durduk."


translate turkish day7_dv_e627ef17:


    me "Orada işe yarar bir şey var mı?"


translate turkish day7_dv_2e4b2df9:


    "Sırt çantasını gösterdim."


translate turkish day7_dv_c665ba01:


    dv "Bir göz atın."


translate turkish day7_dv_62531094:


    "Çoğunlukla ayakkabılar ve giysiler vardı ama en altta bir dergi ve bir kutu kibrit buldum. Ateş yakmak için oldukça yeterliydi."


translate turkish day7_dv_55d331e0:


    "Kısa süre sonra devrilmiş bir ağacın üzerine oturmuş, ateşin başında ellerimizi ısıtıyorduk."


translate turkish day7_dv_64dedd42:


    "Sonunda o lanet kamptan kurtulduğumu ancak şimdi fark edebildim."


translate turkish day7_dv_cef2d4ff:


    th "Hiçbir cevap bulamamıştım; aksine, sanırım hayatımın geri kalanını bu gerçeklikte geçireceğim için her şey daha da karmaşık hale gelmişti."


translate turkish day7_dv_584626de:


    th "Tüm bilimkurgu olaylarını hesaba katmazsam, 80'lerin sonunda güneyde bir yerlerde olduğum açık."


translate turkish day7_dv_c66b43bf:


    th "Buraya nasıl ve daha da önemlisi neden getirildiğim artık o kadar da önemli değil, çünkü bir şekilde uyum sağlamam gerekiyor."


translate turkish day7_dv_0cc0cf06:


    th "Ve yanımda oturan kızla başlamalıyım."


translate turkish day7_dv_48a428eb:


    me "Peki bölge merkezine ulaştığımızda ne yapacağız?"


translate turkish day7_dv_9eca505b:


    dv "Ailemizi arayacağız, başka ne olacak!"


translate turkish day7_dv_94184036:


    "Alisa hafifçe gülümsedi{w} Araması gereken biri vardı."


translate turkish day7_dv_f4eb646d:


    me "Sonra ne olacak?"


translate turkish day7_dv_e639a729:


    dv "Sonra her şey bitecek."


translate turkish day7_dv_e54b39e9:


    me "Ne demek istiyorsun?"


translate turkish day7_dv_35919e4b:


    dv "Evlerimize gideceğiz."


translate turkish day7_dv_22dddcd1:


    "Bu cevap beni gerçekten şaşırtmadı, sadece dönem bittikten sonra ne olacağını düşünmemiştim."


translate turkish day7_dv_5c1ed51e:


    me "Hepsi bu kadar mı?"


translate turkish day7_dv_964c391d:


    dv "Başka ne var?"


translate turkish day7_dv_ee102f21:


    me "Bilmiyorum...{w} Tüm bu olanlardan sonra..."


translate turkish day7_dv_be621763:


    dv "Ama hiçbir şey olmadı!"


translate turkish day7_dv_bdfc5195:


    "Bana neşeyle anlattı."


translate turkish day7_dv_7a16e55f:


    me "Ne demek 'hiçbir şey olmadı'?"


translate turkish day7_dv_5788094d:


    dv "Lena'yı bulmak için bir şansın olacak."


translate turkish day7_dv_7540e341:


    "Şaşırdım ama Alisa bunu kesinlikle nazikçe söyledi."


translate turkish day7_dv_1deed426:


    me "Sanki Lena'ya ihtiyacım varmış gibi!"


translate turkish day7_dv_bad_3bbe4c98:


    dv "Senin yok mu?"


translate turkish day7_dv_bad_af26aec3:


    "Dürüst olmak gerekirse, Lena şu anda düşündüğüm son kişiydi."


translate turkish day7_dv_bad_3d1847ad:


    me "Hayır."


translate turkish day7_dv_bad_7f24994f:


    dv "O zaman, belki de benimdir?"


translate turkish day7_dv_bad_eb6f47e6:


    "Alisa'ya dikkatle baktım{w} inatla sırıttı."


translate turkish day7_dv_bad_3674b5bc:


    th "Ve geçenlerde ağlıyordu..."


translate turkish day7_dv_bad_86e80d63:


    me "Peki ya sen?"


translate turkish day7_dv_bad_ff946cd9:


    "Soruyu geçiştirdim."


translate turkish day7_dv_bad_50f50099:


    dv "Benim hakkımda ne düşünüyorsun?"


translate turkish day7_dv_bad_ae44c7f6:


    me "Bilmiyorum."


translate turkish day7_dv_bad_0c350a0a:


    dv "Belki de doğrudan söyleyebilirsin?"


translate turkish day7_dv_bad_90c7a728:


    "Uzun bir sessizlik oldu."


translate turkish day7_dv_bad_ec6e249c:


    th "Alisa doğru dürüst bir cevap bekliyor ama ben kendim çözemiyorum."


translate turkish day7_dv_bad_785620ea:


    th "Bu öncü kampı ve şimdi de kolayca söyleyemeyeceğim bir şeyi duymak isteyen kız."


translate turkish day7_dv_bad_5dc514e5:


    me "Görüyorsunuz ya."


translate turkish day7_dv_bad_a3d0602e:


    "Ve sonra gerçekten anladım."


translate turkish day7_dv_bad_cff69fc4:


    "Artık kurnazlık yapmanın ve bir şeyleri geride tutmanın faydası olmadığını anladım."


translate turkish day7_dv_bad_881eda46:


    "Neredeyse kafesten çıkmayı başarıyordum{w} En kötüsü geride kaldı!"


translate turkish day7_dv_bad_ef1f22d6:


    "Ya da tam tersine, en kötüsü henüz gelmedi ama açıkça konuşmanın zamanı geldi."


translate turkish day7_dv_bad_fd117b88:


    me "Görüyorsunuz...{w} Benden beklediğiniz şey neredeyse imkansız."


translate turkish day7_dv_bad_a80e7dec:


    dv "Görünüşe göre senin için her şey imkânsız."


translate turkish day7_dv_bad_393056bc:


    "Burnunu çekti."


translate turkish day7_dv_bad_bc3ffa54:


    me "Bunu söylemek garip ama doğru{w} başıma ne geleceğini bilmiyorum... yarın bile değil, ama bir saniye sonra!"


translate turkish day7_dv_bad_1183f209:


    dv "Peki ne olabilir? Ortadan kaybolacak mısın?"


translate turkish day7_dv_bad_b9c3fa63:


    me "Büyük ihtimalle."


translate turkish day7_dv_bad_d5f6c4f2:


    "Bir kahkaha patlattı."


translate turkish day7_dv_bad_ac122a30:


    dv "Biliyor musun, her türlü bahaneye hazırdım ama böylesine değil."


translate turkish day7_dv_bad_0fdb45a6:


    me "Bunlar bahane değil, sadece dinle..."


translate turkish day7_dv_bad_1bc70a2f:


    "Alisa dikkatle bana baktı ve sözümü kesmeye hiç niyeti yokmuş gibi görünüyordu."


translate turkish day7_dv_bad_8de689be:


    me "Görüyorsunuz, ben buraya ait değilim{w} kamptan değil, tüm dünyadan bahsediyorum{w} buradaki hepiniz benim için tamamen garip, anlaşılmaz insanlarsınız."


translate turkish day7_dv_bad_2ee7cffc:


    dv "Aslında sizin de bizim için olduğunuz gibi."


translate turkish day7_dv_bad_2a05cd1b:


    me "Benim gezegenimden mi yoksa benim gerçekliğimden mi olduğunuzdan bile emin değilim."


translate turkish day7_dv_bad_cb2bf9d2:


    dv "Kes şunu artık..."


translate turkish day7_dv_bad_117896c8:


    "Alisa yorgunca söyledi."


translate turkish day7_dv_bad_340880cb:


    me "Bir keresinde uyuduğunuzu ve tamamen farklı bir yerde uyandığınızı hayal edin{w} Ve sadece yer değil, aynı zamanda farklı bir zaman."


translate turkish day7_dv_bad_c0004c2a:


    me "Bana olan da buydu! 21. yüzyılın başlarında buradan çok uzakta bir şehirde yaşıyordum."


translate turkish day7_dv_bad_79a7b35b:


    me "Şimdi göründüğümden biraz daha yaşlıydım{w} kendi hayatım vardı, iyi ya da kötü olmasına bakmaksızın, o benim hayatımdı."


translate turkish day7_dv_bad_e281434b:


    me "Sonra bir gece otobüse bindim, uyuyakaldım ve burada uyandım."


translate turkish day7_dv_bad_0743d894:


    me "On yedi yaşında bir öncü olarak."


translate turkish day7_dv_bad_560a2626:


    "Alisa bana şaşkınlıkla baktı."


translate turkish day7_dv_bad_3439946a:


    dv "Ve sana inanmamı mı bekliyorsun?"


translate turkish day7_dv_bad_be346c4b:


    me "Bilmiyorum, bu size kalmış...{w} Bunu size söylemek benim için gerçekten kolay olmadı."


translate turkish day7_dv_bad_82b2a360:


