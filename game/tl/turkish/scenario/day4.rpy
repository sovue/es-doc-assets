
translate turkish day4_std_morning_81731118:


    "Kafamın içinde cehennemi bir çınlamayla uyandım."


translate turkish day4_std_morning_163f48a5:


    "Çınlama bilincimin derinliklerinden geliyor gibiydi."


translate turkish day4_std_morning_dfa1885d:


    "Ancak kendime geldikten sonra, bu çınlamanın nedeninin çalar saatim olduğunu fark ettim."


translate turkish day4_std_morning_c8d82a68:


    th "Garip. Nereden çıktı bu? Neden yatağımın yanında duruyor?"


translate turkish day4_std_morning_51698244:


    "Saate göre saat yedi buçuktu."


translate turkish day4_std_morning_77df9db1:


    "Olga Dmitriyevna çoktan gitmişti ve beni sıraya girmeye zorlayacak kimse yoktu."


translate turkish day4_std_morning_f7391aeb:


    th "Böylece biraz daha uyuyabilirdim."


translate turkish day4_std_morning_08555663:


    "Gözlerimi kapattım ama bilincim kahvesini çoktan içmiş ve uzun, verimli bir güne hazır gibiydi. Kalkmam gerekiyor."


translate turkish day4_std_morning_dae26579:


    th "Günümü planlamalıyım. Ne de olsa bugün en azından bir şeyler öğrenmem gerekiyor."


translate turkish day4_std_morning_213e2357:


    "Ama yine de aklıma hiçbir şey gelmedi."


translate turkish day4_std_morning_dbbf160b:


    th "İyi. Tamamen uyanmam ve yıkanmam gerekiyor."


translate turkish day4_std_morning_0f23f979:


    "Yıkanmaya giderken Zhenya ile karşılaştım."


translate turkish day4_std_morning_2b068e19:


    me "Seni bu kadar erken kaldıran neydi?"


translate turkish day4_std_morning_86a5cb53:


    mz "Erken kalkmanın bir sakıncası var mı?"


translate turkish day4_std_morning_bb2e0646:


    "Sanki ona hakaret etmişim gibi bana baktı."


translate turkish day4_std_morning_08d4c5a9:


    me "Hayır, bir şey demedi. Sadece merak ettim."


translate turkish day4_std_morning_44cce5e2:


    mz "Seni ilgilendirmez!"


translate turkish day4_std_morning_b3f5b0be:


    "Hay Allah. Zhenya iyi günündeyken bile pek sempatik değildir. Ama bugün sadece öfkeli görünüyordu."


translate turkish day4_std_morning_eabc170b:


    "Soğuk su beni canlandırdı, kafamdaki sis dağıldı ve düşüncelerim kendilerini düzenlemeye başladı."


translate turkish day4_std_morning_ca15c6d0:


    "İlginç bir şekilde, cevapları bulmaktan çok kantinde iyi bir yer bulma konusunda endişelenmeye başladım."


translate turkish day4_std_morning_db0151db:


    "Dişlerimi fırçaladım ve tam çıkacaktım ki kulaklarımın dibinden sessiz bir ses geçti."


translate turkish day4_std_morning_4766e5e2:


    th "Muhtemelen bir sincap ya da başka bir hayvandı."


translate turkish day4_std_morning_3cb11a08:


    "Başka bir ses duydum, bu sefer biraz daha uzaktan."


translate turkish day4_std_morning_2a6c3c6a:


    "Kaynağı aramak için patika boyunca on metre yürüdüm."


translate turkish day4_std_morning_e0c86c0b:


    "Hiç kimse yoktu. Sadece sabah ormanı."


translate turkish day4_std_morning_82583edb:


    "Yıkama standına döndüm ve çimlerde bir şey arayan Miku'yu gördüm."


translate turkish day4_std_morning_152eeed8:


    "Beni fark edince gülümsedi ve yanıma atladı."


translate turkish day4_std_morning_a1863396:


    mi "Oh, merhaba! Günaydın! Yanlışlıkla diş tozumu dağıttım. Hepsini geri toplamaya çalışıyordum."


translate turkish day4_std_morning_3243720e:


    "Çimenler de pek yardımcı olmuyor gibi."


translate turkish day4_std_morning_7f1bbccc:


    me "Bunun iyi bir fikir olduğuna emin misin?"


translate turkish day4_std_morning_fdcbae6e:


    mi "Peki, neden? Başka ne yapabilirim ki? Elimde başka yok! Elimdeki son şeydi."


translate turkish day4_std_morning_30820f3b:


    "En sevdiği oyuncağı elinden alınmış bir çocuk gibi suratını astı."


translate turkish day4_std_morning_7ff796f1:


    me "İşte, sana benimkini vereceğim."


translate turkish day4_std_morning_fd9fb11a:


    "Çantamı karıştırdım."


translate turkish day4_std_morning_1ac55bec:


    "Diş tozu yoktu."


translate turkish day4_std_morning_4396dacc:


    th "Hmmm... garip. Az önce oraya koymamış mıydım? Bir dakikalığına uzaklaştım ve şimdi yok."


translate turkish day4_std_morning_b866f4d7:


    me "Dinle, unutmuşum gibi görünüyor."


translate turkish day4_std_morning_b5e2c150:


    "Ona kaybolduğunu söylemek istemedim."


translate turkish day4_std_morning_25a1bc7e:


    "Bu kızın hassasiyetini bildiğimden, kaybolan ev eşyalarının onu çok etkileyeceğini ve beyninin aşırı ısınmasını önlemek için kendini sıfırlayacağını varsaymak güvenliydi."


translate turkish day4_std_morning_3f91116b:


    me "Ben gideyim."


translate turkish day4_std_morning_165f0267:


    mi "Evet, şerefe. Bizi ziyaret edin. Yani, beni müzik kulübünde ziyaret edin, orada hala yalnızım. Ama biz... Yani ben..."


translate turkish day4_std_morning_d82a5e6d:


    "Miku'nun sesi arkamda kalan yaz sabahının tazeliğinde kayboldu."


translate turkish day4_std_morning_0c128c91:


    "Liderin kamarasına döndüğümde cep telefonumu aldım ve pil göstergesine baktım."


translate turkish day4_std_morning_2f9d1f0c:


    "Bir gün yetecek kadar, belki daha da az."


translate turkish day4_std_morning_3d04d563:


    th "Tabii ki burada bana pek yardımcı olmayacak ama yine de..."


translate turkish day4_std_morning_632d44dd:


    "Seksenlerde bir şarj aleti bulmak, onu icat etmek anlamına gelirdi."


translate turkish day4_std_morning_f6cc3af9:


    "Kahvaltıya gidiyordum ki biri kapıyı çaldı."


translate turkish day4_std_morning_482a0501:


    "Slavya'ydı."


translate turkish day4_std_morning_47583a01:


    sl "Günaydın.{w} Olga Dmitrievna'yı gördün mü?"


translate turkish day4_std_morning_9e0939cf:


    "Göğüslerine baktım. Bir gün önce beni çok fazla büyülemişlerdi."


translate turkish day4_std_morning_2645a069:


    sl "Semyon?"


translate turkish day4_std_morning_3f835829:


    "Slavya endişeyle bana bakıyordu, ama ben yine de bakışlarımı onun göğüslerinden ayırmayı başaramadım."


translate turkish day4_std_morning_a428f2b1:


    sl "Bir sorun mu var?"


translate turkish day4_std_morning_a21b3e34:


    me "Tam tersine, her şey yolunda."


translate turkish day4_std_morning_65e261bd:


    sl "Olga Dmitrievna...?"


translate turkish day4_std_morning_535da2f1:


    me "Bilmiyorum, uyandığımda burada değildi."


translate turkish day4_std_morning_1e0f3ed2:


    "Sonunda kendimi kontrol etmeyi başardım."


translate turkish day4_std_morning_0d62f1e5:


    sl "Peki, hala yapmam gereken bir şey var, kahvaltıda görüşürüz."


translate turkish day4_std_morning_145891de:


    "Slavya gülümsedi, bana el salladı ve koşarak uzaklaştı."


translate turkish day4_std_morning_f6cc3af9_1:


    "Tam kahvaltıya gidiyordum ki biri kapıyı çaldı."


translate turkish day4_std_morning_26171c75:


    "Lena'ydı."


translate turkish day4_std_morning_5edd55c2:


    un "Ermm... Günaydın."


translate turkish day4_std_morning_70958877:


    me "Evet, günaydın."


translate turkish day4_std_morning_dab051d6:


    "Biraz şaşırmıştım."


translate turkish day4_std_morning_6e7a684a:


    "Önceki gün yaşananlar hâlâ hafızamda tazeydi ama bu konuda konuşmak istemiyordum."


translate turkish day4_std_morning_ed2df426:


    me "Muhtemelen Olga Dmitrievna'yı arıyorsunuz, değil mi?"


translate turkish day4_std_morning_736f44dd:


    un "Şey, hayır...{w} yani, evet..."


translate turkish day4_std_morning_db521796:


    "Lena her zamanki gibiydi, utangaç ve kolay utanan."


translate turkish day4_std_morning_c62b7542:


    "İskeledeki o dans... şimdi bir rüyadan daha fazlası gibi görünmüyordu."


translate turkish day4_std_morning_edd9b25a:


    me "O burada değil, üzgünüm."


translate turkish day4_std_morning_98757b47:


    un "Hmm.. tamam o zaman..{w} Ben gidiyorum..."


translate turkish day4_std_morning_751ac511:


    me "Tamam..."


translate turkish day4_std_morning_2dd7a526:


    "Lena gittiğinde ona karşı çok soğuk davrandığımı düşündüm, bu yüzden bir sonraki karşılaşmamızda daha nazik olmaya karar verdim."


translate turkish day4_std_morning_07104fa7:


    "Yine de, ne olursa olsun, sabah ışıl ışıl ve güzeldi."


translate turkish day4_std_morning_5a3770b6:


    "Parlak güneş, uzay ve zamanın yer değiştirdiği öncü kamp Sovyonok'un üzerinde parlıyor, sakinlerini ısıtıyor ve günü verimli bir şekilde geçirmeleri için onları enerjiyle dolduruyordu."


translate turkish day4_std_morning_08b429c2:


    "Ya da benim durumumda, burada olup biten her şeye bir açıklama bulmak için nafile çabalarla harcamak için."


translate turkish day4_std_morning_eaabbc69:


    "Kantinin yakınında alışılmadık derecede büyük bir kalabalık vardı."


translate turkish day4_std_morning_2260fedb:


    "Elbette kampta öncülerin kantin kadar sevdiği başka bir yer yoktu, ama neden hepsi verandada toplanmıştı...?"


translate turkish day4_std_morning_f5aef4ac:


    "Neler olduğunu anlamak için yaklaştım."


translate turkish day4_fail_morning_bd4585a5:


    "Kafamın içinde cehennemi bir çatırtı beni uyandırdı{w} Kafatasım sanki biri içeriden üflüyormuş gibi hissediyordu."


translate turkish day4_fail_morning_fce68231:


    "Gözlerimi ovuşturdum, komodinin üzerinde çalan çalar saati gördüm, onu kapattım ve tekrar uyudum...."


translate turkish day4_fail_morning_a20cefa7:


    "..."


translate turkish day4_fail_morning_d941f014:


    "Uyandığımda saat dokuza çeyrek vardı."


translate turkish day4_fail_morning_772587d6:


    th "Uyanma vakti gelmiş gibi görünüyor. Kahvaltımı kaçıramam."


translate turkish day4_fail_morning_3b1d754c:


    "Kalktım, kendimi kaşıdım ve...{w} birden dün akşamı hatırladım!"


translate turkish day4_fail_morning_5ef37d77:


    "Yastığın altında bir kağıt parçası vardı:"


translate turkish day4_fail_morning_470a435f:


    "\"Burada olmanın bir sebebi var."


translate turkish day4_fail_morning_2dc1af34:


    th "Hâlâ anlamıyorum, ne anlama geliyor...?"


translate turkish day4_fail_morning_50258f02:


    th "Kendime bir mesaj göndermeyi nasıl başardım?"


translate turkish day4_fail_morning_cdc1a9f5:


    th "Bunu neden hatırlamıyorum?"


translate turkish day4_fail_morning_f2a17f0f:


    "Cevaptan çok soru{w} daha doğrusu hiç cevap yok."


translate turkish day4_fail_morning_3d4304d6:


    "Kulübeden çıktım ve kampa baktım."


translate turkish day4_fail_morning_25fa9b94:


    th "Hayır, bir illüzyona benzemiyor."


translate turkish day4_fail_morning_b5c3816d:


    "Ama bu not... her şeyi çok daha karmaşık hale getirdi."


translate turkish day4_fail_morning_2b1800da:


    th "Neye güvenebilirim?"


translate turkish day4_fail_morning_5b2a5873:


    "Midem haince gurulduyordu."


translate turkish day4_fail_morning_4c70df13:


    th "Ajan Mulder bile soruşturmaları aç yürütmezdi."


translate turkish day4_fail_morning_eaabbc69:


    "Kantinin yanında beklenmedik bir kalabalık vardı."


translate turkish day4_fail_morning_2260fedb:


    "Elbette kampta öncülerin kantin kadar sevdiği başka bir yer yoktu, ama neden hepsi verandaya doluşmuştu...?"


translate turkish day4_fail_morning_f5aef4ac:


    "Neler olduğunu anlamak için yaklaştım."


translate turkish day4_us_morning_0e224319:


    "Rüyamda sıcaklık hissettim."


translate turkish day4_us_morning_62c15031:


    "Bu bazen olur. Beyniniz henüz tam olarak uyanmamıştır ama güneşin gözünüzde parladığını hissedersiniz ve uyandığınızda ışığa alışmak için bir süre gözlerinizi kırparsınız."


translate turkish day4_us_morning_57bf0ff9:


    "Harika bir sabahtı{w} kuşlar ötüyordu, hava taze ve güzel kokuluydu ve dünya gün ışığıyla yıkanıyordu."


translate turkish day4_us_morning_51613331:


    "Bir süre daha yatakta kalacaktım ama... bir şeyler yolunda gitmiyordu."


translate turkish day4_us_morning_32a6b4a1:


    "Dün akşamki tüm olaylar aklımdan geçti."


translate turkish day4_us_morning_be5ac746:


    "Korkunç ve o kadar da korkunç olmayan hikâyeler, Ulyana."


translate turkish day4_us_morning_a581c654:


    "Bana sımsıkı sarılmış horluyordu. Küçük bir kızın yapacağı gibi değil."


translate turkish day4_us_morning_a84a89a7:


    "Ama hiç endişelenmedim."


translate turkish day4_us_morning_73427713:


    th "Ne de olsa daha erken. En geç saat yedi ya da sekiz."


translate turkish day4_us_morning_bb3ada36:


    th "Kim o kadar erken saatte kütüphaneye gitmek ister ki?"


translate turkish day4_us_morning_5c2e2f4e:


    "Arkama yaslandım ve pencereden dışarı baktım."


translate turkish day4_us_morning_a3c34756:


    th "Birkaç dakika içinde güneş tam Ulyana'nın gözlerine vuracak."


translate turkish day4_us_morning_7e2c6b03:


    me "İşte o zaman uyanacaksın!"


translate turkish day4_us_morning_70e45333:


    th "İlginç, bana bu kadar sıkı sarılmayı nasıl başardı?"


translate turkish day4_us_morning_a9947f93:


    th "Gerçekten de kendimi hiç kurtaramadım."


translate turkish day4_us_morning_a26bbdc9:


    "Teorik olarak, bu şekilde yatarak bir ya da iki saat daha geçirmeye hazırdım, ama aniden ayak sesleri duydum."


translate turkish day4_us_morning_89be002b:


    th "Belaya benziyor!"


translate turkish day4_us_morning_05c821d8:


    me "Uyan! Beni duyuyor musun? Uyan!"


translate turkish day4_us_morning_e09dbdfe:


    "Ulyana'yı dikkatle ama ısrarla omuzlarından tutup sarsmaya başladım, onu gevşetmeye çalıştım ama nafile."


translate turkish day4_us_morning_5fe87263:


    "Bu arada ayak sesleri yaklaşıyordu."


translate turkish day4_us_morning_ee87d584:


    th "Ne pahasına olursa olsun bizi kurtarmalıyım."


translate turkish day4_us_morning_fb5bb4b6:


    "Ayakta durmak işe yaramaz görünüyor - zaten bunu öğrendim - bu yüzden sürünmeye karar verdim."


translate turkish day4_us_morning_0178b537:


    "Hareketlerim (hiç katılmadığım) yedek subay eğitimine çok benziyordu - bir asker topçu saldırısı altındayken yaralı subayını sürüklüyordu."


translate turkish day4_us_morning_385cbf84:


    "Subay baygın, asker bitkin ve dikenli tel katmanları etraflarını sarmış."


translate turkish day4_us_morning_29669d4f:


    "Kütüphanenin kapısı açıldığında bir kitaplığın arkasına çömelip Ulyana'yı saklamayı zar zor başarabildim."


translate turkish day4_us_morning_d2052b63:


    "Zhenya kapının eşiğinde duruyordu."


translate turkish day4_us_morning_c24e1c91:


    th "Sabahın köründe geldiği için işine biraz fazla bağlı görünüyordu."


translate turkish day4_us_morning_61db85c5:


    el "...bekle!"


translate turkish day4_us_morning_3417c9cb:


    "Tanıdık bir ses duydum."


translate turkish day4_us_morning_177ac4cc:


    th "Ha? Bir ziyaretçi mi? Yani buraya gelmek için bir sebebi var."


translate turkish day4_us_morning_ccf4620f:


    mz "Neden dün gelemedi? Ya da bugün, ama daha sonra?"


translate turkish day4_us_morning_2dfa95a0:


    el "Bilim kimseyi beklemez."


translate turkish day4_us_morning_229b38d1:


    mz "Bilim."


translate turkish day4_us_morning_49bd4154:


    "Elektronikti."


translate turkish day4_us_morning_dfa36536:


    mz "Bir saniye bekle, onu bulacağım."


translate turkish day4_us_morning_35e81a10:


    "Bize doğru yöneldi."


translate turkish day4_us_morning_1a39bf90:


    "Ulyana'yı sırtımda olacak şekilde zar zor döndürmeyi başardım ve dört ayak üzerinde sürünerek yakındaki bir kitaplığa gittim, orada yere yığıldım ve nefes almaya çalıştım."


translate turkish day4_us_morning_b01a480f:


    mz "Neydi bu? Sibernetik matematik...?{w} Ya da matematiksel sibernetik...?"


translate turkish day4_us_morning_5e51dcff:


    th "Görünüşe göre bizi fark etmedi."


translate turkish day4_us_morning_266ebd21:


    el "Fotovoltaiklerin elektronik bombardımanı hakkında bir şeyler istiyorum."


translate turkish day4_us_morning_dc097374:


    mz "Çıldırdın mı sen? Neden askeri bir şeyimiz olsun ki?"


translate turkish day4_us_morning_6335428f:


    el "Bu hiç de askeri değil..."


translate turkish day4_us_morning_e0071b38:


    "Bir süre ikisi de sessiz kaldı."


translate turkish day4_us_morning_861c8f5c:


    el "Zhenya..."


translate turkish day4_us_morning_6a6e65d4:


    mz "Ne var?"


translate turkish day4_us_morning_ab9b10c0:


    el "Bu gece nehre gidelim."


translate turkish day4_us_morning_552a9040:


    mz "Ne için?"


translate turkish day4_us_morning_62e815fe:


    el "Şey...{w} Sadece..."


translate turkish day4_us_morning_7f61d9af:


    mz "Yapacak çok işim var...{w} Haydi, kımıldayın, robotunuz sizi bekliyor."


translate turkish day4_us_morning_3323f7c2:


    el "Tamam..."


translate turkish day4_us_morning_1e0523ce:


    "Kapının çarpması Electronik'in aşk mücadelesinin bir kitabesi gibiydi."


translate turkish day4_us_morning_67878bf4:


    th "Görünüşe göre o kadar da soğukkanlı bir robot değilmiş."


translate turkish day4_us_morning_7efc1a56:


    "Sessizce kıkırdadım."


translate turkish day4_us_morning_c59fe92e:


    "Her neyse, kahkaha atmak biraz uygunsuz görünüyor. Bir şekilde kütüphaneden kaçmalıyız."


translate turkish day4_us_morning_89531da4:


    "Zhenya kahvaltıya gidene kadar beklemek şu an için en kolay çözüm gibi görünüyor."


translate turkish day4_us_morning_395caa92:


    "Ne de olsa o komünist bir işçi. Electronik'in efsanevi robotlarından biri değil. En azından bir ara yemek yemesi gerekiyor."


translate turkish day4_us_morning_5672d57d:


    "Bu arada, Ulyana uyanmayacaktı."


translate turkish day4_us_morning_29b73a64:


    th "En azından artık horlamıyordu."


translate turkish day4_us_morning_9a87b38e:


    "Kütüphane sessizdi."


translate turkish day4_us_morning_928c4608:


    "Zhenya'yı görmedim ama durumdan az çok memnundum."


translate turkish day4_us_morning_ba7c4e5e:


    "Birden masasından anlaşılmaz sesler geldi: tıkırtılar, çatırtılar ve ...{w} müzik başladı."


translate turkish day4_us_morning_70db9b38:


    "Sovyet marşı!?"


translate turkish day4_us_morning_ba1d06f5:


    th "Tek kelimeyle harika!"


translate turkish day4_us_morning_c14cb5ff:


    "Şarkıya eşlik etmeye başlayan Zhenya olmasaydı, her şey yolunda gidebilirdi!"


translate turkish day4_us_morning_c94f8616:


    mz "Dostluk ve emekte sonsuza dek birleştik..."


translate turkish day4_us_morning_75088394:


    "Onun vatansever duygularını kıskanıyordum."


translate turkish day4_us_morning_06f8fd05:


    "Ne yazık ki bazı ses sorunları vardı. Sovyet pop sahnesi kesinlikle Zhenya adında bir yıldızı kaçırmadı."


translate turkish day4_us_morning_9877cbdf:


    "Marş sona erdi ve tanıdık olmayan bir ses beş yıllık ekin hasadı planının başarılarından bahsetmeye başladı."


translate turkish day4_us_morning_26511e70:


    "Belli ki bir radyoydu."


translate turkish day4_us_morning_2d3e165e:


    "Dikkatle dinlemeye başladım. Belki ilginç bir şeyler söyleyeceklerdi."


translate turkish day4_us_morning_526eb40c:


    "Ancak tarımsal başarıların listesinden sonra ses kaybolmaya başladı ve birkaç dakika içinde yok oldu."


translate turkish day4_us_morning_13ff876e:


    th "Muhtemelen sinyal bozulması."


translate turkish day4_us_morning_a0c04095:


    "Zhenya ayağa kalktı ve bize doğru yöneldi."


translate turkish day4_us_morning_9e8818da:


    "Durum dibe vuruyor."


translate turkish day4_us_morning_356a32e8:


    "Ulyana'nın elini muazzam bir mücadeleyle çözmeyi başardım."


translate turkish day4_us_morning_079daa56:


    "Gitmekte özgürdüm ama çömelmekten o kadar sıkışmıştım ki ayağa kalkacak gücüm yoktu."


translate turkish day4_us_morning_86aec307:


    th "En kötüsüne hazırlanmanın ve bahaneler düşünmeye başlamanın zamanı geldi..."


translate turkish day4_us_morning_a755654d:


    "Birden adımlar durdu."


translate turkish day4_us_morning_d2163297:


    "Görünüşe göre Zhenya kitaplığın diğer tarafında duruyordu."


translate turkish day4_us_morning_f120f183:


    "Kitapların hışırtı sesini duydum."


translate turkish day4_us_morning_ce9a6b7b:


    th "Muhtemelen bir şey arıyordu."


translate turkish day4_us_morning_9743d34f:


    "Bir kitap aldı ve masasına döndü."


translate turkish day4_us_morning_f06c5e02:


    "Kapı çarparak açıldı."


translate turkish day4_us_morning_3cf16294:


    mt "Semyon?!{w} Onu gördün mü?"


translate turkish day4_us_morning_5fd5cacf:


    "Olga Dmitrievna kesinlikle nefes nefese kalmıştı."


translate turkish day4_us_morning_5419bf5d:


    mt "Ulyana?!"


translate turkish day4_us_morning_ac7585a7:


    mz "Hayır..."


translate turkish day4_us_morning_80c6622f:


    "Zhenya şaşkınlıkla cevap verdi."


translate turkish day4_us_morning_519eac8f:


    "Kapı bir önceki sefer olduğu gibi gürültüyle çarpıldı."


translate turkish day4_us_morning_8adc70f4:


    "Görünüşe göre herkes bizi arıyor ve Zhenya kütüphanenin etrafına bakmaya başlayacak..."


translate turkish day4_us_morning_2dc3e10c:


    "Ama neyse ki tam o anda uzaktan gelen zil sesi öncüleri kahvaltıya çağırır."


translate turkish day4_us_morning_4d1c12f2:


    "Zhenya dakik bir insan olduğu için oyalanmamaya karar verdi ve birkaç dakika içinde kütüphaneden ayrıldı. Kütüphanede sadece ben ve Ulyana kalmıştık."


translate turkish day4_us_morning_35353818:


    "O zaman onunla ne yapacağıma karar verme zamanı gelmişti."


translate turkish day4_us_morning_195ba3f0:


    "Artık yakalanmaktan korkmuyordum, eğildim ve kulağına bağırdım."


translate turkish day4_us_morning_e501c3ad:


    me "Uyan, uyan, yumurta ve fırın!"


translate turkish day4_us_morning_e9fe52a8:


    "Anında sıçradı ve etrafına bakınmaya başladı."


translate turkish day4_us_morning_a94e04aa:


    "Beni fark edince Ulyana'nın gözleri büyüdü."


translate turkish day4_us_morning_ba2cf72c:


    us "Ne yapıyorsun burada?"


translate turkish day4_us_morning_571b4ce2:


    me "Casusculuk oynuyorum."


translate turkish day4_us_morning_ed803309:


    us "Ne?"


translate turkish day4_us_morning_e29d2e60:


    me "Boş ver... İyi uyudun mu?"


translate turkish day4_us_morning_41c2189c:


    us "Evet..."


translate turkish day4_us_morning_feb4bc5f:


    "Görünüşe göre bilinci henüz tam yerine gelmemiş."


translate turkish day4_us_morning_d2228502:


    me "Kahvaltı mı?"


translate turkish day4_us_morning_41c2189c_1:


    us "Evet."


translate turkish day4_us_morning_8bceae14:


    "Kütüphaneden çıktık."


translate turkish day4_us_morning_d5d18ead:


    th "Nihayet!"


translate turkish day4_us_morning_9eb55c9a:


    th "Artık Ulyana'nın ve benim bütün gece boyunca orada olmamızın ne, nasıl ve neden olduğunu kimseye açıklamak zorunda kalmayacağım kesindi..."


translate turkish day4_us_morning_71de8971:


    us "Böyle uyuyakaldığım için özür dilerim..."


translate turkish day4_us_morning_6d36c28b:


    me "Sorun değil."


translate turkish day4_us_morning_9b91052f:


    "Sanırım sözlerim çok samimiyetsiz geldi çünkü bana inançsızlıkla baktı."


translate turkish day4_us_morning_4322ee3d:


    us "Bir dakika...{w}. Bunca zamandır orada ne yapıyordun?"


translate turkish day4_us_morning_75f4b174:


    me "Bana inanmazsın."


translate turkish day4_us_morning_b515de5d:


    us "Bekle bir dakika...{w} Bu şu demek..."


translate turkish day4_us_morning_4f6d2aa7:


    "Ulyana kıkırdadı, benden uzaklaştı ve yüksek sesle bağırdı:"


translate turkish day4_us_morning_abd7e09d:


    us "Kahvaltı için ilk ben geldim!"


translate turkish day4_us_morning_74c13f1d:


    me "Bu kadar derin bir uykudan sonra büyük bir sürpriz değil..."


translate turkish day4_us_morning_72667b52:


    "Dedim ama Ulyana çok ileride olduğu için beni duyamadı bile."


translate turkish day4_us_morning_eaabbc69:


    "Kantinin etrafı alışılmadık derecede kalabalıktı."


translate turkish day4_us_morning_2260fedb:


    "Elbette kampta öncülerin kantin kadar sevdiği başka bir yer yoktu, ama neden hepsi verandada toplanmıştı...?"


translate turkish day4_us_morning_f5aef4ac:


    "Yaklaştım ve neler olduğunu anlamaya çalıştım."


translate turkish day4_main1_3fe8cd89:


    "Görünüşe göre tüm kamp verandada toplanmıştı: tanıdık kızlar, Olga Dmitrievna ve Electronik oradaydı."


translate turkish day4_main1_0c95f62a:


    "Hararetli bir tartışma yapıyorlardı."


translate turkish day4_main1_6785b764:


    "Yaklaştım."


translate turkish day4_main1_c74edda5:


    mt "Ah, Semyon!"


translate turkish day4_main1_af775fc1:


    mt "Nerelerdeydin sen? Bütün gece seni bekledim ve sabahtan beri arıyorum! Ulyana bana dün kütüphaneden birlikte çıktığınızı söyledi."


translate turkish day4_main1_9d5d157b:


    "Ulyana'ya baktım. Acımasızca sırıtıyordu...."


translate turkish day4_main1_51149e68:


    me "..."


translate turkish day4_main1_2f165ff9:


    mt "Bununla sonra ilgileniriz!"


translate turkish day4_main1_4c6e2dcd:


    mt "Bugün Shurik'i gördün mü?"


translate turkish day4_main1_3aabe659:


    me "Hayır, sorun nedir?"


translate turkish day4_main1_28e30b6d:


    mt "Sabahın erken saatlerinden beri onu bulamadık."


translate turkish day4_main1_70b53a62:


    th "Kaybolan öncüler. Bu yeni bir şey."


translate turkish day4_main1_547a39ce:


    mt "Ama dün seninle miydi?"


translate turkish day4_main1_1e640e7b:


    "Electronik'le konuşuyordu."


translate turkish day4_main1_8fb4fd1c:


    el "Evet, konuşuyordu."


translate turkish day4_main1_7c91c87b:


    mt "Yani bu sabah uyandığınızda onu hiçbir yerde bulamadınız mı?"


translate turkish day4_main1_62543f01:


    el "Hayır..."


translate turkish day4_main1_30b2a809:


    mt "Neden hemen bana gelmedin?"


translate turkish day4_main1_9f2b5808:


    el "Erken kalkıp yıkanmaya falan gittiğini düşündüm."


translate turkish day4_main1_a5b6d3cb:


    sl "Dün bir şeyden bahsetti mi?"


translate turkish day4_main1_f2c87db5:


    "Slavya araya girdi."


translate turkish day4_main1_c620bee1:


    el "Örneğin mi?"


translate turkish day4_main1_01cfc02e:


    sl "Mesela bir yere gittiğini mi?"


translate turkish day4_main1_62543f01_1:


    el "Hayır..."


translate turkish day4_main1_cd7d9ef9:


    me "Bunda bu kadar korkunç olan ne? Saat daha sabahın 9'u. Yürüyüşe çıkmaya karar vermiş olabilir."


translate turkish day4_main1_6059e846:


    sl "Shurik'i tanımıyorsun."


translate turkish day4_main1_453d16cb:


    "Bana ciddi ciddi baktı."


translate turkish day4_main1_66a4843a:


    me "Hayır, görmüyorum."


translate turkish day4_main1_66774de2:


    "Ama bu durumda şüpheli bir şey görmedim."


translate turkish day4_main1_fac4579f:


    mt "Tamam, panik yapmayı bırakalım. Onu bulacağız!"


translate turkish day4_main1_d68ecb78:


    us "Kahvaltıyı nasıl kaçırabilir?"


translate turkish day4_main1_56aa99aa:


    "Ulyana sırıttı."


translate turkish day4_main1_3fab6262:


    dv "Aynen öyle! Yine de yemek zamanı."


translate turkish day4_main1_a24b7420:


    "Öncüler kantine doğru ilerledi."


translate turkish day4_main1_7a51fac4:


    "Ama Olga Dmitrievna beni durdurdu."


translate turkish day4_main1_29b74cfc:


    mt "Ve sen, Semyon, lütfen burada kal."


translate turkish day4_main1_e79d0fd5:


    me "Öyle mi?"


translate turkish day4_main1_d124d112:


    mt "Bütün gece nerede olduğunu açıklamak ister misin?"


translate turkish day4_main1_f883183e:


    me "Şey..."


translate turkish day4_main1_597e6c44:


    "Bu hiç düşünmediğim bir şeydi."


translate turkish day4_main1_7a46a669:


    "Doğru, bu fark edilmeden geçip gitmiş olamaz. En azından net bir açıklama düşünebilirdim."


translate turkish day4_main1_538bd425:


    "Ama düşünemedim..."


translate turkish day4_main1_8f6d4306:


    me "Ben...{w}Ben ve Ulyana kitapları raflara yerleştiriyorduk. Ama sonra beni oraya kilitledi ve kaçtı! Sabaha kadar orada mahsur kaldım!"


translate turkish day4_main1_a1c3fbc7:


    mt "Bugün kütüphanedeydim! Ve seni orada görmedim."


translate turkish day4_main1_3f76b658:


    th "Bunun farkındayım."


translate turkish day4_main1_c0f84c22:


    me "Şey...{w} Sessizce ayrıldım."


translate turkish day4_main1_41bc7385:


    mt "Peki Ulyana neden bana tamamen farklı bir şey söylüyor?"


translate turkish day4_main1_2ff7837a:


    th "Hmm, bu ne olabilir?"


translate turkish day4_main1_2f2b2114:


    me "Hikayelerinin neye benzediğini biliyorsun!"


translate turkish day4_main1_d27d2beb:


    mt "Evet, haklı olabilirsin..."


translate turkish day4_main1_d4764288:


    "Kamp lideri bir an durakladı."


translate turkish day4_main1_fe53b407:


    mt "Bunun sana inandığım anlamına geldiğini düşünme!"


translate turkish day4_main1_f9dd954e:


    "Öyle düşünmedim."


translate turkish day4_main1_18c37203:


    mt "Tamam, bunu sonra hallederiz, unutmayacağım!{w} Şimdi Shurik'i bulmak daha önemli."


translate turkish day4_main1_9513cd87:


    me "Evet..."


translate turkish day4_main1_7d563950:


    mt "Kovuldum."


translate turkish day4_main1_af8e37ef:


    "Yine nereye uyum sağlayacağıma dair bir seçeneğim yoktu. Tek boş yer Alisa ve Ulyana'nın olduğu masaydı."


translate turkish day4_main1_ed08ccfd:


    us "Otursana."


translate turkish day4_main1_ebb45b6a:


    "Yanındaki sandalyeyi işaret etti."


translate turkish day4_main1_04d910fd:


    "Ben de oturdum."


translate turkish day4_main1_1a2c041d:


    "Alisa her zamanki gibi görünüyordu. Daha önce izlemeye geleceğime söz verdiğim gösteriyi kaçırdığım için kavga çıkaracak gibi görünmüyordu."


translate turkish day4_main1_36580956:


    th "O bu konuda konuşmak istemiyorsa ben neden konuşayım?"


translate turkish day4_main1_b7584acc:


    us "Yemeğini almayacak mısın?"


translate turkish day4_main1_97ba4a43:


    th "İyi fikir!{w} Bunu düşünmemiştim."


translate turkish day4_main1_e2f039bb:


    "Bugünkü kahvaltı dünkünden çok farklı görünmüyordu ama daha iştah açıcı görünüyordu."


translate turkish day4_main1_ca4c8a18:


    "Belki de sadece çok acıkmıştım."


translate turkish day4_main1_f0e3f8e3:


    "Ya da belki bir başka Ulyana şakasından kaçınmak için bir an önce bitirmeye hevesliydim."


translate turkish day4_main1_15c24207:


    us "Bugün bizimle sahile gelmek ister misin?"


translate turkish day4_main1_18dfa619:


    me "Ne zaman?"


translate turkish day4_main1_516609bc:


    us "Kahvaltıdan hemen sonra."


translate turkish day4_main1_40ae9715:


    "Genel olarak konuşursak, rahatlamak bugün gündemimde yoktu, ama zamanımı düşünerek geçireceksem, neden bunu bronzlaşırken yapmayayım?"


translate turkish day4_main1_c1286eed:


    me "Elbette, neden olmasın..."


translate turkish day4_main1_a64a24e7:


    us "Ah, harika!"


translate turkish day4_main1_b7bd4e35:


    "Güzelce gülümsedi."


translate turkish day4_main1_2cb6f965:


    me "Bahse girerim başka bir şaka planlıyorsundur?"


translate turkish day4_main1_e4b476c4:


    us "Hayır, hiç de değil!"


translate turkish day4_main1_dd0d143d:


    "Ulyana ellerini bana doğru salladı."


translate turkish day4_main1_6d3417f3:


    dv "Kesinlikle öyle!"


translate turkish day4_main1_08dcf315:


    "Alisa sırıttı."


translate turkish day4_main1_232ce05b:


    dv "O her zaman böyledir!"


translate turkish day4_main1_27304fd6:


    "Alisa'ya dikkatle baktım ve birden dün akşamı hatırladım."


translate turkish day4_main1_a2cb95d1:


    "Garip davranışlarını, tartışmamızı."


translate turkish day4_main1_35ddcb27:


    "Ama şimdi her zamanki gibi görünüyordu."


translate turkish day4_main1_c3ed033d:


    th "Belki de ona bir şey söylemeye gerek yoktur?"


translate turkish day4_main1_c2e8c7a9:


    "Gerçi söylemeyecektim."


translate turkish day4_main1_b56982ca:


    "Günün sonunda, o gece olan her şey sanki sadece bir rüyaymış gibi olağandışı görünmeyi bıraktı."


translate turkish day4_main1_6c304510:


    us "Yok artık!"


translate turkish day4_main1_1ca23a9b:


    me "Bence o haklı."


translate turkish day4_main1_53340723:


    us "Kimse bana inanmıyor!"


translate turkish day4_main1_d1036c99:


    "Ulyana kirli bulaşık tepsisini aldı ve ayağa kalktı."


translate turkish day4_main1_0a9f12c1:


    us "Afiyet olsun!"


translate turkish day4_main1_39b14315:


    "Hiç şüpheye yer bırakmayacak bir şekilde dedi ki - bugün beni plajda iyi bir şey beklemiyor."


translate turkish day4_main1_f86ec2e1:


    "Ben ve Alisa yalnız kaldık."


translate turkish day4_main1_37176700:


    me "Biliyor musun, sanırım seninle gelmemeliyim."


translate turkish day4_main1_2d5beca1:


    dv "Nedenmiş o?"


translate turkish day4_main1_8d93196b:


    me "Yapmam gereken bir şey var."


translate turkish day4_main1_844c800d:


    dv "Peki bu tam olarak ne olabilir?"


translate turkish day4_main1_d12f273c:


    "Gözlerimin içine baktı ve ben uygun bir bahane bile bulamadım."


translate turkish day4_main1_6517fda2:


    me "Mayom bile yok."


translate turkish day4_main1_da8226ff:


    dv "Benimkini dene."


translate turkish day4_main1_e10064b1:


    me "Sence bana uyar mı?"


translate turkish day4_main1_8d7ab4dd:


    dv "Bir dene bakalım!"


translate turkish day4_main1_1f304310:


    me "Çabalamaya değeceğini sanmıyorum."


translate turkish day4_main1_3479d749:


    dv "Pısırık olma!{w} Sana mayo bulacağız!"


translate turkish day4_main1_54a8822f:


    "Bu sözler korkumu daha da arttırdı."


translate turkish day4_main1_0547c124:


    dv "Beni kantinde bekle, birazdan dönerim."


translate turkish day4_main1_505d91ae:


    me "Tamam."


translate turkish day4_main1_850a4c6e:


    th "Onu beklemekte yanlış bir şey yok, değil mi?"


translate turkish day4_main1_6488a41b:


    "Kahvaltımı bitirip binadan çıktım ve merdivenlere oturdum."


translate turkish day4_main1_52db742c:


    "Hepsi kendi işinde gücünde olan öncüler birer birer yanımdan geçip gittiler."


translate turkish day4_main1_6db745af:


    "Kimse yanımda durmadı{w} kimse bana doğru bakmadı bile."


translate turkish day4_main1_3594b82e:


    "Görünüşe göre beni bir yabancı olarak değil, tam tersine kendi yaşlarında başka bir genç, yoldaşları olarak görüyorlardı."


translate turkish day4_main1_15995c83:


    "Kendimi bu kampa ve sakinlerine ilk günkü kadar dikkatli bakmamaya başladığımı düşünürken yakaladım."


translate turkish day4_main1_750c0871:


    "Gerçekten de Alisa birkaç dakika içinde dönmüştü."


translate turkish day4_main1_1d6a18c3:


    dv "Hazır mısın?"


translate turkish day4_main1_eaccb1bc:


    me "Ne için hazır?"


translate turkish day4_main1_82448915:


    "Bana şortları verdi...{w} Gerçi onlara şort denemezdi..."


translate turkish day4_main1_d7b10247:


    "Kelebekler ve çiçeklerle süslenmiş pembe boxer'lara benziyorlardı. Aslında boxer'dılar."


translate turkish day4_main1_956c7f92:


    me "Sormaya korkuyorum ama bunları nereden aldın?"


translate turkish day4_main1_6993170f:


    dv "Giymeye korkuyor musun?"


translate turkish day4_main1_009490c9:


    me "Şey, biliyorsunuz...{w} öyle bir niyetim yok."


translate turkish day4_main1_398d5637:


    "Şakasını takdir ettim ama kendimi gülünç duruma düşürmek istemedim."


translate turkish day4_main1_f3133a95:


    dv "Giy şunları!"


translate turkish day4_main1_8736d85c:


    "Kabaca söyledi."


translate turkish day4_main1_57346f05:


    me "Neden benim yerime sen denemiyorsun? Bence bu mayonun rengi gözlerini çok güzel ortaya çıkarır!"


translate turkish day4_main1_37b30d8c:


    dv "Hadi bahse girelim!"


translate turkish day4_main1_6a537964:


    "Onun bahsini kabul etmeye hiç niyetim yoktu."


translate turkish day4_main1_1498c76e:


    me "Hayır, teşekkürler."


translate turkish day4_main1_b5ac4c3c:


    dv "Pekala, ya plaja bunları giyerek gidersiniz ya da çıplak yüzersiniz!"


translate turkish day4_main1_a6fdaa06:


    th "Artıları ve eksileri tarttığımızda, ikinci seçenek bile ilkinden daha iyi görünüyor."


translate turkish day4_main1_1b8d0016:


    me "Hiçbir yere gitmeyi planlamıyorum!"


translate turkish day4_main1_b43b3d6a:


    dv "O zaman herkese bu sandıkları kamaramda bıraktığını söylerim!"


translate turkish day4_main1_66ba2af9:


    me "Bunu neden yapayım ki?"


translate turkish day4_main1_37160fae:


    dv "Nereden bilebilirim ki?"


translate turkish day4_main1_42be2b6f:


    "Kahkahalara boğuldu."


translate turkish day4_main1_9efe078e:


    "Alisa ile tartışmak istemedim ve sonunda plaja gitmeye karar verdim."


translate turkish day4_main1_14c26ca5:


    "Ama o gösterişli mayolarla değil."


translate turkish day4_main1_74372f49:


    me "Tamam. On dakika içinde orada olacağım."


translate turkish day4_main1_ea4299c9:


    dv "Sakın geç kalma!"


translate turkish day4_main1_3dfe79f9:


    "Bunu söyledikten sonra kaçtı."


translate turkish day4_main1_77b838f6:


    "Bir havlu almak ve umarım bavul gibi bir şey bulmak için ayaklarımı sürükleyerek liderin kamarasına gittim."


translate turkish day4_main1_cdc7b7a7:


    "Olga Dmitrievna odada beni bekliyordu."


translate turkish day4_main1_044559b3:


    mt "Semyon, Shurik hakkında bir şey duydun mu?"


translate turkish day4_main1_d45464b9:


    me "Yarım saat önceki gibi..."


translate turkish day4_main1_edefb213:


    "Yatağıma doğru yürüdüm ve bir havlu aldım."


translate turkish day4_main1_d024b380:


    mt "Bir yere mi gidiyorsun?"


translate turkish day4_main1_cb685aa8:


    me "Evet, sahile."


translate turkish day4_main1_850934a0:


    mt "Bekle. Mayonuz var mı?{w} Hatırladığım kadarıyla buraya bavulsuz gelmiştiniz..."


translate turkish day4_main1_82f7a16c:


    "Garip, ilk karşılaşmamızda bu gerçek onu şaşırtmamıştı."


translate turkish day4_main1_5cb822ee:


    me "Hayır..."


translate turkish day4_main1_f01befe8:


    mt "Peki ne giyeceksin?"


translate turkish day4_main1_9da88e5d:


    th "Güzel soru. Ne?"


translate turkish day4_main1_7479b07e:


    me "Bilmiyorum."


translate turkish day4_main1_22a42eb2:


    mt "Bekle bir dakika."


translate turkish day4_main1_81a73d46:


    "Gardıroba doğru yürüdü ve bir çekmecenin kilidini açtı."


translate turkish day4_main1_b666fe0c:


    "Bir anda bir çift normal siyah şortu oldu."


translate turkish day4_main1_21d21de6:


    th "Bunları nereden bulmuştu? Daha da önemlisi, neden?"


translate turkish day4_main1_e922975f:


    "Bir önceki seanstan biri onları unutmuş olabilir..."


translate turkish day4_main1_b2cd5380:


    "Bu kamptaki tüm tuhaf şeyler düşünüldüğünde, Olga Dmitrievna'nın odasında erkek mayosu bulmak pek de şaşırtıcı değildi."


translate turkish day4_main1_3066598f:


    me "Teşekkür ederim."


translate turkish day4_main1_86258ed4:


    "Şortlar tam bana göreydi...."


translate turkish day4_main1_a20cefa7:


    "..."


translate turkish day4_main1_742830e4:


    "Kulübenin arkasında üstümü değiştirdim ve sahile gittim."


translate turkish day4_main1_cf92b9ce:


    "Birçok öncü orada toplanmıştı ama ben sadece Alisa ve Ulyana'yı tanıdım."


translate turkish day4_main1_170351a5:


    us "Buraya gelin!"


translate turkish day4_main1_a0ef15ef:


    "Onlara doğru yürüdüm ve kumun üzerine oturdum."


translate turkish day4_main1_27f5a44d:


    dv "Görüyorum ki daha iyi bir şey bulmuşsun..."


translate turkish day4_main1_99336af1:


    "Şortlarıma baktı ve sırıttı."


translate turkish day4_main1_5e648c4f:


    me "Gördüğünüz gibi...."


translate turkish day4_main1_0eed83b2:


    us "Hadi, yüzelim!"


translate turkish day4_main1_d1aa6677:


    me "İstemiyorum{w} belki sonra..."


translate turkish day4_main1_d3a86de3:


    "Yüzmeyi pek sevmezdim."


translate turkish day4_main1_ba1e125e:


    dv "Keyfine bak."


translate turkish day4_main1_a6eddd01:


    "Kızlar suya koştu."


translate turkish day4_main1_521b9f2c:


    th "Neden buraya geldim? Neden cevaplar aramak için dışarıda değilim...?"


translate turkish day4_main1_a50d7f70:


    th "Şimdi umursamalı mıyım?"


translate turkish day4_main1_a482e6e3:


    "Sovyonok normal görünüyordu."


translate turkish day4_main1_b9b33704:


    "Elbette bu üç buçuk gün boyunca başıma pek çok tuhaf şey geldi ama hiçbiri ayrı ayrı ele alındığında doğaüstü görünmüyordu{w} özellikle de en ufak bir ipucu bile bulmaya yaklaşamadığım için."


translate turkish day4_main1_cc830959:


    "Aksine, olan her şey kafamı daha da karıştırdı."


translate turkish day4_main1_4795bad4:


    th "Ne gibi alternatiflerim var?"


translate turkish day4_main1_662e06d0:


    th "Yerel halktan hiçbir doğruluk payı alamayacağım{w} Gerçi bunu bildiklerinden bile şüpheliyim..."


translate turkish day4_main1_4ed7892c:


    th "Buradan gitmeye çalışmalı mıyım?"


translate turkish day4_main1_8000702a:


    th "Ama nerede olduğumu bile bilmediğimi düşünürsek ne kadar yürüyebilirim?"


translate turkish day4_main1_e75df2a1:


    th "Tek seçeneğimin beklemek olduğu ortaya çıktı."


translate turkish day4_main1_4f43f435:


    "Bir süre sonra kızlar geri geldi. Ulyana elinde bir şey tutuyordu."


translate turkish day4_main1_30f4be0c:


    us "Bak!"


translate turkish day4_main1_06938095:


    "Kafamı kaldırdım ve bir kerevit gördüm{w} normal bir kerevit."


translate turkish day4_main1_456ae98b:


    "Ulyana yanıma uzandı ve ona eziyet etmeye başladı."


translate turkish day4_main1_dd41af79:


    me "Zavallı hayvanı rahat bırak!"


translate turkish day4_main1_3b3d6cb9:


    us "Neden!{w} O sadece bir kerevit!"


translate turkish day4_main1_c9e60657:


    me "Ne olmuş yani? Onun da yaşamaya hakkı var!"


translate turkish day4_main1_ea38a367:


    us "Pençelerini koparıp aşçıdan akşam yemeği için haşlamasını isteyeceğim!"


translate turkish day4_main1_68e2c448:


    me "Sanki yiyecek başka bir şeyimiz yokmuş gibi..."


translate turkish day4_main1_4a330faf:


    "Alisa'ya baktım{w} Ulyana'nın zavallı deniz yaratığıyla eğlencesine hiç ilgi duymuyor gibiydi."


translate turkish day4_main1_411121e6:


    me "Söyle ona!"


translate turkish day4_main1_86658590:


    dv "Sorun ne?{w} O bir kerevit, bunu hak ediyor!"


translate turkish day4_main1_6a626905:


    "Görünüşe göre kızlar ilkokuldaki doğa derslerini kaçırmışlar ve çevreye karşı empatiden yoksunlar..."


translate turkish day4_main1_679b46e1:


    me "Ver şunu!"


translate turkish day4_main1_4ec958c5:


    "Kereviti Ulyana'nın elinden kaptım."


translate turkish day4_main1_4949cf90:


    us "Keyfin bilir."


translate turkish day4_main1_80d64677:


    "Direnmemesine biraz şaşırdım."


translate turkish day4_main1_56d514c5:


    "Zavallı hayvanın gözlerinin içine baktım."


translate turkish day4_main1_c21fcd5d:


    "Hiçbir şey ifade etmiyorlardı ama konuşabilseydi kesinlikle öfkelenirdi, belki de BM insan hakları sözleşmesine bile giderdi diye düşündüm."


translate turkish day4_main1_70c26240:


    "Doğruyu söylemek gerekirse bunun işe yarayacağından emin değildim..."


translate turkish day4_main1_4595a707:


    "Kereviti nehre götürdüm ve serbest bıraktım."


translate turkish day4_main1_53896b88:


    us "Boş ver, daha çok yakalarım. Burada onlardan çok var."


translate turkish day4_main1_45927c46:


    "Dedi Ulyana."


translate turkish day4_main1_972f86d7:


    me "Buna hiç şüphe yok..."


translate turkish day4_main1_ca01a7fa:


    "Mırıldandım."


translate turkish day4_main1_b18fe1e2:


    "Zaman geçti ve uykum gelmeye başladı."


translate turkish day4_main1_357544c9:


    "Uykuya daldım."


translate turkish day4_main1_0c650a7c:


    "Rüyamda ne gördüğümü, rüya görüp görmediğimi bile hatırlamıyorum ama biri omzumu sarsınca uyandım."


translate turkish day4_main1_3c1fbed3:


    "Olga Dmitrievna yanımda duruyordu."


translate turkish day4_main1_517d89d0:


    me "Sen de mi yüzmeye geldin?"


translate turkish day4_main1_fd959960:


    "Hala yarı uykulu bir şekilde sordum."


translate turkish day4_main1_da0111bc:


    mt "Hayır{w} neredeyse öğle yemeği vakti geldi ve biz hala Shurik'i bulamadık."


translate turkish day4_main1_82a4bab8:


    "Lider, ıslak bir mayoyla karşımda durarak söyledi."


translate turkish day4_main1_f95c9fc9:


    me "Ve?"


translate turkish day4_main1_1df88814:


    mt "Onu aramanı istiyorum."


translate turkish day4_main1_7cc521ca:


    me "Tüm bu kamptaki tek öncü benmişim gibi görünüyor."


translate turkish day4_main1_5581e203:


    "İçtenlikle öfkelendim."


translate turkish day4_main1_ccbda48f:


    "Olga Dmitriyevna'nın beni bir köle gibi kullanacağı ayakçısı olarak gördüğü her seferinde daha da netleşiyordu{w} ya da tam tersi..."


translate turkish day4_main1_89e79303:


    mt "Madem sana geldim, o zaman bana yardım etmeni istiyorum."


translate turkish day4_main1_5aa2346a:


    "Neden tam olarak ben?"


translate turkish day4_main1_aad225f0:


    "Ancak biraz düşündükten sonra kabul etmeye karar verdim."


translate turkish day4_main1_2186b207:


    "Ne de olsa uyurken omuzlarım ve sırtım güneşten yanmıştı ve Shurik'i aramak kampın keşfedilmemiş yerlerini tanımamı sağlayacaktı."


translate turkish day4_main1_505d91ae_1:


    me "Tamam..."


translate turkish day4_main1_b55d2be6:


    "Sadece mayoyla dolaşmak pek doğru değildi, o yüzden önce üzerimi değiştirmeliydim...."


translate turkish day4_main1_a20cefa7_1:


    "..."


translate turkish day4_main1_97b8a867:


    "On dakika sonra Olga Dmitrievna'nın kulübesinin önünde durmuş nereye gideceğime karar veriyordum."


translate turkish day4_busstop_84a6a4dc:


    "Otobüs durağı iyi bir seçim gibi görünüyordu."


translate turkish day4_busstop_310157f5:


    "Aklıma garip bir düşünce geldi - belki Shurik de benimle aynı durumdaydı ve bu yüzden belki de 410 numaralı otobüsle bu kamptan kaçmaya karar verdi."


translate turkish day4_busstop_ae9e2dee:


    "Eğer o da buraya kazara geldiyse, bu gerçekten doğru olabilir."


translate turkish day4_busstop_2832326d:


    "Gerçi bunun ihtimali oldukça düşük."


translate turkish day4_busstop_6d68af7d:


    th "Ama asla bilemezsiniz!"


translate turkish day4_busstop_5a9376e0:


    th "Ya otobüs gerçekten gelirse..."


translate turkish day4_busstop_794a9280:


    "Ancak buna pek inanamıyordum."


translate turkish day4_busstop_d2b67202:


    "Gerçekten de otobüs durağında birkaç dakika bekledim, Shurik'ten ya da burada başka birinden iz olmadığından emin oldum ve kampa geri döndüm."


translate turkish day4_busstop_3f3e9168:


    "Kapıların arkasından biri fırladı ve bana çarptı{w} darbe güçlü değildi, bu yüzden sadece sendeledim."


translate turkish day4_busstop_548da2a4:


    "Miku önümde durdu ve morarmış alnını ovuşturdu."


translate turkish day4_busstop_37374d4c:


    me "Oh, özür dilerim..."


translate turkish day4_busstop_7459a96f:


    mi "Sorun değil! Benim hatam! Müzik kulübüne gidiyordum ama yeni bir şarkı hakkında düşüncelere dalmışım. Sözleri ve müziği düşünüyordum. Buraya nasıl geldiğimi fark etmemiştim."


translate turkish day4_busstop_a9298d73:


    mi "Yani özür dilemene gerek yok!"


translate turkish day4_busstop_03f805f3:


    "Dakikadaki kelime sayısı belli ki beynimin tanıma sınırlarını aşıyordu."


translate turkish day4_busstop_513cdea5:


    "Hemen geri çekilmeye çalıştım."


translate turkish day4_busstop_e170ad8d:


    me "Tabii, tabii. Gitmem gerek. Bilirsin işte..."


translate turkish day4_busstop_206044ed:


    mi "Oh, bekle!"


translate turkish day4_busstop_6eecb271:


    "Her zamanki gibi onu dinlemek zorunda kalmadan gitmek istedim ama Miku elimi tuttu."


translate turkish day4_busstop_71a0a5fc:


    "Başka bir rap seansı tarafından acı verici bir infazın net bir görüntüsüne sahip olduğum için kavrayışı beni ürpertti."


translate turkish day4_busstop_14425216:


    mi "Bana biraz yardım edebilir misin, lütfen? Sadece birazcık?"


translate turkish day4_busstop_80eb41cf:


    "Bugün yapılacaklar listemde kesinlikle bu yoktu."


translate turkish day4_busstop_d90e19df:


    me "Seve seve yapardım ama..."


translate turkish day4_busstop_ffd83896:


    mi "Lütfen!"


translate turkish day4_busstop_74c53f6a:


    "Miku bana öyle yavru köpek gözleriyle baktı ki kalbim erimeye başladı."


translate turkish day4_busstop_075057b4:


    "Elimi kesinlikle bırakmayacaktı."


translate turkish day4_busstop_d6c51513:


    me "Tam olarak ne yardımına ihtiyacın var?"


translate turkish day4_busstop_855dcd0b:


    mi "Bana eşlik edeceksin! Tek başıma beste yapmayı beceremiyorum! Şarkı söyleyebilirim. Ya da çalabilirim. İkisini aynı anda yapamam."


translate turkish day4_busstop_4c33c840:


    th "Virtüözümüzün bile zayıf yönleri var."


translate turkish day4_busstop_4942eb5b:


    me "Şey, biliyorsun, gerçekten hiçbir enstrüman çalamıyorum..."


translate turkish day4_busstop_9f6720fa:


    mi "Boş ver onu! Sana her şeyi göstereceğim! Hadi, gidelim!"


translate turkish day4_busstop_4ccac507:


    th "Öte yandan, hiçbir şey kaybetmiyorum."


translate turkish day4_busstop_e7714637:


    "Ancak."


translate turkish day4_busstop_e2956e63:


    me "Biliyorsun, Shurik'i ve diğer şeyleri arıyor olmalıydım..."


translate turkish day4_busstop_48f85b22:


    "Miku bana hayal kırıklığıyla baktı."


translate turkish day4_busstop_2554171f:


    mi "Sadece birazcık!"


translate turkish day4_busstop_0d2840a0:


    "Söyleyecek söz bulamıyordum."


translate turkish day4_busstop_be6c9d1e:


    "Beni de kendisiyle birlikte sürükledi."


translate turkish day4_busstop_59712563:


    th "Muhtemelen bundan iyi bir şey çıkmayacak, ama onu üzerimden atmanın tek yolu elimi onun elinden çekip almak."


translate turkish day4_busstop_0dd57599:


    "Ama bu pek hoş olmaz."


translate turkish day4_busstop_161f1f1a:


    th "Ne de olsa kötü bir şey olmayacak!{w} Muhtemelen..."


translate turkish day4_busstop_82406965:


    "Bir dakika içinde müzik kulübündeydik."


translate turkish day4_busstop_c75b785f:


    "Miku bir gitar aldı."


translate turkish day4_busstop_d8313998:


    mi "İşte, bir bak!"


translate turkish day4_busstop_ddd216e1:


    "Oturdu ve çalmaya başladı."


translate turkish day4_busstop_62735169:


    "Ellerini takip etmeye çalıştım. Melodi oldukça basit görünüyordu."


translate turkish day4_busstop_074f6095:


    "Tekrarlamak oldukça kolay görünüyordu."


translate turkish day4_busstop_d28a7a64:


    mi "Anladın mı?"


translate turkish day4_busstop_b4dbe06d:


    me "Sayılır."


translate turkish day4_busstop_39da62e2:


    mi "Hadi deneyelim."


translate turkish day4_busstop_4bfbb8ba:


    "Gitarı aldım ve çalmaya başladım."


translate turkish day4_busstop_b59ab969:


    "Bu pek işe yaramadı."


translate turkish day4_busstop_3865d2b8:


    mi "Sana bir kez daha göstereyim."


translate turkish day4_busstop_045ce299:


    "Benden çok daha iyi oynadı."


translate turkish day4_busstop_4db3b5a0:


    "Miku'ya bakınca merak ettim."


translate turkish day4_busstop_ac84947f:


    th "Elbette gevezeydi, naif ve sakardı...{w} Ancak müzik konusunda son derece yetenekliydi."


translate turkish day4_busstop_1e78833e:


    mi "Tekrar dene."


translate turkish day4_busstop_dfcc8234:


    "İkinci seferde çok daha iyiydim."


translate turkish day4_busstop_763aacd2:


    mi "Vay canına, bu çok daha iyi!"


translate turkish day4_busstop_d1046a49:


    "Gülümsedi."


translate turkish day4_busstop_a0871d04:


    "Aslında zor değildi - sadece aynı notaları defalarca tekrarlayın."


translate turkish day4_busstop_621a4f25:


    th "Sadece izini kaybetme!"


translate turkish day4_busstop_20b61502:


    mi "Emrimle başla!"


translate turkish day4_busstop_35ec24e9:


    me "Tamam."


translate turkish day4_busstop_697d9fca:


    mi "Hazır mısın? Başla!"


translate turkish day4_busstop_52370984:


    "Japonca bir şarkıydı."


translate turkish day4_busstop_f1a32904:


    "Açıkçası tek bir kelime bile anlamadım ama Miku'nun şarkısı oldukça iyiydi{w} hatta olağanüstüydü!"


translate turkish day4_busstop_0f7f3a55:


    "Her notaya, her kelimeye kalbini koydu."


translate turkish day4_busstop_b6da10b3:


    th "Evet, müzik muhtemelen onun hayatını adadığı şeydi."


translate turkish day4_busstop_f7383791:


    "Sanki müziği seçen o değil de, müzik onu seçmiş gibi görünüyordu..."


translate turkish day4_busstop_c487d162:


    "Son yarım saat Miku'ya bambaşka bir ışık sundu...."


translate turkish day4_busstop_a20cefa7:


    "..."


translate turkish day4_busstop_128ef1ec:


    mi "Oh, teşekkür ederim! Beğendin mi? Sonunda seninle başardım, tek başıma o kadar iyi değil. Ya kelimeleri karıştırıyorum ya da telleri kaçırıyorum. Ve seninle her şey mükemmel! Çok teşekkür ederim."


translate turkish day4_busstop_327d8e83:


    mi "Gerçekten yeteneklisin, biliyor musun!{w} Hiç hazırlık yapmadan böyle oynamak..."


translate turkish day4_busstop_5dbd8783:


    th "Hayır, görünüşe göre onun hakkındaki fikrimi çok aceleci değiştirmişim."


translate turkish day4_busstop_5b2f2663:


    me "Şarkı için teşekkürler!{w} Gitmeliyim, görüşürüz!"


translate turkish day4_busstop_df33f13a:


    mi "Teşekkürler..."


translate turkish day4_busstop_f1561010:


    "Sözlerinin geri kalanı kapının arkasında kaldı."


translate turkish day4_busstop_a9ebca9c:


    "Kulübenin duvarına yaslandım ve iç çektim."


translate turkish day4_busstop_ab0c1c58:


    "Miku'nun şarkısı hâlâ zihnimde çalıyordu."


translate turkish day4_forest_cfbff117:


    "Belli ki Olga Dmitrievna ve öncüleri kampın her köşesini didik didik aramışlardı."


translate turkish day4_forest_5cc420a6:


    "Enine boyuna dolaşmışlardı."


translate turkish day4_forest_305ab809:


    "Muhtemelen Shurik'i kantinde ya da plajda aramaya değmez."


translate turkish day4_forest_bbfd297a:


    "Ya da sibernetik kulübünde! Burası onun ikinci eviydi{w} hatta belki de ilk eviydi."


translate turkish day4_forest_b2a1e220:


    "Bu yüzden çevredeki ormana bakmaya değer olabilir."


translate turkish day4_forest_50fb2210:


    "Ormanın içine fazla girmeyi planlamamıştım. Aksi takdirde yarın arayacakları kişi ben olabilirdim."


translate turkish day4_forest_919b405e:


    "Kırsal kesimi pek sık ziyaret etmedim."


translate turkish day4_forest_a12c2f29:


    "Sadece çocukluğumda her yaz bir kır evinde kalırdım{w} ama o da şehre çok yakındı."


translate turkish day4_forest_a605f85e:


    "Ama bu kampta uzun zamandır görmediğim her şeyi bulmak mümkündü: bunaltıcı bitki örtüsü, öten kuşlar ve temiz hava."


translate turkish day4_forest_a278fb75:


    "Bir çayır buldum ve bir kütüğün üzerine oturdum."


translate turkish day4_forest_6853b13e:


    th "Burası ne kadar huzurlu..."


translate turkish day4_forest_0617ce76:


    th "Ama Shurik nerede?"


translate turkish day4_forest_b4222e21:


    "Aslında, isteği dışında götürülmüş olabilir."


translate turkish day4_forest_ef624150:


    "Bu kamp normal olmaktan çok uzak, bu yüzden öncülerin ortadan kaybolması o kadar da garip olmamalı."


translate turkish day4_forest_d487dd90:


    th "İlgi çekici bir olasılık - beni buraya gönderen gücün işi olabilir mi, yoksa bu sadece ayrı bir yerel varlığın işi mi?"


translate turkish day4_forest_25b671a8:


    "Kendi düşüncelerimin içinde kaybolmuşken, önümdeki çimlerin nasıl hareket etmeye başladığını fark etmedim."


translate turkish day4_forest_4e2bb113:


    "Yakından baktım ve bir sincap gördüm."


translate turkish day4_forest_fd1017fc:


    "Bana dikkatlice yaklaştı ve ellerime baktı."


translate turkish day4_forest_aa2cbac9:


    "Muhtemelen burada beslenmeye alışık."


translate turkish day4_forest_871d8c7f:


    me "Kusura bakma dostum, yanımda hiçbir şey yok..."


translate turkish day4_forest_94efe0a6:


    "Tabii ki sincap beni anlayamadı ve orada öylece oturup ikram beklemeye devam etti."


translate turkish day4_forest_5fbbd1e5:


    "Onun için üzüldüm çünkü cebimde bir ekmek kırıntısı bile yoktu."


translate turkish day4_forest_3b611457:


    "Gözlerinin içine bakmaya bile utandığımı fark ettim ve yoluma devam etmeye karar verdim...."


translate turkish day4_forest_a20cefa7:


    "..."


translate turkish day4_forest_97cf4b53:


    "Biraz daha dolaştıktan sonra yıkama standına geldim."


translate turkish day4_forest_8563a8ed:


    th "Ormanda da olmadığı ortaya çıktı{w} En azından çevrede değil."


translate turkish day4_forest_977ea43c:


    "Ve daha uzağa gitmek sadece korkutucu."


translate turkish day4_forest_150dfa24:


    "Yıkama standlarına doğru yürüdüm, gömleğimi çıkardım ve kendimi silmeye çalıştım, çünkü terlemiştim."


translate turkish day4_forest_cf3e2df3:


    "Ancak bu o kadar kolay değildi."


translate turkish day4_forest_0fd38ed9:


    th "Yıkama kabına giremeyecektim ve bir kepçe bile yoktu..."


translate turkish day4_forest_9ff095ed:


    "Birden arkamdan ayak sesleri duydum{w} arkamı döndüm."


translate turkish day4_forest_fd05bbb8:


    "Electronik bana doğru yürüyordu."


translate turkish day4_forest_051049d1:


    el "Shurik'i mi arıyorsun?"


translate turkish day4_forest_16055c7f:


    me "Evet...{w} Sen de mi?"


translate turkish day4_forest_d1214932:


    el "Ben de..."


translate turkish day4_forest_959d6609:


    me "Dinle, sen onu daha iyi tanıyorsun, nereye gitmiş olabilir?"


translate turkish day4_forest_1cbcc91e:


    el "Hiçbir fikrim yok."


translate turkish day4_forest_2e34b08a:


    "Üzgün bir şekilde cevap verdi."


translate turkish day4_forest_d074bc24:


    me "Şey...{w} Neden herkesin bu kadar yaygara kopardığını anlamıyorum. Gece boyunca seninle birlikte kulübede değil miydi? O zaman çok uzun süre gitmiş olamaz...{w} Belki yürüyüşe çıkmıştır?"


translate turkish day4_forest_5def083f:


    el "Bilmiyorsun Shurik!"


translate turkish day4_forest_668b3318:


    "Dedi Electronik heyecanla."


translate turkish day4_forest_b25357aa:


    el "Kendini fanatik bir şekilde işine adamış biri{w} hayatı robotik ve sibernetikten ibaret. Onun gibi insanlar milyonda bir bulunur! Hayır, milyarda bir! Onun yetenekleri sınırsız! Ona saygı duyuyorum! O çelik gibi bir adam!"


translate turkish day4_forest_503848df:


    el "Hayır, sadece muzaffer!"


translate turkish day4_forest_6b3cf294:


    "O anda binlerce kişilik bir kalabalığın önünde konuşma yapan Hitler'e benziyordu."


translate turkish day4_forest_fe5e3be9:


    "Jestleri bile uyuşuyordu."


translate turkish day4_forest_ccf562b1:


    me "Tamam...{w} Ne olmuş yani?"


translate turkish day4_forest_b4f43170:


    el "Ne olmuş? Anlamıyorsun, değil mi?"


translate turkish day4_forest_5cb822ee:


    me "Hayır."


translate turkish day4_forest_37697e5c:


    el "Hepsini harcıyor, anlıyor musun? Tüm boş zamanlarını kulübümüzde geçiriyor! HEPSI!"


translate turkish day4_forest_2c080d1a:


    me "Yani bu şekilde ortadan kaybolmak onun için alışılmadık bir şey mi?"


translate turkish day4_forest_acffd441:


    el "Elbette!"


translate turkish day4_forest_2ce86487:


    "Electronik sakinleşmiş gibi görünüyor."


translate turkish day4_forest_505d91ae:


    me "Tamam."


translate turkish day4_forest_2c5335a6:


    "Bana dikkatle baktı."


translate turkish day4_forest_3aee18b1:


    el "Yıkanacak mısın?"


translate turkish day4_forest_b37f1cb4:


    me "Pek sayılmaz...{w} Sadece biraz durulayacağım. Çok sıcak."


translate turkish day4_forest_4fa820b9:


    el "Ben de."


translate turkish day4_forest_2771ee33:


    "Etrafına bakındı."


translate turkish day4_forest_459c94ac:


    el "Keşke bir kova ya da kepçe olsaydı. Daha fazla su almak için bir şey."


translate turkish day4_forest_1403f59c:


    "Evet, fark ettim bile."


translate turkish day4_forest_01eb5767:


    el "O zaman şöyle yapalım."


translate turkish day4_forest_fe274fdb:


    "Lavaboların arkasına doğru yürüdü ve musluklardan birini çekti."


translate turkish day4_forest_6341f283:


    "Şaşkınlıkla musluğun ucu yukarı döndü ve su lavaboya dökülmek yerine neredeyse 90 derecelik bir açıyla yukarı sıçradı."


translate turkish day4_forest_5dcfd900:


    "Bu şekilde yıkanmayı başarabilirdiniz."


translate turkish day4_forest_0d1796ca:


    "Bu sırada Electronik tişörtünü çıkardı ve çömeldi, bu yüzden şortunu indirmiş gibi görünüyordu."


translate turkish day4_forest_746f00c8:


    "Tam olarak anlayamadım çünkü arkasında durduğu yıkama standı onu beline kadar gizliyordu."


translate turkish day4_forest_f589c698:


    "Akıntıyı kendine doğru yönlendirdi ve sessizce bir şeyler söylemeye başladı."


translate turkish day4_forest_aabf34aa:


    el "Hadi bacamı temizleyelim, baca süpürelim..."


translate turkish day4_forest_76b7903e:


    "Şaşkınlıktan ne yapacağımı bilemedim."


translate turkish day4_forest_a7e62300:


    "Fark etmiş gibiydi."


translate turkish day4_forest_b0d91aa4:


    el "Kendimi yıkayacağım ve sonra kullanmana izin vereceğim."


translate turkish day4_forest_01fbaabb:


    "Tanrım, çok üşüdüm!"


translate turkish day4_forest_4c762e8b:


    me "Şey, bilirsiniz...{w} Yapmam gereken bir şey olduğunu hatırladım! Gitmem gerek!"


translate turkish day4_forest_c6ce9432:


    "Electronik'in tüm tuhaflıkları arasında, az önce gördüğüm an en tuhaf olanıydı."


translate turkish day4_forest_b530b3f7:


    el "Hey! Neyin var senin?{w} Böyle sıcak bir günde soğuk bir duş şimdiye kadarki en iyi şeydir!"


translate turkish day4_forest_9308b010:


    me "Hayır-hayır-hayır!{w} Bu olmaz!{w} Ve her neyse, gitmeliyim"


translate turkish day4_forest_b9ecea82:


    "Hemen gömleğimi giydim ve ormana geri koştum."


translate turkish day4_forest_eedd04d7:


    th "Ona ne olduğunu merak ediyorum."


translate turkish day4_house_of_mt_ed200de8:


    th "Ama yine de aptalca bir fikir."


translate turkish day4_house_of_mt_3cdc1097:


    "Shurik kampın herhangi bir yerinde saklanıyor olsaydı şimdiye kadar bulunurdu (tabii bulunmak istediğini varsayarsak)."


translate turkish day4_house_of_mt_90c7afe2:


    th "Bu yüzden onlara yardım edebileceğimi pek sanmıyorum."


translate turkish day4_house_of_mt_afd17b4a:


    "Bu düşünceyle birlikte kulübeye girdim ve kendimi yatağa uzattım."


translate turkish day4_house_of_mt_f20ad58c:


    th "Olga Dmitrievna beni burada bulursa iyi bir şey olmayacak."


translate turkish day4_house_of_mt_d712f4f6:


    th "Dur... yeter! Ben sadece titreyen bir yaratık mıyım, yoksa haklarım var mı?"


translate turkish day4_house_of_mt_befe5d34:


    "Zaten hiçbir şey yapmak istemiyordum."


translate turkish day4_house_of_mt_2300b407:


    "Gün öncekiler kadar sıcaktı ve yapılacak tek şey yatakta kalıp öğle yemeğini beklemekti."


translate turkish day4_house_of_mt_43e095ca:


    "Tam uykuya dalıyordum ki biri kapıyı çaldı."


translate turkish day4_house_of_mt_48555f41:


    me "İçeri gel."


translate turkish day4_house_of_mt_482a0501:


    "Slavya kapının eşiğinde durdu."


translate turkish day4_house_of_mt_df14250c:


    sl "Olga Dmitrievna burada değil, değil mi?"


translate turkish day4_house_of_mt_5a7a7577:


    me "Hayır."


translate turkish day4_house_of_mt_63863ec8:


    sl "Peki sen ne yapıyorsun?"


translate turkish day4_house_of_mt_1c3f46c0:


    "Şüpheyle sordu."


translate turkish day4_house_of_mt_a57d59c9:


    "Kendime baktım, yatağa uzandım ve şöyle dedim:"


translate turkish day4_house_of_mt_15d05c86:


    me "Uzanmak..."


translate turkish day4_house_of_mt_f8b93764:


    sl "Ama Olga Dmitrievna'nın senden Shurik'i bulmanı istediğini duydum."


translate turkish day4_house_of_mt_ff471f9a:


    me "Şey, evet."


translate turkish day4_house_of_mt_e26abf96:


    sl "Ve?"


translate turkish day4_house_of_mt_6715e0fb:


    me "Ne anlamı var ki? Eminim çoktan bütün kampın altını üstüne getirmiştir."


translate turkish day4_house_of_mt_e06cc00e:


    me "Fazla zaman geçmedi.{w} Neden panik yapalım ki?"


translate turkish day4_house_of_mt_04fc551f:


    sl "Biliyorsun, bir şeyler olabilir..."


translate turkish day4_house_of_mt_edee7f76:


    "Slavya düşünceli bir şekilde bana baktı."


translate turkish day4_house_of_mt_b68d7b34:


    sl "Ayağa kalk."


translate turkish day4_house_of_mt_34c3a4c4:


    me "Kalkmak zorunda mıyım?"


translate turkish day4_house_of_mt_2551395c:


    "O kadar yıpranmıştım ki bir yere gitme düşüncesi bile beni korkutuyordu."


translate turkish day4_house_of_mt_2bb8d573:


    sl "Evet, korkuyorsun!"


translate turkish day4_house_of_mt_90cc9542:


    "Slavya asla hayır diyebileceğim bir insan değil."


translate turkish day4_house_of_mt_6cdf61dd:


    "İsteksizce ayağa kalktım ve onunla birlikte kamaradan çıktım."


translate turkish day4_house_of_mt_5aaa09bd:


    "Bir süre kapının önünde durduk, yaz güneşinin ışıkları altında dinlendik{w} gerçi ben biraz kızarmıştım..."


translate turkish day4_house_of_mt_fca62f46:


    me "Nereye gideceğiz?"


translate turkish day4_house_of_mt_276df626:


    sl "Her yere bakmalıyız."


translate turkish day4_house_of_mt_57a26992:


    th "Harika bir fikir. Tek kelimeyle harika!"


translate turkish day4_house_of_mt_018386dd:


    "Rotamızdaki ilk durak kütüphaneydi."


translate turkish day4_house_of_mt_42ea0267:


    "Slavya masada oturan Zhenya'nın yanına gitti ve onunla konuştu."


translate turkish day4_house_of_mt_188600a4:


    "Ben sadece kapı aralığında durdum. Bu kütüphaneciyle gereğinden fazla iletişim kurmak istemiyordum."


translate turkish day4_house_of_mt_eccb8e77:


    "Birkaç dakika sonra Slavya yanıma geldi."


translate turkish day4_house_of_mt_48013d82:


    me "Ne oldu?"


translate turkish day4_house_of_mt_37eba565:


    sl "Hiçbir şey..."


translate turkish day4_house_of_mt_4c3d69ef:


    "Başını salladı"


translate turkish day4_house_of_mt_e93ab54f:


    th "Beklendiği gibi...."


translate turkish day4_house_of_mt_a20cefa7:


    "..."


translate turkish day4_house_of_mt_79e8cb2c:


    "Kantin{w} Öğle yemeği başlamadan önce hala vaktimiz vardı, bu yüzden her zamanki öncü kalabalığı yoktu."


translate turkish day4_house_of_mt_e2de9d7b:


    "Binanın içi ve dışı boştu."


translate turkish day4_house_of_mt_84df38db:


    "Slavya aşçılarla konuşurken ben oturmuş tuzlukla oynuyordum."


translate turkish day4_house_of_mt_ae189afc:


    "Tencereden biraz tuz döküldü."


translate turkish day4_house_of_mt_f8a8a439:


    "Batıl inançlarım olsaydı kesinlikle endişelenirdim."


translate turkish day4_house_of_mt_31901972:


    "Gariptir ki, o da burada değildi."


translate turkish day4_house_of_mt_387e3a7a:


    "Onu örneğin buzdolabında bulmuş olsaydı...... bu beklenmedik bir durum olurdu."


translate turkish day4_house_of_mt_a20cefa7_1:


    "..."


translate turkish day4_house_of_mt_d5c5547a:


    "Planımıza göre bir sonraki durak revirdi."


translate turkish day4_house_of_mt_60f69217:


    "İçeri girmemeye karar verdim ve Slavya'yı dışarıda bekledim."


translate turkish day4_house_of_mt_6b61c0c5:


    "Sonuç yok."


translate turkish day4_house_of_mt_c08b785a:


    "Spor sahasında futbol oynayan öncüler vardı."


translate turkish day4_house_of_mt_b4ae2b53:


    "Shurik için onların arasında kaybolmak zor olacaktı."


translate turkish day4_house_of_mt_b2c08c50:


    "Sonunda kulüp binasına ulaştık."


translate turkish day4_house_of_mt_38b1dea9:


    me "Sence burada olabilir mi? İnsanların ilk arayacakları yerin burası olduğunu düşünürdüm."


translate turkish day4_house_of_mt_7827a8db:


    sl "Hadi içeri girelim."


translate turkish day4_house_of_mt_40d2a09a:


    "İçerisi boş."


translate turkish day4_house_of_mt_2836519c:


    "Slavya kapıyı açtı ve yan odaya geçti."


translate turkish day4_house_of_mt_f73e0745:


    "Ben de onu takip ettim."


translate turkish day4_house_of_mt_0ba05a1b:


    "Tüm bunlar bana aptalca bir girişim gibi görünüyordu."


translate turkish day4_house_of_mt_a967e5b1:


    "Özellikle de Slavya'nın fikri olduğu için garipti."


translate turkish day4_house_of_mt_9b88aabc:


    th "Yani anlıyorum, sorumluluk vesaire... Ama kampta olmadığı çok açık değil mi?"


translate turkish day4_house_of_mt_13a0360f:


    th "Ne de olsa bizimle saklambaç oynamıyor, değil mi?"


translate turkish day4_house_of_mt_c1888233:


    sl "Burada da kimse yok."


translate turkish day4_house_of_mt_6e164047:


    me "Ne bekliyordun ki? Dolapta mı oturacaktı?"


translate turkish day4_house_of_mt_dfc5030f:


    sl "Evet!"


translate turkish day4_house_of_mt_6e0f81b2:


    "Onu gücendirmişim gibi görünüyor."


translate turkish day4_house_of_mt_bc695e77:


    me "Üzgünüm, üzgünüm...{w} Ama cidden!"


translate turkish day4_house_of_mt_d2e028e4:


    sl "Anlıyorum...{w} Ama tüm olasılıkları kontrol etmeliyiz."


translate turkish day4_house_of_mt_1a2d3a52:


    me "Tamam, dinle, gerçekten ne düşünüyorsun?"


translate turkish day4_house_of_mt_1829f925:


    sl "Shurik'in kaybolması hakkında mı?"


translate turkish day4_house_of_mt_fc30fd2b:


    me "Evet."


translate turkish day4_house_of_mt_68504b39:


    sl "Belki de ormana gitmiştir ve bir orman ruhu tarafından yakalanmıştır."


translate turkish day4_house_of_mt_ec2c2a7c:


    "Buna güldü."


translate turkish day4_house_of_mt_579bb939:


    me "Ne muhteşem bir hikaye."


translate turkish day4_house_of_mt_adb6e4a6:


    th "Ancak, bu kampta asla bilemezsiniz."


translate turkish day4_house_of_mt_920eda59:


    sl "Evet, doğru...{w} Ama şimdi şaka zamanı değil!"


translate turkish day4_house_of_mt_d7a9b9f5:


    me "Neşelen!{w} Onu bulacağız!"


translate turkish day4_house_of_mt_4f31da71:


    sl "Umarım..."


translate turkish day4_house_of_mt_c17a722d:


    "Slavya gülümsedi."


translate turkish day4_house_of_mt_551b3c25:


    sl "Hâlâ yapacak işlerim var."


translate turkish day4_house_of_mt_038a986f:


    me "Sonra görüşürüz."


translate turkish day4_house_of_mt_432f59be:


    "O gitti ama ben bir süre orada durup sibernetik kulübünün dolabına baktım...."


translate turkish day4_house_of_mt_a20cefa7_2:


    "..."


translate turkish day4_house_of_mt_c6af67a5:


    "Ancak Slavya'nın hareketlerinden o kadar etkilenmiştim ki başka bir yerde aramaya devam etmeye karar verdim."


translate turkish day4_boathouse_9797429b:


    th "Belki Shurik su kenarındaki taşları toplamaya karar vermiştir."


translate turkish day4_boathouse_140891ff:


    th "En kötü ihtimalle cesedini bulurum."


translate turkish day4_boathouse_639b643a:


    th "Ama bu şekilde bitmeyeceğinden eminim!"


translate turkish day4_boathouse_ea7057f1:


    "Biri bana seslendiğinde meydandan geçiyordum."


translate turkish day4_boathouse_418a6303:


    dv "Bekle! Bekle!"


translate turkish day4_boathouse_3900d745:


    "Alisa geldi ve gülümsedi. Hemen bir tuzak sezdim."


translate turkish day4_boathouse_2f227a4f:


    dv "Nereye gidiyorsun?"


translate turkish day4_boathouse_d6059f36:


    me "Shurik'i arıyorum...{w} Olga Dmitrievna istedi."


translate turkish day4_boathouse_ce4ee092:


    dv "Nasıl gidiyor? Heyecan verici mi?"


translate turkish day4_boathouse_9d114d2d:


    "Gözlerimin içine dikkatle baktı ve ben beceriksizce arkamı döndüm."


translate turkish day4_boathouse_cba9cbf0:


    me "Pek sayılmaz...{w} Ama biliyorsun, bir öncü eksik."


translate turkish day4_boathouse_36e1c3b7:


    dv "Bu kadar küçük bir şey için çıldırmıyorsun değil mi?"


translate turkish day4_boathouse_cb23542f:


    me "Ne demek istiyorsun?"


translate turkish day4_boathouse_b0848313:


    dv "Sadece birkaç saat geçti{w} Belki de yürüyüş yaparken zamanın nasıl geçtiğini anlamamıştır..."


translate turkish day4_boathouse_da12543c:


    "Kesinlikle aynı fikirdeydim, ama bunu ona söylemiyordum."


translate turkish day4_boathouse_f7f0bc77:


    me "Evet, bu doğru.{w} Ama kim bilir neler olabilirdi..."


translate turkish day4_boathouse_64f4e64e:


    dv "Sana yardım edeyim!"


translate turkish day4_boathouse_16a32560:


    me "Mmm... Neye?"


translate turkish day4_boathouse_a3e48491:


    "Şüphelendim."


translate turkish day4_boathouse_01b2df0c:


    dv "Shurik'i ararken!"


translate turkish day4_boathouse_beae491d:


    me "Oh, ama yapabilirim..."


translate turkish day4_boathouse_55688a4e:


    dv "Oh, hadi ama!"


translate turkish day4_boathouse_f0fb482a:


    "Bana gülümsedi ama bu gülümsemede kötü niyetli bir şeyler vardı."


translate turkish day4_boathouse_cd88bad5:


    "Doğal olarak, gülümsemesi yeterince hoştu, ama bana gerçekten arkasında bir şey varmış gibi geldi."


translate turkish day4_boathouse_b88b8d82:


    me "Madem ısrar ediyorsun..."


translate turkish day4_boathouse_4e8dafb2:


    "Aklında ne olduğunu anlayamadığım için reddetmek için gerçek bir nedenim yoktu."


translate turkish day4_boathouse_b5f16424:


    dv "Ama gitmeden önce evden bir şey almam gerekiyor."


translate turkish day4_boathouse_12c4ee4b:


    me "Tamam, seni bekleyeceğim."


translate turkish day4_boathouse_62de1363:


    dv "Orada öylece durmak konusunda ciddi misin? Gidelim!"


translate turkish day4_boathouse_505d91ae:


    me "Tamam..."


translate turkish day4_boathouse_a2980b83:


    "Alisa'nın kamarasına yaklaştık."


translate turkish day4_boathouse_7aa63adb:


    "Kapısındaki Jolly Roger olmasa diğer kamaralar gibi olacaktı."


translate turkish day4_boathouse_e4591d9e:


    dv "Bu arada, Ulyana benim oda arkadaşım."


translate turkish day4_boathouse_53a56040:


    me "Tamam."


translate turkish day4_boathouse_36881cd4:


    "Kulübeye girdik,"


translate turkish day4_boathouse_983dd462:


    "İçerideki tam kaos bana eski dairemi hatırlattı."


translate turkish day4_boathouse_0d66d2a4:


    th "Gerçi neden 'eski' olarak düşünmüştüm ki?"


translate turkish day4_boathouse_225e52c0:


    "Genel olarak, bir kızın odasını farklı hayal ederim: bembeyaz çarşaflar; duvarlar, zemin ve parıldayan tavan. Tertemiz."


translate turkish day4_boathouse_cd30d970:


    th "Ama en 'örnek' iki öncünün burada yaşadığını düşünürseniz..."


translate turkish day4_boathouse_dab5031c:


    "Bir süre sessizce durduk."


translate turkish day4_boathouse_f744c43e:


    me "Peki ne almanız gerekiyordu?"


translate turkish day4_boathouse_765cf23a:


    dv "Ne?"


translate turkish day4_boathouse_fe1ee079:


    "Görünüşe göre Alisa'nın düşüncesini böldüm."


translate turkish day4_boathouse_72b1039b:


    dv "Evet...{w} Burada değil aslında...{w} Burada bekle, bir dakika içinde döneceğim."


translate turkish day4_boathouse_0049a2fb:


    "Gülümsedi ve koşarak çıktı."


translate turkish day4_boathouse_ebc67191:


    th "Bugün çok huysuz görünüyor."


translate turkish day4_boathouse_7fb057e3:


    "Odayı incelemeye başladım."


translate turkish day4_boathouse_5dfa3fd6:


    "Bir patlama olduğunu söyleyemem, sadece iyi bir dağınıklık vardı."


translate turkish day4_boathouse_49172fa3:


    th "En azından bir öncü seansında yaratılan tüm bu dağınıklığa bakarak, kesinlikle dünyanın en dağınık insanı olmadığımı söyleyebilirim."


translate turkish day4_boathouse_b3f9ad2c:


    "Evimin dekorasyonunun tamamlanması yıllar sürdü!"


translate turkish day4_boathouse_1f000f06:


    "Belirli bir şey düşünmüyordum, sadece odaya bakıyordum."


translate turkish day4_boathouse_76afe60b:


    "Sovyet sanatçıların posterleri, raflardaki bazı kitaplar, çeşitli ev eşyaları..."


translate turkish day4_boathouse_76d3f20d:


    "Ve sonra her şeyin yanlış olduğunu fark ettim!"


translate turkish day4_boathouse_8a607983:


    th "Yakında bir şey olacak!{w} Kötü bir şey!"


translate turkish day4_boathouse_c1ef0499:


    th "Alisa neden beni burada yalnız bıraktı?"


translate turkish day4_boathouse_3eb661ac:


    "Keşfetmem gereken bir şey vardı."


translate turkish day4_boathouse_9e3a46df:


    "İçgüdülerim bana burada kalmanın tehlikeli olduğunu söylüyordu."


translate turkish day4_boathouse_f00b42b5:


    "Kapıya gittim ve açmaya çalıştım."


translate turkish day4_boathouse_531d7dd3:


    "Kilitliydi!"


translate turkish day4_boathouse_f67a6003:


    th "Bu ne sürpriz!{w} Beni sessizce içeri kilitlemeyi nasıl başardı?"


translate turkish day4_boathouse_de1fdea1:


    th "Aklında ne var bilmiyorum ama buradan çıkmam lazım!"


translate turkish day4_boathouse_dee27299:


    "Pencereye gittim, açtım ve dışarı çıktım."


translate turkish day4_boathouse_0ed51470:


    th "Şimdi gidip işimi halledebilirdim ya da..."


translate turkish day4_boathouse_b69f8c48:


    "İkinci seçeneği seçtim ve bekledim."


translate turkish day4_boathouse_e924afbe:


    th "Beni kilitli tutmasının sebebi neydi?"


translate turkish day4_boathouse_7b372665:


    "Neler olduğunu bilmek istiyordum, ayrıca odasını boş bulduğunda Alisa'nın yüzünü görmeyi çok istiyordum."


translate turkish day4_boathouse_4c2291c3:


    "Evin yanındaki çalılıklara saklandım ve beklemeye başladım."


translate turkish day4_boathouse_7eae97a5:


    "Bir süre sonra ayak sesleri duydum."


translate turkish day4_boathouse_009f6978:


    "Alisa ve Olga Dmitrievna eve geldiler."


translate turkish day4_boathouse_f9acd723:


    dv "Her şeyi kendiniz göreceksiniz!"


translate turkish day4_boathouse_bc262665:


    "Kapıyı açtı ve içeri girdi."


translate turkish day4_boathouse_cc2a5873:


    "Birkaç saniye sonra koşarak geri çıktı."


translate turkish day4_boathouse_813cd9cc:


    dv "Biliyor musun, ben..."


translate turkish day4_boathouse_8b502027:


    "Alisa'nın yüzü sanki fare yakalama yarışmasını kazanmış ama son anda bunun gerçek bir olimpik spor olmadığını öğrenmiş gibi görünüyordu."


translate turkish day4_boathouse_4195d1ac:


    mt "Yani öylece ortadan kayboldu mu?"


translate turkish day4_boathouse_962ac463:


    "Olga Dmitrievna kuşkuyla sordu."


translate turkish day4_boathouse_5460bb59:


    th "Pencereyi kendimden sonra kapatarak doğru şeyi yaptım!"


translate turkish day4_boathouse_2178d069:


    dv "Oh hayır...{w} Biliyorsun..."


translate turkish day4_boathouse_3f9c9a9a:


    mt "Her şeyi anlıyorum, Dvachevskaya!"


translate turkish day4_boathouse_fdf3425b:


    mt "Sen ve oda arkadaşın - her zaman aynı şey! Yetmedi mi daha?!"


translate turkish day4_boathouse_38429b64:


    dv "Ama bu doğru...!"


translate turkish day4_boathouse_b29a5db5:


    mt "Gerçekten mi? Birbiri ardına hikayeler. Semyon kamaranda, Semyon seni taciz ediyor. Neden yalan söyleyip duruyorsun? Korkunç bir şey bu."


translate turkish day4_boathouse_a48fe9fa:


    "Alisa gerçekten üzgün görünüyordu ve beni şaşırtacak şekilde tartışmaya çalışmıyordu."


translate turkish day4_boathouse_81dede20:


    "Bir yandan bakması komikti ama diğer yandan Dvachevskaya için biraz üzüldüm."


translate turkish day4_boathouse_0e804b76:


    "Yine de bunu hak ediyor..."


translate turkish day4_boathouse_4d1f6fb4:


    "Liderimiz sonunda onu azarlamayı bitirdi ve gitti."


translate turkish day4_boathouse_2ef1d6a7:


    "Alisa çıldırmıştı{w} yumruklarını sıktı ve titredi, yüzü kızardı, bana patlayacakmış gibi geldi."


translate turkish day4_boathouse_2eb4d7e1:


    "Çalıların arasına oturdum ve sessizce güldüm."


translate turkish day4_boathouse_7a53a4ae:


    "Ancak aklından ne geçtiğini merak ediyordum ve dayak yemekten korkmayarak saklandığım yerden çıktım."


translate turkish day4_boathouse_c7546dc1:


    me "Peki lidere tam olarak ne göstermek istiyordun?{w} Bana mı?"


translate turkish day4_boathouse_d6196049:


    "Alisa döndü ve bana inançsızlıkla baktı."


translate turkish day4_boathouse_60e7b002:


    "Bir an sonra şaşkınlık öfkeye dönüştü."


translate turkish day4_boathouse_b7d8bf72:


    dv "Sen! Sen! Sen!"


translate turkish day4_boathouse_8f37a6c9:


    me "Ne olmuş bana?"


translate turkish day4_boathouse_f834c3f8:


    "Biraz sakinleşti."


translate turkish day4_boathouse_12133f6d:


    dv "Seninle ödeşmek istedim."


translate turkish day4_boathouse_f0d6d1c8:


    "Sırıttı."


translate turkish day4_boathouse_21cbf526:


    me "Ne demek istiyorsun?"


translate turkish day4_boathouse_e8988316:


    dv "İddiayı kaybettin. Kamp liderine beni nasıl takip ettiğini göstermek istedim."


translate turkish day4_boathouse_0fc6db81:


    th "Olga Dmitrievna'nın bu durumda ne yanlış bulabileceğini merak ediyorum, ama devam edelim..."


translate turkish day4_boathouse_0686c1b4:


    dv "İntikam almak istedim!"


translate turkish day4_boathouse_16b585f8:


    me "Ne için?"


translate turkish day4_boathouse_f3add060:


    th "Gerçekten, intikam almak için bu kıza ne yaptım?"


translate turkish day4_boathouse_fa0ca1ce:


    dv "Beni kart oyununda yendin!"


translate turkish day4_boathouse_b0dcc84f:


    th "Ne harika bir sebep!{w} Şüphesiz..."


translate turkish day4_boathouse_f2e007f0:


    me "Anlıyorum."


translate turkish day4_boathouse_b6a65aa2:


    dv "Çünkü sen bir eziksin!"


translate turkish day4_boathouse_32974cc7:


    me "Nedenmiş o?"


translate turkish day4_boathouse_15bab5bb:


    dv "Çünkü benimle rekabet etmekten korkuyorsun!"


translate turkish day4_boathouse_3c1b245e:


    me "Ne zaman?"


translate turkish day4_boathouse_ef0158a3:


    dv "Kart oynadığımız zaman!"


translate turkish day4_boathouse_9d2033ff:


    "Ne kadar ciddi bir sebep."


translate turkish day4_boathouse_c63ec5a4:


    me "Evet..."


translate turkish day4_boathouse_57d2d760:


    me "Belki de senden özür dilemeliyim?"


translate turkish day4_boathouse_81684e59:


    "Alaycı bir şekilde sordum."


translate turkish day4_boathouse_0eebc5d9:


    dv "Siktir git!"


translate turkish day4_boathouse_c0d6d356:


    "Kapıyı çarparak eve girdi."


translate turkish day4_boathouse_5e595186:


    "Alisa'ya kızgın değildim."


translate turkish day4_boathouse_663b2604:


    "Sonuçta böyle bir şey yapmasını bekliyordum."


translate turkish day4_boathouse_d12d5f50:


    "Her neyse, sonuçlarına katlanmadan atlattım."


translate turkish day4_boathouse_2c46efd4:


    "Çok şanslıydım - onun şaşkınlığı ve utancı günümü güzelleştirdi."


translate turkish day4_boathouse_5030ce16:


    "Kıkırdayarak Alisa'nın ölüm tuzağım olmak üzere olan kulübesinden ayrıldım...."


translate turkish day4_main2_a20cefa7:


    "..."


translate turkish day4_main2_48d0d4e6:


    "Öğle yemeğine karışık duygularla gittim - bir başarı duygusu ve boşa harcanan zamanın farkına vararak."


translate turkish day4_main2_4cb70312:


    "Kantin kalabalıktı."


translate turkish day4_main2_58e949cc:


    "Fark edilmeden kalamazdım - Olga Dmitrievna beni çağırdı."


translate turkish day4_main2_a4d48910:


    mt "Semyon, bizimle gel."


translate turkish day4_main2_08ad4dba:


    "Kamp lideri, Slavya ve Electronik dört kişilik masada oturuyorlardı."


translate turkish day4_main2_2acc25a8:


    "Başımı salladım ve yemeğimi almaya gittim."


translate turkish day4_main2_523ebbc0:


    "Bu kez kuyrukta birkaç dakika geçirmem gerekti."


translate turkish day4_main2_c6c2e073:


    "Bugünün menüsü diğer günlerin menülerinden pek farklı değildi{w} en azından yemekler aynı görünüyordu."


translate turkish day4_main2_05eb9d8b:


    "Masaya oturup herkese afiyet olsun dediğimde Olga Dmitrievna şöyle dedi:"


translate turkish day4_main2_b397d74c:


    mt "Peki, ne düşünüyorsun?"


translate turkish day4_main2_c233b6a2:


    me "Ne hakkında?"


translate turkish day4_main2_67341092:


    mt "Her yerde Shurik'i aradık{w} öğlen oldu ve onu hiçbir yerde bulamadık."


translate turkish day4_main2_3d1cf378:


    "Kafiyeyi not aldım ama belirtmek istemedim."


translate turkish day4_main2_5f3e793a:


    sl "Kampın her yerine baktık."


translate turkish day4_main2_46ae85f2:


    el "Komşu ormanın her tarafını dolaştım."


translate turkish day4_main2_cefc6cd9:


    "Olga Dmitrievna bana baktı."


translate turkish day4_main2_f0777904:


    me "Ve ben...{w} ben de yardım ettim."


translate turkish day4_main2_ad33fcd7:


    mt "Polisi aramalıyız!"


translate turkish day4_main2_cc3b3354:


    me "Belki de akşama kadar beklemeliyiz?"


translate turkish day4_main2_26be9189:


    "Tembelce sordum."


translate turkish day4_main2_d859378c:


    me "Belki de eve gitmiştir..."


translate turkish day4_main2_29941732:


    mt "Bu olamaz! Shurik binlerce kilometre uzakta yaşıyor."


translate turkish day4_main2_51a52fb5:


    me "Trenle mi?"


translate turkish day4_main2_932e3a79:


    mt "En yakın istasyon..."


translate turkish day4_main2_b7d1c016:


    "Durakladı."


translate turkish day4_main2_61df2540:


    mt "Çok uzakta..."


translate turkish day4_main2_35d07915:


    "Şimdi işler ilginçleşmeye başlamıştı."


translate turkish day4_main2_3c635a17:


    th "Konuşma ne zaman Sovyonok'tan nasıl ayrılabileceğime gelse, kamp sakinleri konuyu değiştirmeye başladı."


translate turkish day4_main2_91bfb245:


    me "\"Uzak\" ne kadar uzak?"


translate turkish day4_main2_a63beaef:


    mt "Gerçekten uzak."


translate turkish day4_main2_f3bfc63b:


    "Kamp lideri bana baktı ve yüz ifadesiyle daha fazla soru sormanın tavsiye edilmediğini belirtti."


translate turkish day4_main2_12bcc6fb:


    sl "Öyleyse ormanın derinliklerine gitmeliyiz! Belki de kaybolmuştur!"


translate turkish day4_main2_775f2318:


    el "Shurik her zaman bir pusula alır."


translate turkish day4_main2_3c97ead2:


    "Electronik'te çınladı."


translate turkish day4_main2_df6e5065:


    "Acaba sihirli yeleğinde (bir yeleği olduğunu varsayarsak) başka neler bulabilir?"


translate turkish day4_main2_feb702c4:


    "Eğer ormanda kaybolacak olsaydım, pusulanın hiçbir faydası olmazdı."


translate turkish day4_main2_0ff502ce:


    mt "Polis!{w} Polisi akşam aramalıyız!"


translate turkish day4_main2_35192e6e:


    th "En azından şimdi değil."


translate turkish day4_main2_af1d0e2a:


    me "Tamam, o zaman sonra yaparsın..."


translate turkish day4_main2_ec9674fa:


    "Hepsi sessizdi."


translate turkish day4_main2_a0920c3c:


    me "Akşam olmadan onu bulabilmeliyiz, hala vaktimiz var."


translate turkish day4_main2_97d66c28:


    mt "Eğer gerçekten kaybolduysa kaybedecek zamanımız yok!"


translate turkish day4_main2_24f8e21c:


    sl "Emin olamayız."


translate turkish day4_main2_dea475da:


    mt "O zaman nerede? Nerede mi?"


translate turkish day4_main2_515c8c9d:


    "Kamp liderinin sözlerinde doğruluk payı vardı. Bütün gün böyle saklanmak şüphe uyandırıcı."


translate turkish day4_main2_5f25be5b:


    "Bunu neden yapsın ki? Shurik bana oldukça ciddi bir öncü gibi göründü. Ulyana bu davranış için daha uygun olurdu."


translate turkish day4_main2_2ddaebf2:


    "Yani onun gittiğine inanmak için iyi bir neden var."


translate turkish day4_main2_593ca1bb:


    me "Yapılabilecek her şey çoktan yapıldı. Sadece beklemek zorundayız."


translate turkish day4_main2_56f14e0a:


    "Slavya, Electronik ve Olga Dmitrievna bana üzüntüyle baktılar ama tek kelime etmediler...."


translate turkish day4_main2_a20cefa7_1:


    "..."


translate turkish day4_main2_6aa774a1:


    "Yemeğimi bitirdim, tepsiyi geri aldım ve kantinden ayrıldım."


translate turkish day4_main2_5abbd6f2:


    th "Daha günün ilk yarısı..."


translate turkish day4_main2_11e5ce88:


    th "Şimdi ne olacak?"


translate turkish day4_main2_19b6f21b:


    "Kamp öğleden sonra uykusuna dalıyordu."


translate turkish day4_main2_99bbc067:


    "Sadece Genda gözlüklerinin ardından bana bakıyordu."


translate turkish day4_main2_ab4e08c6:


    "Elbette başka bir yere bakıyordu ama içimde sürekli beni izlediğine dair bir his vardı."


translate turkish day4_main2_5f2f4e3e:


    th "Bahse girerim Shurik'in nerede saklandığını biliyordur{w} sadece bir şey söyleyemiyor..."


translate turkish day4_main2_a3a27538:


    "Sibernetik kulübünün liderinin ortadan kaybolması beni düşündürdü."


translate turkish day4_main2_219aa2d9:


    th "Belki de bunun benim davamla bir ilgisi vardır?"


translate turkish day4_main2_2cf5c012:


    cs "Oh, pioneer!"


translate turkish day4_main2_08272ac1:


    "Hemşire önümde durdu."


translate turkish day4_main2_4a52b166:


    "Merakla ona baktım."


translate turkish day4_main2_d7304160:


    cs "Git ve revirdeki yerimi al. Acil bir çağrım var. Birisi yaralandı."


translate turkish day4_main2_de5dd677:


    me "Ben mi?"


translate turkish day4_main2_dacf7660:


    cs "Evet, sen!{w} Anahtarları al!"


translate turkish day4_main2_f30d0d14:


    "Hemşire anahtarları bana fırlattı ve kaçtı."


translate turkish day4_main2_469e7359:


    th "Neden ben? Bu kampta başka kimse yok mu? Tam olarak ne yapmalıyım? Ya bir şey olursa?"


translate turkish day4_main2_7d9ad10a:


    th "Ah şimdi ne yapacağım, reddetme şansımı kaçırdım..."


translate turkish day4_main2_ab1de823:


    "Kapının önünde kararsızca durdum."


translate turkish day4_main2_c422bd2d:


    th "Bir yandan endişelenecek bir şey yok - burada yarım saat kadar zaman geçireceğim ve o geri dönecek."


translate turkish day4_main2_6e8191b6:


    th "Ama ya biri gerçekten yardım için gelirse? Kırık bir bacakla? Ya da kafa travmasıyla?"


translate turkish day4_main2_78c21f2c:


    "Çok fazla endişelenmeye başladım."


translate turkish day4_main2_72b4eb4d:


    "Umarım bu kampta çürük ve sıyrıklardan daha ciddi yaralanmalar olmaz."


translate turkish day4_main2_65e07906:


    "Ama aynı zamanda ciddi bir durumda kesinlikle işe yaramayacağım fikrinden de kurtulamıyorum."


translate turkish day4_main2_1e5b77ba:


    th "Kalp masajı yapmayı bile bilmiyorum!"


translate turkish day4_main2_d02d8b17:


    "Hemşire masasındaki bir dergi dikkatimi çekti."


translate turkish day4_main2_b5804212:


    th "Rahatlamak için iyi bir yol{w} sanırım..."


translate turkish day4_main2_ec4a19eb:


    "Bu 'Sovyet Modası' olarak etiketlenmiş."


translate turkish day4_main2_e9159fbe:


    "Yayın tarihi veya ayı yoktu."


translate turkish day4_main2_726e419d:


    "Ancak bu bir sürpriz değildi. Burada çok daha garip şeyler oluyordu. Sovyet dergileri hakkında pek bir şey bilmiyordum. Belki de üzerlerinde yayın tarihleri yoktu."


translate turkish day4_main2_21eab677:


    "Eski moda kıyafetler giymiş modeller parlak sayfalardan bana bakıyordu."


translate turkish day4_main2_bb76f93b:


    th "Bugünlerde kimse böyle kıyafetler giymezdi."


translate turkish day4_main2_a026df63:


    "Sırıttım."


translate turkish day4_main2_f5d07ae7:


    th "Örneğin Slavya'nın bunu modaya uygun bulup bulmadığını merak ediyorum."


translate turkish day4_main2_2453e3b6:


    th "Benim zamanımda böyle bir şey giyerek ortaya çıksa neler olacağını hayal edebiliyorum."


translate turkish day4_main2_864530e1:


    th "El ele yürüdüğümüzü hayal edin. Ben kapüşonlu paltomu giyiyorum ve o da dantellerle kaplı gösterişli bir elbise giymiş."


translate turkish day4_main2_e7482e77:


    "Sanki Slavya'yı şimdiden kendi dünyamda hayal ediyorum...{w} benimle...{w} ve sadece Slavya'yı değil."


translate turkish day4_main2_19330451:


    th "Bu elbise Ulyana'ya daha çok yakışır, bu sute sarafan Alisa'ya, bu etek ve hırka Lena'ya çok yakışır."


translate turkish day4_main2_acf18888:


    "Keşke gerçek olsalardı..."


translate turkish day4_main2_45c2a3ea:


    "Hayır, onları gördüm, duydum, hatta onlara dokunabildim."


translate turkish day4_main2_b793115e:


    th "Ama hala buradalar ve ben...{w} Ben buraya ait değilim."


translate turkish day4_main2_c7ecb5e1:


    th "Bana yabancı. Sadece buradan çıkmak için bir şans bekliyorum."


translate turkish day4_main2_34ecfe30:


    th "Bekliyorum çünkü artık hiçbir şey bana bağlı değil..."


translate turkish day4_main2_a734d9d3:


    "İçimi çektim, başımı masaya koydum ve uykuya daldım..."


translate turkish day4_main2_a20cefa7_2:


    "..."


translate turkish day4_main2_ad69b965:


    "Kapının açılma sesiyle uyandım."


translate turkish day4_main2_26171c75:


    "Lena kapıda durdu."


translate turkish day4_main2_aa82a2c6:


    th "Dün revirde ona yardım edeceğime söz vermiştim..."


translate turkish day4_main2_6bb5c0bf:


    "Yanaklarım kısa sürede kızardı ve meşgulmüşüm gibi davranarak arkamı döndüm."


translate turkish day4_main2_fbb88586:


    un "Hemşire burada değil mi?{w} O zaman daha sonra gelirim..."


translate turkish day4_main2_37395644:


    me "Onun yerine geçiyorum!"


translate turkish day4_main2_d87b9ec9:


    th "Öncülerin hayatlarından sorumlu olduğum için bunu tüm sorumluluğumla yapmalıyım."


translate turkish day4_main2_7b38c5ca:


    "Aslında sadece benim yüzümden kötü bir şey olmasından korkuyordum."


translate turkish day4_main2_06a1509d:


    me "Herhangi bir sağlık şikâyetiniz var mı?"


translate turkish day4_main2_4c00f79b:


    "Lena'nın kafasını karıştırmamak için ona elimden gelen en profesyonel gülümsemeyi göstermeye çalıştım."


translate turkish day4_main2_69f94ecc:


    un "Özel bir şey yok...{w} Sadece biraz baş ağrısı."


translate turkish day4_main2_2357f708:


    me "Hadi yapalım şunu!"


translate turkish day4_main2_27d0cf32:


    th "Belki biraz ağrı kesici..."


translate turkish day4_main2_f9569158:


    "Tabii ki gerekli ilaçları nerede bulacağımı bilmiyordum, bu yüzden onları bulmam biraz zaman aldı."


translate turkish day4_main2_649ec83c:


    me "Sonunda buldum!"


translate turkish day4_main2_64f21126:


    "Lena'ya bir metamizol tableti uzattım."


translate turkish day4_main2_082d3571:


    un "Teşekkürler."


translate turkish day4_main2_d1046a49:


    "Gülümsedi."


translate turkish day4_main2_38a347b1:


    "Bu hiç beklenmedik bir şeydi ve ona bakarken gerçeklikle bağlantımı kaybettim."


translate turkish day4_main2_3875ba7b:


    un "Ne oldu?"


translate turkish day4_main2_cb318c1b:


    "Lena bir anda garipleşti."


translate turkish day4_main2_bec7dcec:


    me "Dinle, merak ediyordum. Bunu beğendin mi?"


translate turkish day4_main2_6cbc07c6:


    "Bana ne oldu bilmiyorum ama masadan o dergiyi aldım ve bence Lena'ya çok yakışacak olan etek ve hırka resmini ona gösterdim."


translate turkish day4_main2_f9690e49:


    "Belki de bütün kızların benim dünyamda olduğunu düşünerek tamamen çıldırmıştım."


translate turkish day4_main2_50cb5ce9:


    "Ya da belki de hemşirenin gelmesini beklemek yerine dikkatimi dağıtmak istemiştim."


translate turkish day4_main2_1523dd90:


    "Lena resme baktı."


translate turkish day4_main2_1aa04f80:


    un "Evet, sanırım."


translate turkish day4_main2_bc64bbfd:


    me "Böyle şeyler moda mı?"


translate turkish day4_main2_3c68ea6c:


    un "Sanırım..."


translate turkish day4_main2_340ec68e:


    "Kafası karıştı ve kızarmaya başladı."


translate turkish day4_main2_9812399d:


    un "Neden sordunuz?"


translate turkish day4_main2_59e7c056:


    th "Gerçekten, neden..."


translate turkish day4_main2_082d3571_1:


    un "Teşekkür ederim."


translate turkish day4_main2_dcd2e3df:


    me "Sorun değil, sadece dürüst olmaya çalışıyorum!"


translate turkish day4_main2_47092547:


    un "..."


translate turkish day4_main2_c4d1a45e:


    "Bir süre sessiz kaldık."


translate turkish day4_main2_a417690d:


    me "Baş ağrın nasıl?"


translate turkish day4_main2_c1c02f2e:


    un "Çok daha iyi, teşekkür ederim."


translate turkish day4_main2_d1046a49_1:


    "Gülümsedi."


translate turkish day4_main2_a17b8e3e:


    un "Ben gidiyorum."


translate turkish day4_main2_3fc88750:


    me "İyi şanslar!"


translate turkish day4_main2_7e83005b:


    "Lena dışarı çıktı ve ben dergiye bakmaya devam ettim...."


translate turkish day4_main2_a20cefa7_3:


    "..."


translate turkish day4_main2_500f0017:


    "Bir süre sonra biri yine kapıyı çaldı."


translate turkish day4_main2_22afe73c:


    th "Görünüşe göre revir gidilecek en popüler yer."


translate turkish day4_main2_b588274b:


    "Aniden bir hemşireyi canlandırmaya karar verdim...{w} sadece erkek versiyonunu...{w} ve dedim ki:"


translate turkish day4_main2_6b33d385:


    me "İçeri gel!"


translate turkish day4_main2_573b3dff:


    "Kapı açıldı ve Ulyana odaya girdi."


translate turkish day4_main2_5536cc92:


    me "Vay canına! Kapıyı çalmaya karar verdiğin anı kaçırdım mı?"


translate turkish day4_main2_9ef7bfe7:


    us "Kapıyı çalmamda bir sorun mu var?"


translate turkish day4_main2_d6ea162b:


    "Kaşlarını çattı."


translate turkish day4_main2_396150e8:


    me "Neresi acıyor?"


translate turkish day4_main2_cd1dfac0:


    us "Neden sana söyleyeyim ki? Hemşire nerede?"


translate turkish day4_main2_7611a63b:


    me "Tam önünde."


translate turkish day4_main2_d2429dec:


    "Heybetli bir şekilde bacak bacak üstüne attım ve soru dolu gözlerle ona baktım."


translate turkish day4_main2_9881e8d1:


    us "Gitsem iyi olacak{w} senin tarafından tedavi edilmektense ölmek daha iyi."


translate turkish day4_main2_7f6b716b:


    "Yaramazca gülümsedi."


translate turkish day4_main2_5ae0e9e5:


    me "Denememe bile izin vermedin!"


translate turkish day4_main2_2ccca5b3:


    "Ulyana bir an düşündü."


translate turkish day4_main2_2348abed:


    us "Yine de bana birkaç hap verebilirsin."


translate turkish day4_main2_fdf90b79:


    me "Seni rahatsız eden ne?"


translate turkish day4_main2_aa62d7ce:


    "Cevap vermesi biraz zaman aldı."


translate turkish day4_main2_f32986c4:


    us "Ağır bir mide..."


translate turkish day4_main2_150675b6:


    me "Boş bir kafa olmadığına emin misin?"


translate turkish day4_main2_3e1d421a:


    "Nefesimin altında mırıldandım."


translate turkish day4_main2_76d30161:


    us "Ne dedin sen?"


translate turkish day4_main2_f6290a5b:


    me "Hiçbir şey. Bana bir saniye ver."


translate turkish day4_main2_f0d4eaf6:


    "Hapları ilk açtığım çekmecede buldum."


translate turkish day4_main2_3ae2d123:


    us "Teşekkür ederim, doktor!"


translate turkish day4_main2_d2b56c39:


    "Neşeyle gülümsedi."


translate turkish day4_main2_45c9bd9f:


    "Ulyana'yı izlerken bu kadar iyimser ve aktif bir çocuğun nasıl sağlık sorunları olabileceğini düşünemiyordum."


translate turkish day4_main2_db45ba49:


    "Bana kötü kötü baktı."


translate turkish day4_main2_f3f3ce8a:


    us "Hayır, her şeyi senin için bıraktım!"


translate turkish day4_main2_4323f27c:


    "Ulyana revirden koşarak çıktı ve kapıyı çarptı."


translate turkish day4_main2_bd0d0f91:


    "Belki de bunu söylememeliydim."


translate turkish day4_main2_4196aef5:


    me "Yerel mutfağı düşününce çok da şaşırtıcı değil."


translate turkish day4_main2_f2c43065:


    us "Belki de..."


translate turkish day4_main2_f0d6d1c8:


    "Sırıttı."


translate turkish day4_main2_5c8b5c7d:


    us "Görüyorum ki hâlâ hayattasın ve tekmeliyorsun!"


translate turkish day4_main2_6e98e9f8:


    me "Şikayet etmiyorum."


translate turkish day4_main2_14f237e5:


    us "Hoşça kalın!"


translate turkish day4_main2_4323f27c_1:


    "Ulyana kapıyı çarparak revirden çıktı...."


translate turkish day4_main2_a20cefa7_4:


    "..."


translate turkish day4_main2_dbbcc16f:


    "Tekrar Sovyet moda trendlerini incelemeye geri döndüm."


translate turkish day4_main2_a3a786a7:


    "Zaman geçti ama hemşire hâlâ ortalıkta yoktu."


translate turkish day4_main2_5db604a8:


    "Shurik'i aramıyordum, durumumla ilgili herhangi bir ipucu aramıyordum...{w} sadece oturuyor ve bir dergiye göz gezdiriyordum."


translate turkish day4_main2_900a2743:


    "Bir an için bu durumdan oldukça memnun olduğumu hissettim..."


translate turkish day4_main2_f82c0a74:


    th "Şimdiye kadar burada olan her şey sadece bir yaz kampı gezisi olarak görülebilir ve yakın zamanda hiçbir şey değişmezse endişelenmeye başlayabilirim."


translate turkish day4_main2_cbdcd68a:


    "Yine biri kapıyı çaldı."


translate turkish day4_main2_7c25eaac:


    th "Bir salgının patlak vermesini mi kaçırdım?"


translate turkish day4_main2_482a0501:


    "Slavya kapıda duruyordu."


translate turkish day4_main2_23d59ff0:


    sl "Oh, merhaba! Hemşire burada değil mi?"


translate turkish day4_main2_7f88d310:


    me "Merhaba. Hayır, burada değil. Bugünlük ben devralıyorum."


translate turkish day4_main2_8803d0ca:


    sl "Harika."


translate turkish day4_main2_6e6e30b3:


    "Tereddüt etti."


translate turkish day4_main2_ad02f53a:


    me "Ne oldu?"


translate turkish day4_main2_23a777ed:


    sl "Bu arada, Semyon..."


translate turkish day4_main2_626d4643:


    "dedi Slavya ve dikkatle bana baktı."


translate turkish day4_main2_ad02f53a_1:


    me "Ne oldu?"


translate turkish day4_main2_809b714a:


    sl "Sanırım anahtarlarımı kaybettim. Onları bir yerde gördün mü?"


translate turkish day4_main2_c2f310ec:


    th "Elbette gördüm!"


translate turkish day4_main2_fe5cc028:


    me "Evet, işte, dün kantinin yanında buldum. Onları size geri vermek istedim ama unuttum."


translate turkish day4_main2_7506f80e:


    "Yalan söyleme konusunda gerçekten kötüydüm - yanaklarım kızarmıştı, gözlerim etrafta dolaşıyordu ve ellerim sürekli titriyordu."


translate turkish day4_main2_71a21743:


    me "İşte."


translate turkish day4_main2_01753d9d:


    "Kendimi uygun bir azar için hazırlıyordum ama Slavya sadece anahtarları aldı ve şöyle dedi:"


translate turkish day4_main2_edc3cf97:


    sl "Teşekkürler."


translate turkish day4_main2_1a6d0231:


    me "Peki ne için geldin?"


translate turkish day4_main2_3e086ec1:


    "Gerçekten konuyu değiştirmem gerekiyordu."


translate turkish day4_main2_12a9dd7f:


    me "Acıyan bir şey var mı?"


translate turkish day4_main2_87efefbd:


    sl "Hayır, bir şey yok."


translate turkish day4_main2_06e847e7:


    th "Tuhaf.{w} Slavya gibi açık bir insanın bir şeyi gizli tutacağını düşünmezdim bile."


translate turkish day4_main2_0ca10a35:


    me "Seni rahatsız eden bir şey varsa, söyle bana!{w} Bu yüzden buradayım, insanları tedavi etmek için."


translate turkish day4_main2_ed4f432e:


    "Kocaman gülümsedim."


translate turkish day4_main2_537386e4:


    sl "Hayır...{w} Yani evet, ama hayır."


translate turkish day4_main2_981e60cc:


    "Bunu duymak her şeyi mümkün kıldı, sıfıra bölmeyi bile."


translate turkish day4_main2_d633a8ca:


    me "Size nasıl yardımcı olabilirim?"


translate turkish day4_main2_e2229da3:


    sl "Sen mi? Sanırım edemezsin."


translate turkish day4_main2_d6c3c729:


    "Gülümsedi ve gidecekti ama aniden durdu."


translate turkish day4_main2_0a917d1d:


    sl "Ancak...{w} Bir dakikalığına dışarı çıkabilir misiniz?"


translate turkish day4_main2_9ae266c2:


    th "Neden olmasın?"


translate turkish day4_main2_65bf82fc:


    me "Tamam..."


translate turkish day4_main2_cf1fe9a1:


    "Revirden çıktım ve duvara yaslandım."


translate turkish day4_main2_47737877:


    th "Acaba ne yapıyor olabilir, benim bile göremediğim bir şey mi?"


translate turkish day4_main2_8ee2b602:


    "Bir dakika sonra kapı açıldı ve Slavya dışarı çıktı."


translate turkish day4_main2_00d76af5:


    "Elinde küçük bir bohça vardı."


translate turkish day4_main2_fda5f154:


    me "Neymiş o?"


translate turkish day4_main2_1e8b4779:


    sl "Hiçbir şey!"


translate turkish day4_main2_ac04f5d1:


    "Kızardı."


translate turkish day4_main2_b4db0146:


    sl "Teşekkür ederim!"


translate turkish day4_main2_c46d7c1e:


    me "Bir şey değil."


translate turkish day4_main2_ec475aa3:


    "Slavya kaçtı."


translate turkish day4_main2_0f420061:


    th "Sanırım sormamalıydım."


translate turkish day4_main2_3fc88750_1:


    me "İyi şanslar!"


translate turkish day4_main2_3da1183b:


    "Arkasından bağırdım."


translate turkish day4_main2_309686e8:


    sl "Teşekkür ederim!"


translate turkish day4_main2_a3a10705:


    "Ayrılmadan önce bana o tatlı gülümsemelerinden birini verdi...."


translate turkish day4_main2_a20cefa7_5:


    "..."


translate turkish day4_main2_43b742c4:


    "Saate baktım."


translate turkish day4_main2_12b9bc98:


    "Geç oluyordu, dergiyi baştan sona okumuştum ama hemşire hâlâ gelmemişti."


translate turkish day4_main2_e60481fd:


    "Birden kapı açıldı ve Alisa hızla içeri girdi."


translate turkish day4_main2_8fb93608:


    "Bana delici bir şekilde baktı."


translate turkish day4_main2_24b939bd:


    dv "Ne yapıyorsun burada?"


translate turkish day4_main2_0085f606:


    me "Oturuyorum."


translate turkish day4_main2_9fb02d3f:


    "Dürüstçe itiraf ettim."


translate turkish day4_main2_2b2b99a8:


    dv "Tamam o zaman!{w} Hemşire olmadan daha da iyi."


translate turkish day4_main2_36cead21:


    "Mırıldandı."


translate turkish day4_main2_46efe3f1:


    me "Hasta mısın?"


translate turkish day4_main2_81684e59:


    "Sert bir şekilde sordum."


translate turkish day4_main2_d1591f00:


    "Alisa cevap vermedi ve bana yaklaştı."


translate turkish day4_main2_7693d10f:


    dv "Kenara çekil."


translate turkish day4_main2_7332342b:


    me "Neden?"


translate turkish day4_main2_b86ba02e:


    dv "Çekmeceyi açabileyim diye, belli değil mi!?"


translate turkish day4_main2_29a836d9:


    me "Ne için?"


translate turkish day4_main2_eed3c5aa:


    "Kızdı."


translate turkish day4_main2_b2a1824d:


    dv "Seni ilgilendirmez."


translate turkish day4_main2_d0eeeaf6:


    me "Burada yetkili benim sayılır."


translate turkish day4_main2_60f3d758:


    "Bir an düşündü."


translate turkish day4_main2_f54686ff:


    dv "O zaman bana biraz aktif karbon ver!"


translate turkish day4_main2_f841182c:


    me "Mide ağrısı mı?"


translate turkish day4_main2_3a950d86:


    dv "Evet."


translate turkish day4_main2_1fcb3138:


    "Keskin bir şekilde sırıttı."


translate turkish day4_main2_c5e0f7d5:


    "Burada bir terslik olduğu hissine kapıldım."


translate turkish day4_main2_1cfd6748:


    th "Ama asla bilemezsin...{w} Ya gerçekten bir ağrısı varsa?"


translate turkish day4_main2_01822020:


    me "Tamam."


translate turkish day4_main2_e386270a:


    "Çekmeceye uzandım ve bir paket aktif karbon çıkardım."


translate turkish day4_main2_8526df6e:


    dv "Teşekkürler!"


translate turkish day4_main2_b7cee3ff:


    "Elimden aldı ve kaçtı."


translate turkish day4_main2_952420fb:


    me "Gerçekten mi, karın ağrısı mı?"


translate turkish day4_main2_e6d2dba1:


    dv "Gerçekten mi?"


translate turkish day4_main2_494cb28f:


    me "Pek öyle görünmüyor."


translate turkish day4_main2_30d58c19:


    dv "Ne yani, bana inanmanız için öğle yemeğimi her yere mi atmam gerekiyor?"


translate turkish day4_main2_5052e4e8:


    me "Aktif karbonla ne gibi korkunç şeyler yapılabileceğini bilmiyorum ama eminim aklınıza bir şeyler gelecektir!"


translate turkish day4_main2_6e6e30b3_1:


    "Tereddüt etti."


translate turkish day4_main2_2e830d48:


    dv "Peki ya haklıysan?"


translate turkish day4_main2_ccdea9ff:


    me "İşte!{w} Biliyordum!{w} O zaman sana kesinlikle hiçbir şey vermeyeceğim!"


translate turkish day4_main2_422e86f8:


    "Alisa çekmecelere ulaşmaya çalıştı ama ben Alexander Matrosov gibi göğsümle hap kutusunu kapattım."


translate turkish day4_main2_da695243:


    "Tüm küstahlığına rağmen o hâlâ bir kızdı ve beni kenara itme şansı yoktu."


translate turkish day4_main2_672c3026:


    dv "Her neyse! Başka bir yerde bulurum."


translate turkish day4_main2_4a53f5ef:


    "Arkasını döndü ve çıkışa yöneldi."


translate turkish day4_main2_579e0280:


    "Alisa kapıda durdu ve arkasına baktı."


translate turkish day4_main2_40117237:


    dv "Bu arada, kamp lideri ve hemşire bacağı kırık bir öncüyü taşıyorlar{w} Gerçekten umurumda değil, ama mücadele ediyor gibi görünüyorlar."


translate turkish day4_main2_9f4cd3fa:


    me "Evet, tabii!"


translate turkish day4_main2_9aa2cf7a:


    dv "Gel de kendin gör."


translate turkish day4_main2_0f163ab9:


    "Alisa yalan söylüyor gibiydi ama öte yandan, onu görebildiğim sürece..."


translate turkish day4_main2_4ecdd924:


    "Kapıya geldim ve dışarı baktım. Kimse yoktu."


translate turkish day4_main2_c0277722:


    me "Tam olarak nerede?"


translate turkish day4_main2_83ca7233:


    dv "O zaman henüz buraya ulaşmadılar."


translate turkish day4_main2_4a9b3777:


    "Çaresiz bir hareket yaptı."


translate turkish day4_main2_df8028e5:


    dv "İyi eğlenceler!"


translate turkish day4_main2_eeae4ddf:


    "Masaya döndüm ve ancak o zaman çekmecelerden birinin açık olduğunu fark ettim."


translate turkish day4_main2_d82dccfe:


    th "Nasıl bu kadar çabuk yapabildi?!"


translate turkish day4_main2_26b03227:


    th "Bir saniyeliğine arkamı döndüm."


translate turkish day4_main2_5992178b:


    th "Aktif karbondan ne kötülük gelebilir ki?"


translate turkish day4_main2_a20cefa7_6:


    "..."


translate turkish day4_main2_22f56cd3:


    "Yemeğe 15 dakika vardı ve hemşire hala dönmemişti."


translate turkish day4_main2_26c2ca6d:


    th "Sanırım burayı bu şekilde bırakmak olmaz."


translate turkish day4_main2_5cce2231:


    th "Ne de olsa benden buraya göz kulak olmamı istedi."


translate turkish day4_main2_259b8764:


    th "Ayrılırsam ne olacağını kim bilebilir?"


translate turkish day4_main2_96201ae8:


    th "Gerçi kim buradan bir şey çalmak ister ki?"


translate turkish day4_main2_084da37b:


    th "Alisa'nın aktif karbon çalması dışında..."


translate turkish day4_main2_2f835300:


    "Dergiyi tekrar açtım ve dokuzuncu kez karıştırmaya başladım."


translate turkish day4_main2_c423f302:


    "Seksenli yılların modası artık o kadar da eğlenceli değildi."


translate turkish day4_main2_9cba9e2a:


    "Esnemek beni birkaç kez yakaladı."


translate turkish day4_main2_b3a0bc3f:


    "Saat çoktan altı olmuştu, yani akşam yemeği çoktan başlamıştı."


translate turkish day4_main2_154cf8b8:


    "Tabii ki sonuna kadar nöbet tutmam gerekiyordu ama midemin bu konuda kendi fikri var gibiydi."


translate turkish day4_main2_fa7b39d4:


    "Ayağa kalktım ve kararlı adımlarla çıkışa yöneldim."


translate turkish day4_main2_172df4fa:


    "Kapının arkasından bir hışırtı sesi geldi."


translate turkish day4_main2_0360cdef:


    th "Zehirlenen, kolunu kıran ya da daha kötü bir şey yapan başka biri olabilir miydi?"


translate turkish day4_main2_dfc8fcaa:


    "Derin bir iç çektim ve kapı kolunu çektim."


translate turkish day4_main2_4fcedea9:


    "Ancak dışarıda kimse yoktu."


translate turkish day4_main2_c5913e31:


    "Görünüşe göre bu sadece benim hayal gücümmüş."


translate turkish day4_main2_63fae2b6:


    "İçeri döndüm ve revirde bir şeylerin değiştiğini hemen fark ettim."


translate turkish day4_main2_fc8152bc:


    "Daha doğrusu, masanın üzerinde bir elma belirmişti."


translate turkish day4_main2_166e21e4:


    th "Ama nereden?"


translate turkish day4_main2_263f36e7:


    "Meyveler kendiliğinden havadan gelemez, değil mi?"


translate turkish day4_main2_7f119004:


    "Gerçi bu kampta her şey mümkün."


translate turkish day4_main2_8c3d5b7c:


    "Muhtemelen biri onu buraya getirmiştir."


translate turkish day4_main2_a3f9bd63:


    "Belki Lena bana teşekkür etmek istemiştir."


translate turkish day4_main2_c9e3d9e8:


    th "Utangaç ve..."


translate turkish day4_main2_60cc7919:


    th "Ama bekle!{w} Beni nasıl böyle geçebilir?"


translate turkish day4_main2_91c185e1:


    th "Ne de olsa Lena pencereden tırmanmazdı!"


translate turkish day4_main2_598572e0:


    th "Öyleyse başka bir şey olmalı..."


translate turkish day4_main2_a705caba:


    "Birden korkuya kapıldım."


translate turkish day4_main2_c2d327f7:


    th "Ya elma zehirliyse?"


translate turkish day4_main2_7cd7e93e:


    "Gerçi ben burada tamamen çaresizken ve çok daha kolay öldürülebilecekken neden biri işleri zorlaştırsın ki?"


translate turkish day4_main2_dea7837b:


    th "Ya da! Havva'nın Cennet Bahçesi'nde tattığı elma olabilir mi?"


translate turkish day4_main2_74f2512f:


    th "Bu durumda onu kesinlikle yememeliydim!"


translate turkish day4_main2_efaf11ed:


    "Aynı anda midem haince guruldayarak bana orada olduğunu hatırlattı."


translate turkish day4_main2_0aeb7b69:


    th "Oysa reviri kapatmak, kantine ulaşmak, yemek almak zaman alacaktı..."


translate turkish day4_main2_1f01a97c:


    "Midem kendini yemek üzere."


translate turkish day4_main2_7e26087d:


    th "Sanırım yanlış bir şey yok..."


translate turkish day4_main2_49800ad1:


    "Bir kez daha, bu elmanın daha önce burada olup olmadığını hatırlamaya çalıştım."


translate turkish day4_main2_4d50734a:


    th "Sonunda, bir yerden çıkmış olmalıydı!"


translate turkish day4_main2_9c6489f9:


    th "Belki de buraya pencereden gelmiştir?"


translate turkish day4_main2_20f7d3af:


    "Panjur hafifçe açıktı."


translate turkish day4_main2_74cca6f2:


    th "Yani, biri uzanıp onu buraya koymuş olmalı."


translate turkish day4_main2_ec09e77a:


    th "Ciddi bir şey değil! Ancak..."


translate turkish day4_main2_02c83bbb:


    "Sonunda açlık galip geldi ve olgun yeşil elmayı iştahla çiğnemeye başladım."


translate turkish day4_main2_cab5f253:


    "Tadı normal görünüyordu."


translate turkish day4_main2_cd98f167:


    th "Gerçi en güçlü zehrin bile tadının alınabileceğini sanmıyorum."


translate turkish day4_main2_b6572b50:


    th "Ama bunu düşünmek için çok geç..."


translate turkish day4_main2_582156c4:


    th "Hayır!{w} Bunun normal bir elma olduğunu varsaysak bile, her halükarda yıkanmamış meyveleri yememeliyim!"


translate turkish day4_main2_0b227b4a:


    th "İşte böyle..."


translate turkish day4_main2_f6b3f760:


    "Korkum için bir neden buldum ve elmayı kaldırdım."


translate turkish day4_main2_38770f6e:


    "Akşam yemeğine gitme vakti gelmişti."


translate turkish day4_main2_13514a11:


    "Yolda Electronik'e rastladım."


translate turkish day4_main2_9e8d764f:


    me "Nasıl gidiyor? Shurik'i buldun mu?"


translate turkish day4_main2_c6d96820:


    el "Hayır, hala ondan bir iz yok..."


translate turkish day4_main2_0228ef23:


    me "Endişelenme...{w} Onu bulacağız!"


translate turkish day4_main2_257dff95:


    "Onu neşelendirmeye çalıştım."


translate turkish day4_main2_d1dd1c27:


    el "Çok fazla zaman geçti!{w} Aramaya devam edeceğim."


translate turkish day4_main2_6ffcae27:


    me "Akşam yemeği ne olacak?"


translate turkish day4_main2_2b8d0068:


    el "Hayır, Shurik'i bulmak daha önemli."


translate turkish day4_main2_a1983f0e:


    "Düşünceli bir şekilde mırıldandı."


translate turkish day4_main2_0470832e:


    "Onu kavşakta bıraktım ve iyi şanslar diledim."


translate turkish day4_main2_00f424c0:


    "Öncüler kapının önünde toplanmıştı."


translate turkish day4_main2_9219d4ed:


    "En azından bugün için sıradaki son kişi olmamaya çalışarak hızımı artırdım."


translate turkish day4_main2_29a4258a:


    "Ve şanslıydım - uzak köşede tamamen boş bir masa vardı."


translate turkish day4_main2_5d928b01:


    "Hemen yemeğimi aldım ve masaya oturdum."


translate turkish day4_main2_dffdc57f:


    "Bu akşamki yemek meyve çorbası ve bir çift çörekten oluşuyordu."


translate turkish day4_main2_eac59148:


    "Bu set ilk başta beni şaşırttı ama tadı gerçekten güzeldi."


translate turkish day4_main2_e2cd40bb:


    "Yemeye konsantre oldum."


translate turkish day4_main2_c81cbbaa:


    mi "Lena, buraya gidelim! Bak - üç boş sandalye!"


translate turkish day4_main2_8bd763eb:


    "Lena ve Miku önümde durdular."


translate turkish day4_main2_e140e52b:


    un "Bunlar alınmış mı?"


translate turkish day4_main2_0a28548a:


    "Lena merak etti."


translate turkish day4_main2_82cf5563:


    me "Hayır, oturun."


translate turkish day4_main2_e8b7b6b4:


    th "Tabii ki, yalnız olmasını isterdim."


translate turkish day4_main2_082d3571_2:


    un "Teşekkür ederim..."


translate turkish day4_main2_f1ccf9dd:


    "Lena bunu söyler söylemez Zhenya arkasından atladı."


translate turkish day4_main2_2ab6d036:


    mz "Buraya oturacağım. Hiç yer kalmadı."


translate turkish day4_main2_11d6a6d3:


    "Dedi, tepsisini masaya koydu ve cevabımı bile beklemeden oturdu."


translate turkish day4_main2_46957efa:


    me "Elbette. Kendini evinde hisset..."


translate turkish day4_main2_596d1d03:


    "Üzüntüyle mırıldandım."


translate turkish day4_main2_6fa187e2:


    mz "Ne?!"


translate turkish day4_main2_cfaa423d:


    me "Hiçbir şey..."


translate turkish day4_main2_1830a553:


    "Doğruyu söylemek gerekirse, ne Miku ne de Zhenya fazla sorun çıkarmasa da tüm şirketi sadece Lena'ya indirgemek istedim."


translate turkish day4_main2_eea06034:


    "Yalnızca biri çok konuşkan, diğeri de çok kibirliydi."


translate turkish day4_main2_1ffd1a45:


    th "Ama yine de kesinlikle zararsızlardı, özellikle de sayabileceğim diğerlerine kıyasla."


translate turkish day4_main2_0a276ba6:


    un "Görünüşe göre anahtarımı unutmuşum."


translate turkish day4_main2_1236c393:


    mi "Merak etme, benimkini al!"


translate turkish day4_main2_39b90d94:


    "Miku'nun kısa cevabı beni şaşırttı."


translate turkish day4_main2_b6287b9f:


    me "Siz...{w} birlikte mi yaşıyorsunuz?"


translate turkish day4_main2_94800851:


    mi "Tabii ki! Bilmiyor muydun? Birlikte. Bizim kabinimiz en arkada. Yani buradan en uzakta. Yani sonuncusu."


translate turkish day4_main2_0d57a898:


    "Birisi bana Lena'nın Slavya ile ya da en kötü ihtimalle Zhenya ile yaşadığını söyleseydi şaşırmazdım{w} hatta Electronik ile bile."


translate turkish day4_main2_c29a6bc8:


    th "Ama sessiz ve utangaç Lena ve aşırı konuşkan Miku bir çift olarak...{w}Bu gerçekten bir sürpriz!"


translate turkish day4_main2_670ca875:


    mz "Shurik'i buldun mu?"


translate turkish day4_main2_40a04971:


    "Zhenya'nın birinin sorunlarından rahatsız olması garip."


translate turkish day4_main2_5a7a7577:


    me "Hayır, hayır, hayır."


translate turkish day4_main2_f9068a33:


    mz "Herhalde köyde sigara alıyordur. Ya da votka."


translate turkish day4_main2_58ae4528:


    "Kadın homurdandı."


translate turkish day4_main2_e9d77940:


    me "Köy mü?"


translate turkish day4_main2_d535d09a:


    "O anda sohbet çok daha ilginç bir hal aldı."


translate turkish day4_main2_86a5cb53:


    mz "Köylerle bir sorununuz mu var?"


translate turkish day4_main2_1490cc40:


    "Zhenya şaşırmış görünüyordu."


translate turkish day4_main2_fd219846:


    me "Yani yakınlarda bir köy mü var?"


translate turkish day4_main2_429609fe:


    mz "Sanırım öyle..."


translate turkish day4_main2_858becb4:


    "Kararsızca söyledi."


translate turkish day4_main2_31ee18ee:


    "Lena ve Miku'ya baktım ama yemekleriyle meşguldüler ve konuşmamıza dikkat etmediler."


translate turkish day4_main2_9e200e27:


    me "Yani tam olarak bilmiyor musun?"


translate turkish day4_main2_2c01aece:


    mz "Neden umursayayım ki!?"


translate turkish day4_main2_b265fe1c:


    "Zhenya tabağına baktı."


translate turkish day4_main2_3a65b125:


    me "Ama yakında bir şey olmalı."


translate turkish day4_main2_e76c967c:


    mz "Dinle."


translate turkish day4_main2_a2516dfe:


    me "Dinliyorum."


translate turkish day4_main2_391fb882:


    mz "Bilmiyorum! Yememe izin verecek misin!?"


translate turkish day4_main2_76b07f1d:


    th "Görünüşe göre ondan bir şey alamayacağım."


translate turkish day4_main2_b71b185c:


    "Gerçi gerçekten bilmiyor olma ihtimali de var..."


translate turkish day4_main2_91e6868c:


    "Kalan zaman Miku'nun saçma sapan konuşmalarını dinleyerek geçti. Sessizlik içinde yavaş yavaş deliriyordum."


translate turkish day4_main2_7c2f2de1:


    "Açıkçası, dışarı çıktıktan sonra yaptığım ilk şey temiz havayı içime çekmek oldu."


translate turkish day4_main2_ef1b28a4:


    "Güneş batıyordu."


translate turkish day4_main2_153cf25d:


    th "Yürüyüşe çıkmaya karar verdim."


translate turkish day4_main2_2c803352:


    th "Gecenin geri kalanında yapacak daha heyecan verici bir şey bulmam pek olası değil. Bu şekilde beklenmedik bir anda ilginç bir şey ortaya çıkabilir."


translate turkish day4_main2_441bd7cd:


    "Meydana yaklaşırken büyük bir patlama duydum{w} sanki bir şey patlamış gibiydi."


translate turkish day4_main2_2c4a9213:


    "Felç olmuştum."


translate turkish day4_main2_9abc32b1:


    th "Düşmanca bir ortamdayım, buranın kurallarını ve yasalarını bilmiyorum!"


translate turkish day4_main2_e35e500a:


    th "Kaçmak benim için daha iyi olurdu!{w} Ama aynı zamanda çok da meraklıydım..."


translate turkish day4_main2_f6711c85:


    "Muhtemelen orada öylece durmaya devam edecektim ama biri elimi tuttu."


translate turkish day4_main2_db010348:


    "Olga Dmitrievna'ydı."


translate turkish day4_main2_7cc1e65d:


    mt "Neden burada dikiliyorsun? Gidip ne olduğunu görelim!"


translate turkish day4_main2_51893c59:


    me "Bensiz hiç idare edemez misin?"


translate turkish day4_main2_df9d9f60:


    "Ona acıyarak yalvardım."


translate turkish day4_main2_92fa383c:


    mt "Umarım ciddi bir şey değildir!"


translate turkish day4_main2_723aed67:


    "Meydana geldiğimizde öncülerden oluşan bir kalabalık vardı."


translate turkish day4_main2_0b603c9e:


    "Olga Dmitriyevna kalabalığı şiddetle yararak olay yerine yaklaştı."


translate turkish day4_main2_c9d63825:


    "Belli ki birileri Genda'yı havaya uçurmaya çalışmıştı."


translate turkish day4_main2_7a693237:


    "Ancak saldırganlar başarısız olmuş, anıt hâlâ dimdik ayakta duruyordu."


translate turkish day4_main2_f15dbe9c:


    "Kaidede sadece soluk kül izleri vardı."


translate turkish day4_main2_466f41f2:


    mt "Peki, bunu kim yaptı?"


translate turkish day4_main2_fe6f2470:


    "Öncülerin oluşturduğu kalabalığa baktı."


translate turkish day4_main2_588fe4a7:


    "Herhalde bunu organize bir terör örgütü yapmamıştı."


translate turkish day4_main2_dcd82f25:


    "Bu adamların hepsi buraya sadece ne olduğuna bakmak için geldi."


translate turkish day4_main2_1da09f52:


    "Kalabalığın içinde Ulyana ve Alisa'yı fark ettim. Görünüşe göre kamp liderimiz de onları fark etmiş."


translate turkish day4_main2_fdaff1c2:


    mt "Siz ikiniz, buraya gelin!"


translate turkish day4_main2_c276a464:


    "İsteksizce yaklaştılar."


translate turkish day4_main2_4013aec6:


    us "Neden hep ben?"


translate turkish day4_main2_ac0e5120:


    dv "Eğer öyle düşünüyorsan..."


translate turkish day4_main2_f8a4a1d3:


    mt "Bana ellerini göster, Dvachevskaya!"


translate turkish day4_main2_0c3815a2:


    dv "Nesi var bunların?"


translate turkish day4_main2_a967cbc5:


    "Yakından baktım ve siyaha bulanmış olduklarını gördüm."


translate turkish day4_main2_6914b9a6:


    mt "Şimdi anlaşıldı...{w} Neyle bomba yaptınız?!"


translate turkish day4_main2_74595ca6:


    "Küçük terörist itiraf edip etmeme konusunda tereddüt eder gibi oldu ama sonra gururla ağzından kaçırdı:"


translate turkish day4_main2_73fdb6c9:


    dv "Aktif karbon, güherçile ve sülfür!"


translate turkish day4_main2_e3192dfb:


    th "Bir dakika!{w} Karbon!{w} İlk yardım çantasından çaldığı karbon!"


translate turkish day4_main2_2d58bb92:


    mt "Bu onurlu adam sana ne yaptı? İnsan hakları için savaşan..."


translate turkish day4_main2_23e3015c:


    dv "Ayrıca, bana aktif karbon verdi."


translate turkish day4_main2_276a218b:


    "Parmağıyla beni işaret etti. Bütün meydan bana baktı."


translate turkish day4_main2_034b00d2:


    "Bombanın küçüklüğü nedeniyle bu eylemin anlamsızlığına dair düşünceler tam o anda beni terk etti."


translate turkish day4_main2_a6f5f832:


    me "O çaldı! Ben hiçbir şey yapmadım!"


translate turkish day4_main2_978d7670:


    mt "Sana vermiş olsa bile, Semyon'un böyle iğrenç bir antisosyal davranışa asla katılmayacağından eminim!"


translate turkish day4_main2_e7ed10ff:


    me "Evet! Evet! Kesinlikle!"


translate turkish day4_main2_d3ec559b:


    "Kabul ettim......."


translate turkish day4_main2_a20cefa7_7:


    "..."


translate turkish day4_main2_a20cefa7_8:


    "..."


translate turkish day4_main2_d88f4446:


    "Electronik tam o anda bağırarak ortaya çıkmasaydı Alisa'yı ne kadar azarlamaya devam edeceğini hayal bile edemiyordum:"


translate turkish day4_main2_e6b5d4f7:


    el "Buldum onu! Buldum!"


translate turkish day4_main2_a09465a1:


    "Herkes ona doğru döndü."


translate turkish day4_main2_50ceb1d4:


    "Elinde bir çizme tutuyordu."


translate turkish day4_main2_16b80206:


    el "İşte!"


translate turkish day4_main2_b9a254c5:


    "Electronik övünerek başının üzerinde salladı"


translate turkish day4_main2_11da0634:


    el "Bu Shurik'in botu!"


translate turkish day4_main2_c764847f:


    mt "Tamam, sakin ol!{w} Bize onu nerede bulduğunu detaylıca anlat!"


translate turkish day4_main2_a425fd4f:


    el "Ormanda.{w} Eski kampa giderken!"


translate turkish day4_main2_13dffab5:


    "Öncülerin arasında fısıltılar dolaşıyordu."


translate turkish day4_main2_8c7b2ad8:


    all "Eski kamp. Eski kamp."


translate turkish day4_main2_d3e8a3d1:


    mt "Emin misin?"


translate turkish day4_main2_d0c3eb6a:


    el "Kesinlikle eminim!"


translate turkish day4_main2_438450d6:


    me "Bu eski kampı bu kadar özel yapan ne?"


translate turkish day4_main2_37372bdb:


    "Sohbete ben de katıldım."


translate turkish day4_main2_1b61865c:


    mt "Özel bir şey değil, gerçekten..."


translate turkish day4_main2_49a81686:


    "Kekeledi."


translate turkish day4_main2_91c692ef:


    el "Sovyonok'un efsanelerinden biri genç bir kamp liderinin hayaletinin orada yaşadığını anlatır. Bir öncüye aşık olmuş ama öncü onu reddetmiş ve bu yüzden kendini öldürmüş..."


translate turkish day4_main2_417824db:


    us "Bir mutfak bıçağıyla harakiri yaptı. Ertesi gün o çocuğa bir otobüs çarptı!"


translate turkish day4_main2_98631528:


    "Ulyana kalabalığın arasından koşarak çıktı."


translate turkish day4_main2_5eb46b8b:


    me "Otobüs mü?"


translate turkish day4_main2_94dec8ff:


    "Güzergah numarasını sormaktan kaçındım."


translate turkish day4_main2_8e90eaa7:


    el "Ama bilim hayaletlerin varlığını kabul etmiyor. Yani korkacak bir şeyimiz yok."


translate turkish day4_main2_2d8001fb:


    mt "Her neyse, birileri oraya gitmeli!"


translate turkish day4_main2_4ab0957c:


    "Birden kalabalık azalmaya başladı."


translate turkish day4_main2_957e36e8:


    sl "Olga Dmitrievna, neredeyse gece oldu. Belki yarın?"


translate turkish day4_main2_51b9d15d:


    "Arkamı döndüm ve Slavya ile Lena'yı gördüm."


translate turkish day4_main2_f8e498d7:


    mt "Ya gece...{w} Ya gece ona bir şey olursa...?{w} Hayır! Bugün! Şu anda!"


translate turkish day4_main2_ddc6851f:


    me "Bu arada, burası neresi?"


translate turkish day4_main2_747f2d95:


    "Electronik bana kabaca yol tarif etti ve eski kampın hikayesini anlattı."


translate turkish day4_main2_cb78152f:


    "Kamp lideri bana dikkatle baktı,"


translate turkish day4_main2_3ac0f1ea:


    me "Eğer benim..."


translate turkish day4_main2_e13e7c4b:


    mt "Buradaki tek erkek sensin."


translate turkish day4_main2_81abb051:


    "Etrafa bakındım."


translate turkish day4_main2_db2e005d:


    th "Tabii ki...{w} Electronik hemen kaçtı!"


translate turkish day4_main2_0bb42214:


    "Yine de ormanda tek başıma yürümek istemedim."


translate turkish day4_main2_eba0fa62:


    "Bana sorarsan, ben..."


translate turkish day4_main2_83894804:


    "Ne diyorum ben?{w} Neden benimle gelsin ki...?"


translate turkish day4_main2_a89ae039:


    th "Kabul edecek mi?"


translate turkish day4_main2_69f37ce2:


    "Slavya'ya baktım."


translate turkish day4_main2_22e7806d:


    "Bana hiç dikkat etmedi."


