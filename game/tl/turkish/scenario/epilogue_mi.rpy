translate turkish epilogue_mi_b362f783:


    ma "Neden her şey eskisi gibi olamıyor?"


translate turkish epilogue_mi_d70ebca4:


    my "Nasıl yani?"


translate turkish epilogue_mi_00d724da:


    ma "Hadi ama..."


translate turkish epilogue_mi_02c9d340:


    my "Bu ortak bir karardı, biliyorsun."


translate turkish epilogue_mi_ea890fe1:


    ma "Ama yine de..."


translate turkish epilogue_mi_e9145191:


    "Kollarını belime doladı ve kendimi daha da huzursuz hissettim."


translate turkish epilogue_mi_b97bb617:


    ma "Buraya neden gelmiştik ki?"


translate turkish epilogue_mi_2baba03c:


