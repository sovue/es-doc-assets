translate turkish zhenya_route_bbafbb40:


    "Muhtemelen birkaç kaburga kemiğimi kırdım ya da tam tersine sadece birkaçı sağlam kaldı."


translate turkish zhenya_route_6dc32eb8:


    "Her hareket içimde keskin bir acı gibiydi:"


translate turkish zhenya_route_3f894e04:


    pi "Yyyyy! Daha dikkatli olamaz mısın?"


translate turkish zhenya_route_d9ee0e49:


    unp "Üzgünüm."


translate turkish zhenya_route_f99441c3:


    "Öncü kız beni çok gayretle soymaya başladı."


translate turkish zhenya_route_47c8c54f:


    "Sonunda sadece şortla kaldım."


translate turkish zhenya_route_b9d2f671:


    unp "Şimdi onu iyotlamalıyız, dezenfekte etmeliyiz!"


translate turkish zhenya_route_80692109:


    pi "Evet, evet, böylece bir boz ayı gibi mi görünebilirim? Hayır, hadi peroksit kullanalım - çekmecede var."


translate turkish zhenya_route_259d7d24:


    "Öncü tartışmadı."


translate turkish zhenya_route_edaff1f2:


    "Ancak hem peroksit hem de iyot aynı şekilde yakar!"


translate turkish zhenya_route_208736c6:


    "Çığlık atmamak için insanüstü bir çaba harcamak zorunda kaldım."


translate turkish zhenya_route_e6e5397a:


    unp "Acıtıyor mu?"


translate turkish zhenya_route_62a68b8d:


    pi "Ne düşünüyorsun?!"


translate turkish zhenya_route_b462f311:


    "Dişlerimin arasından tısladım."


translate turkish zhenya_route_5d12af1f:


    "Sonra öncü kız beni sarmaya başladı."


translate turkish zhenya_route_c4e8acee:


    "Ne zaman diğer taraftan bandajı almak zorunda kalsa, kendini neredeyse bana iyice bastırıyordu."


translate turkish zhenya_route_a847a4e2:


    unp "Hadi bakalım!"


translate turkish zhenya_route_c8bb1a19:


    "Bunu başarma duygusuyla söyledi."


translate turkish zhenya_route_64313f9e:


    "Aşırı hareket - kafamın içinden geçti."


translate turkish zhenya_route_909f6f6a:


    pi "Evet, bu daha iyi."


translate turkish zhenya_route_6cdbc3d5:


    "Kendimi gerçekten daha iyi hissettiğimden değil ama yarın neredeyse sağlıklı olacağıma dair daha güvenliydim."


translate turkish zhenya_route_98db5fc7:


    "Ancak bu yarındır."


translate turkish zhenya_route_ed2b786e:


    "Ecza dolabına gitmek için kalkmaya çalıştım ama aniden başım döndü ve tekrar kanepeye oturmak zorunda kaldım."


translate turkish zhenya_route_4d858608:


    pi "Bana biraz analgin getir ve...{w} ve...{w} peki, bu..."


translate turkish zhenya_route_521a590f:


    "Yerel ilk yardım çantasının içindekileri gerçekten unuttum mu?"


translate turkish zhenya_route_ed40cc8c:


    "Elimi alnıma götürdüm - yanıyordu."


translate turkish zhenya_route_cc8f0f79:


    pi "Tetanos için bir şey bilmiyorum. Orada talimat olduğu yazıyor."


translate turkish zhenya_route_c61d4c44:


    "Kız telaşlanmaya başladı ve çok geçmeden bana bir avuç dolusu çok renkli tablet getirdi."


translate turkish zhenya_route_38a2fca3:


    pi "Bu nedir?"


translate turkish zhenya_route_cb469a4d:


    unp "Sorduğun gibi..."


translate turkish zhenya_route_27722bff:


    "Elbette risk alıyordum ama daha kötüsü de olamazdı."


translate turkish zhenya_route_f93b1c3f:


    pi "Ve içmek için su."


translate turkish zhenya_route_1cbefc66:


    "Hapları yuttum ve güçlükle kanepeye uzandım."


translate turkish zhenya_route_7e492c7f:


    "Öncü yakınlardaki bir sandalyeye oturdu ve beklentiyle bana baktı."


translate turkish zhenya_route_45d6e425:


    "Ne istiyor ki?"


translate turkish zhenya_route_c822b5dc:


    "Bilinmeyen yorucuydu."


translate turkish zhenya_route_434288d8:


    "Sadece uyumak, kendimi kapatmak ve bir süreliğine bu çılgın dünyayı unutmak istedim.{w} Ya da daha iyisi, farklı bir dünyada uyanmak!"


translate turkish zhenya_route_58911e68:


    "Bırakın başladıkları işi bitirsinler, beni bitirsinler!"


translate turkish zhenya_route_67aba564:


    "Ya da bu utangaç kız..."


translate turkish zhenya_route_0f6e53e3:


    pi "Daha ne kadar böyle oturmayı planlıyorsun?"


translate turkish zhenya_route_1691f095:


    unp "Eğer yolunuza çıkarsam, gidebilirim."


translate turkish zhenya_route_6e477f3d:


    pi "Hayır, sen engel değilsin."


translate turkish zhenya_route_57115d23:


    "Aniden kafamda çılgın ama aynı zamanda anlamsız olmayan bir fikir doğdu!"


translate turkish zhenya_route_5857b475:


    pi "Hatta yardım bile edebilirsin..."


translate turkish zhenya_route_2cf6cc0c:


    "Öncü bana soru sorarcasına baktı."


translate turkish zhenya_route_f7b1fdd6:


    pi "Şu kavanozu al, gördün mü?"


translate turkish zhenya_route_e2b2bbba:


    "Elimi güçlükle kaldırdım ve parmağımı gerekli ilaca doğrulttum."


translate turkish zhenya_route_b0d079f8:


    pi "Şimdi oradan dolu bir şırınga al."


translate turkish zhenya_route_a20cefa7_5:


    "..."


translate turkish zhenya_route_30fbce41:


    mz "Peki sen ciddi misin?"


translate turkish zhenya_route_46df7f73:


    "Zhenya'nın yüzü yanıyordu ve sesi şaşırmış bile değildi; korkmuştu!"


translate turkish zhenya_route_763ea9a0:


    me "Oldukça!"


translate turkish zhenya_route_f35360cc:


    mz "Hayır kesinlikle aklını kaçırmışsın!"


translate turkish zhenya_route_e4748fd7:


    me "Bu kadar büyütecek ne var? En azından birkaç gün içinde - yeni bir tur ve kimse bunu hatırlamayacak."


translate turkish zhenya_route_bb4cc545:


    mz "Hatırlayacağım - bu kadar yeter!"


translate turkish zhenya_route_39419e54:


    me "Yani cevabın hayır mı?"


translate turkish zhenya_route_c6cacbe6:


    mz "Cevabım benimle dalga geçmeyi bırak!"


translate turkish zhenya_route_af512106:


    "Ayağa kalkmaya çalıştı ama kollarını sıkıca tuttum."


translate turkish zhenya_route_fe1f361c_2:


    mz "Hey!"


translate turkish zhenya_route_3d06e455:


    "Zhenya kaçmaya çalışmak yerine güldü ve bana sıkıca sarıldı."


translate turkish zhenya_route_96a92f4a:


    mz "Şaka yapmadığına emin misin? Peki ya buradan çıkarsak?"


translate turkish zhenya_route_3b02a616:


    me "Uzun zamandır bu konu hakkında konuşmadın."


translate turkish zhenya_route_7761d947:


    mz "Söylemedim ama şimdi söylüyorum! Eğer gerçek dünyada unutmayı ve şu anda hiçbir şey söylememiş gibi davranmayı umuyorsan, o zaman..."


translate turkish zhenya_route_d2551cd3:


    me "Hayır, hem burada hem de gerçek dünyada sözlerim samimidir!"


translate turkish zhenya_route_5f3b8e22:


    mz "Neyse...{w} Kontrol etmek çok zor! Yani aniden..."


translate turkish zhenya_route_0af1865c:


    me "Bunda bu kadar ani olan ne? Birbirimizi ne zamandır tanıyoruz? Dönüşlerin sayısını çoktan unuttum."


translate turkish zhenya_route_618d05b1:


    mz "Ve sanırım..."


translate turkish zhenya_route_3129f2d7:


    "Zhenya sessizce söyledi ve bana daha da sıkı sarıldı."


translate turkish zhenya_route_ce617998_17:


    "…"


translate turkish zhenya_route_c4a91b1d:


    "Öncü itaatkar bir şekilde şırıngayı renksiz şeffaf bir sıvıyla doldurdu ve bana verdi."


translate turkish zhenya_route_0fda54f1:


    pi "Hayır, hastanın kendi kendine enjeksiyon yaptığı nerede görülmüş!"


translate turkish zhenya_route_27de15a6:


    unp "Ama nasıl olduğunu bilmiyorum."


translate turkish zhenya_route_954d7da0:


    pi "Evet, burada karmaşık bir şey yok."


translate turkish zhenya_route_23affce2:


    "Benim için bu dünyada hâlâ tek bir tabu vardı: intihar."


translate turkish zhenya_route_0cffd3d6:


    "Çıldırmış öncülerin ellerinde ya da zehirli iğneyle ölmeye hazırdım (ve hatta istedim), ama intihar etmek..."


translate turkish zhenya_route_cee6910e:


    "Bazı nedenlerden dolayı bana imkansız gibi geldi, nedenini gerçekten açıklayamadım ve asla kontrol etmeye çalışmadım."


translate turkish zhenya_route_7742b1d1:


    "Belki de son yirmi dört saat içinde beni yeni bir güçle saran bilinmeyenin korkusuydu ya da belki daha basitti ve nedeni sıradan bir kendini koruma içgüdüsüydü."


translate turkish zhenya_route_d3f91d78:


    "Öyle olsa bile, eğer beni başka biri öldürürse hemen yeni bir turda uyanacağımdan ama zaten her şeye hazır olacağımdan emindim!"


translate turkish zhenya_route_be57257f:


    "Tek sorun şu ki, bu kız açıkça bu hayattan gönüllü olarak ayrılmama yardım etmeyecekti."


translate turkish zhenya_route_75512fb4:


    unp "Hayır, ben...{w} Ya yanlış bir şey yaparsam? Hemşireyi arasan iyi olur! Hemen döneceğim, döneceğim."


translate turkish zhenya_route_f085d7c6:


    "Burada yeterince hemşire yoktu!"


translate turkish zhenya_route_12645575:


    pi "Bekle!"


translate turkish zhenya_route_58ec471e:


    "Dirseğimin üzerinde zorlukla doğruldum ve elini tuttum."


translate turkish zhenya_route_9f0b1268:


    pi "Korkma; bunu yüzlerce kez yaptım ve sana öğreteceğim! O kadar da zor değil."


translate turkish zhenya_route_8d3cf7f8:


    "Kız tereddüt etti."


translate turkish zhenya_route_80585789:


    pi "Önce turnike yap..."


translate turkish zhenya_route_150c2823:


    "Hayır, turnikeye ihtiyacı yok. Kan alınırken turnikeye ihtiyacı var."


translate turkish zhenya_route_43e5513f:


    pi "Tamam, turnike yapma."


translate turkish zhenya_route_dcfbef84:


    "Öncü kız turnikeyi yanımdaki masaya koydu."


translate turkish zhenya_route_12202aea:


    "Onun daha rahat etmesi için sol elimi yana doğru hareket ettirdim."


translate turkish zhenya_route_1ce043ab:


    unp "Belki de yapmamalıyız?..."


translate turkish zhenya_route_81d5325a:


    pi "Hiçbir şey hissetmeyeceğim."


translate turkish zhenya_route_574f5a8b:


    "Elleri titriyordu ve iğne bir o yana bir bu yana zıplıyordu."


translate turkish zhenya_route_8ef32db4:


    "Eğer bir damarını kaçırırsa, bu iyi olmaz."


translate turkish zhenya_route_5bc3003e:


    "Sovyet ecza dolabından alınan ilaçlarla ötenazi yapmak.... şüpheli bir zevktir..."


translate turkish zhenya_route_4f6d90df:


    unp "Bana öyle bakma."


translate turkish zhenya_route_5df5d92e:


    "Kız aniden dedi."


translate turkish zhenya_route_1ab9aef2:


    pi "Sana nasıl bakıyorum? Dikkatini dağıtma!"


translate turkish zhenya_route_11f22c5a:


    unp "Bunu yapamam..."


translate turkish zhenya_route_9b411c3c:


    pi "İşte başlıyoruz..."


translate turkish zhenya_route_de7ff5a4:


    "Yenilgiyle iç çekip elimi geri çektim."


translate turkish zhenya_route_be9f07ea:


    pi "Tamam, unut gitsin. Uyuyacağım ve yarın normale döneceğim. Çıkarken ışıkları ve kapıyı kapatmayı unutma!"


translate turkish zhenya_route_28fb42e2:


    "Kız itaatkar bir şekilde çıkışa doğru yöneldi ama yarı yolda dondu."


translate turkish zhenya_route_d40a0991:


    unp "Gerçekten çok mu acı çekiyorsun?"


translate turkish zhenya_route_cd157731:


    pi "Bu doğru, doğru! Şimdi ne fark eder ki? Sabırlı olacağım."


translate turkish zhenya_route_a609ce96:


    unp "Yapabilirim... {w} ancak... eğer gözlerini kapatırsan."


translate turkish zhenya_route_15ac0b0f:


    pi "Peki kapatacağım, ne değişecek?"


translate turkish zhenya_route_b895e892:


    unp "Benim için daha kolay olacak. Sanki uyuyormuşsun gibi."


translate turkish zhenya_route_5e2e3ab6:


    "Sadece gözleriyle gülümsedi."


translate turkish zhenya_route_1c1458d1:


    pi "Tamam kapatayım."


translate turkish zhenya_route_2fdb022d:


    "Sanki yanlış bir şey yokmuş gibi."


translate turkish zhenya_route_9f19ad89:


    "Öncü kız bana doğru yürüdü ve şırıngayı aldı."


translate turkish zhenya_route_790ba682:


    unp "Ee?"


translate turkish zhenya_route_53a2d83d:


    pi "Evet, evet."


translate turkish zhenya_route_2ffa5e6c:


    "Gözlerimi kapattım ve aynı anda beynimde bir düşünce belirdi: Ona neden bu kadar körü körüne güveniyorum?"


translate turkish zhenya_route_587bd764:


    "Daha yarım saat önce verandada dururken tamamen farklı düşünüyordum!"


translate turkish zhenya_route_db889481:


    "Bir şey beni o kadar sıkı yatağa bastırdı ki kollarımı veya bacaklarımı hareket ettiremedim.{w} Ne yaratıkmış!"


translate turkish zhenya_route_00986cf7:


    "Elinde turnike tutan öncü bir kız tepemde belirdi."


translate turkish zhenya_route_2737718a:


    "Bir an sonra boynumu daha da sıkı kavradı."


translate turkish zhenya_route_047476be:


    pi "Ne yapıyorsun..."


translate turkish zhenya_route_34a7e6ca:


    "Hırıldadım."


translate turkish zhenya_route_a0fcf8d6:


    "Aradığım ölüm bu olsa bile, bu şekilde değil, turnike ile değil! Hayır! Bekle, hazır değilim!"


translate turkish zhenya_route_465ef323:


    "Öncü gittikçe daha sert bastırdı, yüzünde donmuş bir delilik ifadesi vardı: ağzı şeytani bir şekilde sırıtıyordu, çökmüş gözleri tamamen açıktı ve doğal olmayan bir ışıkla parlıyor gibiydi."


translate turkish zhenya_route_ff6a97ff:


    "Kurtulmak için boşuna uğraştım - yaralarım ve zayıflığım engel oldu."


translate turkish zhenya_route_6496742f:


    "Ve şimdi oksijen yoksunluğu başlıyor - her şey gözlerimin önünde yüzüyor, onları kapatıyorum, ama onun çılgın yüz buruşturmasının izi içerideki göz kapaklarında kalıyor!"


translate turkish zhenya_route_65581f39:


    "Bilincimin bir ucunda açık bir kapının çalındığını duyuyorum, şeytani öncü tutuşunu gevşetiyor ve şimdi başka bir kızın yüzü karşımda beliriyor."


translate turkish zhenya_route_b2ada642:


    slp "Hadi gidelim! Acele et"


translate turkish zhenya_route_ada3d630:


    "Tanıdık bir ses fısıldıyor."


translate turkish zhenya_route_9ce82d61:


    "Biri kalkmama yardım etti, birine yaslandım ve topallayarak ilk yardım istasyonundan uzaklaştım."


translate turkish zhenya_route_ce617998_18:


    "…"


translate turkish zhenya_route_871a5dfa:


    "Yavaş yavaş yürüyorduk, sürekli tökezliyor ve her şeye çarpıyorduk."


translate turkish zhenya_route_f59b944c:


    "Bilincimi kaybettim ve kendime geldim ama başımı kaldıramıyordum ve sadece ayaklarıma bakıyordum: sağlık merkezinin önündeki kaldırım taşlarının yerini meydanın asfaltı, onun yerini de dökülmüş yapraklar ve iğnelerle kaplı zemin almıştı."


translate turkish zhenya_route_5ee85201:


    "Sonunda durduk, güçlükle yere çöktüm ve etrafıma baktım."


translate turkish zhenya_route_404bac47:


    "Burası öncünün beni getirdiği aynı açıklık gibi..."


translate turkish zhenya_route_39d09361:


    pi "Bugün cehennem azabı çekiyorum..."


translate turkish zhenya_route_b92aee43:


    "Sırıtmaya çalıştım ama hemen öksürmeye başladım; elimin arkası kanla kaplıydı."


translate turkish zhenya_route_b080400f:


    slp "İşte, bir içki iç."


translate turkish zhenya_route_43a9d8cf:


    "Kız bana bir kamp matarası uzattı."


translate turkish zhenya_route_9e06cea6:


    "Zorlukla birkaç yudum alıp kurtarıcıma baktım."


translate turkish zhenya_route_8a6b8e6c:


    "Aynı tanıdık kıza benziyordu, sadece her zamanki görünümünden farklı bir şey vardı."


translate turkish zhenya_route_8cfe0426:


    "Yine de bu öncü kadının gülümsemesi yüzünde donmuş soğuk kararlılık ifadesinden daha uygundu."


translate turkish zhenya_route_c196cab9:


    "Gerçekten ne diyeceğimi bile bilmiyordum..."


translate turkish zhenya_route_966ef311:


    "Eğer tıp merkezindeki o manyak hakkında bir kez yanıldıysan ve bir saniyeliğine rahatlama fırsatı bulduysan, şimdi sonuna kadar kendini toparlamalısın!"


translate turkish zhenya_route_ca5f5721:


    "Ancak vücudumdaki dayanılmaz ağrılar ve baş dönmesi bir an bile konsantre olmama izin vermedi."


translate turkish zhenya_route_631179f6:


    pi "Burada neler oluyor..."


translate turkish zhenya_route_9e9814e8:


    slp "Sessiz ol, konuşmaya gerek yok; bu seni daha da kötüleştirir! Her şeyi biliyorum."


translate turkish zhenya_route_2e7e3777:


    "Kız dedi ve sanki kendi sözlerinin aksine bir cevap bekliyormuş gibi dikkatle bana baktı."


translate turkish zhenya_route_70c9b40f:


    slp "Senin hakkında her şeyi biliyorum. Aslında, ben de... gerçeğim."


translate turkish zhenya_route_efee23f6:


    pi "Sen nesin, gerçek mi? Dün zaten tanışmıştık - ve senin hakkında {i}gerçek{/i} hiçbir şey fark etmedim!"


translate turkish zhenya_route_7ac3698b:


    "Tekrar kan kustum."


translate turkish zhenya_route_2513e664:


    pi "Bu yine senin yaptığın bir şaka mı?"


translate turkish zhenya_route_b033ae17:


    "Daha sakin bir şekilde devam ettim."


translate turkish zhenya_route_e83d1d1c:


    pi "Beni öylece öldüremezsin, öldürmezsin, değil mi? İşkenceye, alay etmeye mi ihtiyacın var? Delirmemi mi istiyorsun?"


translate turkish zhenya_route_e3e89799:


    "Ve sonra tüm bunların zaten bir zamanlar olduğunu fark ettim... {w} ancak şimdi rollerimiz değişti."


translate turkish zhenya_route_3e56f2df:


    slp "Hayır, hayır, öyle değil! Yanlış anladın! Dün benimle konuşmuyordun. Neden bunu açıklıyorum - sanki sen kendin anlamıyormuşsun gibi!"


translate turkish zhenya_route_39ffacba:


    "Öncü kaşlarını çattı."


translate turkish zhenya_route_8b5427ea:


    slp "Kendi kopyalarınla hiç tanışmadın sanki?"


translate turkish zhenya_route_0ae95c2e:


    "Sözlerinde kesinlikle bir mantık vardı, hemen bulamadığım bir kusur."


translate turkish zhenya_route_8321ad79:


    pi "Peki diyelim ki...{w} Bütün bunları neden yapmak istiyorsun? Bana yardım etmek için yani?"


translate turkish zhenya_route_7d3ad2c5:


    slp "Çünkü sen de benim gibisin, {i}gerçek!{/i}Bu doğal değil mi? Sen benim yerimde olsan aynısını yapmaz mıydın?"


translate turkish zhenya_route_ec9da8a5:


    "Keşke eskiden nasıl şeyler yaptığımı bilseydi..."


translate turkish zhenya_route_218c2c76:


    "Peki ya yalan söylemiyorsa?!"


translate turkish zhenya_route_b6ba807e:


    "Sonuçta bu dünyada kendimden başka {i}insanlarla{/i} da tanıştım!"


translate turkish zhenya_route_e309eca4:


    pi "Eğer öyleyse teşekkürler..."


translate turkish zhenya_route_a5f76af6:


    "Öncü cevap vermedi, sadece gülümsedi."


translate turkish zhenya_route_ad54904e:


    pi "Ama o zaman nasıl olduğunu hala anlamıyorum...{w} Yani \"seninle\" binlerce kez tanıştım - ve hepsi bottu."


translate turkish zhenya_route_c3c67cfd:


    slp "Açıklaması zor ve şimdi zaman yok!"


translate turkish zhenya_route_bf9c30b9:


    pi "Zaman mı yok, acelen mi var?"


translate turkish zhenya_route_7bd2bccb:


    slp "Ve bir tek ben değilim! Yakında buradan çıkacağız!"


translate turkish zhenya_route_794059c2:


    pi "Bu anlamda - bu devrimden yenisine mi?"


translate turkish zhenya_route_48a94368:


    slp "Hayır! Yani genel olarak bu kamptan!"


translate turkish zhenya_route_c6ae4acd:


    pi "Bu nasıl mümkün olabilir?.."


translate turkish zhenya_route_ec482ad2:


    "Aptal bir gülümsemeye boğuldum."


translate turkish zhenya_route_3bf95c39:


    "Buradan çıkmanın bir yolu olduğu fikri bile uzun zamandır bana saçma geliyordu."


translate turkish zhenya_route_35c07165:


    slp "Sakın bana sonsuza kadar burada kalmak istediğini söyleme?"


translate turkish zhenya_route_4faa5838:


    pi "Aslında, ben her zaman buradayım..."


translate turkish zhenya_route_c0cdbc2d:


    slp "Benim işim teklif etmek."


translate turkish zhenya_route_c4dddafe:


    pi "Hayır, dur, sadece beni yanlış anladın..."


translate turkish zhenya_route_895a960c:


    "Peki bu neden \"yanlış\"?"


translate turkish zhenya_route_4d5b7b29:


    "{i}Gerçek{/i} dünyaya dönmeye gerçekten hazır mıyım?"


translate turkish zhenya_route_b5a196bc:


    "Artık bana yabancı ve düşmanca geliyor, çünkü evim artık bu kamp."


translate turkish zhenya_route_a6c7a702:


    "Ama bu ev harabe halinde; yağmalanmış ve yakılmış!"


translate turkish zhenya_route_429f73ec:


    "Onu yeniden inşa edebilecek miyim?"


translate turkish zhenya_route_0a336b4a:


    slp "Evet? Peki o zaman ne istiyorsun?"


translate turkish zhenya_route_108a6cc5:


    pi "Tamam ama nasıl? Benden sadece senin sözüne güvenmemi istemiyorsun, değil mi? Eğer durumumu gerçekten anlıyorsan, açıklamayı reddetmeyeceksin..."


translate turkish zhenya_route_438e567e:


    slp "Tamam ama şimdi değil; takip edilmediğimizden emin olmalıyız!"


translate turkish zhenya_route_a50296a4:


    pi "Bekle…"


translate turkish zhenya_route_79498c62:


    "Ancak öncü beni dinlemedi ve bir saniye sonra ormanın azgın yeşillikleri arasında kayboldu."


translate turkish zhenya_route_3d661175:


    "Harika..."


translate turkish zhenya_route_2d6f3c2a:


    mz "Ama nasıl dikeceğimi bilmiyorum!"


translate turkish zhenya_route_72ebe9e8:


    me "Ne yazık... İyi bir ev hanımının ciddi bir ihmali!"


translate turkish zhenya_route_7b17d3b9:


    mz "Ah, kim söyleyebilir ki! Yüzükleri neyden yapacaksın? Yoksa bir endüktans bobininin telini parmağına dolamayı mı planlıyorsun?"


translate turkish zhenya_route_a4eed316:


    me "İşte birkaç fikir..."


translate turkish zhenya_route_c59c53ff:


    mz "Peki dinliyorum."


translate turkish zhenya_route_84f14225:


    "Zhenya başarısızlığımı tahmin ederek bana dikkatle baktı ve gülümsedi."


translate turkish zhenya_route_205070b7:


    "Ancak onunla tanışmadan önce bile tamamen farklı beceriler edinmiştim ve birkaç yüzük yapmak benim için özellikle zor olmazdı."


translate turkish zhenya_route_c07bca8e:


    "Tek sorun ekipman - bir öncü kampında mücevher aletleri bulamazsın."


translate turkish zhenya_route_69c44bc3:


    "İhtiyacım olan her şeyi bir hafta içinde hazırlamak için zamanım olmazdı..."


translate turkish zhenya_route_1ca203ea:


    "Sibernetik kulübü olmasaydı!"


translate turkish zhenya_route_2551c817:


    "Orada depolanan ekipmanların önemli bir kısmını incelediğinde, iki basit yüzük için yeterli yaldız bulunacaktır."


translate turkish zhenya_route_0866bdde:


    "Sibernetikçileri birkaç gün meşgul etmek sorun değil - bunu ilk kez yapmıyorum!"


translate turkish zhenya_route_bb3c0a72:


    me "Bu bir sürpriz!"


translate turkish zhenya_route_6091a866:


    mz "Öyle olsa bile..."


translate turkish zhenya_route_b4a932b1:


    "Zhenya'nın kafası karışmıştı."


translate turkish zhenya_route_b50a6e08:


    mz "Bir hafta içinde gitmiş olacaklar. Yanına hiçbir şey alamayacağını biliyorsun."


translate turkish zhenya_route_8d6f2a2a:


    me "Ne olmuş yani? Senin için iki metal parçası mı daha önemli yoksa...?"


translate turkish zhenya_route_e5b74069:


    mz "Hayır, elbette hayır..."


translate turkish zhenya_route_47c8c285:


    me "Ancak insanlar gibi şeyler yapmayı planladığımızdan... elbise..."


translate turkish zhenya_route_53695934:


    "Zhenya'nın gözleri parladı."


translate turkish zhenya_route_05ebce7a:


    "Takım elbise pek sorun değildi - kamptaki en az birkaç adamın pantolon ve ceketi olduğunu biliyordum, hatta görünüşe göre koyu gri renkteydi."


translate turkish zhenya_route_6208daa1:


    "Yazlık bir elbise de Zhenya'ya yakışırdı ama sonuçta bu onun fikriydi {w} Beklendiği gibi hemen reddetti."


translate turkish zhenya_route_5d04b965:


    me "Tül kullan!"


translate turkish zhenya_route_6c3efbe4:


    mz "Ciddi misin?"


translate turkish zhenya_route_658e4271:


    "Artık tartışmaktan yorulmuşa benziyor."


translate turkish zhenya_route_b98d0d5d:


    me "Hayır... Ama her zaman kızlardan birine sorabilirsin! Bence bu en iyi seçenek."


translate turkish zhenya_route_c02501ad:


    "Zhenya kızardı, somurttu ve arkasını döndü."


translate turkish zhenya_route_fdf97a8a:


    mz "Gidip kendin iste! Ölçülerini de al, çünkü kendin giyeceksin!"


translate turkish zhenya_route_d13b52c7:


    mz "Peki, örneğin Slava'ya gidip şunu soracağımı nasıl düşünürsün: \"Bana bir gelinlik yapar mısın?\""


translate turkish zhenya_route_6b63784c:


    me "Bana bunun neden olduğunu söyle...{w} bir kostüm yarışması için!"


translate turkish zhenya_route_209d81c1:


    me "Hayır, bu biraz aptalca..."


translate turkish zhenya_route_4e958dc2:


    me "Bir kostüm balosu için!"


translate turkish zhenya_route_6a0bdf61:


    "Zhenya şaşırdı ama hemen tartışmadı."


translate turkish zhenya_route_148134b8:


    me "Bu fikri danışmandan alacağım, için rahat olsun. Utanılacak bir şey olmayacak! Düğün gösterinin bir parçası. Shurik ve Electronik ilk insanlı uzay yürüyüşünü canlandırsın, Miku zırhlı bir arabanın üzerinde Lenin'i canlandırsın...."


translate turkish zhenya_route_f1b9bc99:


    me "Ve sen ve ben evleneceğiz!"


translate turkish zhenya_route_15cdfe60:


    mz "Peki hangi tarihi olayı yeniden canlandırarak bunu yapmak istiyorsun?"


translate turkish zhenya_route_33626f7e:


    me "Ne fark eder ki, Tanrım? Büyük Katerina ve Üçüncü Petro'nun düğünü olması umurumda değil!"


translate turkish zhenya_route_341cca1a:


    mz "Ooh, o zaman seni kötü bir kader bekliyor, kocacığım!"


translate turkish zhenya_route_8796d51d:


    "Zhenya sırıttı."


translate turkish zhenya_route_aea00f45:


    me "Önemli değil, bu sadece bir örnek! Bak zaten şaka yapıyorsun."


translate turkish zhenya_route_323de6e5:


    mz "Hâlâ bir şekilde..."


translate turkish zhenya_route_c8e1c467:


    me "Güven bana!"


translate turkish zhenya_route_91039827:


    mz "Tamam, eğer her şeyin yoluna gireceğini düşünüyorsan..."


translate turkish zhenya_route_ce617998_19:


    "…"


translate turkish zhenya_route_333e14d0:


    "Hava aydınlanmaya başlamıştı, ateş tekrar kendini hatırlatıyordu ve hatta daha da kötüleşiyor gibiydi."


translate turkish zhenya_route_21698494:


    "\"Gerçek\" öncü ormanın bir yerinde kaybolmuş gibiydi - sanırım tekrar terk edildim..."


translate turkish zhenya_route_4bde977b:


    "Ancak bu sefer pek yanılgıya düşmedim; {i}gerçekliğe{/i} dönmek değil, sadece dünyayı normale döndürmek istedim."


translate turkish zhenya_route_d802c7b0:


    "Belki diğer tarafta sadece bir saat veya on yıllar geçmiştir; bunun bir önemi yok."


translate turkish zhenya_route_f694e34b:


    "Kendimi, uyanan ve etrafımdaki dünyayı tanımayan komadaki bir insan gibi hissettim."


translate turkish zhenya_route_18fc7c9f:


    "Doğuda ufuk parlak kızıl bir ışıltıyla parlıyor, gökyüzünü ateş parıltılarıyla dolduruyordu."


translate turkish zhenya_route_f25fa47d:


    "Peki ya bu dünyada sadece sakinleri değişmediyse?"


translate turkish zhenya_route_cc66a0fd:


    "Sadece birkaç dakika daha - ve bu küçük açıklığa ulaşan kavurucu güneşin ışınları, tüm lanet \"Baykuş\" ile birlikte beni de yakacak!"


translate turkish zhenya_route_f7aa9307:


    "Keşke “gerçek” öncü geri dönse!"


translate turkish zhenya_route_a51237ea:


    "Tanıdık dünyada canlı canlı yanmaktansa {i}yeni{/i} dünyaya yerleşmek daha iyidir!"


translate turkish zhenya_route_0cac00e1:


    "Üstelik burada başıma gelen her şeyi oradaki hiç kimse bilmeyecek!"


translate turkish zhenya_route_d3d6bce6:


    "Kendi yaptığım her şey hakkında..."


translate turkish zhenya_route_95cdb0f9:


    pi2 "Aklında bir şey var gibi görünüyor, değil mi?"


translate turkish zhenya_route_64f4c9df:


    "Yakınlarda tanıdık bir ses duyuldu. {w} Benim sesim..."


translate turkish zhenya_route_9a21a38f:


    pi "Ne istiyorsun?"


translate turkish zhenya_route_c8492839:


    "Görünüşüne şaşırdım ve hatta biraz korktum - öfkeli öncülerle yeterince sorunum vardı ve görsel ikizlerimi unutmuştum."


translate turkish zhenya_route_dc0d54d6:


    "Her ne kadar \"çiftlerim\" olsa da?..{w} Onlara böyle seslenmemin üzerinden ne kadar zaman geçti?"


translate turkish zhenya_route_1fbbac28:


    "Kesinlikle, çünkü benim için her zaman {i}Ben{/i} vardı ve {i}onlar{/i} vardı - hiçbir ortak noktamız yok, biz farklı insanlarız, bir zamanlar tek olsak bile..."


translate turkish zhenya_route_9f450679:


    pi2 "Belki şunu düşünüyorsun: Hangi noktada her şey ters gitti?"


translate turkish zhenya_route_449bd8e5:


    "Burada yanılıyordu - bunu hiç düşünmedim."


translate turkish zhenya_route_43ab8e00:


    pi2 "Kendine asla cevabını bulamayacağın sorular sorarak şüpheler yüzünden eziyet mi çekiyorsun?"


translate turkish zhenya_route_f91eeb18:


    pi "Sadece bunun bitmesini istiyorum! Ve senin burada olmanın yardımcı olacağını sanmıyorum!"


translate turkish zhenya_route_33691edf:


    pi2 "Her şey uzun zaman önce durdu, eğer bahsettiğin buysa..."


translate turkish zhenya_route_4a413495:


    pi "Evet? Bir şey fark edilmiyor."


translate turkish zhenya_route_2212509c:


    pi2 "Sen hariç herkes için! O gün otobüste yanlış karar verdin ve öldün."


translate turkish zhenya_route_22952e7f:


    "Vücudumu dikkatlice inceledim.{w} Acıyor, bu da hayatta olduğum anlamına geliyor!"


translate turkish zhenya_route_2d38d332:


    pi "Gerçekten ölü bir adama benzemiyorum!"


translate turkish zhenya_route_8258081a:


    pi2 "Sence gerçekten sinemada göründüğü kadar kolay mı? Hayatın seni terk ettiği anı hatırlamak ister misin, son nefesini hatırlamak ister misin? Geçiş anını? Yeni bir varoluş seviyesindeki ilk anları?"


translate turkish zhenya_route_c9d54b47:


    pi "Anlamıyorum. O zaman {i}gerçekte{/i} ölmüş olmalıyım!"


translate turkish zhenya_route_92313099:


    pi2 "Hayır! Sana bir şans verildi, ancak sen bundan yararlanmadın ve sonunda kendi kişisel cehennemine, belirsizliğe düştün!"


translate turkish zhenya_route_6aee1bdf:


    pi "Ah, Amerika'yı keşfetmişsin de haberim yokmuş!"


translate turkish zhenya_route_e8ac9853:


    pi2 "Bunu biliyordun ama artık burada yalnız kaldığını ve hiçbir çıkış yolu olmadığını bilmiyordun!"


translate turkish zhenya_route_5eb47f22:


    pi "Biliyordum..."


translate turkish zhenya_route_7c4f3efc:


    "Ya da en azından tahmin ettim."


translate turkish zhenya_route_4e47c222:


    pi "Peki ya sen?"


translate turkish zhenya_route_4822c2b3:


    pi2 "Ben burada değilim! Ben senin halüsinasyonunum!"


translate turkish zhenya_route_24b2d9d5:


    "Ve orman onun iğrenç kahkahasıyla çınladı."


translate turkish zhenya_route_0870ec03:


    "Bütün bunlar acı verici derecede tanıdık ama neden şimdi tekrarlanıyor?"


translate turkish zhenya_route_ed1d079e:


    "Bela tek başına gelmez dedikleri doğru mu?"


translate turkish zhenya_route_9ec16ea9:


    pi "Tanrı aşkına..."


translate turkish zhenya_route_724dc14a:


    "Gözlerimi kapattım ve güvende olmak için arkamı döndüm."


translate turkish zhenya_route_997dc7d7:


    pi3 "Bunu ona yapma çünkü o da bizden biri! Ya da en azından bir zamanlar öyleydi..."


translate turkish zhenya_route_bebf711e:


    "Tanıdık ses biraz farklı geliyordu."


translate turkish zhenya_route_5b2a770e:


    "Önümdeki açıklıkta iki öncü vardı."


translate turkish zhenya_route_8f95cdc6:


    pi2 "Bir kamayı yenemezsin!"


translate turkish zhenya_route_a6e86815:


    pi3 "Zaten onun her şeyini çaldılar!"


translate turkish zhenya_route_c8ef17e5:


    pi2 "Yani hepsi bu değil!"


translate turkish zhenya_route_0c2864de:


    "Tartıştılar ve gerçeklik benim için tüm anlamını yitirdi."


translate turkish zhenya_route_2f5de2b0:


    pi3 "Bak, o zaten aklını tamamen kaybetmiş!"


translate turkish zhenya_route_044d2365:


    pi2 "Özel bir şey yok, geçecek! Ulyana'ya anlattığımız hikayede olduğu gibi, var olmayan bir arkadaşının adına {i}imza atarak{/i}: \"Deli insanlar akıl sağlığına kavuşur ve normal insanlar delirir.\""


translate turkish zhenya_route_67371292:


    "Ve yine o şeytani kahkaha."


translate turkish zhenya_route_f0b0ba2b:


    pi2 "Sence bu onun başına ilk kez mi geliyor?"


translate turkish zhenya_route_102a2a69:


    pi3 "Öyle değil mi?"


translate turkish zhenya_route_e27da733:


    pi2 "Bunun ilk kez olmadığından eminim! Her şeyi hatırladığını, her şeye hazır olduğunu, her öncünün davranışını önceden bildiğini sanıyor! Ama o kadar çok şeyi unuttu ki! Unutulan, belki de en önemlisi..."


translate turkish zhenya_route_c19cedfa:


    uv2 "Yeter artık!"


translate turkish zhenya_route_c600ee72:


    "Aniden bu ikisi ayrıldı ve uzun kulaklı olan sürünerek öne çıktı..."


translate turkish zhenya_route_cf99867f:


    "Ondan her zaman biraz korkmuştum çünkü bana öyle geliyordu ki ondan hiçbir iyi şey beklemeye değmezdi."


translate turkish zhenya_route_ea619637:


    "Üstelik ruhumun derinliklerinde bir yerde, bende bir tür hayvani, ilkel korkuyu, tıpkı karanlık korkusunu uyandırdı."


translate turkish zhenya_route_1bc7b239:


    "Ve ben onun hikayesine hiç inanmadım! {w} Sanki o bizim bilinçaltımız, onun gizli kısmı!"


translate turkish zhenya_route_628e7777:


    "Ne saçmalık ama!"


translate turkish zhenya_route_c0c70154:


    uv2 "Görmüyor musun, kendini kötü hissediyor! Hiçbir işe yaramıyorsun! İşte buradasın..."


translate turkish zhenya_route_9229cca9:


    "Parmağını “kötü” öncüye doğrulttu."


translate turkish zhenya_route_cd25bf7c:


    uv2 "İlaç almak için hemşire odasına koş!"


translate turkish zhenya_route_9f2460f9:


    pi2 "Ne ilacı?.."


translate turkish zhenya_route_f3f86c57:


    "Biraz şaşırmıştı."


translate turkish zhenya_route_654f75d1:


    uv2 "Hangileri olduğunu bilmiyorum! Buradaki en akıllı kişi sensin; o halde çöz şunu!"


translate turkish zhenya_route_136154fe:


    "Öncü umutsuzca içini çekti ve yavaş yavaş kampa doğru ilerledi."


translate turkish zhenya_route_e04e4c0e:


    uv2 "Peki sen…"


translate turkish zhenya_route_8f4741a0:


    "“İyi olana” baktı."


translate turkish zhenya_route_9d637256:


    uv2 "Ve sen...{w} yani...{w} ayrıca kendine yapacak bir şeyler bul! Tanrım, senin sızlanmanı dinlemek mide bulandırıcı; bu sadece durumu daha da kötüleştiriyor!"


translate turkish zhenya_route_1187e1a0:


    pi3 "Ama yardım etmek istedim..."


translate turkish zhenya_route_ea0da183:


    uv2 "Ama yardım etmiyorsun! O halde hadi!"


translate turkish zhenya_route_151f70d8:


    "Elini salladı ve yüzünde öyle bir ifade oluşturdu ki, kafasında bir düşünce parladı - tıpkı hoşnutsuz bir kedi gibi!"


translate turkish zhenya_route_85e516ba:


    "Öncü tartışmadı ve ikizini takip etti."


translate turkish zhenya_route_5cd1f1b6:


    pi "Peki şimdi ne olacak?"


translate turkish zhenya_route_c0cfa3ab:


    "Pek heyecan duymadan sordum."


translate turkish zhenya_route_6dd0b4ac:


    "Bir kereden fazla aldatıldım - ona şimdi bile inanmayı düşünmüyorum {w} Özellikle ona!"


translate turkish zhenya_route_698655c7:


    "Bütün yerel sakinler arasında uzun kulaklı olanın yardımıma koşacağını hiç düşünmezdim."


translate turkish zhenya_route_01ee43cb:


    "En azından kelimelerle - çünkü o da geçmiş zamanları hatırlıyor, otobüsteki kavgamızı hatırlıyor."


translate turkish zhenya_route_4eddc54b:


    pi "Beni tekrar aptal durumuna düşürebileceğini mi sanıyorsun?"


translate turkish zhenya_route_eb468b81:


    "Son gücümle ayağa kalktım, gözlerim acıdan kararmıştı."


translate turkish zhenya_route_968edac1:


    "Ama nereye gideceğim?"


translate turkish zhenya_route_5c0580b2:


    "Kendime bir şırınga almalıydım o zaman..."


translate turkish zhenya_route_7bea4bf4:


    "Ve neden {i}burada{/i} intiharın son olduğuna karar verdim?"


translate turkish zhenya_route_6e9bb08c:


    uv2 "Hey!"


translate turkish zhenya_route_f5f49f8f:


    "Koca kulaklı olan yanıma sıçradı ve düşmemem için beni tuttu."


translate turkish zhenya_route_4991f6ed:


    pi "Sen...{w} gerçekten bana yardım ettiğine inanmamı mı istiyorsun?!"


translate turkish zhenya_route_2c0c4fc1:


    uv2 "Peki şimdi ne yaptığımı sanıyorsun? Sonuçta, her zaman {i}sana yardım ediyorum{/i}!"


translate turkish zhenya_route_74481647:


    pi "Evet, elbette..."


translate turkish zhenya_route_b7427c21:


    "Tekrar yere çöktüm ve derin bir iç çektim."


translate turkish zhenya_route_de2d25b8:


    "Bu durumda gerçekten gidecek hiçbir yerim yok."


translate turkish zhenya_route_19691844:


    pi "Peki öncüleriniz ne zaman dönecek?.."


translate turkish zhenya_route_f0748a5e:


    uv2 "Yakında…"


translate turkish zhenya_route_0ba6f1f4:


    "Belli belirsiz cevap verdi."


translate turkish zhenya_route_0a87d3a3:


    pi "Tamam, oturup bekleyelim, kaybedecek hiçbir şeyim yok..."


translate turkish zhenya_route_a20cefa7_6:


    "..."


translate turkish zhenya_route_e9c63299:


    "Bütün kamp meydanda toplandı."


translate turkish zhenya_route_034dc053:


    "Ulyana, Electronik'i kovalayarak kartondan yapılmış, kötü bir şekilde buruşmuş bir kozmonot kaskını almaya çalışıyordu."


translate turkish zhenya_route_4f376572:


    "İlk insan uzay yürüyüşü sahnesinde ilginçlikler yok değildi: sibernetikçiler için yapılan doğaçlama roket, Shurik'in en kritik anda atladığı Genda'nın bir anıtıydı."


translate turkish zhenya_route_48adf945:


    "Dünya'ya uçmak güzeldi, Dünya yörüngesinden biraz daha yakındı ve bahtsız öncüyle neredeyse şarkıdaki gibi karşılaştı - \"evin yakınındaki çimenler.\""


translate turkish zhenya_route_457c4564:


    mt "Koşmayı bırak! Kendini öldüreceksin!"


translate turkish zhenya_route_4bd9c425:


    "Olga Dmitrievna feryat etti."


translate turkish zhenya_route_b6eca189:


    "Bu durumda onu neyin daha çok endişelendirdiğini bile bilmiyorum - sibernetiğin sağlığı mı yoksa çok eski zamanlardan beri yılın 365 günü hiçbir kazanın yaşanmadığı kampın imajı mı?"


translate turkish zhenya_route_0b44a339:


    "Yanımda duran Zhenya kolumu çekiştirdi ama ben gösteriye fazla kapıldığım için buna hemen dikkat etmedim."


translate turkish zhenya_route_ce73fe66:


    mz "Ee!"


translate turkish zhenya_route_ad02f53a:


    me "Ne?"


translate turkish zhenya_route_173b40bd:


    mz "Bunu yapmamız gerektiğine emin misin?"


translate turkish zhenya_route_c62cea6e:


    me "İstediğin buydu!"


translate turkish zhenya_route_5d729a3c:


    mz "Ve ben hiçbir şey istemedim!{w} Az önce önerdin, ben de kabul ettim..."


translate turkish zhenya_route_bbd48daa:


    me "Bunu zaten yüzlerce kez tartıştık. Üstelik bu gerçek değil, bunu sen de biliyorsun."


translate turkish zhenya_route_8dad8ac4:


    mz "Ah, yani şimdi gerçek değil mi?"


translate turkish zhenya_route_cb64fecf:


    "Tehditkar bir şekilde söyledi."


translate turkish zhenya_route_2cf45de0:


    me "Öyle demek istemedim... Sadece {i}bu{/i} dünyadayız, unutma. Birkaç gün içinde her şey yeniden olacak, kimse bunu hatırlamayacak bile."


translate turkish zhenya_route_26238f0b:


    mz "Evet ama yapacağım!"


translate turkish zhenya_route_070599c2:


    me "Peki kimden daha çok utanıyorsun? Çevremizdekilerden mi yoksa kendinden mi?"


translate turkish zhenya_route_e9fca54d:


    "Zhenya kızardı ve cevap vermedi."


translate turkish zhenya_route_aed58c1a:


    mt "Tamam, git giyin artık!"


translate turkish zhenya_route_40fea5f9:


    "Olga Dmitrievna bize emri verdi."


translate turkish zhenya_route_a752ccba:


    me "Hazır mısın?"


translate turkish zhenya_route_38c18bf5:


    "Zhenya başını salladı."


translate turkish zhenya_route_ce617998_20:


    "…"


translate turkish zhenya_route_53d34154:


    "10 dakika sonra meydanda sıradan bir öncü kampına göre tuhaf bir gösteri yaşandı."


translate turkish zhenya_route_a219887e:


    "“Baykuş” için bile tuhaftı bu!"


translate turkish zhenya_route_907927ec:


    "Evet ve öncülerden oluşan bir kalabalığın ortasında, başka birinin omzundan eski bir Sovyet kıyafeti giymiş halde dururken kendimi tuhaf hissettim."


translate turkish zhenya_route_3903c48c:


    "Elbette resmi bir frak değil ama şort ve kısa kollu gömlekten daha iyidir."


translate turkish zhenya_route_941c499b:


    "Zhenya aceleyle dikilmiş bir gelinlik giymişti."


translate turkish zhenya_route_159608c4:


    "Başka bir durumda gülünç göründüğünü söylerdim ama şimdi değil."


translate turkish zhenya_route_9d9d5e6c:


    "Şimdi bu elbise bana iddialı moda salonlarının kıyafetlerinden daha güzel göründü."


translate turkish zhenya_route_f29ba8f0:


    mt "Peki şimdi benim unuttuğum hangi sahneyi yapıyorsun?"


translate turkish zhenya_route_567dd942:


    "Danışman kulağıma fısıldadı."


translate turkish zhenya_route_4fdd0140:


    me "Olga Dmitrievna, ne fark eder! Hadi başlayalım!"


translate turkish zhenya_route_025b7514:


    mt "Tamam…"


translate turkish zhenya_route_de8c4bfc:


    "Zhenya bir ıstakoz kadar kırmızıydı ve gözlerini nereye saklayacağını bilmiyordu."


translate turkish zhenya_route_a876aab3:


    "Görünüşe göre kesinlikle bana bakmak istemiyordu."


translate turkish zhenya_route_0e1a4307:


    me "Her şey yoluna girecek."


translate turkish zhenya_route_5788b9db:


    "dedim sessizce."


translate turkish zhenya_route_ff4fa4d8:


    "Miku öncü kalabalığın içinde neşeyle gülümsüyor, sanki kendi düğünüymüş gibi bakıyordu - belki biraz aptalca ama samimi."


translate turkish zhenya_route_3c5ef511:


    "Lena her zamanki gibi kızarıyordu ama ara sıra bize bakıyordu."


translate turkish zhenya_route_d006862e:


    "Alice buraya zorla getirildiğini ve kendisine kalsa gitar çalmasının ya da sadece uyumasının daha iyi olacağını anlatmaya çalıştı."


translate turkish zhenya_route_7b0dcbe4:


    "Ancak Ulyana açıkça tüm performanstan memnun kaldı: Çocukların mutlu olmak için fazla bir şeye ihtiyacı yok."


translate turkish zhenya_route_002294ae:


    "Slavya bizim adımıza gerçekten çok mutlu görünüyordu ve tatlı bir şekilde gülümsedi."


translate turkish zhenya_route_fc45d68b:


    mz "Bu işi hızla bitirelim."


translate turkish zhenya_route_337d23ad:


    "Görünüşe göre biraz daha fazla ve Zhenya ölesiye utanacak."


translate turkish zhenya_route_01822020:


    me "Tamam."


translate turkish zhenya_route_280f303c:


    me "Biz hazırız."


translate turkish zhenya_route_ab16cb35:


    "Danışmana bağırdım."


translate turkish zhenya_route_27d5273b:


    "Artık düğünlerde genellikle söylenen şeyi söyleme zamanı gelmişti."


translate turkish zhenya_route_daa4ab51:


    "Elbette kelimeleri tam olarak bilmiyordum ve önceden hazırladığım her şeyi başarıyla unutmuştum."


translate turkish zhenya_route_4208fbed:


    me "Yemin ederim..."


translate turkish zhenya_route_9eb7ae3d:


    "Titreyen bir sesle konuşmaya başladım."


translate turkish zhenya_route_145c5153:


    me "Kederde ve yaşlılıkta..."


translate turkish zhenya_route_100598bd:


    "Hayır, orada durum tam olarak böyle değildi."


translate turkish zhenya_route_32f2392a:


    us "Neden mırıldanıyorsun? Hiçbir şey duyamıyorum!"


translate turkish zhenya_route_1770bf88:


    "Ulyana neşeyle çığlık attı."


translate turkish zhenya_route_2676b165:


    dv "Sessiz ol, yoksa sonun Zhenya gibi olur."


translate turkish zhenya_route_8155be36:


    "Tehdidin kendisi üzerinde anında etkisi oldu ve Ulyana sustu."


translate turkish zhenya_route_90d25991:


    me "Genel olarak bu..."


translate turkish zhenya_route_3b342837:


    "Daha bir dakika önce kesinlikle sakin olduğuma yemin etmeye hazırdım ama şimdi tek kelime edemiyordum."


translate turkish zhenya_route_cca9bafd:


    "Zhenya'nın nasıl hissettiğini kimse tahmin edemezdi."


translate turkish zhenya_route_1e527a61:


    "Cesaretimi topladım."


translate turkish zhenya_route_1d086fbd:


    me "Ömrümün sonuna kadar, ölüm bizi ayırana kadar, kederde, sevinçte, zenginlikte ve yoksullukta seninle birlikte olacağıma yemin ederim!"


translate turkish zhenya_route_7aaa9384:


    "Bundan önce neşeli gürültücü öncüler anında sustular."


translate turkish zhenya_route_b4112c36:


    "Öyle bir sessizlik vardı ki kalbimin çılgınca atışını duyabiliyordum."


translate turkish zhenya_route_6d361550:


    "Zhenya hâlâ gözleri aşağıya dönük bir şekilde duruyordu."


translate turkish zhenya_route_5d3c27fa:


    me "Peki, şimdi sen!"


translate turkish zhenya_route_7b26ab8b:


    "Derin bir nefes aldı ve ağzından kaçırdı:"


translate turkish zhenya_route_7f141d67:


    mz "Seninle evlenmeyi kabul ediyorum, iyi günde de kötü günde de yanında olacağıma söz veriyorum. Bu kadar!"


translate turkish zhenya_route_5c93db98:


    "Kalabalık kahkahalara boğuldu."


translate turkish zhenya_route_f65f12c2:


    "Ancak Zhenya'nın sözleri bana oldukça ciddi geldi."


translate turkish zhenya_route_fde7233b:


    mz "Ve şu işi bitirelim."


translate turkish zhenya_route_e0f4c4c3:


    me "Peki ya \"artık gelini öpebilirsin\"?"


translate turkish zhenya_route_1a014c13:


    "Şakacı bir ses tonuyla sordum."


translate turkish zhenya_route_8492c157:


    "Zhenya gözlerini kırpıştırarak bu durumda öpüşmeden de yapabileceğimizi açıkça belirtti."


translate turkish zhenya_route_c8b5fcd7:


    "Muhtemelen haklıdır ve bunun için hala zaman olacak."


translate turkish zhenya_route_a718aa85:


    mt "Tebrikler! Herkese teşekkürler!"


translate turkish zhenya_route_f52b105b:


    "Olga Dmitrievna bağırdı. Elektronik bir kamerayla öne çıktı."


translate turkish zhenya_route_4f2d1d7d:


    "Öyle görünüyordu ki sanki şimdi elindeki lastik demirini büyük bir zevkle tutuyormuş gibiydi."


translate turkish zhenya_route_6ddf4f60:


    el "Hatırlanması gereken birkaç kare..."


translate turkish zhenya_route_e70a6fe5:


    mz "İşte yine başlıyoruz!"


translate turkish zhenya_route_a312257a:


    "Zhenya ona böğürdü."


translate turkish zhenya_route_1b473258:


    me "Hadi - bir aile fotoğraf albümü için."


translate turkish zhenya_route_b402f943:


    "Biraz tereddüt etti ama yine de gülümser gibi bir tavır takındı."


translate turkish zhenya_route_cd93bb8a:


    me "Her şeyi doğru yaptık! Gerekenden bile daha iyi!"


translate turkish zhenya_route_cd8ad1b8:


    "Zhenya ilk defa gözlerimin içine baktı, gülümsedi ve şöyle dedi:"


translate turkish zhenya_route_bcd11e4b:


    mz "Evet, muhtemelen."


translate turkish zhenya_route_ce617998_21:


    "…"


translate turkish zhenya_route_0852e54f:


    "Gün bitmek üzereyken uyandım."


translate turkish zhenya_route_0bb1d15b:


    "Ateşim düştü ve sağ kolumda bir enjeksiyon izi vardı."


translate turkish zhenya_route_532743cd:


    "Kulaklı olan gerçekten işe yaradı mı?.."


translate turkish zhenya_route_5ca624bb:


    "İlk başta, son günlerde yaşananlardan sonra buradaki herhangi birinin iyi bir iş yapabileceğine inanamadım."


translate turkish zhenya_route_762d0ac9:


    "Zorlukla kalktım ve kampa doğru yola çıktım."


translate turkish zhenya_route_7dac7415:


    "Sonuçta ormanda kesinlikle yapacak hiçbir şeyim yok ve sanki işler daha da kötüye gidemezmiş gibi."


translate turkish zhenya_route_67da5e6b:


    "Kafamdan defalarca tek bir düşünce geçti - Buna katlanmalıyım, bu hafta hayatta kalmalıyım ve sonra daha kolay olacak - fiziksel olarak iyileşeceğim, hatta zihinsel olarak iyileşmek için biraz zaman olacak."


translate turkish zhenya_route_d272d59d:


    "Sadece umutsuzluğa kapılma, pes etme - {i}onun{/i} gibi olma!"


translate turkish zhenya_route_85b36826:


    "Böyle yaşamaktansa ölmek daha iyidir!"


translate turkish zhenya_route_a20cefa7_7:


    "..."


translate turkish zhenya_route_3a421f90:


    "Sırt çantaları, çantalar ve paketlerle öncüler meydanda bir o yana bir bu yana koşuşturuyordu."


translate turkish zhenya_route_cb975bdd:


    "Danışman, elleri kalçalarında, küçük bir anıt gibi Genda'nın yanında duruyordu ve tehditkar bir şekilde bağırıyordu."


translate turkish zhenya_route_7b2c05b0:


    "Ne bekleyeceğimi bilmeden olduğum yerde donup kaldım."


translate turkish zhenya_route_f64d961c:


    "{i}Bu{/i} dünya sürekli hareket halindeydi, gözlerimizin önünde değişiyordu: dün beni öldürmek istediler, peki ya bugün?"


translate turkish zhenya_route_f711d58a:


    mtp "Merhaba Semyon!"


translate turkish zhenya_route_303ef93d:


    "Danışman bana tehditkar bir şekilde bakarak bağırdı."


translate turkish zhenya_route_058c857c:


    pi "Kim, ben mi? Benimle mi konuşuyorsun?"


translate turkish zhenya_route_98ac5311:


    mtp "Neden hâlâ toplanmadınız?"


translate turkish zhenya_route_f8ea68a4:


    pi "Hazır mısın? Daha erken anladım..."


translate turkish zhenya_route_5268cef9:


    mtp "Bugün vardiyanın son günü! Yine mi unuttun? Haydi hazırlanalım!"


translate turkish zhenya_route_4267b07b:


    "Onunla tartışmak istemedim - sadece gücüm yoktu - ve şaşırmayı uzun zaman önce bıraktım, o yüzden şöyle dedim:"


translate turkish zhenya_route_6c4fab7d:


    pi "Böyle giyinmem sorun olur mu?"


translate turkish zhenya_route_e9b3d6f4:


    "Ve yırtık pırtık giysilerini ve vücudunun her yerindeki çürükleri gösterdi."


translate turkish zhenya_route_4eb3fa9a:


    mtp "Senin derdin ne?"


translate turkish zhenya_route_ee50b2d9:


    "Danışman gerçekten şaşırmıştı."


translate turkish zhenya_route_3c6b857f:


    mtp "Ormanda koşup düştün mü?"


translate turkish zhenya_route_077afa71:


    pi "Bu saçmalık da ne? Ne ormanı? Neden ormanda koşayım ki?"


translate turkish zhenya_route_64416fdd:


    mtp "Tamam, o senin bileceğin iş... Yarım saat sonra çıkıyoruz, yine geç kalırsan bir vardiya daha kalırsın!"


translate turkish zhenya_route_fde537c1:


    "Sırıttı."


translate turkish zhenya_route_a5626efa:


    "“Bir vardiya daha kalmak”..."


translate turkish zhenya_route_7cbd0db3:


    "Hayır, bu kesinlikle planlarımın bir parçası değil!"


translate turkish zhenya_route_8cc96c2a:


    "Her neyse, buradan çıkmak için bir şans vardı - bu kadar kötü bir şekilde olsa bile!"


translate turkish zhenya_route_af3b5ab5:


    "Yavaş adımlarla durağa doğru ilerledim."


translate turkish zhenya_route_ad26bb5a:


    "Bütün kamp otobüsün önünde toplanmıştı."


translate turkish zhenya_route_a27f23dc:


    "Herkes danışmanı bekliyordu - sonuçta kendi kurallarına uymak onun kurallarında değil."


translate turkish zhenya_route_37559c26:


    unp "Ah, ne oldu sana?.."


translate turkish zhenya_route_9673889c:


    "İlk yardım istasyonundaki öncü kadın anlayışla sordu."


translate turkish zhenya_route_0b9afc20:


    slp "Sen iyi misin? Yara bandı ister misin?"


translate turkish zhenya_route_dd4b010c:


    "Evet, üzerine de biraz muz koy!"


translate turkish zhenya_route_3f25e7ab:


    dvp "Muhtemelen sarhoş oldu ve bir hendeğe düştü."


translate turkish zhenya_route_662ce80f:


    "Evet, kim söyleyebilir ki..."


translate turkish zhenya_route_2872693b:


    usp "Ya kurtlar ona saldırırsa!"


translate turkish zhenya_route_12528bfb:


    "Keşke bu kurtlar yerel öncüler olsa..."


translate turkish zhenya_route_222786fb:


    "Başımı ellerimin arasına alıp kaldırımın kenarına sessizce oturdum."


translate turkish zhenya_route_aef7bae3:


    "Artık yarın ne olacağını düşünmek istemiyordum - yeni bir aşamaya mı geçeceğim yoksa her şey nihayet sonsuza dek sona erecek mi?"


translate turkish zhenya_route_cfa4c35a:


    "Ya da belki önümde beni bekleyen başka bir şey vardır,{w} daha iyi bir şey?"


translate turkish zhenya_route_ce617998_22:


    "…"


translate turkish zhenya_route_cae10f7f:


    "Uyandığımda Zhenya yoktu."


translate turkish zhenya_route_65b807df:


    "Muhtemelen kendi işlerini halletmeye gitmiştir."


translate turkish zhenya_route_f9aba6a3:


    "Tanrı aşkına, bu öncülük oyununa ihtiyacı yok!"


translate turkish zhenya_route_90bc68a6:


    "Hele ki ilk düğün gecesinde!"


translate turkish zhenya_route_9a8da883:


    "Uzandım ve tatlı tatlı esnedim."


translate turkish zhenya_route_9d92e2de:


    "Tamam ama ona sürpriz yapabilirim - ormandan çiçek toplayacağım."


translate turkish zhenya_route_9b419756:


    "Tanrı bilir nasıl bir hediye ama vadideki zambakları sevdiğini biliyorum."


translate turkish zhenya_route_523c3f6b:


    "Kadınların çiçekleri neden sevdiğini hiç anlamadım..."


translate turkish zhenya_route_d823504c:


    "O zaman ısırgan otu veya çobanpüskülü neden olmasın?"


translate turkish zhenya_route_04a18347:


    "Sonuçta bunlar da bitkilerdir ve saksılarda ve vazolarda değil, doğal ortamlarında iyidirler."


translate turkish zhenya_route_206496b3:


    "Ancak Zhenya'ya vadideki zambakları her verdiğimde yüzü parlak bir gülümsemeyle aydınlansa ne fark eder?"


translate turkish zhenya_route_1919fcf8:


    "Tabii belki de mesele sadece çiçekler değildir..."


translate turkish zhenya_route_f7f98ab4:


    "Elimde bir buketle kütüphaneye koştum ve kapıyı yüksek sesle açtım."


translate turkish zhenya_route_d823e1d6:


    "Kütüphanecinin masasına kasvetli bir Alice oturdu ve tembel bir şekilde bir dergiyi karıştırdı."


translate turkish zhenya_route_4bc48b58:


    dv "Ah, yeni evli geldi."


translate turkish zhenya_route_38e73ed3:


    "Kaşlarının altından bakarak mırıldandı."


translate turkish zhenya_route_b3705464:


    me "Merhaba, Zhenya nerede?.."


translate turkish zhenya_route_b20b9d5a:


    dv "Bilmiyorum. Kendisi için buraya oturmamı istedi ve bir yere gitti."


translate turkish zhenya_route_9edc69e2:


    "Evet, benim Zhenya'm Alice'i bile ikna edebilir."


translate turkish zhenya_route_21e4d285:


    me "Tamam, o zaman ben..."


translate turkish zhenya_route_59986aee:


    dv "Ve hiç de mutlu görünmüyordu."


translate turkish zhenya_route_23858456:


    "Alice beni peşinden attı."


translate turkish zhenya_route_6b3f4d60:


    "Zhenya nereye gitti?"


translate turkish zhenya_route_48ccafa2:


    "Belki o da beni şaşırtmaya karar verdi?"


translate turkish zhenya_route_c1260382:


    "Hayır, sürprizler ona göre değil; muhtemelen kahvaltı vakti gelmiştir."


translate turkish zhenya_route_aa30435e:


    "Yemek odasına gittim - hayır, koştum."


translate turkish zhenya_route_b11e70d8:


    "İçeride öncüler neşeyle gevezelik ediyor, tabaklar neşeyle takırdıyordu, kasvetli aşçı bile bugün alışılmadık derecede neşeli görünüyordu."


translate turkish zhenya_route_0b93c284:


    "Slavya'yı fark ettim ve ona yaklaştım."


translate turkish zhenya_route_94ff2553:


    me "Merhaba, Zhenya'yı gördün mü?"


translate turkish zhenya_route_a850b845:


    "Slavya bana şaşkınlıkla baktı, sonra biraz utanıp bakışlarını başka tarafa çevirdi."


translate turkish zhenya_route_ddb1c9c0:


    sl "Otobüs durağına gitmiş gibi görünüyor."


translate turkish zhenya_route_89d4ed9c:


    me "Durağa mı? Ne için?"


translate turkish zhenya_route_16a22502:


    sl "Bilmiyorum...{w} Kendin sorsan daha iyi olur. Acele edersen oraya varırsın."


translate turkish zhenya_route_2ef037d1:


    "Peki, otobüs durağına gideceksek, otobüs durağına gideceğiz!"


translate turkish zhenya_route_27f648fd:


    "Bir dakika sonra kamp kapısından koşarak çıktım..."


translate turkish zhenya_route_1baec8fb:


    "Zhenya'nın yolun kenarında durduğunu gördüm, bakışları uzaklarda bir yere, tarlaların ve ormanların ötesindeki ufka yönelmiş, parlak yaz güneşini takip ediyordu."


translate turkish zhenya_route_f15d9551:


    "Yüzünde üzüntü, beklenti ve özlemin birleştiği tuhaf bir ifade ama aynı zamanda Zhenya tamamen farklı görünüyordu...{w} Onu tanıyamadım."


translate turkish zhenya_route_581fe4cb:


    "En iyisi mi? Hayır, buna yarın {i}gerçek{/i} dünyaya döneceğim gerçeğinden bile daha az inanıyorum."


translate turkish zhenya_route_d91dba14:


    "Belki daha önce daha iyiydi?"


translate turkish zhenya_route_924ac1c6:


    "Sanırım öncü birçok şeyi unuttuğumu söyledi..."


translate turkish zhenya_route_95e3c63e:


    "Ama tam olarak ne?"


translate turkish zhenya_route_867fc00d:


    me "Hey, ben de seni arıyordum."


translate turkish zhenya_route_8e4d71a5:


    "Kulağa aptalca geliyordu ve sesim gözle görülür derecede titriyordu - sadece bir şey söylemem gerekiyordu, bu yüzden sahte bir gülümseme takındım ve dostça görünmeye çalıştım."


translate turkish zhenya_route_8df9005a:


    mz "Ne istiyorsun?"


translate turkish zhenya_route_ac521edd:


    "Zhenya arkasına dönmeden soğuk bir şekilde cevap verdi."


translate turkish zhenya_route_fba62ae7:


    me "Uyandım ve sen orada değildin, o yüzden..."


translate turkish zhenya_route_ff81478a:


    "Zhenya aniden döndü ve gözlerini parlattı."


translate turkish zhenya_route_01ebb44b:


    mz "Ben gidiyorum."


translate turkish zhenya_route_f2dc887f:


    "Beklenmedik derecede sakin bir ses tonuyla söyledi."


translate turkish zhenya_route_25f7abbc:


    me "Nereye?"


translate turkish zhenya_route_86c8528c:


    mz "Ev."


translate turkish zhenya_route_fb5e4a90:


    me "Burada hiç otobüs yok..."


translate turkish zhenya_route_e03488f6:


    "Otobüsler de neyin nesi?!"


translate turkish zhenya_route_75e90b09:


    mz "Yürüyerek."


translate turkish zhenya_route_93c27914:


    me "Ve sana bunu getirdim..."


translate turkish zhenya_route_2fab920e:


    "Titreyen elimle Zhenya'ya bir buket verdim ve buket hemen yere uçtu."


translate turkish zhenya_route_293d1e5d:


    mz "Senden hiçbir şey istemiyorum! Dünkü sen... Seni tanımak istemiyorum! Bana ne oldu bilmiyorum, ama eminim hepsi senin suçun!"


translate turkish zhenya_route_66e6b111:


    me "Hangi konuda?"


translate turkish zhenya_route_40de19bd:


    mz "Her şeyde! Bu aptal düğün ve gece yaşananlar..."


translate turkish zhenya_route_e218d65f:


    me "Ama anlaştık... Bunu sen kendin istedin! Birkaç hafta öncesini hatırlıyor musun?"


translate turkish zhenya_route_f22f02db:


    mz "Birkaç hafta önce seni tanımıyordum bile!"


translate turkish zhenya_route_0afb7a8c:


    "Evet, muhtemelen her şey o zaman başladı."


translate turkish zhenya_route_89eaae80:


    "Ya da {i}devam{/i} – artık umurumda değil!"


translate turkish zhenya_route_8de561c3:


    "Zhenya ile mutlu olabileceğime karar verdim ve o da tıpkı ortaya çıktığı gibi aniden ortadan kayboldu."


translate turkish zhenya_route_47016d9b:


    "{i}Zhenya kütüphanede değil, yemek odasının verandasında oturuyordu{/i} - çok uzun zaman önceydi..."


translate turkish zhenya_route_a49f0e42:


    "Umudumu yitirdikten sonra insan olmayı bıraktım ama sonra onunla tanıştım ve hayat bana bu tuhaf dünyada bile ikinci bir şans verdi sanki."


translate turkish zhenya_route_e96d834d:


    "Sonra o gitti ve sonsuz sayıda döngüden sonra her şeyi unuttum, aynı oldum ve yeniden kendim olmayı bıraktım..."


translate turkish zhenya_route_8209fb60:


    "Belki {i}o{/i} haklıydı?.."


translate turkish zhenya_route_713b6223:


    me "Ne diyorsun?.. Birbirimizi zaten tanıyoruz...{w} Birbirimizi ne kadar zamandır tanıdığımızı bile bilmiyorum!"


translate turkish zhenya_route_53223da6:


    mz "Seni tanımıyorum ve seninle tanışmayı da düşünmüyorum! Seni tanımak istemiyorum."


translate turkish zhenya_route_5dc1718e:


    me "Ama bekle, biz..."


translate turkish zhenya_route_4892f21d:


    "Aniden üzerime bir güçsüzlük çöktü ve düşmemek için diz çöktüm."


translate turkish zhenya_route_2cc03992:


    "Sağ elimin yüzük parmağında bir alyans yanıyordu - kelimenin tam anlamıyla sıcaklığını fiziksel olarak hissettim."


translate turkish zhenya_route_4d5dd590:


    mz "Al şunu!"


translate turkish zhenya_route_66517b70:


    "Zhenya cebinden bir şey çıkardı ve bana fırlattı."


translate turkish zhenya_route_35c23299:


    mz "Yürüyerek gideceğim!"


translate turkish zhenya_route_f4572a11:


    "İnce altın alyansı ellerimde döndürdüm ve ağladım."


translate turkish zhenya_route_f6b5b83d:


    "Daha önce hiç ağlamadığım gibi; ne bu dünyada, ne de ahirette..."


translate turkish zhenya_route_11c27875:


    "Ve sonra her şey sona erdi."


translate turkish zhenya_route_2b610b28:


    "Sonsuza kadar."


translate turkish zhenya_route_8c05f068:


    "Muhtemelen içimde hala insani bir şeyler kalmıştı, bu yüzden tamamen delirmemek için her şeyi unutmaya karar verdim."


translate turkish zhenya_route_2a64dbfe:


    "Ama şimdi anılar yeniden benimle ve onlarla birlikte acı da geri geldi; o kadar şiddetli değil, zamanla hafifledi ama yine de beni parçalara ayırıyor."


translate turkish zhenya_route_f7d9e51c:


    "Sanki paramparça olmuştum ve geriye garip bir tesadüf eseri bilinç kazandırılmış küçük bir et parçası kalmıştı."


translate turkish zhenya_route_4f7b01ff:


    "Bir bütün ya da bir bütünün parçası değil, sadece talihsiz bir kaza, bu dünyanın mükemmel denkleminde kabul edilebilir bir hata."


translate turkish zhenya_route_302b08db:


    pi4 "Üzülme kardeşim!"


translate turkish zhenya_route_58fabdec:


    "Öncülerden biri yanıma oturdu."


translate turkish zhenya_route_90087846:


    pi "Yine sen misin?"


translate turkish zhenya_route_4f5d7a29:


    pi4 "Ben kimim?"


translate turkish zhenya_route_00129a4d:


    pi "Ne fark var ki? Sen, o, bu, bu; hepiniz aynı görünüyorsunuz!"


translate turkish zhenya_route_4c2f272f:


    "Öncü cevap vermedi, sadece sırıttı."


translate turkish zhenya_route_10c3756d:


    pi "Benimle dalga geçmeye mi geldin? O zaman beni öldürsen daha iyi olur!"


translate turkish zhenya_route_32babbd7:


    pi4 "Ama sen her şeyi hatırladın."


translate turkish zhenya_route_cce9bc51:


    pi "Hatırladım - ve bu durumu daha da kötüleştiriyor!"


translate turkish zhenya_route_56a872ce:


    pi4 "Hepsi senin hatan."


translate turkish zhenya_route_a3eb2c09:


    pi "Ne? Senin koca kulaklı ile gitmeni engellemeye çalıştığım için mi? O otobüste olanın sen olduğunu biliyorum!"


translate turkish zhenya_route_a2bffe06:


    "Öncünün yüzü kayıtsız kaldı."


translate turkish zhenya_route_6e23c048:


    pi4 "Belki öyleyim, belki değilim; şimdi ne fark eder ki?"


translate turkish zhenya_route_2b5b71d1:


    pi "Yani sen... {w} çıktın mı?"


translate turkish zhenya_route_71961912:


    pi "Ve sırf benimle uğraşmak için mi geri döndün?"


translate turkish zhenya_route_e1828c1c:


    pi4 "Bunu kendin yapmadın mı?"


translate turkish zhenya_route_9ebc18c6:


    pi "Tanrı aşkına, bana ahlak dersi verme!"


translate turkish zhenya_route_d6d21cef:


    "Dizlerimin üzerine çökmüş, Karım'ın yavaşça uzaklaşmasını izliyordum."


translate turkish zhenya_route_b7251b6d:


    "Böylece virajda ortadan kayboldu ve bir daha geri gelmeyecek..."


translate turkish zhenya_route_28c9f488:


    "Ancak bunun artık Zhenya olmadığını biliyordum - Zhenya'm dün ortadan kayboldu ve bu ruhsuz bir oyuncak bebek, sadece ona benziyor {w} Ama çok benzer..."


translate turkish zhenya_route_03273ca5:


    "Peri masalı sonsuza dek süremezdi!"


translate turkish zhenya_route_c7744369:


