translate turkish epilogue_uv_ulya_2c312632:


    me "Çilek ve mantarları mı diyorsun?"


translate turkish epilogue_uv_ulya_bf9129e5_1:


    uv "Tabii ki!"


translate turkish epilogue_uv_ulya_6935bf62:


    "Yulya kollarını iki yana açtı ve bana kızgınlıkla baktı."


translate turkish epilogue_uv_ulya_1bc3348a:


    uv "Bütün malzemelerimin gitmesini mi istiyorsun?"


translate turkish epilogue_uv_ulya_f7e824d2:


