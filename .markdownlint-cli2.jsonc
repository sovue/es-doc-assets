{
  "config": {
    "default": true,
    // строки длиннее 80 символов — обычное дело для этой документации
    "MD013": false,
    // почти каждая страница начинается с :::outdated/:::stub перед H1 — это конвенция шаблона
    "MD041": false,
    // "Пример использования" и т. п. намеренно повторяются в каждом подразделе
    "MD024": { "siblings_only": true },
    // <span>/<u> используются для намеренного оформления (например, цвет имён персонажей)
    "MD033": false,
    // "$" — это синтаксис Ren'Py (инлайн Python-команда), а не приглашение шелла
    "MD014": false,
    // нумерованные шаги часто прерываются код-блоками/контейнерами и продолжают нумерацию (5, 6, 7...),
    // из-за чего markdownlint видит их как отдельные списки, начинающиеся с 1
    "MD029": false
  }
}
